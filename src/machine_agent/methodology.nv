// methodology.nv - the illustration of the agent step that the methodology keeps (state-machine-agent-step.alula.md, format 2.14), copied as it is into `cases/` with the extension
// `.txt` (its links are the links of the methodology's folder), compiled in for the test that pins what the translator says about it.
module alula.machine_agent

/// The text of the illustration of the methodology.
export fn methodology_text() -> str => embed_str("cases/agent-step-methodology-214.alula.txt")

/// The text of the English twin of the illustration (state-machine-agent-step.en.alula.md, the same machine, row for row), copied as it is.
export fn methodology_en_text() -> str => embed_str("cases/agent-step-methodology-214.en.alula.txt")

/// The illustration of the agent step of the methodology at the commit of the format 2.14 (AL-38 ... AL-49, task 149): copied as it is.
export fn methodology_214_text() -> str => embed_str("cases/agent-step-methodology-214.alula.txt")

/// Its English twin at the same commit.
export fn methodology_214_en_text() -> str => embed_str("cases/agent-step-methodology-214.en.alula.txt")

/// The record of the machine "Meeting" of the methodology at the same commit (30 states, 67 rows, 12 rows of ends, 29 data, 22 primitives), copied as it is.
export fn meeting_214_text() -> str => embed_str("cases/meeting-methodology-214.alula.txt")
