// methodology.nv - the illustration of the agent step that the methodology keeps (spec/samples/agent-step.alula.md, format 2.23), copied as it is into `cases/` with the extension
// `.txt` (its links are the links of the methodology's folder), compiled in for the tests that pin what the translator says about it; the same for its English twin and for the record of the
// machine "Meeting". The files `cases/*-names-222*.tsv` are the output of the reference script of the package (`tools/check-alula-keywords.py`): the JSON names of the declarations.
//
// Since 0.9.1 (task 241) the call `Пауза(…)` of 2.25 is an error (a library is connected by its file only, section 9), so the tests read the copies without what the call brought: the line of
// the call (with its continuation), the party `усиленный` that only the library reads and its counter, the write word of the library in the column `пишет`. The copies themselves stay as they are: the guard of the copies compares them with
// `spec/samples/` after the migration script; the fingerprints of the files read them raw.
module alula.machine_agent

import std.text

/// The text of the illustration as it is in the file (the fingerprint of the copy).
export fn methodology_file() -> str => embed_str("cases/agent-step-methodology-222.alula.txt")

/// The text of the English twin as it is in the file.
export fn methodology_en_file() -> str => embed_str("cases/agent-step-methodology-222.en.alula.txt")

/// The record of the machine "Meeting" as it is in the file.
export fn meeting_file() -> str => embed_str("cases/meeting-methodology-222.alula.txt")

// The text without the call of «Пауза» of 2.25 and the party that only the library reads (with its counter).
fn without_pause(text str) -> str {
    mut out = []str.new()
    mut skip = false
    for line in text.split("\n") {
        ro t = line.strip_suffix("\r") ?? line
        if t.starts_with("Пауза(") || t.starts_with("Pause(") {
            skip = true
            continue
        }
        if skip && (t.starts_with(" ") || t.starts_with("\t")) { continue }
        skip = false
        if t.starts_with("| попытка_усиленного |") && text.contains("открытые_запросы != []") {
            // the rows of the meeting read `открытые_запросы`, which the call of 2.25 declared: the copy declares it in place of the counter of the party
            out.push("| открытые_запросы | []строка | [] | — | механика |")
            continue
        }
        if t.starts_with("| усиленный |") || t.starts_with("| enhanced |") || t.starts_with("| попытка_усиленного |") || t.starts_with("| enhanced_attempt |") { continue }
        // the write word of the data of the built-in library of 2.25 is gone too: those data are written by the rows
        out.push(line.replace("| действия и фрагмент |", "| действия |").replace("| rows_and_fragment |", "| rows |"))
    }
    out.join("\n")
}

/// The text of the illustration of the methodology (format 2.23, AL-51 ... AL-64, task 151) without the call of «Пауза».
export fn methodology_text() -> str => without_pause(methodology_file())

/// The text of the English twin of the illustration (spec/samples/agent-step.en.alula.md, the same machine, row for row) without the call of «Pause».
export fn methodology_en_text() -> str => without_pause(methodology_en_file())

/// The record of the machine "Meeting" of the methodology (30 states, 67 rows, 12 rows of ends, 29 data, 24 external functions, 14 rows of the names) without the call of «Пауза».
export fn meeting_text() -> str => without_pause(meeting_file())
