// journal_test.nv - the codes of the journal of the agent step are exactly the codes of the table of the journal of the methodology (state-machine-journal.md, section 2 and the
// events of the format) with the same parameters: the table of the methodology is copied here as data. Static: the codes the machine writes; dynamic: the codes the scenarios see.
module alula.machine_agent

// ORACLE-WORKAROUND(32): `import std.text` is needed in `nova build` for `[]str.join` (a `nova test` build has it already); drop the import when item 32 is fixed
import std.text
import alula.machine_table.{MachineDef, Action, JournalAct, MachineErrorAct, IfAct, ForEachAct, LetAct, NamedExpr}

// code, parameters (names, in the order of the table of the methodology)
type JCode { code str, params []str }

fn jc(code str, params []str) -> JCode => { code, params }

// The codes of the machine "agent step" in the table of the methodology (22 of its own, `fork_no_match` is one of them).
fn agent_codes() -> []JCode => [
    jc("turn_requests_exhausted", []), jc("model_refused", []), jc("turn_cancelled", []), jc("agent_permanent_error", []),
    jc("turn_failed", ["reason"]), jc("agent_transient_error", ["retry"]), jc("agent_transient_error_exhausted", ["retries"]),
    jc("fork_no_match", ["fork"]), jc("output_truncated_continue", []), jc("output_truncated_again", []), jc("agent_no_result", []),
    jc("reply_form_violated", []), jc("reply_form_not_fixed", []),
    jc("permission_auto_allowed", ["action"]), jc("permission_auto_denied", ["action"]), jc("permission_human_allowed", ["action"]), jc("permission_human_denied", ["action"]),
    jc("token_limit", ["spent"]), jc("cost_limit", ["spent"]), jc("turn_limit", ["sent"]), jc("agent_step_stopped", ["reason"]),
    jc("agent_usage", ["session", "result", "model", "input", "output", "reasoning", "cache_read", "cache_write", "cost"])
]

// The codes of the pause (the engine, rule 23).
fn pause_codes() -> []JCode => [
    jc("human_stop", ["author", "source", "event"]), jc("pause_by_parent_stop", ["request", "event"]),
    jc("cancel_discarded_foreign_request", ["request", "event"]), jc("cancel_discarded_already_replied", ["request", "event"]),
    jc("request_cancelled", ["request", "event"]), jc("cancel_parse_no_match", []),
    jc("human_continue", ["previous", "author", "source", "event"]), jc("parent_continue", ["previous", "request", "event"])
]

// The events of the format (`input_rejected` has optional parameters and is checked apart).
fn format_codes() -> []JCode => [jc("machine_data", ["data"]), jc("machine_error", ["reason"])]

fn all_codes() -> []JCode {
    mut out = []JCode.new()
    for c in agent_codes() { out.push(c) }
    for c in pause_codes() { out.push(c) }
    for c in format_codes() { out.push(c) }
    out
}

// What the interpreter itself writes (the executor discards and journals, rule 17; a defect): not codes of a machine.
fn executor_notes() -> []str => ["event_ignored", "event_unknown", "event_malformed", "machine_defect", "input_rejected", "signal_passed"]

fn engine_codes() -> []str => [
    "machine_started", "event_accepted", "reply_discarded", "request_ordered", "request_sent", "request_closed", "cancel_ordered", "cancel_sent",
    "cancel_without_request", "snapshot_ordered", "machine_finished", "engine_resumed"
]

fn find_code(code str) -> Option[JCode] {
    for c in all_codes() {
        if c.code == code { return Some(c) }
    }
    None
}

fn names_text(names []str) -> str => names.join(",")

fn param_names(params []NamedExpr) -> []str {
    mut out = []str.new()
    for p in params { out.push(p.name) }
    out
}

// The journal actions of a list of actions: "code|name,name", the nested ones too.
fn journal_of_actions(actions []Action, mut out []str) -> () {
    for a in actions {
        match a {
            JournalAct { code, params } => out.push("${code}|${names_text(param_names(params))}")
            MachineErrorAct { code, params } => out.push("${code}|${names_text(param_names(params))}")
            IfAct { cond, then_actions, else_actions } => {
                journal_of_actions(then_actions, out)
                journal_of_actions(else_actions, out)
            }
            ForEachAct { var, list, body } => journal_of_actions(body, out)
            LetAct { name, value, body } => journal_of_actions(body, out)
            _ => ()
        }
    }
}

fn written_codes(def MachineDef) -> []str {
    mut out = []str.new()
    for st in def.states {
        journal_of_actions(st.entry, out)
        for r in st.rows { journal_of_actions(r.actions, out) }
        for a in st.accept { journal_of_actions(a.actions, out) }
    }
    for r in def.common { journal_of_actions(r.actions, out) }
    out
}

fn is_written(written []str, code str) -> bool {
    for w in written {
        if w.starts_with("${code}|") { return true }
    }
    false
}

test "jn static codes" {
    ro written = written_codes(agent_def())
    for w in written {
        ro at = w.find("|") ?? 0
        ro code = w[..at]
        ro names = w[(at + 1)..]
        match find_code(code) {
            Some(c) => {
                if names != names_text(c.params) { panic("the code ${code} has the parameters [${names}], the table of the methodology has [${names_text(c.params)}]") }
            }
            None => panic("the code ${code} is not in the table of the journal of the methodology")
        }
    }
    // every code of the table of the methodology that the table of states writes by name is written (agent_usage is written by a definition, machine_data by `журнал(все_данные)`)
    for c in agent_codes() {
        if c.code != "agent_usage" && !is_written(written, c.code) { panic("the table of the methodology has the code ${c.code}, the machine does not write it") }
    }
    for c in pause_codes() {
        if !is_written(written, c.code) { panic("the pause has the code ${c.code}, the machine does not write it") }
    }
}

test "jn dynamic codes" {
    mut seen = []str.new()
    for fr in all_runs() {
        for t in fr.run.traces {
            for e in t.entries {
                ro code = e.event.code
                if engine_codes().contains(code) { continue }
                if !seen.contains(code) { seen.push(code) }
                if code == "input_rejected" {
                    // the optional parameters: reason, and the field when it applies
                    assert(e.event.params.len() == 2)
                    assert(e.event.params[0].name == "reason")
                    assert(e.event.params[1].name == "field")
                }
                if executor_notes().contains(code) { continue }
                mut names = []str.new()
                for p in e.event.params { names.push(p.name) }
                match find_code(code) {
                    Some(c) => {
                        if names_text(names) != names_text(c.params) { panic("${fr.name}: the code ${code} has the parameters [${names_text(names)}], the table has [${names_text(c.params)}]") }
                    }
                    None => panic("${fr.name}: the code ${code} is not in the table of the journal of the methodology")
                }
            }
        }
    }
    // the codes the scenarios do not see: the two of the defensive rows
    for c in all_codes() {
        if !seen.contains(c.code) && c.code != "fork_no_match" && c.code != "cancel_parse_no_match" { panic("no scenario writes the code ${c.code}") }
    }
    assert(!seen.contains("fork_no_match"))
    assert(!seen.contains("cancel_parse_no_match"))
}

test "jn counts" {
    assert(agent_codes().len() == 22)
    assert(all_codes().len() == 32)
}
