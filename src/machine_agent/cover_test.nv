// cover_test.nv - every row of the table "Agent step" has a scenario: the rows that the scenarios of `scenarios/agent-step-*` took (the mark `taken` of the state after every step) are
// compared with the rows of the machine; a row that no scenario takes is red. The rows that cannot be taken by any sequence of events are named here with the reason.
module alula.machine_agent

import std.text
import std.encoding.json.{Json}
import alula.machine.{standard_registry, agent_step_machine_text, scenario_files, NamedText}
import alula.machine_table.{MachineDef, load_machine, MachineErrorAct, ToNothing}
import alula.machine_run.{PortolanMachine, Scenario, ScenarioRun, load_portolan_machine, parse_scenario, run_scenario, run_ok, report_text}

fn agent_def() -> MachineDef {
    match load_machine(agent_step_machine_text(), standard_registry()) {
        Ok(d) => d
        Err(issues) => panic("the agent step does not load: ${issues[0].path}: ${issues[0].message}")
    }
}

fn agent_machine() -> PortolanMachine {
    match load_portolan_machine(agent_step_machine_text(), standard_registry()) {
        Ok(m) => m
        Err(e) => panic("the agent step is not made: ${e}")
    }
}

// The rows of the machine as marks: `State#n`, `common#n`, `end:State#n`.
fn all_rows() -> []str {
    ro def = agent_def()
    mut out = []str.new()
    for st in def.states {
        for r in st.rows { out.push("${st.name}#${r.n}") }
    }
    for r in def.common { out.push("common#${r.n}") }
    for er in def.end_rows { out.push("end:${er.state}#${er.n}") }
    out
}

// The rows that no event can take: the rows `else` of the forks (the conditions before them cover every value) and the row 6 of the common events (the three conditions before it
// cover every request id). They are defensive: they write `machine_error(fork_no_match)` or `cancel_parse_no_match` and go to the end ERRORED.
fn dead_rows() -> []str => ["Retry#4", "Continuation#3", "ReplyValidation#5", "Policy#4", "Budget#5", "StepOutcome#3", "common#6"]

fn agent_scenarios() -> []NamedText {
    mut out = []NamedText.new()
    for f in scenario_files() {
        if f.name.starts_with("agent-step-") { out.push(f) }
    }
    out
}

// The rows taken after every step of a scenario, from the encoded state of the trace.
fn taken_of(encoded str) -> []str {
    mut out = []str.new()
    match Json.parse(encoded) {
        Ok(j) => match j.object() {
            Some(o) => match o.get("taken") {
                Some(t) => match t.array() {
                    Some(items) => {
                        for item in items {
                            match item.str() {
                                Some(s) => out.push(s)
                                None => ()
                            }
                        }
                    }
                    None => ()
                }
                None => ()
            }
            None => ()
        }
        Err(e) => ()
    }
    out
}

fn run_with(m PortolanMachine, file NamedText) -> ScenarioRun {
    match parse_scenario(file.text) {
        Ok(sc) => run_scenario(m, sc)
        Err(e) => panic("${file.name}: ${e.path}: ${e.message}")
    }
}

/// FileRun: a scenario file and its run.
type FileRun { name str, run ScenarioRun }

// Every scenario of the agent step run once (the machine is made once: building it checks the whole table).
fn all_runs() -> []FileRun {
    ro m = agent_machine()
    mut out = []FileRun.new()
    for f in agent_scenarios() { out.push(FileRun { name: f.name, run: run_with(m, f) }) }
    out
}

fn taken_by(run ScenarioRun) -> []str {
    mut out = []str.new()
    for t in run.traces {
        for r in taken_of(t.encoded) {
            if !out.contains(r) { out.push(r) }
        }
    }
    out
}

// The name of the scenario of a row: `agent-step-agent-turn-3`, `agent-step-common-1`, `agent-step-end-halted-5`.
fn state_word(name str) -> str {
    if name == "Start" { return "start" }
    if name == "AgentTurn" { return "agent-turn" }
    if name == "Retry" { return "retry" }
    if name == "Continuation" { return "continuation" }
    if name == "ReplyValidation" { return "reply-validation" }
    if name == "Policy" { return "policy" }
    if name == "Permission" { return "permission" }
    if name == "Budget" { return "budget" }
    if name == "Accounting" { return "accounting" }
    if name == "StepOutcome" { return "step-outcome" }
    if name == "Pause" { return "pause" }
    if name == "common" { return "common" }
    if name == "End" { return "end-end" }
    if name == "Halted" { return "end-halted" }
    if name == "Errored" { return "end-errored" }
    panic("a state without a word for the file: ${name}")
}

fn file_of_row(row str) -> str {
    ro body = row.replace("end:", "")
    match body.find("#") {
        Some(at) => "agent-step-${state_word(body[..at])}-${body[(at + 1)..]}.scenario.test.json"
        None => panic("a row without a number: ${row}")
    }
}

test "cv rows counted" {
    ro rows = all_rows()
    assert(rows.len() == 60)
    for dead in dead_rows() { assert(rows.contains(dead)) }
}

test "cv dead rows are else" {
    ro def = agent_def()
    mut seen = 0
    for st in def.states {
        for r in st.rows {
            if dead_rows().contains("${st.name}#${r.n}") {
                seen += 1
                assert(r.is_else)
                assert(r.actions.len() == 1)
                match r.actions[0] {
                    MachineErrorAct { code, params } => assert(code == "fork_no_match")
                    _ => assert(false)
                }
                match r.next.target {
                    ToNothing => ()
                    _ => assert(false)
                }
            }
        }
    }
    assert(seen == 6)
    ro last = def.common[5]
    assert(last.n == 6)
    match last.actions[0] {
        MachineErrorAct { code, params } => assert(code == "cancel_parse_no_match")
        _ => assert(false)
    }
}

test "cv every row has a file" {
    mut have = []str.new()
    for f in agent_scenarios() { have.push(f.name) }
    for row in all_rows() {
        if dead_rows().contains(row) { continue }
        if !have.contains(file_of_row(row)) { panic("no scenario file for the row ${row}: ${file_of_row(row)}") }
    }
    assert(have.len() >= 60)
}

test "cv scenarios agree and take every row" {
    ro runs = all_runs()
    assert(runs.len() >= 60)
    mut covered = []str.new()
    for fr in runs {
        if !run_ok(fr.run) { panic(report_text(fr.run)) }
        for r in taken_by(fr.run) {
            if !covered.contains(r) { covered.push(r) }
        }
    }
    ro expected = dead_rows()
    mut missing = 0
    for row in all_rows() {
        if !covered.contains(row) {
            missing += 1
            if !expected.contains(row) { panic("no scenario takes the row ${row}") }
        }
    }
    for row in expected {
        if covered.contains(row) { panic("the row ${row} is said to be dead but a scenario takes it") }
    }
    assert(missing == expected.len())
    // the scenario named after a row takes that row
    for row in all_rows() {
        if expected.contains(row) { continue }
        ro file = file_of_row(row)
        mut found = false
        for fr in runs {
            if fr.name == file {
                found = true
                if !taken_by(fr.run).contains(row) { panic("the scenario ${file} does not take the row ${row}") }
            }
        }
        if !found { panic("no scenario file for the row ${row}: ${file}") }
    }
}
