// agent_test.nv - the machine "Agent step" of the product: the table `machines/agent_step.alula.txt` (format 2.7: the sample of the methodology and the keys of the project) translates without a note, its translation is the committed
// file `agent_step.alula.json`, the machine passes the checks of the load and is made; the same table without the list markers (format 2.5) gives the same tree.
module alula.machine_agent

// ORACLE-WORKAROUND(32): `import std.text` is needed in `nova build` for `[]str.join` (a `nova test` build has it already); drop the import when item 32 is fixed
import std.text
import alula.machine.{standard_registry, agent_step_table_text, agent_step_machine_text}
import alula.machine_table.{load_machine}
import alula.machine_run.{load_alula_machine}
import alula.machine_text.{translate_checked, translate_report, TranslateReport, error_text, render_summary}

fn agent_report() -> TranslateReport => translate_checked(agent_step_table_text(), standard_registry())

fn errors_text(report TranslateReport) -> str {
    mut parts = []str.new()
    for e in report.errors { parts.push(error_text(e, "agent_step.alula.txt")) }
    parts.join(" ## ")
}

test "ag clean" {
    ro report = agent_report()
    if report.errors.len() > 0 { panic(errors_text(report)) }
    assert(report.errors.len() == 0)
    assert(report.rows_noted == 0)
    assert(report.rows_total == 127)
}

test "ag file is translation" {
    assert(agent_report().json == agent_step_machine_text())
    assert(translate_report(agent_step_table_text()).json == agent_step_machine_text())
}

test "ag loads" {
    match load_machine(agent_step_machine_text(), standard_registry()) {
        Ok(def) => {
            assert(def.name == "agent_step")
            assert(def.version == "alula-2.14")
            assert(def.states.len() == 14)
            assert(def.common.len() == 6)
            assert(def.parties.len() == 3)
            assert(def.data.len() == 21)
            assert(def.definitions.len() == 16)
            assert(def.end_rows.len() == 13)
            assert(def.primitives.len() == 3)
            assert(def.request_limit.len() == 1)
            assert(def.initial == "Start")
            assert(def.error_end == "Errored")
        }
        Err(issues) => panic("the agent step does not load: ${issues[0].path}: ${issues[0].message}")
    }
}

test "ag builds" {
    match load_alula_machine(agent_step_machine_text(), standard_registry()) {
        Ok(m) => {
            assert(m.name() == "agent_step")
            assert(m.limit == 1)
            assert(m.state_name(m.initial()) == "Start")
        }
        Err(e) => panic("the agent step is not made: ${e}")
    }
}

test "ag summary" {
    ro text = render_summary(agent_step_machine_text())
    assert(text.starts_with("machine agent_step (version alula-2.14): 14 states, 47 rows, "))
    assert(text.contains("  AgentTurn (appeal): 9 rows, 18 actions"))
    assert(text.contains("common events: 6 rows"))
    assert(text.contains("ends: 13 rows"))
}

// The table without the list markers and with the old continuation lines, format 2.5: the tree is the same but the key `alula_version`.
fn without_markers(text str) -> str {
    mut lines = []str.new()
    for line in text.split("\n") {
        if line.starts_with("  - ") {
            lines.push("           ${line[4..]}")
        } else if line.starts_with("- ") {
            lines.push(line[2..])
        } else {
            lines.push(line)
        }
    }
    lines.join("\n").replace("format: 2.14", "format: 2.14")
}

test "ag markers optional" {
    ro plain = without_markers(agent_step_table_text())
    assert(plain != agent_step_table_text())
    ro report = translate_checked(plain, standard_registry())
    if report.errors.len() > 0 { panic(errors_text(report)) }
    assert(report.json.replace("\"alula_version\":\"2.5\"", "\"alula_version\":\"2.14\"") == agent_step_machine_text())
}
