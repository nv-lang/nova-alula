// sample_test.nv - the sample of the methodology (spec/samples/agent-step.alula.md, format 2.7, copied as it is into `cases/`) goes through the translator without a hand edit: no errors,
// the checks of the table pass, the paragraphs are skipped, the expansion of the fragment is skipped, the JSON is the JSON of the product table but for the keys of the project.
module alula.machine_agent

// ORACLE-WORKAROUND(32): `import std.text` is needed in `nova build` for `[]str.join` (a `nova test` build has it already); drop the import when item 32 is fixed
import std.text
import alula.machine.{is_table_name}
import alula.examples.{sample_registry}
import alula.machine_table.{load_machine}
import alula.machine_text.{translate_checked, TranslateReport, error_text, render_summary}

fn lf(text str) -> str => text.replace("\r\n", "\n")

fn sample() -> str => lf(methodology_text())

fn sample_report() -> TranslateReport => translate_checked(sample(), sample_registry())

fn sample_json() -> str => sample_report().json

fn report_of(text str) -> TranslateReport => translate_checked(text, sample_registry())

fn lines_of_errors(report TranslateReport) -> []str {
    mut out = []str.new()
    for e in report.errors { out.push("${e.line}:${e.col} ${e.kind} ${e.message}") }
    out
}

fn says_error(report TranslateReport, needle str) -> bool {
    for line in lines_of_errors(report) {
        if line.contains(needle) { return true }
    }
    false
}

fn line_number(text str, start str) -> int {
    mut no = 0
    for line in text.split("\n") {
        no += 1
        if line.starts_with(start) { return no }
    }
    -1
}

test "sm clean" {
    ro report = sample_report()
    if report.errors.len() > 0 { panic(error_text(report.errors[0], "sample")) }
    assert(report.errors.len() == 0)
    assert(report.rows_noted == 0)
    assert(report.rows_total == 127)
}

test "sm warnings listed" {
    ro report = sample_report()
    assert(report.warnings.len() == 0)
    assert(sample().contains("Начальное состояние: СТАРТ"))
}

test "sm loads" {
    match load_machine(sample_json(), sample_registry()) {
        Ok(def) => {
            assert(def.name == "agent_step")
            assert(def.version == "alula-2.22")
            assert(def.states.len() == 14)
            assert(def.common.len() == 6)
            assert(def.parties.len() == 3)
            assert(def.data.len() == 21)
            assert(def.definitions.len() == 16)
            assert(def.end_rows.len() == 13)
            assert(def.primitives.len() == 3)
            assert(def.request_limit.len() == 1)
            assert(def.params.len() == 2)
        }
        Err(issues) => panic("the sample does not load: ${issues[0].path}: ${issues[0].message}")
    }
}

test "sm summary" {
    ro text = render_summary(sample_json())
    assert(text.starts_with("machine agent_step (version alula-2.22): 14 states, 47 rows, "))
    assert(text.contains("  AgentTurn (appeal): 9 rows, 18 actions"))
    assert(text.contains("common events: 6 rows"))
    assert(text.contains("ends: 13 rows"))
}

test "sm header 27" {
    assert(sample_json().starts_with("{\"format\":\"machine/2\",\"alula_version\":\"2.22\",\"machine\":\"agent_step\",\"version\":\"alula-2.22\""))
    assert(sample().contains("- format: 2.22"))
}

test "sm no expansion section" {
    // the section of the expansion of a fragment is gone from the sample (AL-44, 2.13): the sample holds none, and a section added at the end is named as removed with nothing else said
    assert(!sample().contains("## Раскрытие"))
    ro junk = report_of("${sample()}\n## Раскрытие фрагмента «Пауза»\n\n@@@ {{{ \"\n| a |\n")
    assert(junk.errors.len() == 1)
    assert(junk.errors[0].message.contains("убран"))
}

test "sm no prose needed" {
    mut kept = []str.new()
    mut after_blank = true
    mut in_code = false
    for line in sample().split("\n") {
        if line.starts_with("```") {
            in_code = !in_code
            kept.push(line)
            after_blank = false
            continue
        }
        ro paragraph = !in_code && after_blank && line != "" && !line.starts_with("#") && !line.starts_with("|") && !line.starts_with("- ") && !line.starts_with("Начальное состояние")
        if paragraph { continue }
        kept.push(line)
        after_blank = line == ""
    }
    ro stripped = kept.join("\n")
    assert(stripped.byte_len() < sample().byte_len() - 1000)
    ro report = report_of(stripped)
    if report.errors.len() > 0 { panic(error_text(report.errors[0], "stripped")) }
    assert(report.errors.len() == 0)
    assert(report.json == sample_json())
}

test "sm second state pause" {
    ro heading = "### ПАУЗА — обращение\n- Сторона: усиленный\n\n"
    ro text = sample().replace("### КОНЕЦ — конец", "${heading}### КОНЕЦ — конец")
    assert(text != sample())
    ro report = report_of(text)
    assert(report.errors.len() >= 1)
    assert(says_error(report, "состояние `ПАУЗА` объявлено дважды"))
    ro at = line_number(text, "### ПАУЗА — обращение")
    assert(lines_of_errors(report)[0].starts_with("${at}:5 name "))
}

test "sm connection only" {
    ro ticks = "```"
    ro text = sample().replace("право_записи: \"файлы, которые правит агент; пауза их права не трогает\")\n${ticks}\n", "право_записи: \"файлы, которые правит агент; пауза их права не трогает\")\n${ticks}\n\nСправка о подключении.\n")
    assert(text != sample())
    ro report = report_of(text)
    assert(report.errors.len() >= 1)
    assert(says_error(report, "только строки подключения"))
    ro list = sample().replace("право_записи: \"файлы, которые правит агент; пауза их права не трогает\")\n${ticks}\n", "право_записи: \"файлы, которые правит агент; пауза их права не трогает\")\n${ticks}\n\n- пункт списка\n")
    assert(says_error(report_of(list), "только строки подключения"))
}

test "sm words" {
    ro json = sample_json()
    assert(json.contains("\"values\":[[\"Read\",\"read\"],[\"Write\",\"write\"],[\"Delete\",\"delete\"],[\"Move\",\"move\"],[\"Search\",\"search\"],[\"Execute\",\"execute\"],[\"Network\",\"network\"],[\"Think\",\"think\"],[\"SwitchMode\",\"switch_mode\"],[\"Other\",\"other\"]]"))
    assert(!json.contains("FailCode\",\"cases"))
    assert(json.contains("{\"name\":\"CallerKind\",\"cases\":[{\"name\":\"Lens\"},{\"name\":\"CycleSession\"},{\"name\":\"ChatTurn\"},{\"name\":\"Gatekeeper\"}]}"))
}

test "sm sets" {
    ro json = sample_json()
    ro q = "\\\""
    assert(json.contains("full {ActionKind: ${q}allow${q} | ${q}deny${q} | ${q}ask${q}}"))
    assert(json.contains("\"result\":\"${q}allow${q} | ${q}deny${q} | ${q}ask${q}\""))
}

test "sm id field" {
    ro json = sample_json()
    assert(!json.contains("\"request_id\""))
    assert(json.contains("\"name\":\"cancel_request\",\"fields\":[{\"name\":\"id\",\"type\":\"text\"}]"))
}

test "sm table names" {
    for n in ["a.alula.md", "a.alula.txt"] { assert(is_table_name(n)) }
    for n in ["a.md", "a.json", "a.alula", "table.md", "a.alula.json", "a.table.json", "foo.table.md", "foo.table.txt", "foo.machine.json"] { assert(!is_table_name(n)) }
    // the translator reads the text and not the name of the file: the notes of one text differ only by the name that the caller prints
    ro broken = translate_checked(sample().replace("число_ходов += 1", "число_ходов +="), sample_registry())
    assert(broken.errors.len() > 0)
    ro old_name = error_text(broken.errors[0], "agent_step.table.md")
    ro new_name = error_text(broken.errors[0], "agent_step.alula.md")
    assert(old_name.replace("agent_step.table.md", "F") == new_name.replace("agent_step.alula.md", "F"))
    assert(sample_report().json == translate_checked(sample(), sample_registry()).json)
}
