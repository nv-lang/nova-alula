// support_test.nv - helpers of the tests of the interpreter: the machines of the data directory, a step with its orders as text.
module alula.machine_run

// ORACLE-WORKAROUND(32): `import std.text` is needed in `nova build` for `[]str.join` (a `nova test` build has it already); drop the import when item 32 is fixed
import std.text
import alula.machine.{Value, PrimitiveHost, EvalError, Null, enum_value, standard_registry, machine_files, text_of_file, record_get, value_json}
import alula.engine.{Incoming, EventKind, Order, StepEnvironment, JournalEvent, SignalOrder}

fn machine_text(name str) -> str => text_of_file(machine_files(), name)

fn build_from(text str) -> PortolanMachine {
    match load_portolan_machine(text, standard_registry()) {
        Ok(m) => m
        Err(e) => panic("the machine does not load: ${e}")
    }
}

fn build(name str) -> PortolanMachine => build_from(machine_text(name))

fn chat() -> PortolanMachine => build("chat.portolan.json")
fn calc() -> PortolanMachine => build("calc.portolan.json")
fn dialog() -> PortolanMachine => build("dialog.portolan.json")
fn actions() -> PortolanMachine => build("actions.portolan.json")

// The agent step with the answers of its primitives: the reply is valid, closing the turn answers nothing.
fn agent_step() -> PortolanMachine => with_replies(build("agent_step.portolan.json"), [
    ScriptedReply { name: "reply_validation", value: enum_value("ReplyCheck", "Valid") },
    ScriptedReply { name: "close_agent_turn", value: Null }
])

// An event as the engine hands it to a machine: the envelope is stamped.
fn stamped(kind EventKind, name str, request Option[str], input str) -> Incoming => {
    id: "e-1", trace: "t-1", step: 2, kind, name, request, input, at: 1000
}

fn said(text str) -> Incoming => stamped(EventKind.Input, "user_message", None, text)
fn word_in(name str, input str) -> Incoming => stamped(EventKind.Input, name, None, input)
fn chunk(text str) -> Incoming => stamped(EventKind.Progress, "agent_chunk", Some("agent-1"), text)
fn done() -> Incoming => stamped(EventKind.Answered, "agent_done", Some("agent-1"), "")
fn refused(code str) -> Incoming => stamped(EventKind.Refused, "agent_refused", Some("agent-1"), code)
fn expired() -> Incoming => stamped(EventKind.Expired, "timeout", Some("agent-1"), "")
fn cancelled() -> Incoming => stamped(EventKind.Input, "cancel", None, "")

// The result of one step: the state, whether the machine moved (Go), the orders it gave.
type Out { state PortolanState, moved bool, orders []Order, signals []SignalOrder }

fn run1(m PortolanMachine, st PortolanState, event Incoming) -> Out {
    mut environment = StepEnvironment.new()
    mut host = ScriptedHost { at: 1000, replies: m.replies, ids: 0 }
    ro transition = portolan_step(m, st, event, environment, host)
    match transition {
        Go(next) => Out { state: next, moved: true, orders: environment.orders, signals: environment.signals }
        Stay => Out { state: st, moved: false, orders: environment.orders, signals: environment.signals }
    }
}

// The same with a host of the test (to see the calls of the primitives).
fn run_with(m PortolanMachine, st PortolanState, event Incoming, mut host PrimitiveHost) -> Out {
    mut environment = StepEnvironment.new()
    ro transition = portolan_step(m, st, event, environment, host)
    match transition {
        Go(next) => Out { state: next, moved: true, orders: environment.orders, signals: environment.signals }
        Stay => Out { state: st, moved: false, orders: environment.orders, signals: environment.signals }
    }
}

// A host that remembers the names of the calls.
type RecHost { calls []str }

fn RecHost mut @call_primitive(name str, args []Value) -> Result[Value, EvalError] {
    @calls.push("${name}/${args.len()}")
    Ok(Null)
}

fn journal_text(event JournalEvent) -> str {
    if event.params.len() == 0 { return "log:${event.code}" }
    mut parts = []str.new()
    for p in event.params { parts.push("${p.name}=${p.value}") }
    "log:${event.code}(${parts.join(";")})"
}

// The orders as text, in the order of giving.
fn summary(orders []Order) -> str {
    mut parts = []str.new()
    for o in orders {
        match o {
            Send(order) => parts.push("send:${order.party}:${order.input}:${order.idle_term}")
            Note(event) => parts.push(journal_text(event))
            Cancel(order) => parts.push("cancel:${order.party}")
            Save => parts.push("save")
            Finish(c) => match c.failure {
                Some(code) => parts.push("finish:refusal:${code.name()}")
                None => parts.push("finish:answer:${c.text}")
            }
        }
    }
    parts.join(",")
}

// The signals that a step ordered as text: `request:signal`.
fn signals_text(signals []SignalOrder) -> str {
    mut parts = []str.new()
    for s in signals { parts.push("${s.request}:${s.signal}") }
    parts.join(",")
}

// A datum of the state (Null when there is none).
fn datum(st PortolanState, name str) -> Value {
    match st.data {
        Record { name: record_name, fields } => match record_get(fields, name) {
            Some(v) => v
            None => Null
        }
        _ => Null
    }
}

fn datum_json(st PortolanState, name str) -> str => value_json(datum(st, name))

// The states one after another: each event is applied to the state the previous one left; the last Out comes back.
fn run_all(m PortolanMachine, first PortolanState, events []Incoming) -> Out {
    mut out = Out { state: first, moved: false, orders: []Order.new(), signals: []SignalOrder.new() }
    for e in events { out = run1(m, out.state, e) }
    out
}

// The input of a start event.
fn start_with(json str) -> Incoming => word_in("start", json)

fn started_calc(start int) -> Out {
    ro m = calc()
    run1(m, m.initial(), start_with("{\"start\":${start},\"label\":\"abc\"}"))
}
