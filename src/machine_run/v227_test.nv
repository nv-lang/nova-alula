// v227_test.nv - task 244 (Alula 2.27, AL-147): the root of a test file says `"kind": "test"` instead of `"format": "test/0"` (no number of the schema after a slash); the old key
// is an error with the hint.
module alula.machine_run

import std.text

fn test227(root str) -> str => `{${root},"machine":"Calc","name":"t","start_at":1000,"steps":[]}`

test "v227 a test file with kind test is read" {
    match parse_test(test227("\"kind\":\"test\"")) {
        Ok(sc) => assert(sc.machine == "Calc")
        Err(e) => assert(false)
    }
}

test "v227 the key format of a test file is an error with the hint" {
    match parse_test(test227("\"format\":\"test/0\"")) {
        Ok(sc) => assert(false)
        Err(e) => assert(e.message.contains("с 2.27 — kind и revision"))
    }
}

test "v227 a kind other than test is refused" {
    match parse_test(test227("\"kind\":\"machine\"")) {
        Ok(sc) => assert(false)
        Err(e) => assert(e.message.contains("kind"))
    }
}
