// params_test.nv - P-9 of format 2.7: the interpreter takes the table "key -> value" of the project; a key is `проект.<ключ>` of the column "project override"; a key that the column
// does not have refuses the load; the value is checked against the type of the parameter. The `params` of a scenario go through the same table. P-8: the data of a word or a signal.
module alula.machine_run

import std.text
import alula.machine.{Value, Int, Text, Float, Null, List, standard_registry, scenario_files, text_of_file}
import alula.machine_table.{MachineDef, load_machine}

fn calc_def() -> MachineDef {
    match load_machine(machine_text("calc.alula.json"), standard_registry()) {
        Ok(def) => def
        Err(issues) => panic("calc does not load")
    }
}

fn given(key str, value Value) -> []ProjectValue => [ProjectValue { key, value }]

fn calc_with(params []ProjectValue) -> Result[PortolanMachine, str] => portolan_machine_with(calc_def(), standard_registry(), params)

fn calc_count(params []ProjectValue) -> str {
    match calc_with(params) {
        Ok(m) => datum_json(run1(m, m.initial(), start_with("{\"start\":0,\"label\":\"abc\"}")).state, "count")
        Err(e) => "refused: ${e}"
    }
}

fn refusal(params []ProjectValue) -> str {
    match calc_with(params) {
        Ok(m) => "built"
        Err(e) => e
    }
}

test "pp default" {
    assert(calc_count([]) == "4")
    assert(calc_count(given("проект.calc.step", Int(2))) == "4")
}

test "pp override" {
    assert(calc_count(given("проект.calc.step", Int(5))) == "10")
    assert(calc_count(given("проект.calc.step", Int(3))) == "6")
    assert(calc_count(given("проект.calc.step", Int(1))) == "4")
}

test "pp same machine" {
    ro plain = portolan_machine(calc_def(), standard_registry())
    match plain {
        Ok(m) => assert(datum_json(run1(m, m.initial(), start_with("{\"start\":0,\"label\":\"abc\"}")).state, "count") == "4")
        Err(e) => panic(e)
    }
    match calc_with([]) {
        Ok(m) => assert(m.name() == "Calc")
        Err(e) => panic(e)
    }
}

test "pp unknown key" {
    assert(refusal(given("проект.nope", Int(1))).contains("no parameter has the key проект.nope"))
    assert(refusal(given("проект.", Int(1))).contains("no parameter has the key"))
    assert(refusal(given("проект.calc.step.x", Int(1))).contains("no parameter has the key"))
}

test "pp key shape" {
    assert(refusal(given("calc.step", Int(1))).contains("the key of the project is проект.<key>"))
    assert(refusal(given("STEP", Int(1))).contains("the key of the project is проект.<key>"))
    assert(refusal(given("", Int(1))).contains("the key of the project is проект.<key>"))
    assert(refusal(given("project.calc.step", Int(1))).contains("the key of the project is проект.<key>"))
}

test "pp no column" {
    ro bare = machine_text("calc.alula.json").replace(", \"project_key\": \"calc.step\"", "")
    assert(bare != machine_text("calc.alula.json"))
    ro def = match load_machine(bare, standard_registry()) {
        Ok(d) => d
        Err(issues) => panic("calc without a key does not load")
    }
    match portolan_machine_with(def, standard_registry(), given("проект.calc.step", Int(5))) {
        Ok(m) => panic("built")
        Err(e) => assert(e.contains("no parameter has the key проект.calc.step"))
    }
    match portolan_machine_with(def, standard_registry(), given("проект.STEP", Int(5))) {
        Ok(m) => panic("built")
        Err(e) => assert(e.contains("no parameter has the key проект.STEP"))
    }
    match portolan_machine_with(def, standard_registry(), []) {
        Ok(m) => assert(m.name() == "Calc")
        Err(e) => panic(e)
    }
}

test "pp value type" {
    assert(refusal(given("проект.calc.step", Int(0))).contains("the parameter STEP"))
    assert(refusal(given("проект.calc.step", Int(-3))).contains("the parameter STEP"))
    assert(refusal(given("проект.calc.step", Text("2"))).contains("the parameter STEP"))
    assert(refusal(given("проект.calc.step", Float(2.0))).contains("the parameter STEP"))
    assert(refusal(given("проект.calc.step", Null)).contains("the parameter STEP"))
    assert(refusal(given("проект.calc.step", List([Int(1)]))).contains("the parameter STEP"))
    assert(refusal(given("проект.calc.step", Int(1))) == "built")
}

test "pp twice" {
    ro twice = [ProjectValue { key: "проект.calc.step", value: Int(2) }, ProjectValue { key: "проект.calc.step", value: Int(3) }]
    assert(refusal(twice).contains("the key проект.calc.step is given twice"))
}

test "pp checked first" {
    ro mixed = [ProjectValue { key: "проект.calc.step", value: Int(2) }, ProjectValue { key: "проект.other", value: Int(3) }]
    assert(refusal(mixed).contains("no parameter has the key проект.other"))
}

test "pp scenario params" {
    ro text = "{\"format\":\"scenario/0\",\"machine\":\"Calc\",\"params\":{\"проект.calc.step\":5},\"steps\":[{\"do\":\"feed\",\"event\":{\"kind\":\"start\",\"input\":{\"start\":0,\"label\":\"abc\"}},\"expect\":{\"state\":\"Finish\",\"data\":{\"count\":10}}}]}"
    ro run = run_text(calc(), text)
    assert(run_ok(run))
    ro plain = text.replace("\"params\":{\"проект.calc.step\":5},", "")
    ro without = run_text(calc(), plain)
    assert(!run_ok(without))
    assert(report_text(without).contains("data count"))
}

test "pp scenario key" {
    ro bad = "{\"format\":\"scenario/0\",\"machine\":\"Calc\",\"params\":{\"STEP\":5},\"steps\":[]}"
    assert(parse_err(bad).contains("the key of a parameter is проект.<key>"))
    ro good = "{\"format\":\"scenario/0\",\"machine\":\"Calc\",\"params\":{\"проект.calc.step\":5},\"steps\":[]}"
    assert(parse_err(good) == "ok")
}

fn policy_text() -> str => text_of_file(scenario_files(), "agent-step-policy-1.scenario.test.json")

test "pp agent keys" {
    ro sc = scenario_of("agent-step-policy-1.scenario.test.json")
    assert(sc.params.len() == 1)
    assert(sc.params[0].name == "проект.политика_разрешений")
    assert(run_ok(agent_run("agent-step-policy-1.scenario.test.json")))
    ro wrong = policy_text().replace("проект.политика_разрешений", "проект.другое")
    assert(wrong != policy_text())
    assert(parse_err(wrong) == "ok")
}

test "pp agent full dict" {
    ro m = build_from(agent_text())
    match portolan_machine_with(m.def, standard_registry(), given("проект.политика_разрешений", Int(1))) {
        Ok(b) => panic("built")
        Err(e) => assert(e.contains("the parameter PERMISSION_POLICY"))
    }
    match portolan_machine_with(m.def, standard_registry(), given("проект.пауза_повтора", Int(5000))) {
        Ok(b) => assert(b.name() == "agent_step")
        Err(e) => panic(e)
    }
    match portolan_machine_with(m.def, standard_registry(), given("проект.пауза_повтора", Int(-1))) {
        Ok(b) => panic("built")
        Err(e) => assert(e.contains("the parameter RETRY_PAUSE"))
    }
}

// ---- P-8: the data of a word or a signal ----------------------------------------------------------------------------------

fn malformed_in(file str, old str, new str) -> bool {
    ro text = text_of_file(scenario_files(), file).replace(old, new)
    if text == text_of_file(scenario_files(), file) { panic("nothing to replace in ${file}") }
    match parse_scenario(text) {
        Ok(sc) => {
            ro run = run_scenario(build_from(agent_text()), sc)
            for t in run.traces {
                for j in t.journal {
                    if j.starts_with("event_malformed") { return true }
                }
            }
            false
        }
        Err(e) => panic("the scenario does not read")
    }
}

test "pp several fields" {
    ro sc = scenario_of("agent-step-pause-1.scenario.test.json")
    assert(sc.steps[1].event.kind == "signal")
    assert(sc.steps[1].event.input.starts_with("{"))
    assert(sc.steps[1].event.input.contains("\"author\""))
    assert(run_ok(agent_run("agent-step-pause-1.scenario.test.json")))
}

test "pp one field" {
    ro sc = scenario_of("agent-step-common-3.scenario.test.json")
    assert(sc.steps[1].event.kind == "signal")
    assert(sc.steps[1].event.name == "cancel_request")
    assert(sc.steps[1].event.input == "other-1")
    assert(run_ok(agent_run("agent-step-common-3.scenario.test.json")))
}

test "pp no fields" {
    ro sc = scenario_of("agent-step-pause-2.scenario.test.json")
    assert(sc.steps[2].event.kind == "word")
    assert(sc.steps[2].event.name == "halt")
    assert(sc.steps[2].event.input == "")
    assert(run_ok(agent_run("agent-step-pause-2.scenario.test.json")))
}

test "pp wrong shape" {
    assert(malformed_in("agent-step-pause-1.scenario.test.json", "{\"human_word\": \"w\", \"author\": \"ann\", \"source\": \"console\"}", "\"w\""))
    assert(!malformed_in("agent-step-common-3.scenario.test.json", "\"input\": \"other-1\"", "\"input\": \"x-1\""))
}
