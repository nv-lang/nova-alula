// alula_test.nv - task 113: the machine that is data is named by the language: `AlulaMachine`, `AlulaState`, `alula_machine_with`, `load_alula_machine`,
// `alula_step`; the key of its tree is `alula_version`.
module alula.machine_run

import std.text
import alula.machine.{standard_registry, text_of_file, machine_files}
import alula.engine.{EventKind, StepEnvironment}

fn pm_text() -> str => text_of_file(machine_files(), "calc.alula.json")

fn pm_load() -> AlulaMachine {
    match load_alula_machine(pm_text(), standard_registry()) {
        Ok(m) => m
        Err(e) => panic("calc does not load: ${e}")
    }
}

test "pm names" {
    ro m = pm_load()
    ro st AlulaState = m.initial()
    assert(m.name() == "Calc")
    assert(m.state_name(st) == m.def.initial)
}

test "pm with params" {
    match alula_machine_with(pm_load().def, standard_registry(), []ProjectValue.new()) {
        Ok(m) => assert(m.def.name == "Calc")
        Err(e) => panic("rebuild: ${e}")
    }
}

test "pm step" {
    ro m = pm_load()
    mut environment = StepEnvironment.new()
    mut host = ScriptedHost { at: 1000, replies: m.replies, ids: 0 }
    ro event = stamped(EventKind.Input, "user_message", None, "go")
    ro transition = alula_step(m, m.initial(), event, environment, host)
    match transition {
        Go(next) => assert(next.name != "")
        Stay => ()
    }
}

test "pm key" {
    ro versioned = pm_text()
    assert(versioned.contains("\"alula_version\": \"2.14\""))
    match load_alula_machine(versioned, standard_registry()) {
        Ok(m) => assert(m.def.name == "Calc")
        Err(e) => panic("alula_version: ${e}")
    }
    // a tree of another version is refused
    ro older = pm_text().replace("\"alula_version\": \"2.14\"", "\"alula_version\": \"2.11\"")
    match load_alula_machine(older, standard_registry()) {
        Ok(m) => panic("2.11 is accepted")
        Err(e) => assert(e.contains("2.14"))
    }
    // the old name of the key is not accepted
    ro old = pm_text().replace("\"format\": \"machine/2\",", "\"format\": \"machine/2\", \"table_format\": \"2.5\",")
    match load_alula_machine(old, standard_registry()) {
        Ok(m) => panic("table_format is accepted")
        Err(e) => assert(e.contains("table_format"))
    }
}
