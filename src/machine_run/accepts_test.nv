// accepts_test.nv - task 126: the question "does the state take this word?" (`AlulaMachine.accepts_word`), the hub asks it in place of the name of a state.
module alula.machine_run

import alula.machine.{standard_registry, text_of_file, machine_files, Null}
import alula.engine.{Incoming, EventKind, StepEnvironment}

fn ac_load(file str) -> AlulaMachine {
    match load_alula_machine(text_of_file(machine_files(), file), standard_registry()) {
        Ok(m) => m
        Err(e) => panic("${file} does not load: ${e}")
    }
}

fn ac_dialog() -> AlulaMachine => ac_load("dialog.alula.json")

fn ac_chat() -> AlulaMachine => ac_load("chat.alula.json")

fn ac_feed(m AlulaMachine, s AlulaState, e Incoming) -> AlulaState {
    mut environment = StepEnvironment.new()
    match m.step(s, e, environment) {
        Go(next) => next
        Stay => s
    }
}

fn ac_in(m AlulaMachine, s AlulaState, name str, input str) -> AlulaState => ac_feed(m, s, stamped(EventKind.Input, name, None, input))

fn ac_open(m AlulaMachine) -> AlulaState => ac_in(m, m.initial(), "user_message", "hi")

fn ac_named(s AlulaState, name str) -> AlulaState => { name, started: s.started, input: s.input, data: s.data, taken: []str.new() }

test "ac dialog: Idle takes a message" {
    ro m = ac_dialog()
    assert(m.accepts_word(m.initial(), "user_message"))
}

test "ac dialog: Idle takes the word that closes the session" {
    ro m = ac_dialog()
    assert(m.accepts_word(m.initial(), "close_session"))
}

test "ac dialog: Idle has no row for the cancel" {
    ro m = ac_dialog()
    assert(!m.accepts_word(m.initial(), "cancel"))
}

test "ac dialog: a name the table does not know is not taken" {
    ro m = ac_dialog()
    assert(!m.accepts_word(m.initial(), "session_created"))
    assert(!m.accepts_word(m.initial(), "permission_decision"))
    assert(!m.accepts_word(m.initial(), ""))
}

test "ac dialog: a turn is open after a message, the state is not the initial one" {
    ro m = ac_dialog()
    ro open = ac_open(m)
    assert(m.state_name(open) != m.state_name(m.initial()))
}

test "ac dialog: an open turn does not take a message" {
    ro m = ac_dialog()
    assert(!m.accepts_word(ac_open(m), "user_message"))
}

test "ac dialog: an open turn takes the cancel, a signal of the table" {
    ro m = ac_dialog()
    assert(m.accepts_word(ac_open(m), "cancel"))
}

test "ac dialog: an open turn does not take the word that closes the session" {
    ro m = ac_dialog()
    assert(!m.accepts_word(ac_open(m), "close_session"))
}

test "ac dialog: a part of an answer is not a word" {
    ro m = ac_dialog()
    assert(!m.accepts_word(ac_open(m), "agent_chunk"))
}

test "ac dialog: after the cancel the session takes a message again" {
    ro m = ac_dialog()
    ro back = ac_in(m, ac_open(m), "cancel", "")
    assert(m.accepts_word(back, "user_message"))
    assert(!m.accepts_word(back, "cancel"))
}

test "ac dialog: the end takes nothing" {
    ro m = ac_dialog()
    ro closed = ac_in(m, m.initial(), "close_session", "")
    assert(!m.accepts_word(closed, "user_message"))
    assert(!m.accepts_word(closed, "close_session"))
    assert(!m.accepts_word(closed, "cancel"))
}

test "ac dialog: a state that is not in the table takes nothing" {
    ro m = ac_dialog()
    assert(!m.accepts_word(ac_named(m.initial(), "NoSuchState"), "user_message"))
}

test "ac dialog: a machine that has not started takes no word" {
    ro m = ac_dialog()
    ro s = m.initial()
    ro idle AlulaState = { name: s.name, started: false, input: s.input, data: s.data, taken: []str.new() }
    assert(!m.accepts_word(idle, "user_message"))
}

test "ac dialog: the answer does not depend on the names of the states" {
    ro m = ac_dialog()
    ro open = ac_open(m)
    assert(m.accepts_word(m.initial(), "user_message") != m.accepts_word(open, "user_message"))
    assert(m.accepts_word(m.initial(), "cancel") != m.accepts_word(open, "cancel"))
}

test "ac chat: the first state takes a message and a cancel word" {
    ro m = ac_chat()
    assert(m.accepts_word(m.initial(), "user_message"))
    assert(m.accepts_word(m.initial(), "cancel"))
}

test "ac chat: an open request takes the cancel and not a message" {
    ro m = ac_chat()
    ro open = ac_open(m)
    assert(!m.accepts_word(open, "user_message"))
    assert(m.accepts_word(open, "cancel"))
}

test "ac chat: the end takes nothing" {
    ro m = ac_chat()
    ro done = ac_feed(m, ac_open(m), stamped(EventKind.Answered, "agent_done", Some("agent-1"), ""))
    assert(!m.accepts_word(done, "user_message"))
    assert(!m.accepts_word(done, "cancel"))
}

test "ac common event: a signal of the machine of the session start is taken in a state and not in the pause or the end" {
    ro m = ac_load("session_start.alula.json")
    ro base = AlulaState { name: "Gate2", started: true, input: Null, data: m.initial_data, taken: []str.new() }
    assert(m.accepts_word(base, "human_stop"))
    assert(m.accepts_word(base, "parent_stop"))
    assert(!m.accepts_word(ac_named(base, "Pause"), "human_stop"))
    assert(!m.accepts_word(ac_named(base, "End"), "human_stop"))
}
