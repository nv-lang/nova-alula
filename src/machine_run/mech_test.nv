// mech_test.nv - the mechanics of the contract that the agent step needs (format 1, 9; rules 14, 15, 18, 21): the limit of the requests, the counters of the attempts, the open
// requests, the request of the call, the cancel of the open requests, the mark of the rows taken, the answers of the host and the parameters of a scenario.
module alula.machine_run

import std.text
import alula.machine.{text_of_file}
import alula.examples.{scenario_files, sample_registry}

fn load_err(text str) -> str {
    match load_alula_machine(text, sample_registry()) {
        Ok(m) => "ok"
        Err(e) => e
    }
}

test "mx limit with a set" {
    // a limit with a set sends at most so many at once (task 119); it was refused before
    ro lenses = machine_text("lenses.alula.json")
    assert(load_err(lenses) == "ok")
    ro limited = lenses.replace("\"initial\": \"Prepare\",", "\"request_limit\": { \"op\": \"lit\", \"value\": 2 }, \"initial\": \"Prepare\",")
    assert(limited != lenses)
    assert(load_err(limited) == "ok")
    assert(build_from(limited).limit == 2)
}

// Two agents, a limit of one: the state A waits for the agent a, the signal `jump` leads to B that asks the agent b while the request of a is open.
fn two_agents() -> str => `{"format":"machine/2","machine":"Two","version":"1","request_limit":{"op":"lit","value":1},
"data":[{"name":"open_requests","type":"[]text","initial":{"expr":{"op":"list","items":[]}},"writes":"mechanics"},
{"name":"a_attempt","type":"int>=0","initial":{"expr":{"op":"lit","value":0}},"monotonic":true,"writes":"mechanics"},
{"name":"b_attempt","type":"int>=0","initial":{"expr":{"op":"lit","value":0}},"monotonic":true,"writes":"mechanics"}],
"parties":[{"name":"a","id":"a","kind":"agent","result":"text","counter":"a_attempt"},{"name":"b","id":"b","kind":"agent","result":"text","counter":"b_attempt"}],
"signals":[{"name":"jump"}],"initial":"A",
"states":[{"name":"A","kind":"appeal","party":"a","rows":[{"n":1,"event":{"kind":"signal","name":"jump"},"to":"B"},{"n":2,"event":{"kind":"answer"},"to":"End"}]},
{"name":"B","kind":"appeal","party":"b","rows":[{"n":1,"event":{"kind":"answer"},"to":"End"}]},
{"name":"End","kind":"end","reads":[]}],
"ends":{"result":"text","rows":[{"state":"End","n":1,"when":{"op":"lit","value":true},"answer":{"kind":"answer","value":{"op":"lit","value":"done"}}}]}}`

test "mx limit guards" {
    // the limit of the requests that the machine holds open (rule 21): a second appeal that would pass it is a defect
    ro m = build_from(two_agents())
    assert(m.limit == 1)
    ro first = run1(m, m.initial(), word_in("start", ""))
    assert(first.state.name == "A")
    ro jumped = run1(m, first.state, word_in("jump", ""))
    assert(summary(jumped.orders).starts_with("log:machine_defect(kind=request_limit;"))
    assert(summary(jumped.orders).contains("finish:refusal:NoResult"))
}
