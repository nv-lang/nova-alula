// rows_test.nv - the machine "Task runner" equals the table of the methodology (task-runner-states.md): the 228 rows of the 71 states, row by row: the number of the rows of each state, where each
// row leads, the kind of each state, the party (the side) of each appeal, the words of the parties. The table of the methodology is data (`methodology_rows.tsv`, made by `extract_rows.py` from the
// file of the methodology: the state, the number of the row, the state it leads to; "!" is a row that ends in a machine error, which the methodology leads to the end ERROR). The pause (4 rows) and
// the common events (6 rows) are the fragment, checked by the scenarios. The 18 rows of the verdicts of the four reviews are rows of the fork ReviewVerdict of the product.
module alula.machine_runner

// ORACLE-WORKAROUND(32): `import std.text` is needed in `nova build` for `[]str.join` (a `nova test` build has it already); drop the import when item 32 is fixed
import std.text
import alula.machine_table.{MachineDef, StateDef, TableRow, ForkKind, AppealKind, EndKind, OperationKind, MachineErrorAct, find_party}

/// The rows of the table of the methodology that the machine does not write: the row "иначе" of a fork whose rows name every value of the type (AL-57: the type proves the exhaustion, the row would be a warning).
fn dropped_rows() -> []str => ["PhaseSwitch#7"]

fn is_dropped(state str, n int) -> bool => dropped_rows().contains("${state}#${n}")

/// MRow: a row of the table of the methodology: the Latin name of the state, the number of the row, the state it leads to or "!".
type MRow { state str, n int, to str }

fn methodology_rows() -> []MRow {
    mut out = []MRow.new()
    for line in embed_str("methodology_rows.tsv").split("\n") {
        if line.byte_len() == 0 { continue }
        mut cells = []str.new()
        for c in line.split("\t") { cells.push(c) }
        out.push(MRow { state: cells[0], n: cells[1].to_int() ?? 0, to: cells[2] })
    }
    out
}

fn state_names_of_rows() -> []str {
    mut out = []str.new()
    for r in methodology_rows() {
        if !out.contains(r.state) { out.push(r.state) }
    }
    out
}

fn rows_of(state str) -> int {
    mut most = 0
    for r in methodology_rows() {
        if r.state == state && r.n > most { most = r.n }
    }
    most
}

fn party_id_of(def MachineDef, st StateDef) -> str {
    ro at = find_party(def, st.party)
    if at < 0 { return "?" }
    def.parties[at].id
}

fn words_of(def MachineDef, id str) -> []str {
    mut out = []str.new()
    for p in def.parties {
        if p.id != id { continue }
        for w in p.signals { out.push(w.name) }
    }
    out
}

test "rw methodology rows" {
    assert(methodology_rows().len() == 228)
    assert(state_names_of_rows().len() == 72)
}

test "rw state row counts" {
    ro def = runner_def()
    for name in state_names_of_rows() {
        assert(has_state(def, name))
        ro got = state_of(def, name).rows.len()
        // the fork of the verdicts has the row "иначе" more; the appeals of the four reviews have the row of the answer and the row of the failure
        ro want = if name == "ReviewVerdict" { 19 } else if name == "PhaseSwitch" { rows_of(name) - 1 } else { rows_of(name) }
        if got != want { panic("${name} has ${got} rows, the methodology has ${want}") }
    }
    assert(state_of(def, "Pause").rows.len() == 4)
    assert(state_of(def, "End").rows.len() == 0)
    assert(state_of(def, "Halted").rows.len() == 0)
    assert(state_of(def, "Errored").rows.len() == 0)
}

test "rw every row leads where the methodology leads" {
    ro def = runner_def()
    mut seen = 0
    for m in methodology_rows() {
        if is_dropped(m.state, m.n) { continue }
        ro got = row_target(state_of(def, m.state), m.n)
        if got != m.to { panic("${m.state} #${m.n} leads to ${got}, the methodology leads it to ${m.to}") }
        seen += 1
    }
    assert(seen == 227)
}

test "rw the answer rows of the reviews lead to the fork of the verdicts" {
    ro def = runner_def()
    for name in ["AnalysisReview", "PlanReview", "ImplementationReview", "DeliveryReview"] {
        assert(state_of(def, name).rows.len() == 2)
        assert(row_target(state_of(def, name), 1) == "ReviewVerdict")
        assert(row_target(state_of(def, name), 2) == "ReviewFailure")
    }
}

test "rw rows are numbered from one" {
    ro def = runner_def()
    for name in state_names_of_rows() {
        mut k = 1
        for r in state_of(def, name).rows {
            assert(r.n == k)
            k += 1
        }
    }
}

test "rw errors end in a machine error" {
    ro def = runner_def()
    mut errors = 0
    for m in methodology_rows() {
        if m.to != "!" { continue }
        if is_dropped(m.state, m.n) { continue }
        errors += 1
        ro st = state_of(def, m.state)
        mut found = false
        for r in st.rows {
            if r.n != m.n { continue }
            found = true
            assert(r.actions.len() >= 1)
            match r.actions[r.actions.len() - 1] {
                MachineErrorAct { code, params } => assert(code != "")
                _ => panic("${m.state} #${m.n} does not end in a machine error")
            }
        }
        assert(found)
    }
    // the rows "иначе" of the 26 forks that have one (PhaseSwitch has none, see `dropped_rows`), the failure codes that are not named (SessionFailure 3, ReviewFailure 3), the restart of the implementation review (ReviewVerdict 13)
    assert(errors == 27)
}

test "rw else rows" {
    ro def = runner_def()
    mut elses = 0
    for name in state_names_of_rows() {
        ro st = state_of(def, name)
        for r in st.rows {
            if r.is_else { elses += 1 }
        }
        if st.kind == ForkKind && name != "PhaseSwitch" {
            assert(st.rows[st.rows.len() - 1].is_else)
        }
    }
    // PhaseSwitch names every value of the enum and has no row "иначе"
    assert(!state_of(def, "PhaseSwitch").rows[state_of(def, "PhaseSwitch").rows.len() - 1].is_else)
    assert(elses == 27)
}

test "rw kinds of the states" {
    ro def = runner_def()
    for n in ["PreparationOutcome", "SpecificationReconciliation", "PlanReconciliation", "PhaseSwitch", "SessionFailure", "AfterSession", "RouteClassification", "FactoryWord", "RouteCheck",
              "RouteRecording", "BriefCheck", "ApprovalCheck", "AfterApproval", "ReviewParsing", "PlanPhase", "PlanStopWord", "DecisionsOutcome", "ImplementationPhase", "ImplementationOutcome",
              "Gate8Outcome", "DeliveryPhase", "DeliveryLetter", "DeliverySecrets", "DeliveryDiff", "DeliveryMessage", "FeedbackRoute", "ReviewFailure", "ReviewVerdict"] {
        assert(state_of(def, n).kind == ForkKind)
    }
    for n in ["Preparation", "SpecificationSnapshot", "CopySnapshot", "PlanSnapshot", "ToRequirements", "ToPlan", "BriefCopy", "FullPathReturn", "ForeignSnapshot", "ApprovalRecording",
              "AnswersRecording", "DecisionsRecording", "OwnerDecisionsRecording", "LetterRenaming", "FeedbackSaving"] {
        assert(state_of(def, n).kind == OperationKind)
    }
    for n in ["End", "Halted", "Errored"] {
        assert(state_of(def, n).kind == EndKind)
    }
}

test "rw sides of the gates" {
    ro def = runner_def()
    // the side "gatekeeper": the gates on which the gatekeeper may answer; the side "enhanced": the expensive gates and the pause (decision 54 of the methodology)
    for n in ["Gate13Preparation", "TreeBusy", "Gate13Status", "Gate4", "Gate4Question", "Gate7PlanQueue", "Gate7Plan", "Gate6", "Gate7ImplementationStep", "Gate7Implementation", "Gate7Delivery", "Gate11"] {
        assert(party_id_of(def, state_of(def, n)) == "gatekeeper")
    }
    for n in ["Gate14", "Gate14Refusal", "ForeignApproval", "Gate5", "Gate8", "Gate8Confirmation", "Gate8Delivery", "Gate12", "Gate10a", "Gate10b", "Gate10c", "Gate10d", "Pause"] {
        assert(party_id_of(def, state_of(def, n)) == "enhanced")
    }
    assert(party_id_of(def, state_of(def, "SessionLaunch")) == "session_launch")
    for n in ["AnalysisReview", "PlanReview", "ImplementationReview", "DeliveryReview"] {
        assert(party_id_of(def, state_of(def, n)) == "loop_review")
    }
}

test "rw words of the gates" {
    ro def = runner_def()
    ro gate = words_of(def, "gatekeeper")
    for w in ["repeat", "halt", "no_answers", "answers", "answers_change_goal", "implementation", "plan", "requirements", "decisions_keep_plan", "decisions_change_plan", "finish", "feedback"] {
        if !gate.contains(w) { panic("the gatekeeper has no word ${w}: ${gate.join(",")}") }
    }
    assert(gate.len() == 12)
    ro enh = words_of(def, "enhanced")
    for w in ["fast", "full", "accepted", "yours", "not_yours", "confirmed", "full_path", "close_manually", "cut_scope", "other_decisions", "verified", "decisions_recorded", "allow_commit", "allow_push", "sent", "continue", "halt"] {
        if !enh.contains(w) { panic("the enhanced party has no word ${w}: ${enh.join(",")}") }
    }
    assert(enh.len() == 17)
}

test "rw words carry the data of the methodology" {
    ro def = runner_def()
    for p in def.parties {
        for w in p.signals {
            if p.id == "enhanced" && w.name == "fast" { assert(w.fields.len() == 3) }
            if p.id == "enhanced" && w.name == "full_path" { assert(w.fields.len() == 1) }
            if p.id == "enhanced" && w.name == "continue" { assert(w.fields.len() == 3) }
            if p.id == "gatekeeper" && w.name == "repeat" { assert(w.fields.len() == 0) }
            if p.id == "gatekeeper" && w.name == "answers" { assert(w.fields.len() == 1) }
        }
    }
}
