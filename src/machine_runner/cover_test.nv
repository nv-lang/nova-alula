// cover_test.nv - every row of the table "Task runner" has a scenario: the rows that the scenarios of `scenarios/runner-*` took (the mark `taken` of the state after every step) are compared with the
// rows of the machine; a row that no scenario takes is red. The rows that cannot be taken by any sequence of events are named here with the reason.
module alula.machine_runner

import std.text
import std.encoding.json.{Json}
import alula.machine_table.{MachineErrorAct}
import alula.machine_run.{ScenarioRun, run_ok, report_text}

/// The rows of the machine as marks: `State#n`, `common#n`, `end:State#n`.
fn all_rows() -> []str {
    ro def = runner_def()
    mut out = []str.new()
    for st in def.states {
        for r in st.rows { out.push("${st.name}#${r.n}") }
    }
    for r in def.common { out.push("common#${r.n}") }
    for er in def.end_rows { out.push("end:${er.state}#${er.n}") }
    out
}

// The rows that no event can take. The rows "иначе" of the forks whose conditions before them cover every value that the chain can bring (a bool, an enum named in full, a datum that is always set
// before the fork) are defensive: they write `machine_error(fork_no_match)` and go to the end ERRORED. PreparationOutcome 2 is taken only after a restart whose preparation of the executor wrote
// the datum `preparation_return`; PhaseSwitch 6 only by a phase that the gate 11 never sends through the head of the cycle (the gate leads to the end itself). The row 6 of the common events
// (three conditions before it cover every request id) is defensive too. The fork PhaseSwitch names every value of the enum `Фаза`, so it has no row "иначе" (AL-57; the methodology has it as the row 7).
fn dead_rows() -> []str => [
    "PreparationOutcome#2", "PreparationOutcome#6", "PhaseSwitch#6", "AfterSession#20", "RouteClassification#6", "FactoryWord#4", "RouteCheck#5", "RouteRecording#3",
    "BriefCheck#3", "ApprovalCheck#3", "AfterApproval#3", "PlanPhase#6", "DecisionsOutcome#3", "ImplementationOutcome#6", "Gate8Outcome#4", "DeliveryPhase#3",
    "DeliveryLetter#5", "DeliverySecrets#3", "DeliveryDiff#3", "DeliveryMessage#3", "common#6"
]

// The rows taken after every step of a scenario, from the encoded state of the trace.
fn taken_of(encoded str) -> []str {
    mut out = []str.new()
    match Json.parse(encoded) {
        Ok(j) => match j.object() {
            Some(o) => match o.get("taken") {
                Some(t) => match t.array() {
                    Some(items) => {
                        for item in items {
                            match item.str() {
                                Some(s) => out.push(s)
                                None => ()
                            }
                        }
                    }
                    None => ()
                }
                None => ()
            }
            None => ()
        }
        Err(e) => ()
    }
    out
}

fn taken_by(run ScenarioRun) -> []str {
    mut out = []str.new()
    for t in run.traces {
        for r in taken_of(t.encoded) {
            if !out.contains(r) { out.push(r) }
        }
    }
    out
}

// The word of a state for the name of a file: `PreparationOutcome` - `preparation-outcome`, `Gate13Preparation` - `gate13-preparation`, `Gate10a` - `gate10a`.
fn kebab(name str) -> str {
    mut out = ""
    mut prev_low = false
    for ch in name.chars() {
        ro up = ch >= 'A' && ch <= 'Z'
        if up && prev_low { out = "${out}-" }
        out = "${out}${ch.to_ascii_lowercase()}"
        prev_low = !up
    }
    out
}

fn file_of_row(row str) -> str {
    ro body = row.replace("end:", "")
    match body.find("#") {
        Some(at) => "runner-${kebab(body[..at])}-${body[(at + 1)..]}.scenario.test.json"
        None => panic("a row without a number: ${row}")
    }
}

test "cv rows counted" {
    ro rows = all_rows()
    // 232 rows of the states of the methodology (the row "иначе" of PhaseSwitch is not written) and of the verdict fork, 4 of the pause, 6 common events, 8 rows of the ends
    assert(rows.len() == 250)
    for dead in dead_rows() { assert(rows.contains(dead)) }
    assert(dead_rows().len() == 21)
}

test "cv kebab" {
    assert(kebab("PreparationOutcome") == "preparation-outcome")
    assert(kebab("Gate13Preparation") == "gate13-preparation")
    assert(kebab("Gate10a") == "gate10a")
    assert(kebab("Gate7ImplementationStep") == "gate7-implementation-step")
    assert(kebab("End") == "end")
}

test "cv dead rows are else" {
    ro def = runner_def()
    mut seen = 0
    for st in def.states {
        for r in st.rows {
            if dead_rows().contains("${st.name}#${r.n}") && r.is_else {
                seen += 1
                assert(r.actions.len() == 1)
                match r.actions[0] {
                    MachineErrorAct { code, params } => assert(code == "fork_no_match")
                    _ => assert(false)
                }
            }
        }
    }
    // 18 rows "иначе"; the other three are PreparationOutcome 2, PhaseSwitch 6 and the row 6 of the common events
    assert(seen == 18)
    ro last = def.common[5]
    assert(last.n == 6)
    match last.actions[0] {
        MachineErrorAct { code, params } => assert(code == "cancel_parse_no_match")
        _ => assert(false)
    }
}

test "cv every row has a file" {
    mut have = []str.new()
    for f in runner_scenarios() { have.push(f.name) }
    for row in all_rows() {
        if dead_rows().contains(row) { continue }
        if !have.contains(file_of_row(row)) { panic("no scenario file for the row ${row}: ${file_of_row(row)}") }
    }
    assert(have.len() >= 228)
}

test "cv scenarios agree and take every row" {
    ro runs = all_runs()
    assert(runs.len() >= 257)
    mut covered = []str.new()
    for fr in runs {
        if !run_ok(fr.run) { panic("${fr.name}: ${report_text(fr.run)}") }
        for r in taken_by(fr.run) {
            if !covered.contains(r) { covered.push(r) }
        }
    }
    ro expected = dead_rows()
    mut missing = 0
    for row in all_rows() {
        if !covered.contains(row) {
            missing += 1
            if !expected.contains(row) { panic("no scenario takes the row ${row}") }
        }
    }
    for row in expected {
        if covered.contains(row) { panic("the row ${row} is said to be dead but a scenario takes it") }
    }
    assert(missing == expected.len())
    // the scenario named after a row takes that row
    for row in all_rows() {
        if expected.contains(row) { continue }
        ro file = file_of_row(row)
        mut found = false
        for fr in runs {
            if fr.name == file {
                found = true
                if !taken_by(fr.run).contains(row) { panic("the scenario ${file} does not take the row ${row}") }
            }
        }
        if !found { panic("no scenario file for the row ${row}: ${file}") }
    }
}

test "cv flows" {
    mut flows = 0
    mut nested = 0
    for f in runner_scenarios() {
        if f.name.starts_with("runner-flow-") { flows += 1 }
        if f.name.starts_with("runner-flow-nested-") { nested += 1 }
    }
    assert(flows == 28)
    assert(nested == 5)
}
