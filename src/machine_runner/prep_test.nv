// prep_test.nv - the destination `возврат_подготовки` of the format (rule 24, task 123): the row leads to the state that the datum `preparation_return` names; the target is read BEFORE the actions of
// the row, the jump empties the datum; an empty datum is a defect of the executor. The datum is written by the preparation of the executor only, so a probe machine takes it from its input.
module alula.machine_runner

// ORACLE-WORKAROUND(32): `import std.text` is needed in `nova build` for `[]str.join` (a `nova test` build has it already); drop the import when item 32 is fixed
import std.text
import alula.machine.{standard_registry}
import alula.machine_text.{translate_checked}
import alula.machine_run.{AlulaMachine, load_alula_machine, parse_scenario, run_scenario, run_ok, report_text}

fn probe_text() -> str {
    ro head = "# Машина: Проба возврата\n\n- machine: back_probe\n- machine_version: 1\n- format: 2.22\n\n## Вход\n\n| имя | тип | примечание |\n|---|---|---|\n| возврат_подготовки | ?Состояние | куда вернуться |\n\n"
    ro data = "## Данные\n\n| имя | тип | начальное | не убывает | пишет |\n|---|---|---|---|---|\n| возврат_подготовки | ?Состояние | вход.возврат_подготовки | — | механика |\n| остановка | \"\" \\| \"after\" | \"\" | — | строки |\n\n"
    ro states = "## Состояния\n\nНачальное состояние: РЕШИТЬ\n\n### РЕШИТЬ — развилка\n- Читает: возврат_подготовки, остановка\n\n| № | Условие | Действия | Куда |\n|---|---|---|---|\n| 1 | остановка == \"after\" | — | КОНЕЦ |\n| 2 | есть(возврат_подготовки) | остановка = \"after\" | возврат_подготовки |\n| 3 | иначе | ошибка_машины(\"fork_no_match\", fork: \"Decide\") | — |\n\n### КОНЕЦ — конец\n- Читает: остановка\n\n### ОШИБКА — конец\n- Читает: все_данные\n- При входе:\n  - журнал(запись_перехода);\n  - журнал(все_данные)\n\n"
    ro ends = "## Концы\n\n- Результат: строка\n\n| конец | № | когда | ответ |\n|---|---|---|---|\n| КОНЕЦ | 1 | истина | Ответ(остановка) |\n| ОШИБКА | 1 | истина | Отказ(FailCode.NoResult, текст_записи(запись_перехода)) |\n"
    "${head}${data}${states}${ends}"
}

fn probe() -> AlulaMachine {
    ro report = translate_checked(probe_text(), standard_registry())
    if report.errors.len() > 0 { panic(notes_of(report).join(" ## ")) }
    match load_alula_machine(report.json, standard_registry()) {
        Ok(m) => m
        Err(e) => panic("the probe is not made: ${e}")
    }
}

fn run_probe(input str, expect str) -> bool {
    ro text = "{\"format\":\"scenario/0\",\"machine\":\"back_probe\",\"name\":\"probe\",\"start_at\":1000,\"steps\":[{\"do\":\"feed\",\"event\":{\"kind\":\"start\",\"request\":\"up-1\",\"input\":${input}},\"expect\":${expect}}]}"
    match parse_scenario(text) {
        Ok(sc) => {
            ro run = run_scenario(probe(), sc)
            if !run_ok(run) { panic(report_text(run)) }
            true
        }
        Err(e) => panic("${e.path}: ${e.message}")
    }
}

test "pr the row leads to the state of the datum and empties it" {
    assert(run_probe("{\"preparation_return\":\"End\"}", "{\"state\":\"End\",\"data\":{\"stop_reason\":\"after\",\"preparation_return\":null},\"outcome\":\"answer:after\"}"))
}

test "pr without the datum the else row is taken" {
    assert(run_probe("{}", "{\"state\":\"Errored\"}"))
}
