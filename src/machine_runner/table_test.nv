// table_test.nv - the machine "Task runner" of the product: the table `machines/task_runner.alula.md` translates without a note, its translation is the committed file `task_runner.alula.json`,
// the machine passes the checks of the load and is made; the circles "tree - file - tree" in both languages give the same tree; the record is in the lists of the data files.
module alula.machine_runner

import std.text
import alula.machine.{standard_registry, task_runner_table_text, task_runner_machine_text, machine_files, table_files, text_of_file}
import alula.machine_table.{StateKind, AppealKind, ForkKind, EndKind, OperationKind, MachineParty, GatekeeperParty, EnhancedParty}
import alula.machine_run.{load_portolan_machine}
import alula.machine_text.{translate_checked, translate_report, render_summary, render_machine}

test "tr clean" {
    ro report = table_report()
    if report.errors.len() > 0 { panic(errors_text(report)) }
    assert(report.errors.len() == 0)
    assert(report.warnings.len() == 0)
    assert(report.rows_noted == 0)
    assert(report.rows_total > 240)
}

test "tr file is translation" {
    assert(table_report().json == task_runner_machine_text())
    assert(translate_report(task_runner_table_text()).json == task_runner_machine_text())
}

test "tr in the lists" {
    assert(text_of_file(machine_files(), "task_runner.alula.json") == task_runner_machine_text())
    assert(text_of_file(table_files(), "task_runner.alula.md") == task_runner_table_text())
    assert(task_runner_table_text().starts_with("# Машина: Раннер задачи"))
}

test "tr loads" {
    ro def = runner_def()
    assert(def.name == "task_runner")
    assert(def.initial == "Preparation")
    assert(def.error_end == "Errored")
    assert(def.states.len() == 76)
    assert(def.common.len() == 6)
    assert(def.parties.len() == 4)
    assert(def.end_rows.len() == 8)
    assert(def.primitives.len() == 30)
    assert(def.request_limit.len() == 1)
    assert(def.includes.len() == 0)
    assert(def.constants.len() == 2)
}

test "tr builds" {
    match load_portolan_machine(task_runner_machine_text(), standard_registry()) {
        Ok(m) => {
            assert(m.name() == "task_runner")
            assert(m.limit == 1)
            assert(m.state_name(m.initial()) == "Preparation")
        }
        Err(e) => panic("the task runner is not made: ${e}")
    }
}

test "tr kinds" {
    ro def = runner_def()
    mut forks = 0
    mut appeals = 0
    mut ends = 0
    mut operations = 0
    for st in def.states {
        if st.kind == ForkKind { forks += 1 }
        if st.kind == AppealKind { appeals += 1 }
        if st.kind == EndKind { ends += 1 }
        if st.kind == OperationKind { operations += 1 }
    }
    // 75 states of the methodology (27 forks, 15 operations, 30 appeals with the pause, 3 ends) and the fork of the verdicts of the four reviews
    assert(forks == 28)
    assert(operations == 15)
    assert(appeals == 30)
    assert(ends == 3)
    assert(forks + operations + appeals + ends == 76)
}

test "tr parties" {
    ro def = runner_def()
    mut nested = []str.new()
    mut gatekeepers = 0
    mut enhanced = 0
    for p in def.parties {
        if p.kind == MachineParty { nested.push(p.nested) }
        if p.kind == GatekeeperParty { gatekeepers += 1 }
        if p.kind == EnhancedParty { enhanced += 1 }
    }
    assert(nested.len() == 2)
    assert(nested.contains("session_start"))
    assert(nested.contains("cycle_check"))
    assert(gatekeepers == 1)
    assert(enhanced == 1)
    mut ids = []str.new()
    for p in def.parties { ids.push(p.id) }
    assert(ids.contains("session_launch"))
    assert(ids.contains("loop_review"))
    assert(ids.contains("gatekeeper"))
    assert(ids.contains("enhanced"))
}

test "tr summary" {
    ro text = render_summary(task_runner_machine_text())
    assert(text.starts_with("machine task_runner (version 1): 76 states, "))
    assert(text.contains("  AfterSession (fork): 20 rows"))
    assert(text.contains("  ReviewVerdict (fork): 19 rows"))
    assert(text.contains("  Pause (appeal): 4 rows"))
    assert(text.contains("common events: 6 rows"))
    assert(text.contains("ends: 8 rows"))
}

test "tr header" {
    assert(task_runner_machine_text().starts_with("{\"format\":\"machine/2\",\"portolan_version\":\"2.12\",\"machine\":\"task_runner\",\"version\":\"1\""))
    assert(task_runner_table_text().contains("- format: 2.12"))
}

test "tr circle ru" {
    assert(circle(task_runner_machine_text(), "ru") == "")
}

test "tr circle en" {
    assert(circle(task_runner_machine_text(), "en") == "")
}

test "tr circle same file" {
    ro first = render_machine(task_runner_machine_text(), "ru")
    assert(first.notes.len() == 0)
    ro again = translate_checked(first.text, standard_registry())
    assert(again.errors.len() == 0)
    assert(render_machine(again.json, "ru").text == first.text)
}

test "tr english file" {
    ro en = render_machine(task_runner_machine_text(), "en")
    assert(en.notes.len() == 0)
    assert(en.text.contains("- language: en"))
    assert(en.text.contains("machine session_start(input "))
    assert(en.text.contains("machine cycle_check(input "))
    assert(en.text.contains("### SessionLaunch — appeal"))
    ro back = translate_checked(en.text, standard_registry())
    assert(back.errors.len() == 0)
    assert(tree_diff(task_runner_machine_text(), back.json) == "")
    ro ru = render_machine(back.json, "ru")
    ro twice = translate_checked(ru.text, standard_registry())
    assert(twice.errors.len() == 0)
    assert(tree_diff(task_runner_machine_text(), twice.json) == "")
}

test "tr prepare return" {
    // the destination of the preparation is a row of the table: the datum is written by the executor only
    ro def = runner_def()
    mut seen = 0
    for r in state_of(def, "PreparationOutcome").rows {
        if row_target(state_of(def, "PreparationOutcome"), r.n) == "@prepare_return" { seen += 1 }
    }
    assert(seen == 1)
    assert(has_datum(def, "preparation_return"))
}
