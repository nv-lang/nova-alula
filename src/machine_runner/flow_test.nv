// flow_test.nv - what the scenarios of the task runner show all together: every state is visited, both routes end, the refusals of the table of the ends are the outcomes of scenarios, the held
// answers are journaled, and a run is deterministic (two runs give the same states, journal and data).
module alula.machine_runner

// ORACLE-WORKAROUND(32): `import std.text` is needed in `nova build` for `[]str.join` (a `nova test` build has it already); drop the import when item 32 is fixed
import std.text
import alula.machine_run.{ScenarioRun, StepTrace, run_ok}

fn named(runs []FileRun, name str) -> ScenarioRun {
    for fr in runs {
        if fr.name == "${name}.scenario.test.json" { return fr.run }
    }
    panic("no scenario ${name}")
}

fn last_outcome(run ScenarioRun) -> str => run.traces[run.traces.len() - 1].outcome

fn last_state(run ScenarioRun) -> str => run.traces[run.traces.len() - 1].state

test "fl the scenarios all together" {
    ro runs = all_runs()
    assert(runs.len() == 257)
    for fr in runs {
        if !run_ok(fr.run) { panic(fr.name) }
    }
    mut visited = []str.new()
    mut steps = 0
    mut outcomes = []str.new()
    for fr in runs {
        outcomes.push(last_outcome(fr.run))
        for t in fr.run.traces {
            steps += 1
            if !visited.contains(t.state) { visited.push(t.state) }
            for row in taken_of(t.encoded) {
                ro at = row.find("#") ?? -1
                if at > 0 {
                    ro name = row[..at].replace("end:", "")
                    if !visited.contains(name) { visited.push(name) }
                }
            }
        }
    }
    for st in runner_def().states {
        if !visited.contains(st.name) { panic("no scenario visits the state ${st.name}") }
    }
    assert(steps > 700)
    assert(outcomes.contains("refusal:NoResult"))
    assert(outcomes.contains("refusal:StoppedByHuman"))
    assert(outcomes.contains("refusal:Cancelled"))
}

test "fl the two routes end" {
    ro runs = all_runs()
    ro full = named(runs, "runner-flow-full-clean")
    assert(last_state(full) == "End")
    assert(last_outcome(full) == "answer:{\"$record\":\"RunnerResult\",\"fields\":{\"feedback_rounds\":0}}")
    ro fast = named(runs, "runner-flow-fast-clean")
    assert(last_state(fast) == "End")
    assert(last_outcome(fast) == "answer:{\"$record\":\"RunnerResult\",\"fields\":{\"feedback_rounds\":0}}")
    // the fast route skips the analysis and the plan: fewer steps than the full route
    assert(fast.traces.len() < full.traces.len())
}

test "fl the end with a round of the feedback" {
    ro end = named(all_runs(), "runner-end-1")
    assert(last_state(end) == "End")
    assert(last_outcome(end) == "answer:{\"$record\":\"RunnerResult\",\"fields\":{\"feedback_rounds\":1}}")
}

test "fl nested flows" {
    ro runs = all_runs()
    assert(last_state(named(runs, "runner-flow-nested-launch")) == "AnalysisReview")
    assert(last_state(named(runs, "runner-flow-nested-pause")) == "SessionLaunch")
    assert(last_state(named(runs, "runner-flow-nested-cancel")) == "Halted")
    assert(last_outcome(named(runs, "runner-flow-nested-cancel")) == "refusal:Cancelled")
    assert(last_state(named(runs, "runner-flow-nested-held")) == "AnalysisReview")
}

test "fl the held answers" {
    ro runs = all_runs()
    for n in ["runner-flow-pause-answer-held", "runner-flow-pause-failure-held", "runner-flow-nested-held"] {
        mut held = false
        mut replayed = false
        for t in named(runs, n).traces {
            for e in t.entries {
                if e.event.code == "answer_held" { held = true }
                if e.event.code == "answer_replayed" { replayed = true }
            }
        }
        assert(held)
        assert(replayed)
    }
}

test "fl deterministic" {
    ro a = all_runs()
    ro b = all_runs()
    assert(a.len() == b.len())
    mut i = 0
    while i < a.len() {
        ro x = a[i].run
        ro y = b[i].run
        assert(x.traces.len() == y.traces.len())
        mut k = 0
        while k < x.traces.len() {
            assert(x.traces[k].state == y.traces[k].state)
            assert(x.traces[k].encoded == y.traces[k].encoded)
            assert(x.traces[k].journal.len() == y.traces[k].journal.len())
            k += 1
        }
        i += 1
    }
}
