// v217_test.nv - task 151: the names and the fragment "Pause" in Alula 2.17: the states of a connected fragment are in the space of the states of the machine after the substitution (AL-58), the data of
// the fragment and of the contract are in the space of the data, the files of definitions bring their own section `## Имена` (AL-60), the hash of the sample file of definitions is the one of 2.17.
module alula.machine_nested

import std.text
import alula.machine.{text_of_file}
import alula.examples.{table_files_225}
import alula.machine_text.{translate_report, translate_definitions, definitions_hash, defs_file_text, error_text}

fn callee217() -> str => text_of_file(table_files_225(), "callee.alula.md")

fn notes217(text str) -> []str {
    mut out = []str.new()
    for e in translate_report(text).errors { out.push("${e.line}:${e.col} ${e.message}") }
    out
}

fn says217(text str, needle str) -> bool {
    for n in notes217(text) {
        if n.contains(needle) { return true }
    }
    false
}

// ---- the states and the data of the fragment ----------------------------------------------------------------------------------------------------

test "v217 callee is clean" {
    ro report = translate_report(callee217())
    if report.errors.len() > 0 { panic(error_text(report.errors[0], "callee")) }
    assert(report.errors.len() == 0)
}

test "v217 a state with the JSON name of the state of the fragment collides" {
    ro text = callee217().replace("| ЗАПРОС | Ask |", "| ЗАПРОС | Pause |")
    assert(text != callee217())
    assert(says217(text, "коллизия"))
    assert(says217(text, "Pause"))
}

test "v217 the state of the fragment is in the space of the states" {
    ro report = translate_report(callee217())
    assert(report.json.contains("\"name\":\"Pause\",\"kind\":\"appeal\""))
}

test "v217 a datum with the JSON name of a datum of the fragment collides" {
    ro text = callee217().replace("## Данные\n", "## Данные\n\n").replace("| имя | тип | начальное | не убывает | пишет |\n|---|---|---|---|---|\n", "| имя | тип | начальное | не убывает | пишет |\n|---|---|---|---|---|\n| мой_список | []строка | [] | — | действия |\n")
    ro named = text.replace("## Имена\n\n| имя | JSON-имя |\n|---|---|\n", "## Имена\n\n| имя | JSON-имя |\n|---|---|\n| мой_список | open_requests |\n")
    assert(says217(named, "коллизия"))
}

test "v217 a datum with the JSON name of a datum of the contract collides" {
    ro text = callee217().replace("| имя | тип | начальное | не убывает | пишет |\n|---|---|---|---|---|\n", "| имя | тип | начальное | не убывает | пишет |\n|---|---|---|---|---|\n| мой_список | []строка | [] | — | действия |\n").replace("## Имена\n\n| имя | JSON-имя |\n|---|---|\n", "## Имена\n\n| имя | JSON-имя |\n|---|---|\n| мой_список | previous |\n")
    assert(says217(text, "коллизия"))
}

test "v217 the protocol signals of the fragment are in the space of the machine signals" {
    ro report = translate_report(callee217())
    assert(report.json.contains("\"name\":\"human_stop\""))
    assert(report.json.contains("\"name\":\"cancel_request\""))
}

// ---- the file of definitions ----------------------------------------------------------------------------------------------------------------------

fn defs_with_names() -> str => "# Функции: счёт\n\n- functions_version: 1\n- format: 2.25\n\n## Типы\n\n```\nтип Токены { вход число, выход число }\n```\n\n## Имена\n\n| имя | JSON-имя |\n|---|---|\n| Токены.вход | input_tokens |\n\n## Константы\n—\n\n## Функции\n—\n"

test "v217 a file of definitions has its section of the names" {
    ro report = translate_definitions(defs_with_names())
    if report.errors.len() > 0 { panic(error_text(report.errors[0], "defs")) }
    assert(report.errors.len() == 0)
    assert(report.json.contains("{\"name\":\"input_tokens\",\"type\":\"int\"}"))
}

test "v217 a file of definitions builds the names by itself" {
    ro text = defs_with_names().replace("## Имена\n\n| имя | JSON-имя |\n|---|---|\n| Токены.вход | input_tokens |\n\n", "")
    ro report = translate_definitions(text)
    assert(report.errors.len() == 0)
    assert(report.json.contains("\"name\":\"TokenUsage\""))
    assert(report.json.contains("\"name\":\"input\""))
}

test "v217 a file of definitions refuses an extra row" {
    ro text = defs_with_names().replace("| Токены.вход | input_tokens |", "| Токены.вход | input_tokens |\n| Токены.выход | output |")
    ro report = translate_definitions(text)
    assert(report.errors.len() > 0)
    assert(report.errors[0].message.contains("лишняя строка"))
}

test "v217 a file of definitions refuses the brackets" {
    ro text = defs_with_names().replace("тип Токены { вход число, выход число }", "тип Токены (TokenUsage) { вход число, выход число }")
    ro report = translate_definitions(text)
    assert(report.errors.len() > 0)
    assert(report.errors[0].message.contains("скобки"))
}

test "v217 a file of definitions refuses the format 2.23" {
    ro report = translate_definitions(defs_with_names().replace("format: 2.25", "format: 2.23"))
    assert(report.errors.len() > 0)
}

test "v217 a file of definitions refuses the format 2.22" {
    ro report = translate_definitions(defs_with_names().replace("format: 2.25", "format: 2.22"))
    assert(report.errors.len() > 0)
    ro older = translate_definitions(defs_with_names().replace("format: 2.25", "format: 2.14"))
    assert(older.errors.len() > 0)
}

test "v217 the hash of the sample file of definitions is that of 2.25" {
    assert(definitions_hash(defs_file_text("арифметика_цикла")) == "f757b8aa7b08")
}

test "v217 the English sample file of definitions has the hash of 2.25" {
    ro text = defs_file_text("cycle_arithmetic")
    assert(text.contains("format: 2.25"))
    assert(definitions_hash(text).byte_len() == 12)
    assert(definitions_hash(text) == "75062faf50d1")
}

test "v217 the format line of the file of definitions is 2.25" {
    assert(defs_file_text("арифметика_цикла").contains("- format: 2.25"))
}
