// v212_test.nv - task 125: Alula 2.12 for the nested machines: the meeting examples read at 2.25, `Вход: нет` of an appeal, a pure primitive called as a function in a condition (AL-29), a field of the request that is named as a datum (AL-28), the table "by role" of the parse (AL-33).
module alula.machine_nested

import std.text
import alula.machine.{Registry, Primitive, ParamSpec, TextType, IntType, BoolType, RecordType, ListType, Volatile, Pure, register}
import alula.examples.{sample_registry}
import alula.machine_text.{translate_checked, render, TranslateReport}

// A file at 2.12 (the fixtures of the older tasks are migrated by the same replace).
fn at212(text str) -> str => text.replace("- format: 2.11\n", "- format: 2.25\n")

fn meeting212() -> str => at212(meeting_examples())

fn boss212() -> str => at212(boss_text())

fn agent212() -> str => at212(tiny_agent())

fn tree_of(text str) -> str => json_of(text)

// The text between the marker and the next quote.
fn after_marker(json str, marker str) -> str {
    ro at = json.find(marker) ?? -1
    if at < 0 { return "" }
    ro rest = json[at + marker.byte_len()..]
    ro end = rest.find("\"") ?? -1
    if end < 0 { return "" }
    rest[..end]
}

// ---- the meeting examples at 2.25 -----------------------------------------------------------------------------------------------------------

test "v212 meeting reads" {
    ro report = checked(meeting212())
    if report.errors.len() > 0 { panic(notes_of(report).join(" ## ")) }
    assert(report.errors.len() == 0)
    assert(report.json.contains("\"alula_version\":\"2.25\""))
}

fn is_clean_text(text str) -> bool => checked(text).errors.len() == 0

// ---- an appeal without a request (AL-23, AL-40) ---------------------------------------------------------------------------------------------------------

fn no_request() -> str => agent212().replace("- Запрос:\n\n| поле запроса | выражение | читает |\n|---|---|---|\n| prompt | text_reply | сторона |\n", "")

test "v212 appeal without a request" {
    ro report = checked(no_request())
    if report.errors.len() > 0 { panic(notes_of(report).join(" ## ")) }
    assert(!report.json.contains("\"inputs\""))
}

test "v212 appeal without a request, a table too" {
    // `Запрос: нет` is no key of 2.14 (AL-40): a key line with an empty value is an error
    assert(!is_clean_text(agent212().replace("- Запрос:\n\n| поле запроса", "- Запрос: нет\n\n| поле запроса")))
}

test "v212 appeal with an empty input" {
    assert(!is_clean_text(agent212().replace("- Запрос:\n\n| поле запроса | выражение | читает |\n|---|---|---|\n| prompt | text_reply | сторона |\n", "- Запрос:\n")))
}

test "v212 appeal without a request reads no datum" {
    assert(note_says(no_request().replace("| 1 | ответ(ответ) | — | text_reply = ответ | DONE |", "| 1 | ответ(ответ) | — | text_reply = строка(text_reply) | DONE |"), "text_reply"))
}

test "v212 render writes no key for an appeal without a request" {
    ro text = render(tree_of(no_request()), "ru")
    assert(!text.contains("Вход:"))
    assert(!text.contains("Запрос: нет"))
    ro en = render(tree_of(no_request()), "en")
    assert(!en.contains("Input:"))
    assert(!en.contains("Request: none"))
}

test "v212 render circle without a request" {
    assert(circle(tree_of(no_request()), "ru") == "")
    assert(circle(tree_of(no_request()), "en") == "")
}

test "v212 call without the fields it needs" {
    // a party of the kind machine with the fields of the input type needs them: no request leaves two fields unsaid
    ro text = boss212().replace("- Запрос:\n\n| поле запроса | выражение | читает |\n|---|---|---|\n| label | \"m\" | сторона |\n| count | 1 | сторона |\n", "")
    assert(note_says(text, "label"))
    assert(note_says(text, "count"))
}

// ---- a pure primitive in a condition (AL-29) --------------------------------------------------------------------------------------------

fn pure_registry() -> Registry {
    mut reg = sample_registry()
    ro p = Primitive { name: "big", params: [ParamSpec { name: "n", spec: IntType, tail: false }], result: BoolType, class: Pure, reads: []str.new(), writes: []str.new() }
    ro r = register(reg, p)
    reg
}

fn fork_text(condition str) -> str {
    ro with_fork = boss212().replace("| 1 | ответ(итог) | — | reply = итог | DONE |", "| 1 | ответ(итог) | — | reply = итог | CHECK |").replace("### DONE — конец", "### CHECK — развилка\n- Читает: reply\n\n| № | Условие | Действия | Куда |\n|---|---|---|---|\n| 1 | ${condition} | — | DONE |\n| 2 | иначе | — | DONE |\n\n### DONE — конец")
    with_prims_in(pure_registry(), with_fork, ["big", "new_id"])
}

fn checked_pure(text str) -> TranslateReport => translate_checked(text, pure_registry())

test "v212 pure call as a function" {
    ro report = checked_pure(fork_text("big(2)"))
    if report.errors.len() > 0 { panic(notes_of(report).join(" ## ")) }
    assert(report.json.contains("\"op\":\"primitive_call\",\"name\":\"big\""))
}

test "v212 the former call word is refused with the new writing" {
    ro report = checked_pure(fork_text("вызвать(big, 2)"))
    assert(note_says_in(report, "`вызвать(…)` в формате 2.23 не бывает (AL-123): пишется `имя(арг)`"))
}

test "v212 pure call inside an expression" {
    ro report = checked_pure(fork_text("не big(1) и big(2)"))
    assert(report.errors.len() == 0)
}

test "v212 volatile call as a function in a condition" {
    ro text = fork_text("новый_ид() == новый_ид()")
    ro report = checked_pure(text)
    assert(report.errors.len() > 0)
    assert(note_says_in(report, "volatile"))
    assert(note_says_in(report, "new_id"))
}

test "v212 volatile call word in a condition" {
    ro report = checked_pure(fork_text("новый_ид() == новый_ид()"))
    assert(report.errors.len() > 0)
    assert(note_says_in(report, "new_id"))
}

test "v212 unknown function still refused" {
    ro report = checked_pure(fork_text("nothing(2)"))
    assert(report.errors.len() > 0)
}

test "v212 undeclared primitive refused" {
    ro report = checked_pure(boss212().replace("| 1 | ответ(итог) | — | reply = итог | DONE |", "| 1 | ответ(итог) | — | reply = итог | CHECK |").replace("### DONE — конец", "### CHECK — развилка\n- Читает: reply\n\n| № | Условие | Действия | Куда |\n|---|---|---|---|\n| 1 | big(2) | — | DONE |\n| 2 | иначе | — | DONE |\n\n### DONE — конец"))
    assert(report.errors.len() > 0)
}

test "v212 pure call circle" {
    ro report = checked_pure(fork_text("big(2)"))
    assert(report.errors.len() == 0)
    assert(circle_with(report.json, "ru", pure_registry()) == "")
    assert(circle_with(report.json, "en", pure_registry()) == "")
}

fn note_says_in(report TranslateReport, needle str) -> bool {
    for e in report.errors {
        if "${e.kind} ${e.message}".contains(needle) { return true }
    }
    false
}

// ---- a field of the request that is named as a datum (AL-28) --------------------------------------------------------------------------

fn named_as_datum() -> str => boss212().replace("| reply | ?CallOutput | пусто | — | действия |", "| reply | ?CallOutput | пусто | — | действия |\n| label | строка | \"\" | — | действия |").replace("| label | \"m\" | сторона |", "| label | если reply == пусто то { \"first\" } иначе { \"again\" } | сторона |").replace("| 1 | ответ(итог) | — | reply = итог | DONE |", "| 1 | ответ(итог) | — | reply = итог; label = \"seen\" | DONE |")

test "v212 field named as a datum with an if" {
    ro report = checked(named_as_datum())
    if report.errors.len() > 0 { panic(notes_of(report).join(" ## ")) }
    assert(report.errors.len() == 0)
    assert(report.json.contains("\"field\":\"label\",\"value\":{\"op\":\"if\""))
}

test "v212 field named as a datum with a call" {
    ro text = with_prims(boss212().replace("| count | 1 | сторона |", "| count | call_step() | сторона |"), ["call_step"])
    ro report = checked(text)
    if report.errors.len() > 0 { panic(notes_of(report).join(" ## ")) }
    assert(report.json.contains("\"op\":\"primitive_call\",\"name\":\"call_step\""))
}

test "v212 field named as a datum read by the rows" {
    // the rows read the datum, the field is the party's
    ro text = named_as_datum().replace("reply = итог; label = \"seen\"", "reply = итог; label = label")
    ro report = checked(text)
    assert(report.errors.len() == 0)
}

// ---- the parse is one function per role (AL-33 turned into AL-131 in 2.25) ----------------------------------------------------------------

fn role_fns_registry() -> Registry {
    mut reg = sample_registry()
    ro answer = ParamSpec { name: "answer", spec: RecordType("CallOutput"), tail: false }
    ro author = Primitive { name: "read_author", params: [answer], result: RecordType("CallOutput"), class: Volatile, reads: []str.new(), writes: []str.new() }
    ro witness = Primitive { name: "read_witness", params: [answer], result: ListType(TextType), class: Volatile, reads: ["reply"], writes: []str.new() }
    ro r1 = register(reg, author)
    ro r2 = register(reg, witness)
    reg
}

fn parse_text(name str, result str) -> str => with_prims_in(role_fns_registry(), boss212().replace("machine callee(вход CallInput, итог CallOutput) | — |", "machine callee(вход CallInput, итог CallOutput); разбор: ${name} -> ${result} | — |"), [name])

fn checked_parse(text str) -> TranslateReport => translate_checked(text, role_fns_registry())

test "v212 parse of a function per role" {
    ro report = checked_parse(parse_text("read_author", "CallOutput"))
    if report.errors.len() > 0 { panic(notes_of(report).join(" ## ")) }
    assert(report.json.contains("\"parse\":{\"primitive\":\"read_author\""))
    assert(!report.json.contains("\"role\""))
}

test "v212 parse result does not fit" {
    ro report = checked_parse(parse_text("read_author", "[]строка"))
    assert(report.errors.len() > 0)
    assert(note_says_in(report, "read_author"))
    assert(note_says_in(report, "after `->`"))
}

test "v212 a literal of the role in the parse is an error with the hint of AL-131" {
    ro text = with_prims_in(role_fns_registry(), boss212().replace("machine callee(вход CallInput, итог CallOutput) | — |", "machine callee(вход CallInput, итог CallOutput); разбор: read_author(\"author\") -> CallOutput | — |"), ["read_author"])
    ro report = checked_parse(text)
    assert(report.errors.len() > 0)
    assert(note_says_in(report, "литерал роли в разборе:"))
    assert(note_says_in(report, "отдельная функция на роль"))
    assert(note_says_in(report, "разобрать_ответ_свидетеля"))
}

test "v212 the parse names the function without brackets" {
    ro text = with_prims_in(role_fns_registry(), boss212().replace("machine callee(вход CallInput, итог CallOutput) | — |", "machine callee(вход CallInput, итог CallOutput); разбор: read_author() -> CallOutput | — |"), ["read_author"])
    assert(note_says_in(checked_parse(text), "литерал роли в разборе:"))
}

fn reads_seen(text str) -> str => text.replace("| 1 | ответ(итог) | — | reply = итог | DONE |", "| 1 | ответ(итог) | — | seen = reply | DONE |").replace("| reply | ?CallOutput | пусто | — | действия |", "| reply | ?CallOutput | пусто | — | действия |\n| seen | ?CallOutput | пусто | — | действия |")

test "v212 parse reads join the input" {
    // the datum `reply` is read by the parse function of the witness: the rows of the state read it without a line of the table "Input"; the function of the author reads nothing
    ro good = checked_parse(reads_seen(parse_text("read_witness", "[]строка")))
    if good.errors.len() > 0 { panic(notes_of(good).join(" ## ")) }
    assert(good.errors.len() == 0)
    ro report = checked_parse(reads_seen(parse_text("read_author", "CallOutput")))
    assert(report.errors.len() > 0)
    assert(note_says_in(report, "reply"))
}

test "v212 parse circle" {
    ro report = checked_parse(parse_text("read_author", "CallOutput"))
    assert(report.errors.len() == 0)
    assert(circle_with(report.json, "ru", role_fns_registry()) == "")
    assert(circle_with(report.json, "en", role_fns_registry()) == "")
}
