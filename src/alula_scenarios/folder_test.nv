// folder_test.nv - task 116: `alula test` on the folder `src/machine/` (the machines and the scenarios of the product) passes every scenario; `alula run` passes every scenario
// of the agent step one by one (the rows are taken by the scenarios: task 109), of the chat, of the small machines; a scenario that is changed is a report.
module alula.alula_scenarios

// ORACLE-WORKAROUND(32): std.fs is imported FIRST in the first file of the unit, or `.join` on a `[]str` resolves to `Path.join` (E_RECV_METHOD_MISMATCH); drop this import when item 32 is fixed
import std.fs.{Path}
import std.text
import alula.machine.{NamedText, machine_files, scenario_files, text_of_file, chat_table_text, agent_step_table_text, table_files}

test "ps test folder all scenarios" {
    ro ran = run_with(["test", "/machine"], machine_folder())
    assert(ran.err == "")
    ro total = scenario_files().len()
    assert(ran.out == "${total} of ${total} scenarios passed\n")
    assert(ran.code == 0)
}

test "ps scenario families" {
    // the families of the folder (the total grows with the machines: task 114 added the 37 of the dialog)
    assert(scenarios_with("agent-step-").len() == 83)
    assert(scenarios_with("chat-").len() == 39)
    assert(scenarios_with("dialog-").len() == 37)
    assert(scenarios_with("nested-").len() == 32)
    assert(scenarios_with("cycle-").len() == 101)
    assert(scenarios_with("session-").len() == 55)
    assert(scenarios_with("runner-").len() == 257)
    assert(scenario_files().len() == 621)
}

// ---- nested machines (task 119): a parent and the machines it calls are found in the folder ------------------------------------------------------------

fn nested_files(callee_file str, callee_text str) -> []NamedText => [
    NamedText { name: "/n/caller.alula.json", text: text_of_file(machine_files(), "caller.alula.json") },
    NamedText { name: callee_file, text: callee_text },
    NamedText { name: "/n/nested-call-ok.scenario.test.json", text: text_of_file(scenario_files(), "nested-call-ok.scenario.test.json") }
]

test "ps test folder nested" {
    ro ran = run_with(["test", "/n"], nested_files("/n/callee.alula.json", text_of_file(machine_files(), "callee.alula.json")))
    assert(ran.err == "")
    assert(ran.out == "1 of 1 scenarios passed\n")
    assert(ran.code == 0)
}

test "ps test folder nested from a table" {
    // the nested machine has no JSON in the folder: it is read from its table when the parent calls it
    ro ran = run_with(["test", "/n"], nested_files("/n/callee.alula.md", text_of_file(table_files(), "callee.alula.md")))
    assert(ran.err == "")
    assert(ran.out == "1 of 1 scenarios passed\n")
    assert(ran.code == 0)
}

test "ps test folder nested lacks" {
    ro files = [
        NamedText { name: "/n/caller.alula.json", text: text_of_file(machine_files(), "caller.alula.json") },
        NamedText { name: "/n/nested-call-ok.scenario.test.json", text: text_of_file(scenario_files(), "nested-call-ok.scenario.test.json") }
    ]
    ro ran = run_with(["test", "/n"], files)
    assert(ran.code == 1)
    assert(ran.out.contains("FAIL /n/nested-call-ok.scenario.test.json"))
    assert(ran.out.contains("the machine callee of the party callee is not in the registry"))
    assert(ran.out.ends_with("0 of 1 scenarios passed\n"))
}

test "ps test folder nested does not fit" {
    // a machine of the name `callee` whose input is not the input type of the party
    ro other = text_of_file(machine_files(), "fan.alula.json").replace("\"machine\":\"fan\"", "\"machine\":\"callee\"")
    ro ran = run_with(["test", "/n"], nested_files("/n/callee.alula.json", other))
    assert(ran.code == 1)
    assert(ran.out.contains("the nested machines do not fit"))
}

test "ps run refuses a parent" {
    ro files = nested_files("/n/callee.alula.json", text_of_file(machine_files(), "callee.alula.json"))
    ro ran = run_with(["run", "/n/caller.alula.json", "/n/nested-call-ok.scenario.test.json"], files)
    assert(ran.code == 1)
    assert(ran.err.contains("calls nested machines"))
    assert(ran.err.contains("alula test"))
}

test "ps test folder nested changed" {
    ro original = text_of_file(scenario_files(), "nested-call-ok.scenario.test.json")
    ro changed = original.replace("\"outcome\": \"answer:hi\"", "\"outcome\": \"answer:bye\"")
    assert(changed != original)
    ro files = [
        NamedText { name: "/n/caller.alula.json", text: text_of_file(machine_files(), "caller.alula.json") },
        NamedText { name: "/n/callee.alula.json", text: text_of_file(machine_files(), "callee.alula.json") },
        NamedText { name: "/n/nested-call-ok.scenario.test.json", text: changed }
    ]
    ro ran = run_with(["test", "/n"], files)
    assert(ran.code == 1)
    assert(ran.out.contains("answer:bye"))
}

test "ps test folder verbose" {
    ro ran = run_with(["test", "/machine", "-v"], machine_folder())
    assert(ran.code == 0)
    ro total = scenario_files().len()
    assert(count_lines_with(ran.out, "ok /machine/scenarios/") == total)
    assert(ran.out.ends_with("${total} of ${total} scenarios passed\n"))
}

test "ps test folder from a table only" {
    // no JSON of the chat in the folder: the machine is read from its table
    mut files = [NamedText { name: "/c/chat.alula.md", text: chat_table_text() }]
    for s in scenarios_with("chat-") { files.push(NamedText { name: "/c/${s.name}", text: s.text }) }
    ro ran = run_with(["test", "/c"], files)
    assert(ran.err == "")
    assert(ran.out == "39 of 39 scenarios passed\n")
    assert(ran.code == 0)
}

test "ps test folder agent step table" {
    // the table of the agent step (format 2.5, the copy `.txt`) runs the scenarios like its JSON
    mut files = [NamedText { name: "/a/agent_step.alula.txt", text: agent_step_table_text() }]
    mut n = 0
    for s in scenarios_with("agent-step-flow") {
        files.push(NamedText { name: "/a/${s.name}", text: s.text })
        n += 1
    }
    ro ran = run_with(["test", "/a"], files)
    assert(ran.err == "")
    assert(ran.out == "${n} of ${n} scenarios passed\n")
    assert(ran.code == 0)
}

test "ps run agent step one by one a" {
    ro all = scenarios_with("agent-step-agent")
    assert(all.len() == 9)
    assert(run_all("agent_step.alula.json", text_of_file(machine_files(), "agent_step.alula.json"), all) == "")
}

