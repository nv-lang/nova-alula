test "ps run agent step one by one f" {
    ro all = scenarios_with("agent-step-f")
    assert(all.len() > 10)
    assert(run_all("agent_step.alula.json", text_of_file(machine_files(), "agent_step.alula.json"), all) == "")
}

test "ps run agent step one by one rest" {
    mut rest = []NamedText.new()
    for s in scenarios_with("agent-step-") {
        ro name = s.name["agent-step-".byte_len()..]
        if !(name.starts_with("agent") || name.starts_with("b") || name.starts_with("c") || name.starts_with("e") || name.starts_with("f")) { rest.push(s) }
    }
    assert(rest.len() > 0)
    assert(run_all("agent_step.alula.json", text_of_file(machine_files(), "agent_step.alula.json"), rest) == "")
}

test "ps run chat one by one" {
    ro all = scenarios_with("chat-")
    assert(all.len() == 39)
    assert(run_all("chat.alula.json", text_of_file(machine_files(), "chat.alula.json"), all) == "")
}

test "ps run chat from its table" {
    ro all = scenarios_with("chat-m")
    assert(all.len() > 0)
    assert(run_all("chat.alula.md", chat_table_text(), all) == "")
}

test "ps run small machines" {
    assert(run_all("calc.alula.json", text_of_file(machine_files(), "calc.alula.json"), scenarios_with("calc-")) == "")
    assert(run_all("gate.alula.json", text_of_file(machine_files(), "gate.alula.json"), scenarios_with("gate-")) == "")
    assert(run_all("lenses.alula.json", text_of_file(machine_files(), "lenses.alula.json"), scenarios_with("lenses-")) == "")
    assert(run_all("variants.alula.json", text_of_file(machine_files(), "variants.alula.json"), scenarios_with("variants-")) == "")
}

test "ps changed scenario is a report" {
    ro original = text_of_file(scenario_files(), "gate-done.scenario.test.json")
    ro changed = original.replace("\"state\": \"Done\"", "\"state\": \"Work\"")
    assert(changed != original)
    ro files = [
        NamedText { name: "/g/gate.alula.json", text: text_of_file(machine_files(), "gate.alula.json") },
        NamedText { name: "/g/gate-done.scenario.test.json", text: changed }
    ]
    ro ran = run_with(["run", "/g/gate.alula.json", "/g/gate-done.scenario.test.json"], files)
    assert(ran.code == 1)
    assert(ran.out.contains("difference(s)"))
    assert(ran.out.contains("Done"))
    assert(ran.out.contains("Work"))
    ro folder = run_with(["test", "/g"], files)
    assert(folder.code == 1)
    assert(folder.out.contains("FAIL /g/gate-done.scenario.test.json"))
    assert(folder.out.ends_with("0 of 1 scenarios passed\n"))
}

test "ps changed agent step scenario" {
    ro original = text_of_file(scenario_files(), "agent-step-flow-happy.scenario.test.json")
    ro changed = original.replace("\"outcome\": \"answer", "\"outcome\": \"refusal")
    ro files = [
        NamedText { name: "/g/agent_step.alula.json", text: text_of_file(machine_files(), "agent_step.alula.json") },
        NamedText { name: "/g/happy.scenario.test.json", text: changed }
    ]
    ro ran = run_with(["run", "/g/agent_step.alula.json", "/g/happy.scenario.test.json"], files)
    assert(changed != original)
    assert(ran.code == 1)
    assert(ran.out.contains("difference(s)"))
}
