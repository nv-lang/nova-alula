// standalone_test.nv - task 122: a scenario with `"standalone": true` runs a machine that calls nested machines ALONE: the parties of the kind `machine` are played by the steps of the scenario, so
// `portolan run` takes it and `portolan test` needs no nested machine in the folder. The machine is the cycle check (the session launch and the meeting are not in the folder).
module alula.portolan_cli

import std.text
import alula.machine.{NamedText, machine_files, scenario_files, text_of_file, cycle_check_machine_text}

fn cycle_json() -> NamedText => file("/c/cycle_check.alula.json", cycle_check_machine_text())

fn scenario_file(name str) -> NamedText => file("/c/${name}.scenario.test.json", text_of_file(scenario_files(), "${name}.scenario.test.json"))

// The scenario as the file keeps it, but not standalone: the nested machines would be looked for in the folder.
fn not_standalone(name str) -> NamedText {
    ro text = text_of_file(scenario_files(), "${name}.scenario.test.json")
    file("/c/${name}.scenario.test.json", text.replace("\"standalone\": true, ", ""))
}

test "sa run a standalone scenario" {
    ro ran = run_with(["run", "/c/cycle_check.alula.json", "/c/cycle-flow-clean.scenario.test.json"], [cycle_json(), scenario_file("cycle-flow-clean")])
    assert(ran.err == "")
    assert(ran.out == "ok\n")
    assert(ran.code == 0)
}

test "sa run without the key is refused" {
    ro plain = not_standalone("cycle-flow-clean")
    assert(plain.text != scenario_file("cycle-flow-clean").text)
    ro ran = run_with(["run", "/c/cycle_check.alula.json", "/c/cycle-flow-clean.scenario.test.json"], [cycle_json(), plain])
    assert(ran.code == 1)
    assert(ran.out == "")
    assert(ran.err.contains("calls nested machines: they are found in a folder, use `portolan test <folder>`"))
}

test "sa test a folder without the nested machines" {
    ro files = [cycle_json(), scenario_file("cycle-flow-clean"), scenario_file("cycle-flow-rework"), scenario_file("cycle-gate9-1"), scenario_file("cycle-end-errored-1")]
    ro ran = run_with(["test", "/c"], files)
    assert(ran.err == "")
    assert(ran.out == "4 of 4 scenarios passed\n")
    assert(ran.code == 0)
}

test "sa test without the key looks for the nested machines" {
    ro files = [cycle_json(), not_standalone("cycle-flow-clean")]
    ro ran = run_with(["test", "/c"], files)
    assert(ran.code == 1)
    assert(ran.out.contains("FAIL /c/cycle-flow-clean.scenario.test.json"))
    assert(ran.out.contains("the machine session_start of the party session_launch is not in the registry"))
    assert(ran.out.contains("the machine meeting of the party meeting is not in the registry"))
    assert(ran.out.ends_with("0 of 1 scenarios passed\n"))
}

test "sa test a mixed folder" {
    // one scenario plays the nested parties, the other asks for them and fails; the folder reports both
    ro files = [cycle_json(), scenario_file("cycle-flow-clean"), not_standalone("cycle-flow-rework")]
    ro ran = run_with(["test", "/c"], files)
    assert(ran.code == 1)
    assert(ran.out.contains("FAIL /c/cycle-flow-rework.scenario.test.json"))
    assert(!ran.out.contains("FAIL /c/cycle-flow-clean.scenario.test.json"))
    assert(ran.out.ends_with("1 of 2 scenarios passed\n"))
}

test "sa a difference of a standalone scenario is a report" {
    ro text = text_of_file(scenario_files(), "cycle-flow-clean.scenario.test.json")
    ro changed = file("/c/cycle-flow-clean.scenario.test.json", text.replace("\"streak\": 0", "\"streak\": 5"))
    assert(changed.text != text)
    ro ran = run_with(["test", "/c"], [cycle_json(), changed])
    assert(ran.code == 1)
    assert(ran.out.contains("FAIL /c/cycle-flow-clean.scenario.test.json"))
    assert(ran.out.contains("streak"))
}

test "sa the key is a boolean" {
    ro text = text_of_file(scenario_files(), "cycle-flow-clean.scenario.test.json")
    ro bad = file("/c/cycle-flow-clean.scenario.test.json", text.replace("\"standalone\": true", "\"standalone\": 1"))
    assert(bad.text != text)
    ro ran = run_with(["test", "/c"], [cycle_json(), bad])
    assert(ran.code == 1)
    assert(ran.out.contains("standalone is true or false"))
}
