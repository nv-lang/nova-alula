// check_test.nv - task 116: `portolan check` (a file of Portolan or the JSON: the translation, the checks of the table, the warnings P-1) and `portolan summary`.
module alula.portolan_cli

// ORACLE-WORKAROUND(32): std.fs is imported FIRST in the first file of the unit, or `.join` on a `[]str` resolves to `Path.join` (E_RECV_METHOD_MISMATCH); drop this import when item 32 is fixed
import std.fs.{Path}
import std.text
import alula.machine.{NamedText, standard_registry, chat_machine_text}
import alula.machine_text.{translate_checked, render_summary}




// The tree whose initial state is not there: the decoder takes it, the checks refuse it.
fn bad_initial_json() -> str => tiny_json().replace("\"initial\":\"Wait\"", "\"initial\":\"Nowhere\"")

test "ck portolan file ok" {
    ro ran = run_with(["check", "/work/tiny.alula.md"], tiny_file())
    assert(ran.code == 0)
    assert(ran.out == "ok\n")
    assert(ran.err == "")
}

test "ck english file ok" {
    ro ran = run_with(["check", "/work/tiny.alula.md"], one("/work/tiny.alula.md", tiny_en()))
    assert(ran.code == 0)
    assert(ran.out == "ok\n")
}

test "ck portolan file errors" {
    ro ran = run_with(["check", "/work/tiny.alula.md"], one("/work/tiny.alula.md", broken_ru()))
    assert(ran.code == 1)
    assert(ran.out == "")
    ro report = translate_checked(broken_ru(), standard_registry())
    assert(ran.err.starts_with("/work/tiny.alula.md:${report.errors[0].line}:${report.errors[0].col}: ${report.errors[0].kind}: "))
    assert(ran.err.contains("\n    "))
}

test "ck all errors are printed" {
    ro report = translate_checked(broken_ru(), standard_registry())
    ro ran = run_with(["check", "/work/tiny.alula.md"], one("/work/tiny.alula.md", broken_ru()))
    assert(count_lines_with(ran.err, "/work/tiny.alula.md:") >= report.errors.len())
}

test "ck warnings are printed and the code is 0" {
    ro ran = run_with(["check", "/work/tiny.alula.md"], one("/work/tiny.alula.md", noted_ru()))
    assert(ran.code == 0)
    assert(ran.err.contains("/work/tiny.alula.md:"))
    assert(ran.err.contains(": warning: "))
    assert(ran.out == "ok (1 warning)\n")
}

test "ck warnings and errors together" {
    ro text = with_prose(broken_ru())
    ro ran = run_with(["check", "/work/tiny.alula.md"], one("/work/tiny.alula.md", text))
    assert(ran.code == 1)
    assert(ran.err.contains(": warning: "))
    assert(ran.err.contains(": check: ") || ran.err.contains(": error: ") || ran.err.contains("НЕТ"))
}

test "ck no check" {
    ro ran = run_with(["check", "/work/tiny.alula.md", "--no-check"], tiny_file())
    assert(ran.code == 0)
    assert(ran.out == "ok\n")
}

test "ck json ok" {
    ro ran = run_with(["check", "/work/tiny.alula.json"], json_file())
    assert(ran.code == 0)
    assert(ran.out == "ok\n")
    assert(ran.err == "")
}

test "ck json check error" {
    assert(bad_initial_json() != tiny_json())
    ro ran = run_with(["check", "/work/tiny.alula.json"], one("/work/tiny.alula.json", bad_initial_json()))
    assert(ran.code == 1)
    assert(ran.out == "")
    assert(ran.err.starts_with("/work/tiny.alula.json:1:1: check: "))
    assert(ran.err.contains("Nowhere"))
}

test "ck json not valid" {
    ro ran = run_with(["check", "/work/tiny.alula.json"], one("/work/tiny.alula.json", "{"))
    assert(ran.code == 1)
    assert(ran.err.starts_with("/work/tiny.alula.json:1:1: check: $: not valid JSON"))
}

test "ck json other format" {
    ro ran = run_with(["check", "/work/tiny.alula.json"], one("/work/tiny.alula.json", `{"format":"machine/1"}`))
    assert(ran.code == 1)
    assert(ran.err.contains("check: "))
}

test "ck json machine from the product" {
    ro ran = run_with(["check", "/work/chat.alula.json"], one("/work/chat.alula.json", chat_machine_text()))
    assert(ran.code == 0)
    assert(ran.out == "ok\n")
}

test "ck missing file" {
    ro ran = run0(["check", "/work/none.alula.md"])
    assert(ran.code == 2)
    assert(ran.err.contains("cannot read /work/none.alula.md"))
}

test "ck unknown option" {
    ro ran = run_with(["check", "/work/tiny.alula.md", "--lenient"], tiny_file())
    assert(ran.code == 2)
    assert(ran.err.contains("unknown option `--lenient`"))
}

// ---- summary ---------------------------------------------------------------------------------------------------------------------

test "sm portolan file" {
    ro ran = run_with(["summary", "/work/tiny.alula.md"], tiny_file())
    assert(ran.code == 0)
    assert(ran.err == "")
    assert(ran.out.starts_with("machine Tiny (version 1): 4 states, "))
    assert(ran.out.contains("1 parties") || ran.out.contains("parties"))
    assert(ran.out.contains("initial: Wait\n"))
}

test "sm equals the function" {
    ro ran = run_with(["summary", "/work/tiny.alula.md"], tiny_file())
    assert(ran.out == "${render_summary(tiny_json())}\n")
}

test "sm json file is the same summary" {
    ro from_json = run_with(["summary", "/work/tiny.alula.json"], json_file())
    ro from_md = run_with(["summary", "/work/tiny.alula.md"], tiny_file())
    assert(from_json.code == 0)
    assert(from_json.out == from_md.out)
}

test "sm english file" {
    ro ran = run_with(["summary", "/work/tiny.alula.md"], one("/work/tiny.alula.md", tiny_en()))
    assert(ran.code == 0)
    assert(ran.out.starts_with("machine Tiny (version 1): 4 states, "))
}

test "sm lists the states" {
    ro out = run_with(["summary", "/work/tiny.alula.md"], tiny_file()).out
    for line in ["  Wait (appeal): ", "  Decide (fork): ", "  Finished (end): ", "  Stopped (end): "] {
        assert(out.contains(line))
    }
    assert(out.contains("ends: "))
}

test "sm errors" {
    ro ran = run_with(["summary", "/work/tiny.alula.md"], one("/work/tiny.alula.md", broken_ru()))
    assert(ran.code == 1)
    assert(ran.err.contains("/work/tiny.alula.md:"))
}

test "sm not a machine" {
    ro ran = run_with(["summary", "/work/tiny.alula.json"], one("/work/tiny.alula.json", "{"))
    assert(ran.code == 1)
    assert(ran.err.contains("not a machine"))
}

test "sm missing file" {
    ro ran = run0(["summary", "/work/none.alula.md"])
    assert(ran.code == 2)
}
