// types_test.nv - the closed list of failures, the kinds of events, the envelope of an incoming event, the journal event
// and the environment that records the orders of a step.
module alula.engine

// ORACLE-WORKAROUND(32): `import std.text` is needed in `nova build` for `[]str.join` (a `nova test` build has it already); drop the import when item 32 is fixed
import std.text

test "fail codes: the closed list has exactly ten codes with the names of the specification" {
    mut names = []str.new()
    for code in FailCode.all() { names.push(code.name()) }
    assert(names.len() == 10)
    assert(names[0] == "NoResult")
    assert(names[1] == "ModelRefused")
    assert(names[2] == "ConnectionLost")
    assert(names[3] == "FormNotFixed")
    assert(names[4] == "Timeout")
    assert(names[5] == "Cancelled")
    assert(names[6] == "StoppedByHuman")
    assert(names[7] == "CeilingReached")
    assert(names[8] == "MaxTokens")
    assert(names[9] == "MaxTurnRequests")
}

test "fail codes: every name parses back to its code, the names are distinct" {
    for code in FailCode.all() {
        match FailCode.parse(code.name()) {
            Some(back) => assert(back.name() == code.name())
            None => assert(false)
        }
    }
    mut seen = []str.new()
    for code in FailCode.all() {
        assert(!seen.contains(code.name()))
        seen.push(code.name())
    }
}

test "fail codes: a text outside the closed list is not a code, and maps to NoResult" {
    assert(FailCode.parse("SomethingNew") == None)
    assert(FailCode.parse("") == None)
    assert(FailCode.of("SomethingNew").name() == "NoResult")
    assert(FailCode.of("Timeout").name() == "Timeout")
}

fn kind_of(name str) -> EventKind => match name {
    "Input" => Input
    "Progress" => Progress
    "Answered" => Answered
    "Refused" => Refused
    _ => Expired
}

test "event kinds: only a final answer, a refusal and an expired term close a request" {
    assert(!kind_of("Input").closes_request())
    assert(!kind_of("Progress").closes_request())
    assert(kind_of("Answered").closes_request())
    assert(kind_of("Refused").closes_request())
    assert(kind_of("Expired").closes_request())
    assert(!kind_of("Input").is_request_bound())
    assert(kind_of("Progress").is_request_bound())
    assert(kind_of("Expired").is_request_bound())
}

test "incoming event: the creator fills the content, the envelope is empty until the engine stamps it" {
    ro e = Incoming.word("user_message", "hello")
    assert(e.id == "")
    assert(e.trace == "")
    assert(e.step == 0)
    assert(e.at == 0)
    assert(e.name == "user_message")
    assert(e.input == "hello")
    assert(e.request == None)
}

test "fail codes: every code has a distinct word for the journal, in snake_case" {
    mut seen = []str.new()
    for code in FailCode.all() {
        ro word = fail_code_word(code)
        assert(word.byte_len() > 0)
        assert(!word.contains(" "))
        assert(!seen.contains(word))
        seen.push(word)
    }
    assert(fail_code_word(FailCode.StoppedByHuman) == "stopped_by_human")
    assert(fail_code_word(FailCode.NoResult) == "no_result")
}

test "journal event: a code and parameters by name, a missing parameter is None" {
    ro event = journal_event("request_ordered", [param("party", "agent"), param("attempt", "1")])
    assert(event.code == "request_ordered")
    assert(event.params.len() == 2)
    assert(event.value_of("party") == Some("agent"))
    assert(event.value_of("attempt") == Some("1"))
    assert(event.value_of("reason") == None)
}

test "environment: the orders of a step are recorded in the order they are given" {
    mut environment = StepEnvironment.new()
    environment.write_journal(journal_event("user_message", [param("text", "hi")]))
    environment.order_send(SendOrder { party: "agent", input: "hi", idle_term: 30000 })
    environment.order_cancel(CancelOrder { party: "agent" })
    environment.order_save()
    environment.order_finish(Conclusion { failure: None, text: "done" })
    assert(environment.orders.len() == 5)
    mut names = []str.new()
    for order in environment.orders {
        match order {
            Note(event) => names.push("note:${event.code}")
            Send(send) => names.push("send:${send.party}")
            Cancel(cancel) => names.push("cancel:${cancel.party}")
            Save => names.push("save")
            Finish(conclusion) => names.push("finish:${conclusion.text}")
        }
    }
    assert(names.join(",") == "note:user_message,send:agent,cancel:agent,save,finish:done")
}

test "transition: Go carries the state, Stay carries nothing" {
    ro go Transition[str] = Go("next")
    ro stay Transition[str] = Stay
    match go {
        Go(state) => assert(state == "next")
        Stay => assert(false)
    }
    match stay {
        Go(state) => assert(false)
        Stay => assert(true)
    }
}
