// sets_test.nv - P-5 of format 2.7: a set of literals `"a" | "b"` stands wherever a type is expected: the argument of `словарь[K, V]` and of `полный словарь[K, V]`, the result and the
// parameter of a definition, a cell "type" of the tables; the brackets are needed under `?` and `[]` only.
module alula.machine_text_fmt

import std.text

// A JSON text as the translator writes it: `'` stands for the quote that the JSON escapes.
fn jq(s str) -> str => s.replace("'", "\\\"")

// Does the text translate without an error, and does its JSON hold the piece? The text is translated once.
fn has_json(text str, piece str) -> bool {
    ro report = checked(text)
    if report.errors.len() > 0 { panic(first_error_of(report)) }
    report.json.contains(jq(piece))
}

fn with_data_row(row str) -> str => replaced(base_text(), "| попытка_вратаря | число>=0 | 0 | да | механика |\n", "| попытка_вратаря | число>=0 | 0 | да | механика |\n${row}\n")

fn with_definition(def str) -> str => replaced(base_text(), "функция пауза_повтора(п число>=0) -> число =>\n  п + 1\n", "функция пауза_повтора(п число>=0) -> число =>\n  п + 1\n\n${def}\n")

test "st dict value" {
    ro text = with_data_row("| свод | словарь[строка, \"allow\" \\| \"deny\"] | [] | — | строки |")
    assert(has_json(text, "{text: 'allow' | 'deny'}"))
}

test "st dict three" {
    ro text = with_data_row("| свод | словарь[число>=0, \"a\" \\| \"b\" \\| \"c\"] | [] | — | строки |")
    assert(has_json(text, "{int>=0: 'a' | 'b' | 'c'}"))
}

test "st full dict param" {
    ro row = "| ПОЛИТИКА_РАЗРЕШЕНИЙ | полный словарь[ВидДействия, \"allow\" \\| \"deny\"] | [ВидДействия.Чтение: \"allow\", ВидДействия.Запись: \"deny\"] | проект.политика |"
    ro text = replaced(base_text(), "| ПАУЗА_ПОВТОРА | число>=0 | 2000 | проект.пауза |\n", "| ПАУЗА_ПОВТОРА | число>=0 | 2000 | проект.пауза |\n${row}\n")
    ro report = checked(text)
    if report.errors.len() > 0 { panic(first_error_of(report)) }
    assert(report.json.contains(jq("full {ActionKind: 'allow' | 'deny'}")))
    assert(report.json.contains("\"project_key\":\"политика\""))
}

test "st definition result" {
    ro text = with_definition("функция решение_по_политике(вид_действия ВидДействия) -> \"allow\" | \"deny\" =>\n  выбор вид_действия { ВидДействия.Чтение => \"allow\", иначе => \"deny\" }")
    ro report = checked(text)
    if report.errors.len() > 0 { panic(first_error_of(report)) }
    assert(report.json.contains("\"result\":\"${jq("'allow' | 'deny'")}\""))
}

test "st definition param" {
    ro text = with_definition("функция интерактивный(вид_действия \"allow\" | \"deny\") -> булево =>\n  вид_действия == \"allow\"")
    ro report = checked(text)
    if report.errors.len() > 0 { panic(first_error_of(report)) }
    assert(report.json.contains("\"type\":\"${jq("'allow' | 'deny'")}\""))
}

test "st definition both" {
    ro def = "функция решение_по_политике(вид_действия \"allow\" | \"deny\" | \"ask\") -> \"allow\" | \"deny\" =>\n  если вид_действия == \"ask\" то { \"deny\" } иначе { вид_действия }"
    assert(has_json(with_definition(def), "'allow' | 'deny' | 'ask'"))
}

test "st under option" {
    ro bad = with_data_row("| свод | ?\"a\" \\| \"b\" | пусто | — | строки |")
    assert(errors_say(bad, "набор литералов под ? или [] пишется в скобках"))
    assert(has_json(with_data_row("| свод | ?(\"a\" \\| \"b\") | пусто | — | строки |"), "?('a' | 'b')"))
}

test "st under list" {
    ro bad = with_data_row("| свод | []\"a\" \\| \"b\" | [] | — | строки |")
    assert(errors_say(bad, "набор литералов под ? или [] пишется в скобках"))
    assert(has_json(with_data_row("| свод | [](\"a\" \\| \"b\") | [] | — | строки |"), "[]('a' | 'b')"))
}

test "st in brackets" {
    ro text = checked(with_data_row("| свод | словарь[строка, (\"allow\" \\| \"deny\")] | [] | — | строки |"))
    assert(text.errors.len() == 0)
    assert(text.json != base_json())
    assert(same_json(with_data_row("| свод | словарь[строка, \"allow\" \\| \"deny\"] | [] | — | строки |"), text.json))
}

test "st nested" {
    assert(has_json(with_data_row("| свод | словарь[строка, ?(\"a\" \\| \"b\")] | [] | — | строки |"), "{text: ?('a' | 'b')}"))
    assert(has_json(with_data_row("| свод | словарь[строка, [](\"a\" \\| \"b\")] | [] | — | строки |"), "{text: []('a' | 'b')}"))
    assert(has_json(with_data_row("| свод | словарь[строка, (\"a\" \\| \"b\", число)] | [] | — | строки |"), "{text: ('a' | 'b', int)}"))
}

test "st one literal" {
    ro one = with_data_row("| свод | словарь[строка, \"a\"] | [] | — | строки |")
    assert(errors_say(one, "набор литералов — два значения и больше"))
}

test "st input and const" {
    ro in_text = replaced(base_text(), "| ход | строка | первый ход |", "| ход | \"first\" \\| \"retry\" | первый ход |")
    assert(has_json(in_text, "'first' | 'retry'"))
    ro const_text = replaced(base_text(), "| ЧИСЛО_ПОВТОРОВ | число>=0 | 3 |", "| ЧИСЛО_ПОВТОРОВ | \"a\" \\| \"b\" | \"a\" |")
    assert(is_clean(const_text))
}
