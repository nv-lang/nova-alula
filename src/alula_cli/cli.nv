// cli.nv - the program `alula` over its effects: the arguments (`Os`), the files (`Fs`), the standard output and error (`Io`). `execute` returns the exit code; the entry point
// `src/alula.nv` ends the process with it, and the tests run it over the memory handlers (`mock_os`, `mock_fs`, `mock_io`).
//   0 success; 1 errors in a file (or a test that differs); 2 a wrong command or arguments, a file that cannot be read or written.
module alula.alula_cli

// ORACLE-WORKAROUND(32): std.fs comes first: with the imports of the modules of the product before it, `.join` on a `Vec` resolves to `Path.join` (E_RECV_METHOD_MISMATCH); order the imports freely when item 32 is fixed
import std.fs.{Fs, Path, read, write_text, try_exists, read_dir, create_dir_all}
import std.os.{args}
import std.io.{stderr, stdout}
import std.text
import alula.machine.{NamedText, Registry}
import alula.machine.{load_host}
fn put_out(text str) Io -> () {
    if text == "" { return }
    mut o = stdout()
    ro written = o.write(text.bytes())
}

fn put_err(text str) Io -> () {
    if text == "" { return }
    mut e = stderr()
    ro written = e.write(text.bytes())
}

// A usage error: `alula <command>: <reason>` on the standard error, the code 2.
fn usage_error(command str, reason str) Io -> int {
    put_err("alula ${command}: ${reason}\n")
    2
}

fn path_of(name str) -> Path => Path.from_bytes(name.bytes())

// The text of a file; `None` when it cannot be read.
fn read_file(name str) Fs -> Option[str] {
    match read(path_of(name)) {
        Ok(bytes) => Some(bytes.to_str_lossy())
        Err(e) => None
    }
}

// Does the file exist?
fn file_exists(name str) Fs -> bool {
    match try_exists(path_of(name)) {
        Ok(there) => there
        Err(e) => false
    }
}

// The folder without the sign at its end (`dir/` is `dir`); the root stays as it is.
fn trimmed_dir(dir str) -> str {
    mut d = dir
    while d.byte_len() > 1 && (d.ends_with("/") || d.ends_with("\\")) { d = d[..d.byte_len() - 1] }
    d
}

// ORACLE-WORKAROUND(53): the function is not named `collect_names`: the registry of the machines has a private one without `Fs`, and under --strict-effects the call there is checked against this one; use the name when item 53 is fixed
// The files of a folder that `alula test` reads (tests and machines), with the folders under it, in the order of their names; false when the folder cannot be read.
fn scan_folder(dir str, mut names []str) Fs -> bool {
    match read_dir(path_of(dir)) {
        Err(e) => false
        Ok(entries) => {
            mut here = []str.new()
            for entry in entries {
                match entry.name_str() {
                    Some(name) => here.push(name)
                    None => ()
                }
            }
            here.sort()
            for name in here {
                ro full = "${dir}/${name}"
                if is_test_file(name) || is_former_name(name) || is_old_test_name(name) {
                    names.push(full)
                } else if !name.starts_with(".") {
                    // a folder is read; anything else (a file, a link) fails to be read as a folder and is skipped
                    ro ignored = scan_folder(full, names)
                }
            }
            true
        }
    }
}

fn folder_files(dir str) Fs -> Option[[]NamedText] {
    mut names = []str.new()
    if !scan_folder(dir, names) { return None }
    mut files = []NamedText.new()
    for name in names {
        match read_file(name) {
            Some(text) => files.push(NamedText { name, text })
            None => ()
        }
    }
    Some(files)
}

// The folder of a file name (`a/b/c.alula.md` -> `a/b`, `c.alula.md` -> `.`); the signs `\` and `/` both divide.
fn dir_of(name str) -> str {
    ro parts = name.replace("\\", "/").split("/")
    mut names = []str.new()
    for p in parts { names.push(p) }
    if names.len() < 2 { return "." }
    mut out = []str.new()
    mut i = 0
    while i + 1 < names.len() {
        out.push(names[i])
        i += 1
    }
    ro joined = out.join("/")
    if joined == "" { return "/" }
    joined
}

// The text of a file of the host: the file named by the option (it must be there), else the file `fallback` beside the machines (an absent one is an empty text: no primitives, no codes of the host).
fn host_text(explicit bool, name str, fallback str) Fs -> Result[str, str] {
    if explicit {
        match read_file(name) {
            Some(t) => return Ok(t)
            None => return Err("cannot read ${name}")
        }
    }
    if !file_exists(fallback) { return Ok("") }
    match read_file(fallback) {
        Some(t) => Ok(t)
        None => Err("cannot read ${fallback}")
    }
}

// The registry of the host of the command: the language and the data of the host, `registry.md` and `journal.md` beside the files (in the folder, for `test`), or the files of `--registry` and `--journal`.
fn host_of(command str, a Args, anchor str) Fs -> Result[Registry, str] {
    ro registry_text = host_text(a.has_registry, a.registry_file, "${anchor}/registry.md")?
    ro journal_text = host_text(a.has_journal, a.journal_file, "${anchor}/journal.md")?
    match load_host(registry_text, journal_text) {
        Ok(reg) => Ok(reg)
        Err(lines) => Err(lines.join("; "))
    }
}

// What the command gave: the errors go to the standard error; the product goes to the file of `-o` (the code 2 when it cannot be written) or to the standard output.
fn deliver(made CmdResult, command str, a Args) Fs Io -> int {
    put_err(made.err)
    if a.has_output && made.out != "" {
        match write_text(path_of(a.output), made.out) {
            Ok(written) => return made.code
            Err(e) => return usage_error(command, "cannot write ${a.output}")
        }
    }
    put_out(made.out)
    made.code
}

// Before anything is done: the file of `-o` must not be there, unless `--force`.
fn output_error(a Args) Fs -> str {
    if a.has_output && !a.force && file_exists(a.output) {
        return "${a.output} already exists (use --force to overwrite)"
    }
    ""
}

// The files of the libraries that a machine of 2.26 connects (section 9): the path of `- Файл:` (of the key `file` of `includes` for a tree) from the folder of the machine, else from the
// folder of `--lib`; with each its twin in the other language (`libs/pause.alula.md` <-> `libs/pause.en.alula.md`, task 241), found the same way. A file that is not found is not given,
// and the translation says "не найдена" (a twin that is not found is the error of `convert` and `render` in the other language).
fn library_files(text str, file str, a Args) Fs -> []NamedText {
    mut out = []NamedText.new()
    ro paths = if is_json_file(file) { tree_libraries(text) } else { wanted_libraries(text) }
    for written in paths {
        for path in [written, twin_path(written, "en"), twin_path(written, "ru")] {
            if library_named(out, path).is_some() { continue }
            ro near = if dir_of(file) == "." { path } else { "${dir_of(file)}/${path}" }
            match read_file(near) {
                Some(t) => out.push(NamedText { name: path, text: t })
                None => {
                    if a.has_lib {
                        match read_file("${trimmed_dir(a.lib)}/${path}") {
                            Some(t) => out.push(NamedText { name: path, text: t })
                            None => ()
                        }
                    }
                }
            }
        }
    }
    // 0.27 (AL-146): a party `machine <имя>` takes its types from the called machine: the machine files of the folder are the registry of the host of the translation
    if !is_json_file(file) && text.contains("| machine ") {
        match folder_files(dir_of(file)) {
            Some(files) => {
                for f in files {
                    if is_text_machine_name(f.name) && f.name != file && library_named(out, f.name).is_none() { out.push(f) }
                }
            }
            None => ()
        }
    }
    out
}

// The files of the libraries in the language that a converted file names (section 9, task 241): for every library of the machine its twin in the language (or its own file when it
// is in that language), as it was read; they are written beside the file of `-o`.
fn twins_for(text str, language str, libs []NamedText) -> []NamedText {
    mut out = []NamedText.new()
    for written in wanted_libraries(text) {
        ro path = twin_path(written, language)
        if library_named(out, path).is_some() { continue }
        match library_named(libs, path) {
            Some(f) => out.push(f)
            None => ()
        }
    }
    out
}

// The path of a library beside the file of `-o` (the same path from the folder of that file).
fn beside_output(a Args, path str) -> str => if dir_of(a.output) == "." { path } else { "${dir_of(a.output)}/${path}" }

// Before a twin is written: a file that is there with another text is not overwritten without `--force`.
fn twins_clash(twins []NamedText, a Args) Fs -> str {
    if a.force { return "" }
    for t in twins {
        ro target = beside_output(a, t.name)
        if file_exists(target) {
            match read_file(target) {
                Some(have) => {
                    if have != t.text { return "${target} already exists and is not the twin ${t.name} (use --force to overwrite)" }
                }
                None => return "${target} already exists and can not be read (use --force to overwrite)"
            }
        }
    }
    ""
}

// Every folder of a path is there.
// ORACLE-WORKAROUND(55): the memory file system makes only the LAST folder of `create_dir_all`, so every folder of the path is made one by one; make the path in one call when item 55 is fixed
fn make_folders(dir str) Fs -> () {
    if dir == "." || dir == "/" || dir == "" { return }
    mut acc = ""
    mut first = true
    for part in dir.split("/") {
        if first {
            acc = part
            first = false
        } else {
            acc = "${acc}/${part}"
        }
        if part != "" && part != "." && part != ".." && !part.ends_with(":") {
            ro made = create_dir_all(path_of(acc))
        }
    }
}

// The twins written beside the file of `-o` (a file with the same text is left as it is); the code 2 when one can not be written.
fn write_twins(twins []NamedText, a Args, command str) Fs Io -> int {
    for t in twins {
        ro target = beside_output(a, t.name)
        if file_exists(target) {
            match read_file(target) {
                Some(have) => {
                    if have == t.text { continue }
                }
                None => ()
            }
        }
        make_folders(dir_of(target))
        match write_text(path_of(target), t.text) {
            Ok(written) => ()
            Err(e) => return usage_error(command, "cannot write ${target}")
        }
    }
    0
}

// `alula convert`: the file, and with `-o` the twins of its libraries beside it (section 9, task 241).
fn convert_deliver(text str, file str, language str, a Args, registry Registry, libs []NamedText) Fs Io -> int {
    ro made = convert_command(text, file, language, a.no_check, a.lenient, registry, libs)
    if made.code != 0 || !a.has_output { return deliver(made, "convert", a) }
    ro twins = twins_for(text, language, libs)
    ro clash = twins_clash(twins, a)
    if clash != "" {
        put_err(made.err)
        return usage_error("convert", clash)
    }
    if twins.len() > 0 { make_folders(dir_of(a.output)) }
    ro code = deliver(made, "convert", a)
    if code != 0 { return code }
    write_twins(twins, a, "convert")
}

// The files of the folder of `--lib` for `alula test` (a library is found by the end of its path).
fn lib_folder_files(a Args) Fs -> []NamedText {
    if !a.has_lib { return []NamedText.new() }
    match folder_files(trimmed_dir(a.lib)) {
        Some(files) => files
        None => []NamedText.new()
    }
}

fn run_file_command(command str, a Args) Fs Io -> int {
    ro file = a.files[0]
    if is_former_name(file) { return usage_error(command, former_name_message(file)) }
    ro language = if a.has_language { a.language } else { "ru" }
    if command == "convert" && !a.has_language { return usage_error(command, "--language ru|en is needed") }
    ro blocked = output_error(a)
    if blocked != "" { return usage_error(command, blocked) }
    ro text = match read_file(file) {
        Some(t) => t
        None => return usage_error(command, "cannot read ${file}")
    }
    ro registry = match host_of(command, a, dir_of(file)) {
        Ok(r) => r
        Err(message) => return usage_error(command, message)
    }
    ro libs = library_files(text, file, a)
    if command == "compile" { return deliver(compile_command(text, file, a.no_check, a.lenient, registry, libs), command, a) }
    if command == "render" { return deliver(render_command(text, file, language, a.lenient, registry, libs), command, a) }
    if command == "convert" { return convert_deliver(text, file, language, a, registry, libs) }
    if command == "check" { return deliver(check_command(text, file, a.no_check, registry, libs), command, a) }
    deliver(summary_command(text, file, a.no_check, registry, libs), command, a)
}

fn run_test_command(a Args) Fs Io -> int {
    ro machine_file = a.files[0]
    ro test_file = a.files[1]
    if is_former_name(machine_file) { return usage_error("run", former_name_message(machine_file)) }
    if is_old_test_name(test_file) {
        put_err("${old_test_name_message(test_file)}\n")
        return 2
    }
    ro machine_text = match read_file(machine_file) {
        Some(t) => t
        None => return usage_error("run", "cannot read ${machine_file}")
    }
    ro test_text = match read_file(test_file) {
        Some(t) => t
        None => return usage_error("run", "cannot read ${test_file}")
    }
    ro registry = match host_of("run", a, dir_of(machine_file)) {
        Ok(r) => r
        Err(message) => return usage_error("run", message)
    }
    deliver(run_command(machine_text, machine_file, test_text, test_file, registry, library_files(machine_text, machine_file, a)), "run", a)
}

fn run_folder_command(a Args) Fs Io -> int {
    ro dir = trimmed_dir(a.files[0])
    if !file_exists(dir) { return usage_error("test", "cannot read the folder ${dir}") }
    match folder_files(dir) {
        None => usage_error("test", "cannot read the folder ${dir}")
        Some(files) => {
            match host_of("test", a, dir) {
                Err(message) => usage_error("test", message)
                Ok(registry) => deliver(test_command(files, dir, a.verbose, registry, lib_folder_files(a)), "test", a)
            }
        }
    }
}

fn command_function(command str, a Args) Fs Io -> int {
    if command == "version" {
        put_out(version_text())
        return 0
    }
    if command == "run" { return run_test_command(a) }
    if command == "test" { return run_folder_command(a) }
    run_file_command(command, a)
}

fn is_command(word str) -> bool => command_names().contains(word)

// The words of the command line from the position `from`.
fn rest_of(argv []str, from int) -> []str {
    mut rest = []str.new()
    mut i = from
    while i < argv.len() {
        rest.push(argv[i])
        i += 1
    }
    rest
}

/// The whole program: the arguments of the process, the work, the exit code. No arguments is the help and the code 0 (`nova test src` runs every program of the folder with none).
export fn execute() Os Fs Io -> int {
    ro argv = args()
    if argv.len() < 2 {
        put_out(help_text())
        return 0
    }
    ro first = argv[1]
    if first == "--help" || first == "-h" {
        put_out(help_text())
        return 0
    }
    if first == "--version" {
        put_out(version_text())
        return 0
    }
    if first == "help" {
        if argv.len() < 3 {
            put_out(help_text())
            return 0
        }
        ro wanted = argv[2]
        if !is_command(wanted) {
            put_err("alula: unknown command `${wanted}` (try `alula --help`)\n")
            return 2
        }
        put_out(command_help(wanted))
        return 0
    }
    if !is_command(first) {
        put_err("alula: unknown command `${first}` (try `alula --help`)\n")
        return 2
    }
    ro a = parse_args(first, rest_of(argv, 2))
    if a.help {
        put_out(command_help(first))
        return 0
    }
    if a.error != "" { return usage_error(first, a.error) }
    ro wanted_files = if first == "version" { 0 } else { 1 }
    ro files_problem = files_error(first, a, wanted_files)
    if files_problem != "" { return usage_error(first, files_problem) }
    command_function(first, a)
}
