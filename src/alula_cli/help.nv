// help.nv - the texts of `alula`: the help of the program, the help of every command, the version.
module alula.alula_cli

import std.text
import alula.machine_table.{alula_versions, MACHINE_FORMAT}

/// The version of the program.
export const PROGRAM_VERSION = "0.8.1"

/// The line of `alula version`: the program, the version of the language it reads (2.12 only: there is no transition period), the format of the compiled machine.
export fn version_text() -> str {
    ro versions = alula_versions()
    if versions.len() == 1 { return "alula ${PROGRAM_VERSION} (Alula ${versions[0]}, ${MACHINE_FORMAT})\n" }
    "alula ${PROGRAM_VERSION} (Alula ${versions[0]} - ${versions[versions.len() - 1]}, ${MACHINE_FORMAT})\n"
}

/// The help of the program.
export fn help_text() -> str => `alula - compile, render, convert, check and run machines of Alula

Usage:
  alula <command> [arguments]
  alula <command> --help

Commands:
  alula compile <file.alula.md> [-o <file.alula.json>] [--lenient] [--no-check] [--force]
      Alula -> the JSON machine/2 (the language of the file is read from its header).
  alula render <file.alula.json> [--language ru|en] [-o <file.alula.md>] [--lenient] [--force]
      the JSON machine/2 -> a file of Alula in the canonical form (Russian by default).
  alula convert <file.alula.md> --language ru|en [-o <file.alula.md>] [--no-check] [--lenient] [--force]
      a file of Alula in the other language, through the JSON.
  alula check <file.alula.md|file.alula.json> [--no-check]
      the translation and the checks of the table; the errors and the warnings.
  alula summary <file.alula.md|file.alula.json> [--no-check]
      the states, the rows, the actions, the data, the parties.
  alula run <machine> <name.alula.test.json> [--registry <file>] [--journal <file>]
      one test on a machine: ok, or the report of the difference.
  alula test <folder> [-v] [--registry <file>] [--journal <file>] [--lib <folder>]
      every *.alula.test.json of the folder on the machines of the folder: "N of M tests passed".
  alula version
      the version of the program and of the languages it reads.

The host: the language names one primitive (new_id) and 35 journal codes; the rest is the data of the host, the files registry.md (primitives, types) and journal.md (codes) beside the machines, or --registry <file> and --journal <file> (every command that reads a machine takes them).

Files:
  *.alula.md            a machine written in Alula (Russian or English; the header says which), or a library (# Библиотека:, 2.26)
  *.alula.json          the compiled machine (machine/2)
  *.alula.test.json     a test (test/0)

An error is "file:line:column: kind: message" and the quoted line under it (a JSON file has no lines: 1:1).
Exit codes: 0 success; 1 errors in a file, or a test that differs; 2 a wrong command or arguments (or a file that cannot be read).
`

/// The help of one command; "" when there is no such command.
export fn command_help(command str) -> str {
    if command == "compile" {
        return `alula compile <file.alula.md> [-o <file.alula.json>] [--lenient] [--no-check] [--force]

Alula -> the JSON machine/2. The language of the file (ru or en) is read from its header; the extension is not looked at.
The JSON goes to the standard output; with -o it goes to the file (an existing file is not overwritten without --force).
The errors and the warnings go to the standard error as "file:line:column: kind: message".

  -o, --output <file>   write the JSON to the file
  --force               overwrite the file of -o
  --lenient             print the JSON of what could be translated even when there are errors (the code is still 1)
  --no-check            do not check the table against the primitives of the host
  --registry <file>     the registry of the host (default: registry.md beside the file)
  --journal <file>      the table of the journal codes of the host (default: journal.md beside the file)
  --lib <folder>        the folder of the libraries (2.26): the file of a library that is not beside the machine is looked for there
`
    }
    if command == "render" {
        return `alula render <file.alula.json> [--language ru|en] [-o <file.alula.md>] [--lenient] [--force]

The JSON machine/2 -> a file of Alula in the canonical form of the specification (section 1b). Russian by default.
What the file cannot say goes to the standard error and the code is 1.

  --language ru|en      the language of the file to write (default ru)
  -o, --output <file>   write the file (an existing file is not overwritten without --force)
  --force               overwrite the file of -o
  --lenient             print what could be said even when something could not
  --registry <file>     the registry of the host (default: registry.md beside the file)
  --journal <file>      the table of the journal codes of the host (default: journal.md beside the file)
`
    }
    if command == "convert" {
        return `alula convert <file.alula.md> --language ru|en [-o <file.alula.md>] [--no-check] [--lenient] [--force]

A file of Alula in the other language: compile, then render. The meaning is kept; the comments (the paragraphs of free text and the lines
starting with ">" or "//") are not carried over, and the program says so on the standard error.

  --language ru|en      the language of the result (needed)
  -o, --output <file>   write the file (an existing file is not overwritten without --force)
  --force               overwrite the file of -o
  --no-check            do not check the table against the primitives of the host
  --lenient             go on when there are errors
  --registry <file>     the registry of the host (default: registry.md beside the file)
  --journal <file>      the table of the journal codes of the host (default: journal.md beside the file)
  --lib <folder>        the folder of the libraries (2.26): the file of a library that is not beside the machine is looked for there
`
    }
    if command == "check" {
        return `alula check <file.alula.md|file.alula.json> [--no-check]

A file of Alula: the translation, the checks of the table, the warnings. A file *.json: the decoding of machine/2 and the checks of the table.
Prints "ok" and the code 0 when there are no errors; the errors and the warnings go to the standard error.

  --no-check            do not check the table against the primitives of the host
  --registry <file>     the registry of the host (default: registry.md beside the file)
  --journal <file>      the table of the journal codes of the host (default: journal.md beside the file)
  --lib <folder>        the folder of the libraries (2.26): the file of a library that is not beside the machine is looked for there
`
    }
    if command == "summary" {
        return `alula summary <file.alula.md|file.alula.json> [--no-check]

The summary of a machine: the states, the rows, the actions, the data, the parties; one line per state.

  --no-check            do not check the table against the primitives of the host
  --registry <file>     the registry of the host (default: registry.md beside the file)
  --journal <file>      the table of the journal codes of the host (default: journal.md beside the file)
  --lib <folder>        the folder of the libraries (2.26): the file of a library that is not beside the machine is looked for there
`
    }
    if command == "run" {
        return `alula run <machine.alula.json|machine.alula.md> <name.alula.test.json>

One test (test/0) on a machine. Prints "ok" and the code 0, or the report of the first differences and the code 1.
The test names its machine; a machine with another name is an error.
A test file with the name of before 0.8.0 is refused with "old file name, rename to *.alula.test.json" and the code 2.

  --registry <file>     the registry of the host (default: registry.md beside the machine)
  --journal <file>      the table of the journal codes of the host (default: journal.md beside the machine)
  --lib <folder>        the folder of the libraries (2.26): the file of a library that is not beside the machine is looked for there
`
    }
    if command == "test" {
        return `alula test <folder> [-v]

Every *.alula.test.json of the folder (and of the folders under it) on the machine that the test names; the machines are the *.alula.json files
of the folder, or the *.alula.md files when a machine has no JSON. Prints the report of every test that differs and "N of M tests passed".
The code is 1 when a test differs, 2 when the folder holds a test with the name of before 0.8.0 (the refusal says "old file name, rename to *.alula.test.json").

  -v, --verbose         one line "ok <file>" for every test that passed
  --registry <file>     the registry of the host (default: registry.md in the folder)
  --journal <file>      the table of the journal codes of the host (default: journal.md in the folder)
  --lib <folder>        the folder of the libraries (2.26): the file of a library that is not beside the machine is looked for there
`
    }
    if command == "version" {
        return `alula version

Prints the version of the program, the versions of Alula it reads and the format of the compiled machine.
`
    }
    ""
}
