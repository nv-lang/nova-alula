// commands.nv - the commands of `alula` on texts: a command gets the text of its file (the files are read by `cli.nv`) and gives an `CmdResult`: what goes to the
// standard output, what goes to the standard error, the exit code. Nothing here touches a file, so every command is the same function in a test and in the program.
module alula.alula_cli

// ORACLE-WORKAROUND(32): `import std.text` is needed in `nova build` for `[]str.join` (a `nova test` build has it already); drop the import when item 32 is fixed
import std.text
import alula.machine.{NamedText, Registry}
import alula.machine_table.{load_machine, parse_machine, issue_text}
import alula.machine_text.{translate_report_with, translate_checked_with, TranslateReport, error_text, render_summary, render_machine_in, library_registry, is_library_text, library_paths}
import alula.machine_run.{AlulaMachine, NestedRegistry, check_registry, run_nested_test, load_alula_machine, parse_test, test_problem, run_test, run_ok, report_text}
import alula.machine_table.{MachineParty}

// ORACLE-WORKAROUND(9): the type is not named `Outcome`: a user type named like a prelude type breaks the build of the program (CC-FAIL "no member named tag in struct Nova_Outcome"); name it `Outcome` when item 9 is fixed
/// CmdResult: the result of a command. `out` is the product (it goes to the standard output or to the file of `-o`), `err` the lines of the standard error, `code` the exit code
/// (0 success, 1 errors in a file, 2 wrong use).
export type CmdResult { out str, err str, code int }

fn done(out str, err str, code int) -> CmdResult => { out, err, code }

/// The lines as one text of the standard error: every line ends with a newline; no lines is no text.
fn lines_text(lines []str) -> str {
    if lines.len() == 0 { return "" }
    "${lines.join("\n")}\n"
}

/// The text of a file of Alula as the translator reads it: the lines end with a newline (a file saved with CR LF is the same file).
fn alula_text(text str) -> str => text.replace("\r\n", "\n")

/// Is the file the compiled JSON? The name says so (`*.alula.json`, or any `*.json`); every other file is a text of Alula.
export fn is_json_file(file str) -> bool => file.ends_with(".json")

/// The paths of the libraries that a file of 2.26 connects (its lines `- Файл:`); the program reads them (cli.nv: the module of the translator is not imported there, ORACLE-WORKAROUND(32)).
export fn wanted_libraries(text str) -> []str => library_paths(alula_text(text))

// `libs`: the files of the libraries that the machine connects (2.26, section 9), by the paths of its lines `- Файл:`.
fn translated(text str, no_check bool, registry Registry, libs []NamedText) -> TranslateReport {
    if no_check { return translate_report_with(alula_text(text), library_registry(libs)) }
    translate_checked_with(alula_text(text), registry, library_registry(libs))
}

// The errors and then the warnings of a report, each `file:line:column: kind: message` and the quoted line.
fn report_lines(report TranslateReport, file str) -> []str {
    mut lines = []str.new()
    for e in report.errors { lines.push(error_text(e, file)) }
    for w in report.warnings { lines.push(error_text(w, file)) }
    lines
}

// The notes of the reverse generator, in the form of an error of a JSON file (it has no lines).
fn note_lines(notes []str, file str) -> []str {
    mut lines = []str.new()
    for n in notes { lines.push("${file}:1:1: render: ${n}") }
    lines
}

// ---- compile -----------------------------------------------------------------------------------------------------------------------

/// `alula compile`: Alula -> the JSON `machine/2`. With errors there is no JSON unless `lenient`; the code is 1 either way.
export fn compile_command(text str, file str, no_check bool, lenient bool, registry Registry, libs []NamedText) -> CmdResult {
    ro report = translated(text, no_check, registry, libs)
    mut lines = report_lines(report, file)
    if report.errors.len() == 0 { return done("${report.json}\n", lines_text(lines), 0) }
    lines.push("alula compile: ${report.errors.len()} errors in ${file} (${report.rows_noted} of ${report.rows_total} rows with notes)")
    ro out = if lenient { "${report.json}\n" } else { "" }
    done(out, lines_text(lines), 1)
}

// ---- render ------------------------------------------------------------------------------------------------------------------------

/// `alula render`: the JSON `machine/2` -> a file of Alula in the language. What the generator cannot say is a note (code 1); with `lenient` the text is printed all the same.
export fn render_command(text str, file str, language str, lenient bool, registry Registry) -> CmdResult {
    ro made = render_machine_in(text, language, false, registry)
    if made.notes.len() == 0 { return done(made.text, "", 0) }
    ro out = if lenient { made.text } else { "" }
    done(out, lines_text(note_lines(made.notes, file)), 1)
}

// ---- convert -----------------------------------------------------------------------------------------------------------------------

/// `alula convert`: a file of Alula -> the file in the language, through the JSON. The comments do not go through the JSON; the program says so.
export fn convert_command(text str, file str, language str, no_check bool, lenient bool, registry Registry, libs []NamedText) -> CmdResult {
    ro report = translated(text, no_check, registry, libs)
    mut lines = report_lines(report, file)
    if report.errors.len() > 0 && !lenient {
        lines.push("alula convert: ${report.errors.len()} errors in ${file} (${report.rows_noted} of ${report.rows_total} rows with notes)")
        return done("", lines_text(lines), 1)
    }
    ro made = render_machine_in(report.json, language, false, registry)
    for l in note_lines(made.notes, file) { lines.push(l) }
    lines.push("alula: note: the comments of ${file} (paragraphs of free text, lines starting with > or //) are not carried over")
    ro failed = report.errors.len() > 0 || made.notes.len() > 0
    ro out = if made.notes.len() == 0 || lenient { made.text } else { "" }
    done(out, lines_text(lines), if failed { 1 } else { 0 })
}

// ---- check -------------------------------------------------------------------------------------------------------------------------

fn ok_line(warnings int) -> str {
    if warnings == 0 { return "ok\n" }
    if warnings == 1 { return "ok (1 warning)\n" }
    "ok (${warnings} warnings)\n"
}

// The issues of the decoder and of the checks of a JSON file, each as an error at 1:1.
fn json_issue_lines(text str, file str, no_check bool, registry Registry) -> []str {
    mut lines = []str.new()
    if no_check {
        match parse_machine(text) {
            Ok(def) => ()
            Err(issue) => lines.push("${file}:1:1: check: ${issue_text(issue)}")
        }
        return lines
    }
    match load_machine(text, registry) {
        Ok(def) => ()
        Err(issues) => {
            for issue in issues { lines.push("${file}:1:1: check: ${issue_text(issue)}") }
        }
    }
    lines
}

/// `alula check`: a file of Alula (the translation with the checks of the table) or a JSON `machine/2` (the decoding with the checks).
export fn check_command(text str, file str, no_check bool, registry Registry, libs []NamedText) -> CmdResult {
    if is_json_file(file) {
        ro problems = json_issue_lines(text, file, no_check, registry)
        if problems.len() == 0 { return done(ok_line(0), "", 0) }
        return done("", lines_text(problems), 1)
    }
    ro report = translated(text, no_check, registry, libs)
    ro lines = report_lines(report, file)
    if report.errors.len() > 0 { return done("", lines_text(lines), 1) }
    done(ok_line(report.warnings.len()), lines_text(lines), 0)
}

// ---- summary -----------------------------------------------------------------------------------------------------------------------

/// `alula summary`: the summary of a machine (the states, the rows, the actions, the data, the parties).
export fn summary_command(text str, file str, no_check bool, registry Registry, libs []NamedText) -> CmdResult {
    if is_json_file(file) {
        ro summary = render_summary(text)
        if summary.starts_with("not a machine") { return done("", "${file}:1:1: summary: ${summary}\n", 1) }
        return done("${summary}\n", "", 0)
    }
    ro report = translated(text, no_check, registry, libs)
    ro lines = report_lines(report, file)
    done("${render_summary(report.json)}\n", lines_text(lines), if report.errors.len() > 0 { 1 } else { 0 })
}

// ---- run ---------------------------------------------------------------------------------------------------------------------------

/// The machine of a file of Alula or of a JSON file, made ready to run; the error is the lines of the errors of the file.
export fn machine_of_file(text str, file str, registry Registry, libs []NamedText) -> Result[AlulaMachine, str] {
    if is_json_file(file) {
        match load_alula_machine(text, registry) {
            Ok(m) => return Ok(m)
            Err(e) => return Err("${file}:1:1: check: ${e}")
        }
    }
    ro report = translate_checked_with(alula_text(text), registry, library_registry(libs))
    if report.errors.len() > 0 {
        mut lines = []str.new()
        for e in report.errors { lines.push(error_text(e, file)) }
        return Err(lines.join("\n"))
    }
    match load_alula_machine(report.json, registry) {
        Ok(m) => Ok(m)
        Err(e) => Err("${file}:1:1: check: ${e}")
    }
}

/// `alula run`: one test on one machine. `ok`, or the report of the differences with the code 1.
export fn run_command(machine_text str, machine_file str, test_text str, test_file str, registry Registry, libs []NamedText) -> CmdResult {
    match machine_of_file(machine_text, machine_file, registry, libs) {
        Err(lines) => done("", "${lines}\n", 1)
        Ok(machine) => {
            match parse_test(test_text) {
                Err(e) => done("", "${test_file}:1:1: test: ${e.path}: ${e.message}\n", 1)
                Ok(sc) => {
                    if sc.machine != machine.def.name {
                        return done("", "${test_file}:1:1: test: the test is for machine ${sc.machine}, the machine of ${machine_file} is ${machine.def.name}\n", 1)
                    }
                    if has_nested(machine) && !sc.standalone {
                        return done("", "${test_file}:1:1: test: the machine ${machine.def.name} calls nested machines: they are found in a folder, use `alula test <folder>`\n", 1)
                    }
                    ro problem = test_problem(machine, sc)
                    if problem != "" { return done("", "${test_file}:1:1: test: ${problem}\n", 1) }
                    ro run = run_test(machine, sc)
                    if run_ok(run) { return done("ok\n", "", 0) }
                    done("${report_text(run)}\n", "", 1)
                }
            }
        }
    }
}

// ---- test --------------------------------------------------------------------------------------------------------------------------

fn is_test_name(name str) -> bool => name.ends_with(".alula.test.json")

fn is_json_machine_name(name str) -> bool => name.ends_with(".alula.json")

fn is_text_machine_name(name str) -> bool => name.ends_with(".alula.md") || name.ends_with(".alula.txt")

/// Is the file one that `alula test` reads: a test or a machine?
export fn is_test_file(name str) -> bool => is_test_name(name) || is_json_machine_name(name) || is_text_machine_name(name)

const FORMER_MARK = ".portolan." // guard-allow(legacy-name): the former extension is named here to be refused

/// Is it a former name of a file (`<name>` + the former mark + `md`, `txt` or `json`)? The language had another name before the format 2.14; its files are not names of Alula
/// and are refused, not skipped (there is no transition period).
export fn is_former_name(name str) -> bool {
    for extension in ["md", "txt", "json"] {
        if name.ends_with("${FORMER_MARK}${extension}") { return true }
    }
    false
}

/// The refusal of a file with a former name.
export fn former_name_message(name str) -> str => "${name}: the name of the file is the former one (*${FORMER_MARK}*): rename it to *.alula.* (the language is called Alula since the format 2.14; there is no transition period)"

const OLD_TEST_SUFFIX = ".scenario.test.json" // the name of a check before AL-135 (task 230); it is named here to be refused

/// Is it the name of a check as it was before AL-135 (`*` + the old suffix)? Such a file is not read by `alula test` and not run by `alula run`: it is refused with a message (AL-136).
export fn is_old_test_name(name str) -> bool => name.ends_with(OLD_TEST_SUFFIX)

/// The refusal of a file with the old name of a check.
export fn old_test_name_message(name str) -> str => "old file name, rename to *.alula.test.json: ${name}"

/// A machine found in the folder: the file it came from and the machine.
type FoundMachine { file str, machine AlulaMachine }

// Does the machine call nested machines (a party of the kind `machine`)?
fn has_nested(machine AlulaMachine) -> bool {
    for p in machine.def.parties {
        if p.kind == MachineParty { return true }
    }
    false
}

// The registry of the machines of the folder for a caller: every machine under its own name (the name of a party of the kind `machine` is the name of the machine it calls).
fn registry_of(found []FoundMachine) -> NestedRegistry {
    mut reg = NestedRegistry.empty()
    for f in found { reg = reg.add(f.machine.def.name, f.machine) }
    reg
}

// The names of the machines that tests run together with their nested machines: a standalone test (task 122) plays the nested parties itself and needs none.
fn nested_run_names(tests []NamedText) -> []str {
    mut out = []str.new()
    for s in tests {
        match parse_test(s.text) {
            Ok(sc) => {
                if !sc.standalone && !out.contains(sc.machine) { out.push(sc.machine) }
            }
            Err(e) => ()
        }
    }
    out
}

// The names of nested machines that the found machines named in `wanted` call and that are not found yet.
fn nested_missing(found []FoundMachine, wanted []str) -> []str {
    mut out = []str.new()
    for f in found {
        if !wanted.contains(f.machine.def.name) { continue }
        for p in f.machine.def.parties {
            if p.kind == MachineParty && machine_named(found, p.nested).is_none() && !out.contains(p.nested) { out.push(p.nested) }
        }
    }
    out
}

fn machine_named(found []FoundMachine, name str) -> Option[AlulaMachine] {
    for f in found {
        if f.machine.def.name == name { return Some(f.machine) }
    }
    None
}

// The names of the machines that the tests of the files ask for and that are not in `found`; the tests that do not parse are not asked about.
fn missing_names(found []FoundMachine, tests []NamedText) -> []str {
    mut out = []str.new()
    for s in tests {
        match parse_test(s.text) {
            Ok(sc) => {
                if machine_named(found, sc.machine).is_none() && !out.contains(sc.machine) { out.push(sc.machine) }
            }
            Err(e) => ()
        }
    }
    out
}

/// `alula test`: every test of `files` (the files of the folder `dir`, tests and machines, in the order of their names) on the machine of the folder that it names. The
/// machines are the `*.alula.json` files; a machine that has no JSON file is read from `*.alula.md` (`*.alula.txt`) when a test asks for it. A file of a library (`# Библиотека:`, 2.26) is no
/// machine: the files of the folder and `libs` (the folder `--lib`) are the libraries that a machine connects by its path.
export fn test_command(files []NamedText, dir str, verbose bool, registry Registry, libs []NamedText) -> CmdResult {
    mut lib_files = []NamedText.new()
    for f in files {
        if is_text_machine_name(f.name) { lib_files.push(f) }
    }
    for f in libs { lib_files.push(f) }
    mut tests = []NamedText.new()
    for f in files {
        if is_test_name(f.name) { tests.push(f) }
    }
    for f in files {
        if is_former_name(f.name) { return done("", "alula test: ${former_name_message(f.name)}\n", 2) }
    }
    // a check with the old name is not skipped in silence (AL-136): one line for each such file, the code 2, nothing is run
    mut old_names = []str.new()
    for f in files {
        if is_old_test_name(f.name) { old_names.push(old_test_name_message(f.name)) }
    }
    if old_names.len() > 0 { return done("", lines_text(old_names), 2) }
    if tests.len() == 0 { return done("", "alula test: no tests in ${dir}\n", 2) }
    mut found = []FoundMachine.new()
    mut errors = []str.new()
    for f in files {
        if is_json_machine_name(f.name) {
            match machine_of_file(f.text, f.name, registry, lib_files) {
                Ok(m) => found.push(FoundMachine { file: f.name, machine: m })
                Err(lines) => errors.push(lines)
            }
        }
    }
    // the machines written in Alula are translated only when a test names a machine that no JSON file has (a translation costs a second for a big machine)
    ro wanted = nested_run_names(tests)
    if missing_names(found, tests).len() > 0 || nested_missing(found, wanted).len() > 0 {
        for f in files {
            if is_text_machine_name(f.name) && !is_library_text(f.text) && (missing_names(found, tests).len() > 0 || nested_missing(found, wanted).len() > 0) {
                match machine_of_file(f.text, f.name, registry, lib_files) {
                    Ok(m) => {
                        if machine_named(found, m.def.name).is_none() { found.push(FoundMachine { file: f.name, machine: m }) }
                    }
                    Err(lines) => errors.push(lines)
                }
            }
        }
    }
    mut out = []str.new()
    mut passed = 0
    for s in tests {
        match parse_test(s.text) {
            Err(e) => out.push("FAIL ${s.name}\n  ${s.name}:1:1: test: ${e.path}: ${e.message}")
            Ok(sc) => {
                match machine_named(found, sc.machine) {
                    None => out.push("FAIL ${s.name}\n  no machine ${sc.machine} in ${dir}")
                    Some(machine) => {
                        ro problem = test_problem(machine, sc)
                        // a standalone test plays the nested parties itself (task 122): no pair to check
                        ro nested_run = has_nested(machine) && !sc.standalone
                        ro pair_problems = if nested_run { check_registry(machine, registry_of(found)) } else { []str.new() }
                        if problem != "" {
                            out.push("FAIL ${s.name}\n  ${s.name}:1:1: test: ${problem}")
                        } else if pair_problems.len() > 0 {
                            out.push("FAIL ${s.name}\n  ${s.name}:1:1: test: the nested machines do not fit: ${pair_problems.join(" | ")}")
                        } else {
                            ro run = if nested_run { run_nested_test(machine, registry_of(found), sc) } else { run_test(machine, sc) }
                            if run_ok(run) {
                                passed += 1
                                if verbose { out.push("ok ${s.name}") }
                            } else {
                                out.push("FAIL ${s.name}\n${report_text(run)}")
                            }
                        }
                    }
                }
            }
        }
    }
    out.push("${passed} of ${tests.len()} tests passed")
    done(lines_text(out), lines_text(errors), if passed == tests.len() { 0 } else { 1 })
}
