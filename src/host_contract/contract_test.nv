// contract_test.nv - the conformance probes of the local host contract (the epic 0.29 result F,
// the card F). THE MATRIX: for every declared operation the positives and the negatives of the
// card, and THE DISTINCTION the card demands: a schema error (a border refusal, no receipt) versus
// a receipt answer (the event ran). The machine of the probes is `echo` of the examples (a free
// input over the example registry), given as its COMPILED TREE (the tree form of instance_open; the
// table form goes through the translator at the CLI layer, outside these probes).

module alula.host_contract

import alula.machine.{Value, Text, Dict, DictEntry, Registry, text_of_file, NamedText}
import alula.examples.{machine_files, example_registry}
import alula.engine.{Pins}

// ---- the fixtures --------------------------------------------------------------------------------------

fn echo_tree() -> str => text_of_file(machine_files(), "echo.alula.json")

fn pins1() -> Pins => { contract_id: "sha256:c1", artifact_id: "sha256:a1" }

fn opened() -> InstanceHandle {
    match instance_open(echo_tree(), example_registry(), pins1()) {
        Ok(h) => h
        Err(m) => panic("echo does not open: ${m}")
    }
}

fn submit(mut h InstanceHandle, envelope str) -> ContractAnswer {
    // the free call: the method form h.submit_json(envelope) resolved to describe_json in the merged
    // unit (the 0.1.4 method resolver picks the wrong single-string method; the survey item 129 class)
    ro out = submit_json(h, envelope)
    out
}

fn envelope(kind str, name str, request str, input str, producer str) -> str {
    mut parts = []str.new()
    parts.push("\"kind\":\"${kind}\"")
    if name != "" { parts.push("\"name\":\"${name}\"") }
    if request != "" { parts.push("\"request\":\"${request}\"") }
    if input != "" { parts.push("\"input\":\"${input}\"") }
    parts.push("\"producer\":\"${producer}\"")
    "{${parts.join(",")}}"
}

// ---- contract.get --------------------------------------------------------------------------------------

test "hc contract.get returns the manifest and both identities" {
    ro answer = contract_get(echo_tree(), example_registry(), "", "", "alula 0.29.0")
    assert(answer.kind == OkAnswer)
    assert(answer.payload.contains("\"contract_id\":\"sha256:"))
    assert(answer.payload.contains("\"artifact_id\":\"sha256:"))
    assert(answer.payload.contains("\"machine\":\"Echo\""))
    assert(answer.payload.contains("\"manifest\":{"))
}

test "hc contract.get refuses a broken tree as a schema error" {
    ro answer = contract_get("no json here", example_registry(), "", "", "alula 0.29.0")
    assert(answer.kind == SchemaError)
    // THE DISTINCTION: a schema error carries NO receipt
    assert(!answer.payload.contains("receipt"))
}

// ---- instance_open -------------------------------------------------------------------------------------

test "hc instance_open refuses a broken tree as a schema error" {
    match instance_open("no json here", example_registry(), pins1()) {
        Ok(_) => panic("a broken machine opened")
        Err(m) => assert(m.contains("schema error"))
    }
}

test "hc a pinned instance opens and describes itself" {
    ro h = opened()
        ro answer = describe_json(h)
    assert(answer.kind == OkAnswer)
    assert(answer.payload.contains("\"machine\":\"Echo\""))
    assert(answer.payload.contains("\"finished\":false"))
}

// ---- instance.submit: the schema errors ----------------------------------------------------------------

test "hc submit refuses a malformed envelope as a schema error" {
    mut h = opened()
    ro answer = submit(h, "not json")
    assert(answer.kind == SchemaError)
    assert(answer.payload.contains("not valid JSON"))
}

test "hc submit refuses an unknown event kind as a schema error" {
    mut h = opened()
    ro answer = submit(h, envelope("telepathy", "", "", "", "local"))
    assert(answer.kind == SchemaError)
    assert(answer.payload.contains("the event kind telepathy is not declared"))
}

test "hc submit refuses an envelope without a kind as a schema error" {
    mut h = opened()
    ro answer = submit(h, "{\"input\":\"x\"}")
    assert(answer.kind == SchemaError)
    assert(answer.payload.contains("takes kind"))
}

// ---- instance.submit: the receipt answers --------------------------------------------------------------

test "hc submit applies a signal and answers with a receipt" {
    mut h = opened()
    ro answer = submit(h, envelope("input", "message", "", "hello", "local"))
    assert(answer.kind == ReceiptAnswer)
    assert(answer.payload.contains("\"decision\":\"applied\""))
    assert(answer.payload.contains("\"effect_id\":\"e:"))
    assert(answer.payload.contains("\"outcome\":"))
}

test "hc a repeated submit is a duplicate receipt, not a schema error" {
    mut h = opened()
    ro first = submit(h, envelope("input", "message", "", "hello", "local"))
        assert(first.kind == ReceiptAnswer)
    ro second = submit(h, envelope("input", "message", "", "hello", "local"))
    assert(second.kind == ReceiptAnswer)
    assert(second.payload.contains("\"decision\":\"duplicate\""))
}

// the conflict of the same event id with another fingerprint is a property of the ENGINE dedup
// (the producer and the event id being equal, the fingerprint differing) — it is proven at the
// engine level (src/engine/admission_test.nv); at this border a changed fingerprint changes the
// event identity, so the honest answer is a second applied event

// ---- instance.status -----------------------------------------------------------------------------------

test "hc status of a known effect answers with the receipt" {
    mut h = opened()
    ro a1 = submit(h, envelope("input", "message", "", "hello", "local"))
    // the submit itself saw the receipt: its outcome word is in the answer
    assert(a1.payload.contains("\"outcome\":"))
    // the identity the submit built: e:<fingerprint>
    ro answer = status_json(h, "local", "e:input|-|hello")
    assert(answer.kind == ReceiptAnswer)
    assert(answer.payload.contains("\"outcome\":\""))
}

test "hc status of an unknown effect is an ok answer with unknown (no receipt)" {
    mut h = opened()
    ro answer = status_json(h, "local", "e:nothing")
    assert(answer.kind == OkAnswer)
    assert(answer.payload.contains("\"outcome\":\"unknown\""))
}

test "hc status refuses an empty effect id as a schema error" {
    ro h = opened()
    ro answer = status_json(h, "local", "")
    assert(answer.kind == SchemaError)
}

// ---- the end-to-end run through the instance -----------------------------------------------------------

test "hc a signal through the contract moves the machine like the tests do" {
    mut h = opened()
    ro a1 = submit(h, envelope("input", "message", "", "hello", "local"))
    mut k = ""
    match a1.kind {
        SchemaError => { k = "schema" }
        ReceiptAnswer => { k = "receipt" }
        OkAnswer => { k = "ok" }
    }
    assert(a1.kind == ReceiptAnswer)
        ro answer = describe_json(h)
    
}
