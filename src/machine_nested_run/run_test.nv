// run_test.nv - the scenarios `nested-*.scenario.test.json` (task 119): a parent that calls a nested machine, run together by the runner of `src/machine_run/nested_scenario.nv`.
// Each file names its parent (`caller`, `fan`); the nested machine `callee` is in the registry. A difference is a report that says the step, the engine and the part.
module alula.machine_nested_run

import std.text
import alula.machine.{text_of_file, NamedText}
import alula.machine_run.{AlulaMachine, NestedRegistry, load_alula_machine, parse_scenario, run_nested_scenario, run_ok, report_text, Scenario, ScenarioRun, check_registry}
import alula.examples.{machine_files, scenario_files, sample_registry}

fn machine_of(name str) -> AlulaMachine {
    match load_alula_machine(text_of_file(machine_files(), "${name}.alula.json"), sample_registry()) {
        Ok(m) => m
        Err(e) => panic("the machine ${name} does not load: ${e}")
    }
}
