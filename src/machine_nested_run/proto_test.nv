// proto_test.nv - the protocol of the call and the runner of the tests of a parent with its nested machines (task 119): the events a request, a signal and an end become, the registry and
// the check of a pair against it, `on` and `also` of a step of a test, the report of a difference.
module alula.machine_nested_run

import std.text
import alula.engine.{PartyRequest, PartyResponse, EventKind, Incoming, Reply, Rejection, FailCode}
import alula.machine.{text_of_file}
import alula.examples.{test_files}
import alula.machine_run.{NestedRegistry, check_registry, nested_of_request, call_start, call_signal, call_signal_name, call_reply, parse_test, run_nested_test, run_ok, report_text, test_through_parent, prepare_child}

fn request_of(id str, input str) -> PartyRequest[str] => { id, attempt: 1, party: "callee", input, idle_term: 0, trace: "t1-p", step: 3 }

fn text_of_test(name str) -> str {
    for f in test_files() {
        if f.name == name { return f.text }
    }
    panic("no test ${name}")
}

fn run_text(text str) -> str {
    match parse_test(text) {
        Ok(sc) => report_text(run_nested_test(machine_of(sc.machine), registry(), sc))
        Err(e) => "parse: ${e.path}: ${e.message}"
    }
}

fn ok_text() -> str => text_of_test("nested-call-ok.alula.test.json")

// ---- the events of the protocol -----------------------------------------------------------------------------------------------------------------

test "np start event" {
    ro ev = call_start(request_of("callee-1", "{\"label\":\"m\"}"))
    assert(ev.kind == EventKind.Input)
    assert(ev.name == "start")
    assert(ev.request == Some("callee-1"))
    assert(ev.input == "{\"label\":\"m\"}")
}

test "np signal names" {
    assert(call_signal_name("stop") == "parent_stop")
    assert(call_signal_name("continue") == "parent_continue")
    assert(call_signal_name("halt") == "parent_halt")
    assert(call_signal_name("cancel") == "cancel_request")
    assert(call_signal_name("jump") == "")
}

test "np signal event" {
    ro ev = call_signal("callee-1", "halt")
    assert(ev.kind == EventKind.Input)
    assert(ev.name == "parent_halt")
    assert(ev.input == "callee-1")
    assert(ev.request == None)
}

test "np reply answer" {
    ro done PartyResponse[str] = Answer(Reply { request: "p", party: "callee", result: "text", trace: "t", step: 4 })
    match call_reply("callee-1", Some(done)) {
        Some(ev) => {
            assert(ev.kind == EventKind.Answered)
            assert(ev.request == Some("callee-1"))
            assert(ev.input == "text")
        }
        None => assert(false)
    }
}

test "np reply refusal" {
    ro refused PartyResponse[str] = Refusal(Rejection { request: "p", party: "callee", reason: FailCode.Cancelled, text: "x", trace: "t", step: 4 })
    match call_reply("callee-2", Some(refused)) {
        Some(ev) => {
            assert(ev.kind == EventKind.Refused)
            assert(ev.request == Some("callee-2"))
            assert(ev.input == "Cancelled")
        }
        None => assert(false)
    }
}

test "np reply none" {
    // ORACLE-WORKAROUND(61): the value is bound with its type, `call_reply("callee-1", None)` is typed `Option[int]` by the code generator; pass the literal when item 61 is fixed
    ro running Option[PartyResponse[str]] = None
    match call_reply("callee-1", running) {
        Some(ev) => assert(false)
        None => assert(true)
    }
}

// ---- the registry ---------------------------------------------------------------------------------------------------------------------------

test "np registry" {
    ro reg = registry()
    assert(reg.entries.len() == 1)
    match reg.find("callee") {
        Some(m) => assert(m.def.name == "callee")
        None => assert(false)
    }
    match reg.find("nobody") {
        Some(m) => assert(false)
        None => assert(true)
    }
    assert(NestedRegistry.empty().entries.len() == 0)
}

test "np registry order" {
    ro reg = NestedRegistry.empty().add("b", machine_of("callee")).add("a", machine_of("caller"))
    assert(reg.entries[0].name == "b")
    assert(reg.entries[1].name == "a")
}

test "np owner of a request" {
    ro caller = machine_of("caller")
    assert(nested_of_request(caller, "callee-1") == "callee")
    assert(nested_of_request(caller, "callee-12") == "callee")
    assert(nested_of_request(caller, "enhanced-1") == "")
    ro fan = machine_of("fan")
    assert(nested_of_request(fan, "a-1") == "callee")
    assert(nested_of_request(fan, "enhanced-1") == "")
}

test "np check lacks" {
    ro problems = check_registry(machine_of("caller"), NestedRegistry.empty())
    assert(problems.len() == 1)
    assert(problems[0].contains("callee"))
    assert(problems[0].contains("not in the registry"))
}

test "np check wrong machine" {
    // another machine under the name: its input is not the input type of the party
    ro reg = NestedRegistry.empty().add("callee", machine_of("fan"))
    ro problems = check_registry(machine_of("caller"), reg)
    assert(problems.len() >= 1)
    assert(problems[0].starts_with("callee: $.parties["))
}

test "np check a cycle of calls" {
    // the nested machine itself calls a machine: task 123 checks the levels below, and a machine that would call itself again is a cycle
    ro reg = NestedRegistry.empty().add("callee", machine_of("caller"))
    ro problems = check_registry(machine_of("caller"), reg)
    assert(problems.len() >= 1)
    assert(problems[problems.len() - 1].contains("calls itself again"))
}

test "np check fits" {
    assert(check_registry(machine_of("fan"), registry()).len() == 0)
    assert(check_registry(machine_of("callee"), registry()).len() == 0)
}

// ---- the test of a parent ---------------------------------------------------------------------------------------------------------------

test "np test fields" {
    match parse_test(ok_text()) {
        Ok(sc) => {
            assert(sc.machine == "caller")
            assert(sc.steps.len() == 3)
            assert(sc.steps[0].on == "")
            assert(sc.steps[0].also.len() == 1)
            assert(sc.steps[0].also[0].target == "callee-1")
            assert(sc.steps[0].also[0].expect.has_state)
            assert(sc.steps[0].also[0].expect.state == "Ask")
            assert(sc.steps[1].on == "callee-1")
            assert(sc.steps[1].also[0].target == "parent")
            assert(sc.steps[2].also.len() == 0)
        }
        Err(e) => assert(false)
    }
}

test "np test refused" {
    ro with_bad_also = ok_text().replace("\"also\": {", "\"also\": {\"zzz\": {\"mood\": 1}, ")
    assert(run_text(with_bad_also).contains("mood"))
    ro not_text = ok_text().replace("\"on\": \"callee-1\"", "\"on\": 5")
    assert(run_text(not_text).contains("text"))
}

test "np runs" {
    assert(run_text(ok_text()) == "")
}

test "np difference parent" {
    ro text = ok_text().replace("\"state\": \"Done\"", "\"state\": \"Call\"")
    ro report = run_text(text)
    assert(report.contains("step 3"))
    assert(report.contains("state: expected Call, got Done"))
}

test "np difference nested" {
    // the step acts on the nested machine: `expect` is compared with it
    ro text = ok_text().replace("\"state\": \"Done\"", "\"state\": \"Ask\"")
    ro report = run_text(text)
    assert(report != "")
    assert(report.contains("expected"))
}

test "np difference also" {
    ro text = ok_text().replace("\"state\": \"Ask\"", "\"state\": \"Done\"")
    ro report = run_text(text)
    assert(report.contains("callee-1: step 1"))
    assert(report.contains("expected Done, got Ask"))
}

test "np difference also parent" {
    ro text = ok_text().replace("\"in answer\"", "\"in failure\"")
    ro report = run_text(text)
    assert(report.contains("parent: step 2"))
    assert(report.contains("queue"))
}

test "np no such target" {
    ro text = ok_text().replace("\"callee-1\": {\n          \"state\": \"Ask\"", "\"callee-9\": {\n          \"state\": \"Ask\"")
    assert(text != ok_text())
    ro report = run_text(text)
    assert(report.contains("there is no callee-9"))
}

test "np data difference" {
    ro text = ok_text().replace("\"count\": 3", "\"count\": 4")
    ro report = run_text(text)
    assert(report.contains("data count"))
}

