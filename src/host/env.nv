// env.nv - the world of the reference host and the two environments of the contract (spec section 7a, AL-130).
//
// The class of an external function is told by the TYPE of what it gets from the host:
//   pure      gets no environment (it sees its arguments only);
//   volatile  gets a `ReadEnv`: the methods of reading, none that writes (the field with the world is private to this module);
//   acting    gets a `mut ActEnv`: the methods of reading and of writing.
// `ReadEnv` and `ActEnv` are two different records, not one protocol: a function type that takes a protocol is compared loosely by Oracle 0.1.0
// (a function that wants more than the host gives would compile and fail at run time), a record is compared by its name. The field `w` is `priv`:
// outside this module neither a `ReadEnv` nor an `ActEnv` can be made by a literal or read through the field (the codes
// E_FIELD_MODULE_PRIVATE and E7301, see `scripts/negative-179/`), so only the host gives an environment to an implementation.
//
// What the types do NOT prove (spec 7a): that an implementation does not reach the world behind the environment (a closure that captured a mutable
// value, a global, output, files, clock, network). That is covered by the guard of the imports (`scripts/guards/check-impl-effects.py`), by
// `--strict-effects` (partly) and by the check of the version of the world around every call (`host.nv`).
module alula.host

import alula.machine.{Value, Null}

/// World: the state of the world of the reference host - a store of values by a text key. Every write raises `version`; the host compares the
/// version before and after a call of a pure or a volatile function: a changed version is a broken contract.
export type World { priv keys []str, priv vals []Value, priv version int }

/// An empty world.
export fn new_world() -> World => { keys: []str.new(), vals: []Value.new(), version: 0 }

/// The value of a key, `Null` when there is none.
export fn World @get(key str) -> Value {
    mut i = 0
    for k in @keys {
        if k == key { return @vals[i] }
        i = i + 1
    }
    Null
}

/// Is there a value under the key?
export fn World @has(key str) -> bool {
    for k in @keys {
        if k == key { return true }
    }
    false
}

/// The number of writes made so far.
export fn World @version() -> int => @version

/// Write a value under a key: a known key keeps its place, a new key goes to the end.
export fn World mut @put(key str, v Value) -> () {
    mut i = 0
    for k in @keys {
        if k == key {
            @vals[i] = v
            @version = @version + 1
            return
        }
        i = i + 1
    }
    @keys.push(key)
    @vals.push(v)
    @version = @version + 1
}

/// ReadEnv: what a volatile function sees. There is no method that writes, and the field is private.
export type ReadEnv { priv w World }

/// The value of a key of the world.
export fn ReadEnv @read(key str) -> Value => @w.get(key)

/// Is there a value under the key?
export fn ReadEnv @has(key str) -> bool => @w.has(key)

/// ActEnv: what an acting function sees: the same reading and a write.
export type ActEnv { priv w World }

/// The value of a key of the world.
export fn ActEnv @read(key str) -> Value => @w.get(key)

/// Is there a value under the key?
export fn ActEnv @has(key str) -> bool => @w.has(key)

/// Write a value under a key of the world.
export fn ActEnv mut @write(key str, v Value) -> () {
    @w.put(key, v)
}
