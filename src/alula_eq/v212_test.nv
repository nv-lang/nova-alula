// v212_test.nv - task 125: the program `alula` and the machines of the product on Alula 2.12: every machine file says `format: 2.12`, every JSON is what `compile` makes of its file, a file of 2.11
// is refused with a message that names 2.12, the circles `compile -> render -> compile` and `convert ru -> en -> ru` give an equal tree with the line of connection of the fragment "Pause".
module alula.alula_eq

import std.text
import alula.machine.{NamedText, text_of_file}
import alula.examples.{machine_files, table_files}

test "v212 json files say 2.22" {
    for f in machine_files() {
        assert(f.text.contains("\"alula_version\":\"2.22\"") || f.text.contains("\"alula_version\": \"2.22\""))
    }
}
