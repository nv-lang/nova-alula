// nested_test.nv - task 119: the circles of the program `alula` on the machines of the nested machines (the parent `caller`, the callee, the set parent `fan`, the chat session `dialog_steps`): `compile` -> `render` -> `compile`
// gives an equal JSON in Russian and in English, `convert` ru -> en -> ru gives an equal JSON, and `check` passes them (the words of the party kind `machine`, `Signal`, `State`, the profile, `Предел запросов`).
module alula.alula_eq

import std.text
import alula.machine.{text_of_file}
import alula.examples.{machine_files, table_files}

test "pn circle callee ru" { assert(circle("callee.alula.json", "ru") == "") }

test "pn circle callee en" { assert(circle("callee.alula.json", "en") == "") }

test "pn circle caller ru" { assert(circle("caller.alula.json", "ru") == "") }

test "pn circle caller en" { assert(circle("caller.alula.json", "en") == "") }

test "pn circle fan ru" { assert(circle("fan.alula.json", "ru") == "") }

test "pn circle fan en" { assert(circle("fan.alula.json", "en") == "") }

test "pn convert callee" { assert(convert_circle("callee.alula.json") == "") }

test "pn convert caller" { assert(convert_circle("caller.alula.json") == "") }

test "pn convert fan" { assert(convert_circle("fan.alula.json") == "") }
