// circle_test.nv - task 116: the circles of the program `alula` on the machines of the product (the chat, the agent step, the five small ones): `compile` -> `render` -> `compile` gives an
// equal JSON in Russian and in English, and `convert` ru -> en -> ru gives an equal JSON; the commands give what the functions of the translator give.
module alula.alula_eq

import std.fs.{Path}
import std.text
import alula.machine.{NamedText}
import alula.machine_text.{translate_checked, render, render_summary}

// A circle through the program: the JSON of the machine -> `render` in the language -> `compile` of the file it wrote. "" when the second tree equals the first, else why not.
fn circle(name str, language str) -> str {
    ro json = machine_json(name)
    ro rendered = run_with(["render", "/m/a.alula.json", "--language", language], one("/m/a.alula.json", json))
    if rendered.code != 0 { return "render ${name}: ${rendered.err}" }
    ro back = run_with(["compile", "/m/b.alula.md"], one("/m/b.alula.md", rendered.out))
    if back.code != 0 { return "compile ${name}: ${back.err}" }
    same_tree(json, back.out)
}

// ru -> en -> ru through `convert`, then `compile`: the tree of the machine again. The first file is the machine rendered in Russian.
fn convert_circle(name str) -> str {
    ro json = machine_json(name)
    ro russian = run_with(["render", "/m/a.alula.json"], one("/m/a.alula.json", json))
    if russian.code != 0 { return "render ${name}: ${russian.err}" }
    ro english = run_with(["convert", "/m/b.alula.md", "--language", "en"], one("/m/b.alula.md", russian.out))
    if english.code != 0 { return "convert en ${name}: ${english.err}" }
    if !english.out.contains("- language: en\n") { return "the English file of ${name} has no language line" }
    ro again = run_with(["convert", "/m/c.alula.md", "--language", "ru"], one("/m/c.alula.md", english.out))
    if again.code != 0 { return "convert ru ${name}: ${again.err}" }
    ro back = run_with(["compile", "/m/d.alula.md"], one("/m/d.alula.md", again.out))
    if back.code != 0 { return "compile ${name}: ${back.err}" }
    same_tree(json, back.out)
}

test "pe circle calc ru" { assert(circle("calc.alula.json", "ru") == "") }

test "pe circle calc en" { assert(circle("calc.alula.json", "en") == "") }

test "pe circle gate ru" { assert(circle("gate.alula.json", "ru") == "") }

test "pe circle gate en" { assert(circle("gate.alula.json", "en") == "") }

test "pe circle lenses ru" { assert(circle("lenses.alula.json", "ru") == "") }

test "pe circle lenses en" { assert(circle("lenses.alula.json", "en") == "") }

test "pe circle variants ru" { assert(circle("variants.alula.json", "ru") == "") }

test "pe circle variants en" { assert(circle("variants.alula.json", "en") == "") }

test "pe circle actions ru" { assert(circle("actions.alula.json", "ru") == "") }

test "pe circle actions en" { assert(circle("actions.alula.json", "en") == "") }

test "pe convert calc" { assert(convert_circle("calc.alula.json") == "") }

test "pe convert gate" { assert(convert_circle("gate.alula.json") == "") }

test "pe convert lenses" { assert(convert_circle("lenses.alula.json") == "") }

test "pe convert variants" { assert(convert_circle("variants.alula.json") == "") }

test "pe convert actions" { assert(convert_circle("actions.alula.json") == "") }

test "pe render is the function" {
    ro json = machine_json("calc.alula.json")
    for language in ["ru", "en"] {
        ro ran = run_with(["render", "/m/calc.alula.json", "--language", language], one("/m/calc.alula.json", json))
        assert(ran.code == 0)
        assert(ran.out == render(json, language))
    }
}
