// v213_test.nv - task 149: the machines of the product are written at Alula 2.13 (format 2.14): the keys `Запрос:` and `Читает:`, `сигнал(…)`, the column `сигналы`, ASCII signs, the JSON names in brackets,
// no section of the expansion of a fragment; every JSON is what `compile` makes of its file; the circles `compile -> render -> compile` and `convert ru -> en -> ru` give an equal tree in both languages,
// the line of connection of the fragment has the parameter `сигнал_остановки`.
module alula.alula_eq

import std.text
import alula.machine.{text_of_file}
import alula.examples.{machine_files, table_files}

test "v213 trees hold signals" {
    for f in machine_files() {
        assert(!f.text.contains("\"words\""))
        assert(!f.text.contains("\"kind\":\"word\""))
        assert(!f.text.contains("\"kind\": \"word\""))
    }
}
