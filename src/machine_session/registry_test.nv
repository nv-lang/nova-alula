// registry_test.nv - the registry of the machines a caller may call (the agent step and the session start; the runner of task 123 calls the second), the pair "session start + agent step" checked
// by `check_registry`, and the five primitives of the table in the registry of the host (`standard_registry()`): their classes, parameters and results, and the types of `session_types()`
// that their signatures use. The host of the tests is the `ScriptedHost`; there is no real executor.
module alula.machine_session

import std.text
import alula.machine.{standard_registry, standard_types, session_types, find_primitive, class_word, spec_text, check_call_args, check_call_result, Value, Int, Text, Bool, Null, List, make_variant, make_record, RecordField, TypeDefs, check_value, RecordType, VariantType}
import alula.machine_run.{NestedRegistry, check_registry, product_registry}
import alula.machine_table.{load_machine, check_nested}
import alula.machine.{cycle_check_machine_text}

fn class_of(name str) -> str {
    match find_primitive(standard_registry(), name) {
        Some(p) => class_word(p.class)
        None => ""
    }
}

fn rtext(s str) -> Value => Text(s)

fn field(name str, v Value) -> RecordField => { name, value: v }

fn finding(severity str, level str) -> Value {
    make_record("Finding", [field("severity", make_variant("Severity", severity, []RecordField.new())), field("level", make_variant("Level", level, []RecordField.new())), field("evidence", Text("e"))])
}

fn summary(essential int, probes int) -> Value => make_record("Summary", [field("essential", Int(essential)), field("probes", Int(probes))])

fn parsing(result str, with_summary bool) -> Value {
    make_record("SessionParsing", [
        field("result", make_variant("SessionResult", result, []RecordField.new())),
        field("summary", if with_summary { summary(1, 3) } else { Null }),
        field("findings", if with_summary { List([finding("Essential", "Plan")]) } else { Null })
    ])
}

test "rg the registry has the two machines" {
    ro reg = registry()
    assert(reg.entries.len() == 3)
    assert(reg.find("agent_step").is_some())
    assert(reg.find("session_start").is_some())
    assert(reg.find("meeting").is_none())
    assert(reg.entries[0].name == "agent_step")
    assert(reg.entries[1].name == "session_start")
}

test "rg the registry machines are the machines of the files" {
    ro reg = registry()
    match reg.find("session_start") {
        Some(m) => {
            assert(m.name() == "session_start")
            assert(m.def.states.len() == 10)
        }
        None => assert(false)
    }
    match reg.find("agent_step") {
        Some(m) => {
            assert(m.name() == "agent_step")
            assert(m.def.states.len() == 14)
        }
        None => assert(false)
    }
}

test "rg the pair fits" {
    ro problems = check_registry(session_machine(), registry())
    assert(problems.len() == 0)
}

test "rg the pair does not fit an empty registry" {
    ro problems = check_registry(session_machine(), NestedRegistry.empty())
    assert(problems.len() == 1)
    assert(problems[0].contains("agent_step"))
    assert(problems[0].contains("not in the registry"))
}

test "rg the session start calls one level only" {
    // the agent step calls nothing; the session start calls the agent step: a caller of the session start (the runner) needs the runner of the pairs to be recursive (task 123)
    ro agent = registry().find("agent_step") ?? panic("no agent step")
    assert(check_registry(agent, registry()).len() == 0)
    mut calls = 0
    for p in session_def().parties {
        if p.nested != "" { calls += 1 }
    }
    assert(calls == 1)
}

test "rg the five primitives are registered" {
    assert(class_of("launch_scope") == "reading")
    assert(class_of("launch_profile") == "reading")
    assert(class_of("session_context") == "reading")
    assert(class_of("parse_session_artifact") == "reading")
    assert(class_of("stop_agent_group") == "irreversible")
    assert(standard_registry().primitives.len() == 56)
}

test "rg the signatures" {
    match find_primitive(standard_registry(), "launch_scope") {
        Some(p) => {
            assert(p.params.len() == 0)
            assert(spec_text(p.result) == "LaunchScope")
        }
        None => assert(false)
    }
    match find_primitive(standard_registry(), "launch_profile") {
        Some(p) => {
            assert(p.params.len() == 1 && p.params[0].name == "session")
            assert(spec_text(p.result) == "AgentProfile")
        }
        None => assert(false)
    }
    match find_primitive(standard_registry(), "session_context") {
        Some(p) => {
            assert(p.params.len() == 9)
            assert(p.params[0].name == "session" && p.params[2].name == "launch_pass" && p.params[8].name == "delivery_short")
            assert(spec_text(p.params[2].spec) == "?int")
            assert(spec_text(p.params[7].spec) == "?text")
            assert(spec_text(p.params[8].spec) == "bool")
            assert(spec_text(p.result) == "text")
        }
        None => assert(false)
    }
    match find_primitive(standard_registry(), "parse_session_artifact") {
        Some(p) => {
            assert(p.params.len() == 2 && p.params[0].name == "session" && p.params[1].name == "reply")
            assert(spec_text(p.params[1].spec) == "AgentReply")
            assert(spec_text(p.result) == "SessionParsing")
        }
        None => assert(false)
    }
    match find_primitive(standard_registry(), "stop_agent_group") {
        Some(p) => {
            assert(p.params.len() == 0)
            assert(spec_text(p.result) == "nothing")
        }
        None => assert(false)
    }
}

test "rg the hidden reads are objects" {
    for name in ["launch_scope", "launch_profile", "session_context", "parse_session_artifact"] {
        match find_primitive(standard_registry(), name) {
            Some(p) => {
                assert(p.reads.len() == 1)
                assert(p.reads[0].starts_with("objects: ") || p.reads[0].starts_with("service store: "))
                assert(p.writes.len() == 0)
            }
            None => assert(false)
        }
    }
}

test "rg the arguments of the primitives" {
    ro reg = standard_registry()
    ro defs = session_types()
    assert(check_call_args(reg, defs, "launch_scope", []Value.new()).is_ok())
    assert(check_call_args(reg, defs, "launch_scope", [Int(1)]).is_err())
    assert(check_call_args(reg, defs, "launch_profile", [rtext("s1")]).is_ok())
    assert(check_call_args(reg, defs, "launch_profile", [Int(1)]).is_err())
    ro nine = [rtext("s1"), rtext(""), Null, rtext("files"), rtext("/t"), rtext("/r"), rtext("full"), Null, Bool(false)]
    assert(check_call_args(reg, defs, "session_context", nine).is_ok())
    assert(check_call_args(reg, defs, "session_context", [rtext("s1")]).is_err())
    assert(check_call_args(reg, defs, "stop_agent_group", []Value.new()).is_ok())
}

test "rg the results of the primitives" {
    ro reg = standard_registry()
    ro defs = session_types()
    assert(check_call_result(reg, defs, "launch_scope", make_variant("LaunchScope", "Fits", []RecordField.new())).is_ok())
    assert(check_call_result(reg, defs, "launch_scope", make_variant("LaunchScope", "DoesNotFit", []RecordField.new())).is_ok())
    assert(check_call_result(reg, defs, "launch_scope", make_variant("LaunchScope", "Maybe", []RecordField.new())).is_err())
    assert(check_call_result(reg, defs, "parse_session_artifact", parsing("Done", false)).is_ok())
    assert(check_call_result(reg, defs, "parse_session_artifact", parsing("Question", true)).is_ok())
    assert(check_call_result(reg, defs, "parse_session_artifact", parsing("Nowhere", false)).is_err())
    assert(check_call_result(reg, defs, "session_context", rtext("the prompt")).is_ok())
    assert(check_call_result(reg, defs, "session_context", Int(1)).is_err())
}

test "rg the types of the session" {
    ro defs = session_types()
    assert(check_value(RecordType("Summary"), summary(0, 0), defs).is_ok())
    assert(check_value(RecordType("Summary"), summary(-1, 0), defs).is_err())
    assert(check_value(RecordType("Finding"), finding("Essential", "OutOfScope"), defs).is_ok())
    assert(check_value(RecordType("Finding"), finding("Critical", "Plan"), defs).is_err())
    assert(check_value(VariantType("SessionResult"), make_variant("SessionResult", "Revision", []RecordField.new()), defs).is_ok())
    assert(check_value(VariantType("Level"), make_variant("Level", "Delivery", []RecordField.new()), defs).is_ok())
}

test "rg the meeting types stay as they were" {
    // the meeting keeps its own Finding (critical, significant, desirable) and Summary (critical, probes): the session types are another set
    ro meeting = standard_types()
    assert(check_value(RecordType("Summary"), make_record("Summary", [field("critical", Int(1)), field("probes", Int(2))]), meeting).is_ok())
    assert(check_value(RecordType("Summary"), summary(1, 2), meeting).is_err())
}

test "rg the cycle check calls this machine with the types it takes" {
    // the cycle check (task 122) is the second caller of the session start: its party `запуск_сессии` has the record of the input of ten fields and the result of three
    ro cycle = match load_machine(cycle_check_machine_text(), standard_registry()) {
        Ok(d) => d
        Err(issues) => panic("the cycle check does not load: ${issues[0].message}")
    }
    ro problems = check_nested(cycle, "session_start", session_def())
    if problems.len() > 0 { panic("PROBLEM ${problems[0].path} ${problems[0].message}") }
    assert(problems.len() == 0)
}
