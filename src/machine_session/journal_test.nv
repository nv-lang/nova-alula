// journal_test.nv - AC-3: the codes of the journal of the machine "Session start" and their parameters are exactly those of the table of the journal of the methodology
// (state-machine-journal.md, section 2: the rows of the machine "сессия", the rows of the engine for the pause, and the events of the format): the table is copied here as data.
// Static: the codes that the table writes. Dynamic: the codes that the scenarios see.
module alula.machine_session

// ORACLE-WORKAROUND(32): `import std.text` is needed in `nova build` for `[]str.join` (a `nova test` build has it already); drop the import when item 32 is fixed
import std.text
import alula.machine.{journal_union, journal_find}
import alula.machine_table.{MachineDef, Action, JournalAct, MachineErrorAct, IfAct, ForEachAct, LetAct, NamedExpr}

// code, parameters (names, in the order of the table of the methodology)
type JCode { code str, params []str }

fn jc(code str, params []str) -> JCode => { code, params }

// The three codes of the machine "сессия" in the table of the methodology.
fn session_codes() -> []JCode => [
    jc("session_not_finished", ["session", "reason"]), jc("session_launch_stopped", ["reason"]), jc("session_result", ["session", "outcome"])
]

// The codes of the pause (the engine, rule 23) and the common one of the forks.
fn pause_codes() -> []JCode => [
    jc("human_stop", ["author", "source", "event"]), jc("pause_by_parent_stop", ["request", "event"]),
    jc("cancel_discarded_foreign_request", ["request", "event"]), jc("cancel_discarded_already_replied", ["request", "event"]),
    jc("request_cancelled", ["request", "event"]), jc("cancel_parse_no_match", []),
    jc("human_continue", ["previous", "author", "source", "event"]), jc("parent_continue", ["previous", "request", "event"])
]

// The events of the format (`input_rejected` has optional parameters and is checked apart); `fork_no_match` is the common code of the forks of five machines.
fn format_codes() -> []JCode => [jc("machine_data", ["data"]), jc("machine_error", ["reason"]), jc("fork_no_match", ["fork"])]

fn all_codes() -> []JCode {
    mut out = []JCode.new()
    for c in session_codes() { out.push(c) }
    for c in pause_codes() { out.push(c) }
    for c in format_codes() { out.push(c) }
    out
}

// What the interpreter itself writes (the executor discards and journals, rule 17; a defect) and what the product adds to the table of the methodology (task 119): not codes of a machine.
fn executor_notes() -> []str => ["event_ignored", "event_unknown", "event_malformed", "machine_defect", "input_rejected", "signal_passed", "signal_ordered", "request_repeated", "answer_held", "answer_replayed", "answer_edited", "form_returned"]

fn engine_codes() -> []str => [
    "machine_started", "event_accepted", "reply_discarded", "request_ordered", "request_sent", "request_closed", "cancel_ordered", "cancel_sent",
    "cancel_without_request", "snapshot_ordered", "machine_finished", "engine_resumed"
]

fn never_seen() -> []str => ["fork_no_match", "cancel_parse_no_match", "machine_data", "machine_error"]

fn find_code(code str) -> Option[JCode] {
    for c in all_codes() {
        if c.code == code { return Some(c) }
    }
    None
}

fn names_text(names []str) -> str => names.join(",")

fn param_names(params []NamedExpr) -> []str {
    mut out = []str.new()
    for p in params { out.push(p.name) }
    out
}

// The journal actions of a list of actions: "code|name,name", the nested ones too.
fn journal_of_actions(actions []Action, mut out []str) -> () {
    for a in actions {
        match a {
            JournalAct { code, params } => out.push("${code}|${names_text(param_names(params))}")
            MachineErrorAct { code, params } => out.push("${code}|${names_text(param_names(params))}")
            IfAct { cond, then_actions, else_actions } => {
                journal_of_actions(then_actions, out)
                journal_of_actions(else_actions, out)
            }
            ForEachAct { var, list, body } => journal_of_actions(body, out)
            LetAct { name, value, body } => journal_of_actions(body, out)
            _ => ()
        }
    }
}

fn written_codes(def MachineDef) -> []str {
    mut out = []str.new()
    for st in def.states {
        journal_of_actions(st.entry, out)
        for r in st.rows { journal_of_actions(r.actions, out) }
        for a in st.accept { journal_of_actions(a.actions, out) }
    }
    for r in def.common { journal_of_actions(r.actions, out) }
    out
}

fn is_written(written []str, code str) -> bool {
    for w in written {
        if w.starts_with("${code}|") { return true }
    }
    false
}

test "jn static codes" {
    ro written = written_codes(session_def())
    for w in written {
        ro at = w.find("|") ?? 0
        ro code = w[..at]
        ro names = w[(at + 1)..]
        match find_code(code) {
            Some(c) => {
                if names != names_text(c.params) { panic("the code ${code} has the parameters [${names}], the table of the methodology has [${names_text(c.params)}]") }
            }
            None => panic("the code ${code} is not in the table of the journal of the methodology")
        }
    }
    // every code of the machine in the table of the methodology is written by name, and so is every code of the pause (the table of the engine); machine_data is `журнал(все_данные)`
    for c in session_codes() {
        if !is_written(written, c.code) { panic("the table of the methodology has the code ${c.code}, the machine does not write it") }
    }
    for c in pause_codes() {
        if !is_written(written, c.code) { panic("the pause has the code ${c.code}, the machine does not write it") }
    }
    // the fork Scope proves its exhaustion by the type and has no row `else`: no table writes the common code of the forks, the interpreter does
    assert(!is_written(written, "fork_no_match"))
}

test "jn the session codes keep their parameters" {
    ro written = written_codes(session_def())
    assert(is_written(written, "session_not_finished"))
    assert(is_written(written, "session_launch_stopped"))
    assert(is_written(written, "session_result"))
    mut found = 0
    for w in written {
        if w == "session_not_finished|session,reason" { found += 1 }
        if w == "session_launch_stopped|reason" { found += 1 }
        if w == "session_result|session,outcome" { found += 1 }
    }
    assert(found == 3)
}

test "jn dynamic codes" {
    ro c = sctx()
    mut seen = []str.new()
    mut reasons = []str.new()
    mut outcomes = []str.new()
    for f in session_scenarios() {
        for t in run_file(c, f).traces {
            for e in t.entries {
                ro code = e.event.code
                if engine_codes().contains(code) { continue }
                if !seen.contains(code) { seen.push(code) }
                if code == "input_rejected" {
                    // the optional parameters: reason, and the field when it applies
                    assert(e.event.params.len() == 2)
                    assert(e.event.params[0].name == "reason")
                    assert(e.event.params[1].name == "field")
                }
                if code == "session_not_finished" {
                    for p in e.event.params {
                        if p.name == "reason" && !reasons.contains(p.value) { reasons.push(p.value) }
                    }
                }
                if code == "session_result" {
                    for p in e.event.params {
                        if p.name == "outcome" && !outcomes.contains(p.value) { outcomes.push(p.value) }
                    }
                }
                if executor_notes().contains(code) { continue }
                mut names = []str.new()
                for p in e.event.params { names.push(p.name) }
                match find_code(code) {
                    Some(jc) => {
                        if names_text(names) != names_text(jc.params) { panic("${f.name}: the code ${code} has the parameters [${names_text(names)}], the table has [${names_text(jc.params)}]") }
                    }
                    None => panic("${f.name}: the code ${code} is not in the table of the journal of the methodology")
                }
            }
        }
    }
    // the codes the scenarios do not see: the two of the defensive rows and the two of the end ERRORED (`machine_data`, `machine_error`; errored_test.nv runs a changed table into it)
    for jc in all_codes() {
        if !seen.contains(jc.code) && !never_seen().contains(jc.code) { panic("no scenario writes the code ${jc.code}") }
    }
    for n in never_seen() { assert(!seen.contains(n)) }
    // the values of the parameters: words of the code, not sentences. The reason of `session_not_finished` is a word of the code of the failure, the outcome is a word of the result of the session
    for r in reasons {
        assert(["no_result", "model_refused", "connection_lost", "form_not_fixed", "timeout", "stopped_by_human", "ceiling_reached", "cancelled", "max_tokens", "max_turn_requests"].contains(r))
    }
    for o in outcomes { assert(["done", "revision", "plan", "requirements", "question"].contains(o)) }
    assert(reasons.len() >= 3)
    assert(outcomes.len() >= 4)
}

test "jn counts" {
    assert(session_codes().len() == 3)
    assert(all_codes().len() == 14)
}

// The codes against the union of the table of the methodology and the table of the product (format 5, 2.12, AL-31): the machine writes only codes of the union, with the parameters of the row.
test "jn union static" {
    for w in written_codes(session_def()) {
        ro at = w.find("|") ?? 0
        ro code = w[..at]
        mut names = []str.new()
        if at + 1 < w.byte_len() {
            for piece in w[(at + 1)..].split(",") { names.push(piece) }
        }
        match journal_find(journal_union(), code) {
            Some(row) => {
                for n in row.params { if !names.contains(n) { panic("the code ${code} lacks ${n} of the union") } }
                for n in names { if n != "" && !row.params.contains(n) && !row.optional.contains(n) { panic("the code ${code} has ${n}, the union has not") } }
            }
            None => panic("the code ${code} is in neither table")
        }
    }
}

test "jn union dynamic" {
    ro c = sctx()
    for f in session_scenarios() {
        for t in run_file(c, f).traces {
            for e in t.entries {
                match journal_find(journal_union(), e.event.code) {
                    Some(row) => {
                        for n in row.params {
                            mut found = false
                            for p in e.event.params { if p.name == n { found = true } }
                            if !found { panic("${f.name}: the code ${e.event.code} lacks ${n}") }
                        }
                    }
                    None => panic("${f.name}: the code ${e.event.code} is in neither table")
                }
            }
        }
    }
}
