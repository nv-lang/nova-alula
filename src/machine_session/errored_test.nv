// errored_test.nv - the end ERRORED of the table "Session start". No sequence of events enters it (it is entered through `machine_error`, whose two ways in the table are the row `else` of the fork
// Scope and the row 6 of the common events, and both are covered by the conditions before them), so the proof runs a table changed on purpose: the two conditions of the fork are made false,
// the fork finds no row, writes `fork_no_match` and goes to the end ERRORED. The end stops the group of the processes of the agent, writes the transition and all the data, and answers
// with a refusal `NoResult` whose text is the transition.
module alula.machine_session

import std.text
import alula.machine.{standard_registry, session_start_table_text}
import alula.machine_text.{translate_checked}
import alula.machine_run.{AlulaMachine, load_alula_machine, parse_scenario, run_scenario, run_ok, report_text, drive_scenario, StepTrace}

fn broken_text() -> str {
    session_start_table_text()
        .replace("| 1 | объём == ОбъёмЗапуска.Помещается | — | СЕССИЯ |", "| 1 | ложь | — | СЕССИЯ |")
        .replace("| 2 | объём == ОбъёмЗапуска.НеПомещается | — | В1 |", "| 2 | ложь | — | В1 |")
}

fn broken_machine() -> AlulaMachine {
    ro report = translate_checked(broken_text(), standard_registry())
    if report.errors.len() > 0 { panic("the changed table does not translate: ${report.errors[0].message}") }
    match load_alula_machine(report.json, standard_registry()) {
        Ok(m) => m
        Err(e) => panic("the changed table is not made: ${e}")
    }
}

fn start_input() -> str => `{"session":"s1","task_dir":"/t","repo_dir":"/r","delivery_mode":"files","route":"full","delivery_short":false}`

fn broken_scenario() -> str => `{
  "format": "scenario/0", "machine": "session_start", "name": "the fork finds no row", "start_at": 1000,
  "steps": [
    { "do": "feed", "event": { "kind": "start", "request": "up-1", "input": ${start_input()} } },
    { "do": "feed", "host": { "launch_scope": { "$variant": "LaunchScope", "name": "Fits", "fields": {} }, "stop_agent_group": null },
      "event": { "kind": "word", "name": "confirm" },
      "expect": { "state": "Errored", "outcome": "refusal:NoResult", "open": [] } }
  ]
}`

test "er the changed table is a table" {
    ro text = broken_text()
    assert(text.contains("| 1 | ложь | — | СЕССИЯ |"))
    assert(text.contains("| 2 | ложь | — | В1 |"))
    assert(!text.contains("ОбъёмЗапуска.Помещается |"))
}

test "er the fork with no row ends in the error" {
    ro sc = match parse_scenario(broken_scenario()) {
        Ok(s) => s
        Err(e) => panic("${e.path}: ${e.message}")
    }
    ro run = run_scenario(broken_machine(), sc)
    if !run_ok(run) { panic(report_text(run)) }
    assert(run.traces.len() == 2)
    assert(run.traces[1].state == "Errored")
}

test "er the end writes the transition and the data" {
    ro sc = match parse_scenario(broken_scenario()) {
        Ok(s) => s
        Err(e) => panic("${e.path}: ${e.message}")
    }
    ro run = run_scenario(broken_machine(), sc)
    mut codes = []str.new()
    for e in run.traces[1].entries { codes.push(e.event.code) }
    // the fork writes its code, the end writes the transition (the same line again) and all the data
    assert(codes.contains("fork_no_match"))
    assert(codes.contains("machine_data"))
    mut forks = 0
    for c in codes {
        if c == "fork_no_match" { forks += 1 }
    }
    assert(forks == 2)
    mut data = ""
    for e in run.traces[1].entries {
        if e.event.code == "machine_data" {
            for p in e.event.params { data = p.value }
        }
    }
    assert(data.starts_with("previous=none; call_request_id=up-1; open_requests=[]; session=s1; launch_source=; launch_pass=none;"))
    assert(data.contains("; step_attempt=0; gatekeeper_attempt=0; enhanced_attempt=0; summary={}; findings={}; task_dir=/t; repo_dir=/r; delivery_mode=files"))
    assert(data.contains("; stop_reason=;"))
}
