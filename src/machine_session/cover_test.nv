// cover_test.nv - every row of the table "Session start" has a scenario: the rows that the scenarios `session-*` took (the mark `taken` of the state of the parent after every step) are compared with
// the rows of the machine; a row that no scenario takes is red. The rows no sequence of events can take are named here with the reason; the end ERRORED is taken by a table changed on purpose
// (test "cv the end errored").
module alula.machine_session

import std.text
import std.encoding.json.{Json}
import alula.machine.{NamedText}
import alula.machine_run.{StepTrace, run_ok, report_text}

// The rows that no event can take: the row 6 of the common events (the three conditions before it cover every request id) and the end Errored (it is entered only through `machine_error`,
// whose only way in the table is that row; the fork Scope has no row `else`, its two rows name both values of the type).
fn dead_rows() -> []str => ["common#6", "end:Errored#1"]

// The rows taken after a step, from the encoded state of the parent.
fn taken_of(encoded str) -> []str {
    mut out = []str.new()
    match Json.parse(encoded) {
        Ok(j) => match j.object() {
            Some(o) => match o.get("taken") {
                Some(t) => match t.array() {
                    Some(items) => {
                        for item in items {
                            match item.str() {
                                Some(s) => out.push(s)
                                None => ()
                            }
                        }
                    }
                    None => ()
                }
                None => ()
            }
            None => ()
        }
        Err(e) => ()
    }
    out
}

/// FileTaken: a scenario file and the rows its parent took.
type FileTaken { name str, ok bool, report str, rows []str }

fn rows_of(traces []StepTrace) -> []str {
    mut out = []str.new()
    for t in traces {
        for r in taken_of(t.encoded) {
            if !out.contains(r) { out.push(r) }
        }
    }
    out
}

// Every scenario run once; the machine is made once (building it checks the whole table).
fn all_taken() -> []FileTaken {
    ro c = sctx()
    mut out = []FileTaken.new()
    for f in session_scenarios() {
        ro run = run_file(c, f)
        out.push(FileTaken { name: f.name, ok: run_ok(run), report: report_text(run), rows: rows_of(run.traces) })
    }
    out
}

// The name of the state in the name of a scenario file: `session-gate2-1`, `session-end-halted-3`.
fn state_word(name str) -> str {
    if name == "Gate2" { return "gate2" }
    if name == "Scope" { return "scope" }
    if name == "Gate1" { return "gate1" }
    if name == "Session" { return "session" }
    if name == "ResultParsing" { return "result-parsing" }
    if name == "Gate13Session" { return "gate13" }
    if name == "Pause" { return "pause" }
    if name == "common" { return "common" }
    if name == "End" { return "end-end" }
    if name == "Halted" { return "end-halted" }
    if name == "Errored" { return "end-errored" }
    panic("a state without a word for the file: ${name}")
}

fn file_of_row(row str) -> str {
    ro body = row.replace("end:", "")
    match body.find("#") {
        Some(at) => "session-${state_word(body[..at])}-${body[(at + 1)..]}.scenario.test.json"
        None => panic("a row without a number: ${row}")
    }
}

test "cv rows counted" {
    ro rows = all_rows(session_def())
    assert(rows.len() == 25)
    for dead in dead_rows() { assert(rows.contains(dead)) }
}

test "cv dead rows are the defensive ones" {
    ro def = session_def()
    assert(state_named(def, "Scope").rows.len() == 2)
    assert(def.common[5].n == 6)
    assert(def.common[5].actions.len() == 1)
    assert(def.end_rows[1].state == "Errored")
}

test "cv every row has a file" {
    ro def = session_def()
    mut have = []str.new()
    for f in session_scenarios() { have.push(f.name) }
    for row in all_rows(def) {
        if dead_rows().contains(row) { continue }
        if !have.contains(file_of_row(row)) { panic("no scenario file for the row ${row}: ${file_of_row(row)}") }
    }
    assert(have.len() >= 40)
}

test "cv scenarios agree and take every row" {
    ro runs = all_taken()
    assert(runs.len() >= 40)
    mut covered = []str.new()
    for fr in runs {
        if !fr.ok { panic("${fr.name}: ${fr.report}") }
        for r in fr.rows {
            if !covered.contains(r) { covered.push(r) }
        }
    }
    ro expected = dead_rows()
    for row in all_rows(session_def()) {
        if !covered.contains(row) && !expected.contains(row) { panic("no scenario takes the row ${row}") }
    }
    for row in expected {
        if covered.contains(row) { panic("the row ${row} is said to be dead but a scenario takes it") }
    }
    // the scenario named after a row takes that row
    for row in all_rows(session_def()) {
        if expected.contains(row) { continue }
        ro file = file_of_row(row)
        mut found = false
        for fr in runs {
            if fr.name == file {
                found = true
                if !fr.rows.contains(row) { panic("the scenario ${file} does not take the row ${row}") }
            }
        }
        if !found { panic("no scenario file for the row ${row}: ${file}") }
    }
}
