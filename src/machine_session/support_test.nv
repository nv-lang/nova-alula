// support_test.nv - helpers of the proofs of the machine "Session start" (task 121): the machine as the tree and as the interpreter holds it, the registry of the machines a caller may call
// (the agent step and the session start), and the scenarios `session-*` run together with their nested machine. A load of the table costs about 0.3 s, so a test loads once and asks.
module alula.machine_session

import std.text
import alula.machine.{standard_registry, scenario_files, session_start_machine_text, NamedText}
import alula.machine_table.{MachineDef, load_machine, StateDef, TableRow}
import alula.machine_run.{AlulaMachine, NestedRegistry, product_registry, load_alula_machine, parse_scenario, run_nested_scenario, drive_nested_scenario, Scenario, ScenarioRun, NestedStepTrace}

/// The tree of the machine as the checks read it.
fn session_def() -> MachineDef {
    match load_machine(session_start_machine_text(), standard_registry()) {
        Ok(d) => d
        Err(issues) => panic("the session start does not load: ${issues[0].path}: ${issues[0].message}")
    }
}

/// The machine as the interpreter holds it (building it checks the whole table once more).
fn session_machine() -> AlulaMachine {
    match load_alula_machine(session_start_machine_text(), standard_registry()) {
        Ok(m) => m
        Err(e) => panic("the session start is not made: ${e}")
    }
}

/// The registry of the machines a caller may call.
fn registry() -> NestedRegistry => product_registry()

/// The state of the machine by its JSON name.
fn state_named(def MachineDef, name str) -> StateDef {
    for st in def.states {
        if st.name == name { return st }
    }
    panic("the machine has no state ${name}")
}

/// The scenarios of the machine: the files `session-*`.
fn session_scenarios() -> []NamedText {
    mut out = []NamedText.new()
    for f in scenario_files() {
        if f.name.starts_with("session-") { out.push(f) }
    }
    out
}

fn scenario_of(file NamedText) -> Scenario {
    match parse_scenario(file.text) {
        Ok(sc) => sc
        Err(e) => panic("the scenario ${file.name} does not parse: ${e.path}: ${e.message}")
    }
}

/// SessCtx: the machine and the registry of its nested machines, loaded once by a test (a load costs more than a run of a scenario).
type SessCtx { m AlulaMachine, reg NestedRegistry }

fn sctx() -> SessCtx => { m: session_machine(), reg: registry() }

/// A scenario run together with the nested machine it calls.
fn run_file(c SessCtx, file NamedText) -> ScenarioRun {
    run_nested_scenario(c.m, c.reg, scenario_of(file))
}

/// The traces of every step of a scenario file (the parent and the nested machines).
fn traces_of(c SessCtx, file NamedText) -> []NestedStepTrace {
    drive_nested_scenario(c.m, c.reg, scenario_of(file))
}

/// The number of the scenario files whose name starts with the prefix (they are all run by the test "cv scenarios agree and take every row").
fn count_group(prefix str) -> int {
    mut n = 0
    for f in session_scenarios() {
        if f.name.starts_with(prefix) { n += 1 }
    }
    n
}

/// The rows of the machine as marks: `State#n`, `common#n`, `end:State#n`.
fn all_rows(def MachineDef) -> []str {
    mut out = []str.new()
    for st in def.states {
        for r in st.rows { out.push("${st.name}#${r.n}") }
    }
    for r in def.common { out.push("common#${r.n}") }
    for er in def.end_rows { out.push("end:${er.state}#${er.n}") }
    out
}
