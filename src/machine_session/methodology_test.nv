// methodology_test.nv - AC-3: the table "Session start" equals the hand-written automaton of the methodology (`task-runner-session-automaton.md`, the function `step` and the table
// "end -> reply"). The automaton is pseudocode that was never compiled, so it cannot be run; its branches are copied here as data (the state, the number of the row, the event, where it
// leads, whether the stop reason is written) and compared with the rows of the table, and the table "end -> reply" is compared with what the runs of the scenarios answer.
module alula.machine_session

import std.text
import alula.machine_table.{MachineDef, TableRow, SignalEv, AnswerEv, FailureEv, NowEv, AssignAct, ToState}
import alula.machine.{spec_text}

/// AutoBranch: a branch of the function `step` of the automaton: `// STATE #n`, the event, where it goes, whether it is a rerun, the stop reason it writes ("" when none).
type AutoBranch { state str, n int, event str, target str, rerun bool, stop str }

fn br(state str, n int, event str, target str, rerun bool, stop str) -> AutoBranch => { state, n, event, target, rerun, stop }

// task-runner-session-automaton.md, "Переходы" (the branch `_ => NotAwaited` of every state is the discard of a foreign event, not a row).
fn automaton() -> []AutoBranch => [
    br("Gate2", 1, "signal:confirm", "Scope", false, ""),
    br("Scope", 1, "cond:fits", "Session", false, ""),
    br("Scope", 2, "cond:does_not_fit", "Gate1", false, ""),
    br("Scope", 3, "else", "-", false, ""),
    br("Gate1", 1, "signal:repeat", "Gate2", false, ""),
    br("Gate1", 2, "signal:halt", "Halted", false, "gate1_halt"),
    br("Session", 1, "answer", "ResultParsing", false, ""),
    br("Session", 2, "failure", "Gate13Session", false, ""),
    br("ResultParsing", 1, "now", "End", false, ""),
    br("Gate13Session", 1, "signal:repeat", "Session", true, ""),
    br("Gate13Session", 2, "signal:halt", "Halted", false, "gate13_halt")
]

fn event_name(r TableRow) -> str {
    match r.event {
        SignalEv { name, binds } => "signal:${name}"
        AnswerEv { bind } => "answer"
        FailureEv { reasons, bind } => "failure"
        NowEv => "now"
        _ => "other"
    }
}

fn stop_written(r TableRow) -> str {
    for a in r.actions {
        match a {
            AssignAct { target, value } => {
                if target.root == "stop_reason" { return value_text_of(value) }
            }
            _ => ()
        }
    }
    ""
}

fn target_of(r TableRow) -> str {
    match r.next.target {
        ToState(n) => n
        _ => "-"
    }
}

test "mt every branch of the automaton is a row" {
    ro def = session_def()
    for b in automaton() {
        ro r = row_of(def, b.state, b.n)
        if b.event.starts_with("signal:") || b.event == "answer" || b.event == "failure" || b.event == "now" {
            assert(event_name(r) == b.event)
        } else {
            // the rows of the fork have conditions, not events
            assert(r.cond.len() == 1 || r.is_else)
        }
        assert(target_of(r) == b.target)
        assert(r.next.restart == b.rerun)
        assert(stop_written(r) == b.stop)
    }
}

test "mt no row without a branch" {
    // the table has the rows of the automaton and the rows of the fragment "Pause" (the engine of the automaton) and nothing more
    ro def = session_def()
    mut own = 0
    for st in def.states {
        if st.name == "Pause" { continue }
        own += st.rows.len()
    }
    assert(own == automaton().len())
    assert(def.common.len() == 6)
    assert(state_named(def, "Pause").rows.len() == 4)
}

test "mt the stop reasons are those of the automaton" {
    ro def = session_def()
    ro d = def.data[find_data_index(def, "stop_reason")]
    assert(spec_text(d.spec) == "\"\" | \"gate1_halt\" | \"gate13_halt\" | \"pause_halt\" | \"cancel_request\"")
}

fn find_data_index(def MachineDef, name str) -> int {
    mut i = 0
    for d in def.data {
        if d.name == name { return i }
        i += 1
    }
    -1
}

fn value_text_of(e Expr) -> str {
    match e {
        Lit(v) => match v {
            Text(s) => s
            _ => ""
        }
        _ => ""
    }
}

// the table "end -> reply" of the automaton (`end_response`): the end, the stop reason, the answer
type EndReply { file str, outcome str }

fn replies() -> []EndReply => [
    EndReply { file: "session-end-end-1", outcome: "answer" },
    EndReply { file: "session-gate1-2", outcome: "refusal:StoppedByHuman" },
    EndReply { file: "session-gate13-2", outcome: "refusal:StoppedByHuman" },
    EndReply { file: "session-end-halted-2", outcome: "refusal:StoppedByHuman" },
    EndReply { file: "session-end-halted-3", outcome: "refusal:Cancelled" }
]

test "mt the table end to reply" {
    ro c = sctx()
    for r in replies() {
        ro end = last_parent(flow_in(c, r.file))
        if r.outcome == "answer" {
            assert(end.outcome.starts_with("answer:"))
        } else {
            assert(end.outcome == r.outcome)
        }
        assert(end.open.len() == 0)
    }
}

test "mt the codes of the refusals" {
    // the automaton: gate13_halt, gate1_halt, pause_halt -> StoppedByHuman; cancel_request -> Cancelled; the error -> NoResult
    ro def = session_def()
    assert(def.end_rows.len() == 5)
    assert(def.end_rows[0].state == "End")
    assert(def.end_rows[1].state == "Errored")
    assert(def.end_rows[2].state == "Halted" && def.end_rows[3].state == "Halted" && def.end_rows[4].state == "Halted")
}

test "mt the data start as the automaton says" {
    ro def = session_def()
    // MachineData.new(): the counters 0, the stop reason "", the refusal text "", the maps empty; the rest comes from the input
    for n in ["step_attempt", "gatekeeper_attempt", "enhanced_attempt"] {
        ro d = def.data[find_data_index(def, n)]
        assert(spec_text(d.spec) == "int>=0")
    }
    assert(spec_text(def.data[find_data_index(def, "agent_reply")].spec) == "?AgentReply")
    assert(spec_text(def.data[find_data_index(def, "result")].spec) == "?SessionResult")
    assert(spec_text(def.data[find_data_index(def, "summary")].spec) == "{int: Summary}")
    assert(spec_text(def.data[find_data_index(def, "findings")].spec) == "{int: []Finding}")
    assert(spec_text(def.data[find_data_index(def, "launch_pass")].spec) == "?int")
}

test "mt the session codes of the automaton" {
    // the code of the dialog: delivery for s7, s7_fix, s8, commit, push; main for the rest (session_dialog_kind)
    ro def = session_def()
    assert(def.definitions[0].name == "вид_диалога_сессии")
}

test "mt the pause is the fragment of the methodology" {
    // the states of the fragment and their rows: ПАУЗА #1 continue, #2 halt, #3 continue from the parent, #4 halt from the parent; the common events 1-6
    ro def = session_def()
    ro pause = state_named(def, "Pause")
    assert(pause.rows.len() == 4)
    assert(pause.rows[0].n == 1 && pause.rows[3].n == 4)
    assert(def.common.len() == 6)
    assert(def.common[0].n == 1 && def.common[5].n == 6)
}
