// include_test.nv - the section `## Подключения`: the files of definitions (name, version, hash, the copy in the tree).
module alula.machine_text_eq

import std.text
import alula.machine.{NamedText}
import alula.machine_table.{load_machine}
import alula.machine_text.{translate_report, translate_checked_with, translate_checked, TranslateReport, defs_file_text}
import alula.machine_text.{translate_definitions, DefsReport, definitions_hash}
import alula.examples.{sample_registry}

fn cycle_file() -> NamedText => { name: "арифметика_цикла", text: cycle_text() }

fn cycle_text() -> str => defs_file_text("арифметика_цикла")

fn meeting_file() -> NamedText => { name: "определения_совещания", text: case_text("meeting-definitions.alula.md") }

fn registry_files() -> []NamedText => [cycle_file(), meeting_file()]

fn wrapper() -> str => case_text("meeting-wrapper.alula.md")

fn wrapped(text str) -> TranslateReport => translate_checked_with(text, sample_registry(), registry_files())

fn says_any(report TranslateReport, needle str) -> bool {
    for e in report.errors {
        if e.message.contains(needle) { return true }
    }
    false
}

// ---- the meeting definitions ------------------------------------------------------------------------------------------------------

test "in meeting defs" {
    ro d = translate_definitions(case_text("meeting-definitions.alula.md"))
    assert(d.errors.len() == 0)
    assert(d.version == "1")
    assert(d.rows_total == 15)
    assert(d.rows_noted == 0)
    assert(d.hash == "9fa0da4a6bdc")
    assert(d.json.contains("\"definitions\":[{\"name\":\"есть_критические\""))
}

test "in meeting counts" {
    ro d = translate_definitions(case_text("meeting-definitions.alula.md"))
    assert(d.json.match_indices("\"result\":").len() == 14)
    assert(d.json.contains("{\"name\":\"линзы_без_критических\""))
}

test "in wrapper" {
    ro report = wrapped(wrapper())
    if report.errors.len() > 0 { panic("${report.errors[0].line}: ${report.errors[0].message}") }
    assert(report.errors.len() == 0)
    assert(report.json.contains("\"includes\":[{\"name\":\"арифметика_цикла\",\"version\":\"1\",\"hash\":\"f757b8aa7b08\"},{\"name\":\"определения_совещания\",\"version\":\"1\",\"hash\":\"9fa0da4a6bdc\"}]"))
    assert(report.json.contains("{\"name\":\"потолок_исчерпан\",\"params\":"))
    assert(report.json.contains("{\"name\":\"слово_да_нет\",\"params\""))
}

test "in wrapper loads" {
    ro report = wrapped(wrapper())
    match load_machine(report.json, sample_registry()) {
        Ok(def) => {
            assert(def.includes.len() == 2)
            assert(def.definitions.len() == 15)
            assert(def.constants.len() == 1)
            assert(def.types.variants.len() == 5)
        }
        Err(issues) => panic("${issues[0].path}: ${issues[0].message}")
    }
}

test "in hash errors" {
    assert(says_any(wrapped(wrapper().replace("f757b8aa7b08", "fad927a77d33")), "хеш файла арифметика_цикла — f757b8aa7b08, а в подключении fad927a77d33"))
    assert(says_any(wrapped(wrapper().replace("арифметика_цикла версия 1", "арифметика_цикла версия 2")), "версия файла арифметика_цикла — 1, а в подключении 2"))
    assert(says_any(wrapped(wrapper().replace("функции: арифметика_цикла", "функции: нет_такого_файла")), "файла определений `нет_такого_файла` нет в реестре"))
    assert(says_any(wrapped(wrapper().replace("функции: определения_совещания версия 1 хеш 9fa0da4a6bdc", "функции: арифметика_цикла версия 1 хеш f757b8aa7b08")), "подключён дважды"))
}

test "in line errors" {
    assert(says_any(wrapped(wrapper().replace("хеш f757b8aa7b08", "хеш fb15")), "после `хеш` ожидается 12 шестнадцатеричных знаков"))
    assert(says_any(wrapped(wrapper().replace("хеш f757b8aa7b08", "хеш 446DDF8041C0")), "после `хеш` ожидается 12 шестнадцатеричных знаков"))
    assert(says_any(wrapped(wrapper().replace("версия 1 хеш f757b8aa7b08", "хеш f757b8aa7b08")), "ожидается `версия`"))
    assert(says_any(wrapped(wrapper().replace("версия 1 хеш f757b8aa7b08", "версия один хеш f757b8aa7b08")), "после `версия` ожидается целое число"))
}

test "in name clash" {
    ro text = wrapper().replace("## Состояния", "## Функции\n\n```\nфункция потолок_исчерпан(номер число>=1, отсчёт число>=1, предел число>=0) -> булево =>\n  истина\n```\n\n## Состояния")
    assert(says_any(wrapped(text), "функция `потолок_исчерпан` повторена"))
}

// ---- the file of definitions as the format asks it ------------------------------------------------------------------------------

fn defs_with(old str, new str) -> DefsReport => translate_definitions(cycle_text().replace(old, new))

fn defs_says(report DefsReport, needle str) -> bool {
    for e in report.errors {
        if e.message.contains(needle) { return true }
    }
    false
}

test "in defs file" {
    assert(defs_with("# Функции: арифметика_цикла", "# Что-то: арифметика_цикла").errors.len() >= 1)
    assert(defs_says(defs_with("functions_version: 1", "functions_version: x"), "functions_version: <целое>"))
    assert(defs_says(defs_with("format: 2.25", "format: 2.3"), "формат файла определений должен быть 2.25"))
    // task 253 (приёмка): the refusal of a defs file of 0.27 names the migration script
    assert(defs_says(defs_with("format: 2.25", "alula_version: 0.27"), "migrate-alula-228.py"))
    assert(defs_says(defs_with("## Константы\n—\n\n", ""), "три раздела по порядку"))
    assert(defs_says(defs_with("## Типы\n—", "## Типы\n—\n\n## Подключения\n—"), "три раздела по порядку"))
    assert(defs_says(defs_with("functions_version: 1", "functions_version: 1\nлишнее: слово"), "в шапке файла определений"))
}

test "in defs hash stable" {
    ro text = cycle_text()
    assert(definitions_hash(text) == "f757b8aa7b08")
    assert(definitions_hash("${text}\n\n") == "f757b8aa7b08")
    assert(definitions_hash(text.replace("пред", "предел")) != "f757b8aa7b08")
    assert(translate_definitions(text).hash == definitions_hash(text))
}

