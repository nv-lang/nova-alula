// rows_test.nv - the machine "Cycle check" equals the table of the methodology (task-runner-review-states.md): the 71 rows of the 19 states, row by row: the number of the rows of each state,
// where each row leads, the kind of each state, the party of each appeal, the words of the parties. The table of the methodology is copied here as data (the state, the number of the row, the state
// it leads to; "!" is a row that ends in a machine error: the methodology leads it to the end ERROR). The pause (4 rows) and the common events (6 rows) are the fragment, checked by the scenarios.
module alula.machine_cycle

// ORACLE-WORKAROUND(32): `import std.text` is needed in `nova build` for `[]str.join` (a `nova test` build has it already); drop the import when item 32 is fixed
import std.text
import alula.machine_table.{MachineDef, StateDef, TableRow, ForkKind, AppealKind, EndKind, MachineErrorAct, ToNothing, find_party}

/// MRow: a row of the table of the methodology: the Latin name of the state, the number of the row, the state it leads to or "!".
type MRow { state str, n int, to str }

fn mr(state str, n int, to str) -> MRow => { state, n, to }

// The 71 rows of the methodology (the column "Куда"; the state names are the Latin names of the dictionary).
fn methodology_rows() -> []MRow => [
    mr("ReviewEntry", 1, "Pass"),
    mr("ReviewEntry", 2, "!"),
    mr("ReviewEntry", 3, "!"),
    mr("ReviewEntry", 4, "Pass"),
    mr("ReviewEntry", 5, "!"),
    mr("Pass", 1, "MeetingCall"),
    mr("Pass", 2, "SessionLaunch"),
    mr("Pass", 3, "End"),
    mr("Pass", 4, "!"),
    mr("MeetingCall", 1, "End"),
    mr("MeetingCall", 2, "End"),
    mr("SessionLaunch", 1, "AfterSession"),
    mr("SessionLaunch", 2, "SessionFailure"),
    mr("SessionFailure", 1, "Halted"),
    mr("SessionFailure", 2, "Halted"),
    mr("SessionFailure", 3, "!"),
    mr("AfterSession", 1, "SummaryParsing"),
    mr("AfterSession", 2, "FixOutcome"),
    mr("AfterSession", 3, "End"),
    mr("AfterSession", 4, "End"),
    mr("AfterSession", 5, "!"),
    mr("SummaryParsing", 1, "Gate3"),
    mr("SummaryParsing", 2, "Gate3"),
    mr("SummaryParsing", 3, "Gate3"),
    mr("SummaryParsing", 4, "NoProbes"),
    mr("SummaryParsing", 5, "!"),
    mr("NoProbes", 1, "Pass"),
    mr("NoProbes", 2, "Retry"),
    mr("NoProbes", 3, "!"),
    mr("Retry", 1, "Pass"),
    mr("Retry", 2, "Halted"),
    mr("Gate3", 1, "Pass"),
    mr("Gate3", 2, "PassOutcome"),
    mr("PassOutcome", 1, "Pass"),
    mr("PassOutcome", 2, "CriterionNotConverging"),
    mr("PassOutcome", 3, "!"),
    mr("CriterionNotConverging", 1, "Ceiling"),
    mr("CriterionNotConverging", 2, "Gate15"),
    mr("CriterionNotConverging", 3, "!"),
    mr("Gate15", 1, "AfterNarrowing"),
    mr("Gate15", 2, "Ceiling"),
    mr("Gate15", 3, "StopStage"),
    mr("AfterNarrowing", 1, "Pass"),
    mr("AfterNarrowing", 2, "Ceiling"),
    mr("AfterNarrowing", 3, "!"),
    mr("Ceiling", 1, "Levels"),
    mr("Ceiling", 2, "Gate9"),
    mr("Ceiling", 3, "!"),
    mr("Gate9", 1, "End"),
    mr("Gate9", 2, "End"),
    mr("Gate9", 3, "End"),
    mr("Gate9", 4, "StopStage"),
    mr("Gate9", 5, "Levels"),
    mr("StopStage", 1, "SessionLaunch"),
    mr("StopStage", 2, "SessionLaunch"),
    mr("StopStage", 3, "Levels"),
    mr("StopStage", 4, "Levels"),
    mr("StopStage", 5, "!"),
    mr("Levels", 1, "End"),
    mr("Levels", 2, "SessionLaunch"),
    mr("Levels", 3, "End"),
    mr("Levels", 4, "End"),
    mr("Levels", 5, "SessionLaunch"),
    mr("Levels", 6, "SessionLaunch"),
    mr("Levels", 7, "!"),
    mr("FixOutcome", 1, "Pass"),
    mr("FixOutcome", 2, "End"),
    mr("FixOutcome", 3, "End"),
    mr("FixOutcome", 4, "End"),
    mr("FixOutcome", 5, "End"),
    mr("FixOutcome", 6, "!")
]

// The states of the methodology that have rows, with the number of the rows (the row "иначе" counts).
fn row_counts() -> []MRow => [
    mr("ReviewEntry", 5, ""), mr("Pass", 4, ""), mr("MeetingCall", 2, ""), mr("SessionLaunch", 2, ""), mr("SessionFailure", 3, ""), mr("AfterSession", 5, ""), mr("SummaryParsing", 5, ""),
    mr("NoProbes", 3, ""), mr("Retry", 2, ""), mr("Gate3", 2, ""), mr("PassOutcome", 3, ""), mr("CriterionNotConverging", 3, ""), mr("Gate15", 3, ""), mr("AfterNarrowing", 3, ""),
    mr("Ceiling", 3, ""), mr("Gate9", 5, ""), mr("StopStage", 5, ""), mr("Levels", 7, ""), mr("FixOutcome", 6, "")
]

fn count_of(state str) -> int {
    for c in row_counts() {
        if c.state == state { return c.n }
    }
    -1
}

fn party_id_of(def MachineDef, st StateDef) -> str {
    ro at = find_party(def, st.party)
    if at < 0 { return "?" }
    def.parties[at].id
}

test "rw methodology has 71 rows" {
    assert(methodology_rows().len() == 71)
    mut total = 0
    for c in row_counts() { total += c.n }
    assert(total == 71)
    assert(row_counts().len() == 19)
}

test "rw state row counts" {
    ro def = cycle_def()
    for c in row_counts() {
        assert(has_state(def, c.state))
        ro got = state_of(def, c.state).rows.len()
        if got != c.n { panic("${c.state} has ${got} rows, the methodology has ${c.n}") }
    }
    // the pause has the four rows of the fragment
    assert(state_of(def, "Pause").rows.len() == 4)
    // the ends have no rows
    assert(state_of(def, "End").rows.len() == 0)
    assert(state_of(def, "Halted").rows.len() == 0)
    assert(state_of(def, "Errored").rows.len() == 0)
}

test "rw every row leads where the methodology leads" {
    ro def = cycle_def()
    mut seen = 0
    for m in methodology_rows() {
        ro got = row_target(state_of(def, m.state), m.n)
        if got != m.to { panic("${m.state} #${m.n} leads to ${got}, the methodology leads it to ${m.to}") }
        seen += 1
    }
    assert(seen == 71)
}

test "rw rows are numbered from one" {
    ro def = cycle_def()
    for c in row_counts() {
        ro st = state_of(def, c.state)
        mut k = 1
        for r in st.rows {
            assert(r.n == k)
            k += 1
        }
    }
}

test "rw errors end in a machine error" {
    ro def = cycle_def()
    mut errors = 0
    for m in methodology_rows() {
        if m.to != "!" { continue }
        errors += 1
        ro st = state_of(def, m.state)
        mut found = false
        for r in st.rows {
            if r.n != m.n { continue }
            found = true
            assert(r.actions.len() >= 1)
            match r.actions[r.actions.len() - 1] {
                MachineErrorAct { code, params } => assert(code != "")
                _ => panic("${m.state} #${m.n} does not end in a machine error")
            }
        }
        assert(found)
    }
    // 12 rows "иначе" of the forks, the row 3 of SessionFailure (a code of failure that is not named), the rows 2 and 3 of ReviewEntry (the numbers below the minimums)
    assert(errors == 15)
}

test "rw else rows" {
    ro def = cycle_def()
    mut elses = 0
    for c in row_counts() {
        ro st = state_of(def, c.state)
        for r in st.rows {
            if r.is_else { elses += 1 }
        }
        if st.kind == ForkKind || c.state == "SessionFailure" {
            // a fork ends in the row "иначе"
            assert(st.rows[st.rows.len() - 1].is_else)
        }
    }
    assert(elses == 13)
}

test "rw kinds of the states" {
    ro def = cycle_def()
    for n in ["ReviewEntry", "Pass", "SessionFailure", "AfterSession", "SummaryParsing", "NoProbes", "PassOutcome", "CriterionNotConverging", "AfterNarrowing", "Ceiling", "StopStage", "Levels", "FixOutcome"] {
        assert(state_of(def, n).kind == ForkKind)
    }
    for n in ["MeetingCall", "SessionLaunch", "Retry", "Gate3", "Gate15", "Gate9", "Pause"] {
        assert(state_of(def, n).kind == AppealKind)
    }
    for n in ["End", "Halted", "Errored"] {
        assert(state_of(def, n).kind == EndKind)
    }
}

test "rw parties of the appeals" {
    ro def = cycle_def()
    assert(party_id_of(def, state_of(def, "MeetingCall")) == "meeting")
    assert(party_id_of(def, state_of(def, "SessionLaunch")) == "session_launch")
    assert(party_id_of(def, state_of(def, "Retry")) == "gatekeeper")
    assert(party_id_of(def, state_of(def, "Gate3")) == "gatekeeper")
    assert(party_id_of(def, state_of(def, "Gate9")) == "gatekeeper")
    assert(party_id_of(def, state_of(def, "Gate15")) == "enhanced")
    assert(party_id_of(def, state_of(def, "Pause")) == "enhanced")
}

fn words_of(def MachineDef, id str) -> []str {
    mut out = []str.new()
    for p in def.parties {
        if p.id != id { continue }
        for w in p.words { out.push(w.name) }
    }
    out
}

test "rw words of the gates" {
    ro def = cycle_def()
    ro gate = words_of(def, "gatekeeper")
    for w in ["repeat", "halt", "not_counted", "counted", "cut_scope", "split", "ask_customer", "stop", "another_pass"] {
        if !gate.contains(w) { panic("the gatekeeper has no word ${w}: ${gate.join(",")}") }
    }
    assert(gate.len() == 9)
    ro enh = words_of(def, "enhanced")
    for w in ["continue", "halt", "narrow", "another_pass", "stop"] {
        if !enh.contains(w) { panic("the enhanced party has no word ${w}: ${enh.join(",")}") }
    }
    assert(enh.len() == 5)
}

test "rw words carry the data of the methodology" {
    ro def = cycle_def()
    for p in def.parties {
        for w in p.words {
            if p.id == "gatekeeper" && w.name == "counted" { assert(w.fields.len() == 2) }
            if p.id == "gatekeeper" && w.name == "stop" { assert(w.fields.len() == 1) }
            if p.id == "enhanced" && w.name == "stop" { assert(w.fields.len() == 1) }
            if p.id == "enhanced" && w.name == "narrow" { assert(w.fields.len() == 1) }
            if p.id == "enhanced" && w.name == "continue" { assert(w.fields.len() == 3) }
            if p.id == "gatekeeper" && w.name == "repeat" { assert(w.fields.len() == 0) }
        }
    }
}
