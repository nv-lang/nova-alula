// support_test.nv - helpers of the proofs of the machine "Cycle check" (task 122): the table `machines/cycle_check.portolan.md`, its translation, the decoded machine, the machine that is made,
// and the scenarios `scenarios/cycle-*` run once on it.
module alula.machine_cycle

// ORACLE-WORKAROUND(32): `import std.text` is needed in `nova build` for `[]str.join` (a `nova test` build has it already); drop the import when item 32 is fixed
import std.text
import std.encoding.json.{Json, JsonValue, JsonObject}
import alula.machine.{standard_registry, cycle_check_table_text, cycle_check_machine_text, scenario_files, NamedText}
import alula.machine_table.{MachineDef, StateDef, TableRow, Target, ToState, ToNothing, ToPrevious, ToSame, ToPrepareReturn, load_machine}
import alula.machine_run.{PortolanMachine, ScenarioRun, load_portolan_machine, parse_scenario, run_scenario, run_ok, report_text}
import alula.machine_text.{translate_checked, TranslateReport, TranslateError, error_text, render_machine}

fn table_report() -> TranslateReport => translate_checked(cycle_check_table_text(), standard_registry())

fn errors_text(report TranslateReport) -> str {
    mut parts = []str.new()
    for e in report.errors { parts.push(error_text(e, "cycle_check.portolan.md")) }
    parts.join(" ## ")
}

fn cycle_def() -> MachineDef {
    match load_machine(cycle_check_machine_text(), standard_registry()) {
        Ok(d) => d
        Err(issues) => panic("the cycle check does not load: ${issues[0].path}: ${issues[0].message}")
    }
}

fn cycle_machine() -> PortolanMachine {
    match load_portolan_machine(cycle_check_machine_text(), standard_registry()) {
        Ok(m) => m
        Err(e) => panic("the cycle check is not made: ${e}")
    }
}

fn state_of(def MachineDef, name str) -> StateDef {
    for st in def.states {
        if st.name == name { return st }
    }
    panic("no state ${name}")
}

fn has_state(def MachineDef, name str) -> bool {
    for st in def.states {
        if st.name == name { return true }
    }
    false
}

// Where a row leads, as the methodology writes it: a state, or "!" for a row that ends in a machine error.
fn target_word(t Target) -> str {
    match t {
        ToState(name) => name
        ToNothing => "!"
        ToPrevious => "@previous"
        ToSame => "@same"
        ToPrepareReturn => "@prepare_return"
    }
}

fn row_target(st StateDef, n int) -> str {
    for r in st.rows {
        if r.n == n { return target_word(r.next.target) }
    }
    "?"
}

// ---- the scenarios of the cycle check -------------------------------------------------------------------------------------------------------

fn cycle_scenarios() -> []NamedText {
    mut out = []NamedText.new()
    for f in scenario_files() {
        if f.name.starts_with("cycle-") { out.push(f) }
    }
    out
}

fn run_with(m PortolanMachine, file NamedText) -> ScenarioRun {
    match parse_scenario(file.text) {
        Ok(sc) => run_scenario(m, sc)
        Err(e) => panic("${file.name}: ${e.path}: ${e.message}")
    }
}

/// FileRun: a scenario file and its run.
type FileRun { name str, run ScenarioRun }

// Every scenario of the cycle check run once (the machine is made once: building it checks the whole table).
fn all_runs() -> []FileRun {
    ro m = cycle_machine()
    mut out = []FileRun.new()
    for f in cycle_scenarios() { out.push(FileRun { name: f.name, run: run_with(m, f) }) }
    out
}

// ---- trees ----------------------------------------------------------------------------------------------------------------------------------

fn kind_of(v JsonValue) -> str {
    if v.is_null() { return "null" }
    if v.is_bool() { return "bool" }
    if v.is_num() { return "num" }
    if v.is_str() { return "str" }
    if v.is_array() { return "array" }
    "object"
}

fn is_empty_list(v JsonValue) -> bool {
    match v.array() {
        Some(xs) => xs.len() == 0
        None => false
    }
}

fn sval(o JsonObject, key str) -> str {
    match o.get(key) {
        Some(v) => v.str() ?? ""
        None => ""
    }
}

// The keys that a circle does not keep: the title (the header of the canonical file holds the Latin name of the machine, 1b (а)) and the version of the language of the tree.
fn dropped_keys() -> []str => ["title", "portolan_version"]

// Where two trees differ: the place and the two pieces, or "" when they are equal.
fn first_difference(left JsonValue, right JsonValue, place str) -> str {
    if kind_of(left) != kind_of(right) { return "${place}: ${kind_of(left)} / ${kind_of(right)}" }
    match left.array() {
        Some(xs) => {
            ro ys = right.array() ?? []JsonValue.new()
            if xs.len() != ys.len() { return "${place}: ${xs.len()} items / ${ys.len()} items" }
            mut i = 0
            while i < xs.len() {
                ro d = first_difference(xs[i], ys[i], "${place}[${i}]")
                if d != "" { return d }
                i += 1
            }
            return ""
        }
        None => ()
    }
    match left.object() {
        Some(xo) => {
            ro yo = right.object() ?? JsonObject.new()
            for k in xo.keys() {
                if place == "$" && dropped_keys().contains(k) { continue }
                match yo.get(k) {
                    Some(yv) => {
                        ro d = first_difference(xo.get(k) ?? JsonValue.null(), yv, "${place}.${k}")
                        if d != "" { return d }
                    }
                    None => {
                        if !(k == "writes" && sval(xo, k) == "rows") && !is_empty_list(xo.get(k) ?? JsonValue.null()) { return "${place}.${k}: missing in the second tree" }
                    }
                }
            }
            for k in yo.keys() {
                if place == "$" && dropped_keys().contains(k) { continue }
                if !xo.contains(k) {
                    if !(k == "writes" && sval(yo, k) == "rows") && !is_empty_list(yo.get(k) ?? JsonValue.null()) { return "${place}.${k}: missing in the first tree" }
                }
            }
            return ""
        }
        None => ()
    }
    if left.to_str() != right.to_str() { return "${place}: ${left.to_str()} / ${right.to_str()}" }
    ""
}

fn tree_diff(a str, b str) -> str {
    ro x = match Json.parse(a) {
        Ok(j) => j
        Err(e) => return "the first tree is not JSON"
    }
    ro y = match Json.parse(b) {
        Ok(j) => j
        Err(e) => return "the second tree is not JSON"
    }
    first_difference(x, y, "$")
}

fn notes_of(report TranslateReport) -> []str {
    mut out = []str.new()
    for e in report.errors { out.push("${e.line}:${e.col} ${e.kind} ${e.message}") }
    out
}

// The circle tree -> file -> tree in a language: "" when the second tree equals the first.
fn circle(json str, lang str) -> str {
    ro made = render_machine(json, lang)
    if made.notes.len() > 0 { return "render: ${made.notes.join(" ## ")}" }
    ro again = translate_checked(made.text, standard_registry())
    if again.errors.len() > 0 { return "translate: ${notes_of(again).join(" ## ")}" }
    tree_diff(json, again.json)
}
