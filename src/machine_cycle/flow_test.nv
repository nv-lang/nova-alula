// flow_test.nv - what the scenarios of the cycle check show all together: every state of the machine is visited, every verdict and every refusal of the table "Ends" is the outcome of some
// scenario, the flows end as the methodology says, and a run is deterministic (two runs give the same states, journal and data).
module alula.machine_cycle

// ORACLE-WORKAROUND(32): `import std.text` is needed in `nova build` for `[]str.join` (a `nova test` build has it already); drop the import when item 32 is fixed
import std.text
import alula.machine_run.{ScenarioRun, StepTrace, run_ok}

fn state_names() -> []str => [
    "ReviewEntry", "Pass", "MeetingCall", "SessionLaunch", "SessionFailure", "AfterSession", "SummaryParsing", "NoProbes", "Retry", "Gate3", "PassOutcome", "CriterionNotConverging",
    "Gate15", "AfterNarrowing", "Ceiling", "Gate9", "StopStage", "Levels", "FixOutcome", "Pause", "End", "Halted", "Errored"
]

fn named(runs []FileRun, name str) -> ScenarioRun {
    for fr in runs {
        if fr.name == "${name}.scenario.test.json" { return fr.run }
    }
    panic("no scenario ${name}")
}

fn last_outcome(run ScenarioRun) -> str => run.traces[run.traces.len() - 1].outcome

fn last_state(run ScenarioRun) -> str => run.traces[run.traces.len() - 1].state

fn all_outcomes(runs []FileRun) -> []str {
    mut out = []str.new()
    for fr in runs { out.push(last_outcome(fr.run)) }
    out
}

fn any_contains(items []str, needle str) -> bool {
    for x in items {
        if x.contains(needle) { return true }
    }
    false
}

test "fl the scenarios all together" {
    ro runs = all_runs()
    assert(runs.len() == 101)
    // every scenario agrees with its file
    for fr in runs {
        if !run_ok(fr.run) { panic(fr.name) }
    }
    // every state of the machine is visited: an appeal or an end is the state a step leaves, a fork is a state some row of which a step took
    mut visited = []str.new()
    mut steps = 0
    mut outcomes = []str.new()
    for fr in runs {
        outcomes.push(last_outcome(fr.run))
        for t in fr.run.traces {
            steps += 1
            if !visited.contains(t.state) { visited.push(t.state) }
            for row in taken_of(t.encoded) {
                ro at = row.find("#") ?? -1
                if at > 0 {
                    ro name = row[..at].replace("end:", "")
                    if !visited.contains(name) { visited.push(name) }
                }
            }
        }
    }
    for n in state_names() {
        if !visited.contains(n) { panic("no scenario visits the state ${n}") }
    }
    assert(steps > 300)
    // every verdict of the methodology is the outcome of some scenario
    for v in ["Clean", "Requirements", "Plan", "Question", "Restart", "Stopped"] {
        if !any_contains(outcomes, "\"verdict\":{\"$variant\":\"Verdict\",\"name\":\"${v}\"}") { panic("no scenario ends with the verdict ${v}") }
    }
    // every refusal of the table of the ends is the outcome of some scenario
    assert(outcomes.contains("refusal:NoResult"))
    assert(outcomes.contains("refusal:StoppedByHuman"))
    assert(outcomes.contains("refusal:Cancelled"))
}

test "fl the five flows" {
    ro runs = all_runs()
    // the clean cycle
    ro clean = named(runs, "cycle-flow-clean")
    assert(clean.traces.len() == 5)
    assert(last_state(clean) == "End")
    assert(last_outcome(clean).contains("\"verdict\":{\"$variant\":\"Verdict\",\"name\":\"Clean\"}"))
    assert(clean.traces[0].state == "SessionLaunch")
    assert(clean.traces[1].state == "Gate3")
    assert(clean.traces[2].state == "SessionLaunch")
    // the rework: the author of the fix is asked after the first counted pass, then the reviewer again
    ro rework = named(runs, "cycle-flow-rework")
    assert(rework.traces.len() == 8)
    assert(last_state(rework) == "End")
    assert(rework.traces[2].state == "SessionLaunch")
    assert(rework.traces[2].sent.len() == 2)
    assert(rework.traces[3].sent.len() == 3)
    // the refusals
    assert(last_outcome(named(runs, "cycle-flow-refusal-stopped")) == "refusal:StoppedByHuman")
    assert(last_outcome(named(runs, "cycle-flow-refusal-no-result")) == "refusal:NoResult")
    assert(last_state(named(runs, "cycle-flow-refusal-stopped")) == "Halted")
    assert(last_state(named(runs, "cycle-flow-input-below-minimum")) == "Errored")
    // the restarts: the state and the open request are given back by the journal, nothing is sent again
    ro restart = named(runs, "cycle-flow-restart-launch")
    assert(restart.traces[1].op == "restart")
    assert(restart.traces[1].state == "SessionLaunch")
    assert(restart.traces[1].sent.len() == 1)
    assert(restart.traces[1].open.len() == 1)
    ro end = named(runs, "cycle-flow-restart-end")
    assert(end.traces[1].state == "End")
    assert(end.traces[1].outcome == end.traces[0].outcome)
    // the death between the commit and the send: the request waits in the queue; the restart does not lose it, the dispatch sends it once
    ro death = named(runs, "cycle-flow-death-between")
    assert(death.traces[2].op == "accept")
    assert(death.traces[2].queue.len() == 1)
    assert(death.traces[2].sent.len() == 1)
    assert(death.traces[3].op == "restart")
    assert(death.traces[4].op == "dispatch")
    assert(death.traces[4].queue.len() == 0)
    assert(death.traces[4].sent.len() == 2)
    ro start = named(runs, "cycle-flow-death-start")
    assert(start.traces[0].sent.len() == 0)
    assert(start.traces[2].sent.len() == 1)
    assert(start.traces[3].sent.len() == 1)
}

test "fl a run is deterministic" {
    ro m = cycle_machine()
    for f in cycle_scenarios() {
        if f.name != "cycle-flow-rework.scenario.test.json" && f.name != "cycle-flow-narrowing-clean.scenario.test.json" && f.name != "cycle-gate9-1.scenario.test.json" { continue }
        ro first = run_with(m, f)
        ro second = run_with(m, f)
        assert(first.traces.len() == second.traces.len())
        mut i = 0
        while i < first.traces.len() {
            assert(first.traces[i].encoded == second.traces[i].encoded)
            assert(first.traces[i].journal.join("|") == second.traces[i].journal.join("|"))
            assert(first.traces[i].state == second.traces[i].state)
            i += 1
        }
    }
}

test "fl the pause and the gates" {
    ro runs = all_runs()
    // the stop of the human and of the parent do not cancel the request of the nested machine (the machine of the session launch keeps its own pause)
    for n in ["cycle-common-1", "cycle-common-2"] {
        ro run = named(runs, n)
        assert(run.traces[1].state == "Pause")
        assert(run.traces[1].cancelled.len() == 0)
        assert(run.traces[1].open.len() == 1)
    }
    // the cancel of the call does cancel it
    ro cancel = named(runs, "cycle-common-5")
    assert(cancel.traces[1].cancelled.len() == 1)
    assert(cancel.traces[1].open.len() == 0)
    // the gate 15 comes only after three counted passes with the same criterion; the gate 9 only when the ceiling is reached
    ro g15 = named(runs, "cycle-gate15-1")
    mut gates = 0
    for t in g15.traces {
        if t.state == "Gate15" { gates += 1 }
        if t.state == "Gate9" { panic("the gate 9 in the scenario of the gate 15") }
    }
    assert(gates == 1)
    ro g9 = named(runs, "cycle-gate9-1")
    for t in g9.traces {
        if t.state == "Gate15" { panic("the gate 15 in the scenario of the gate 9") }
    }
}
