// cover_test.nv - every row of the table "Cycle check" has a scenario: the rows that the scenarios of `scenarios/cycle-*` took (the mark `taken` of the state after every step) are compared with
// the rows of the machine; a row that no scenario takes is red. The rows that cannot be taken by any sequence of events are named here with the reason.
module alula.machine_cycle

import std.text
import std.encoding.json.{Json}
import alula.machine.{scenario_files, NamedText}
import alula.machine_table.{MachineErrorAct}
import alula.machine_run.{ScenarioRun, run_ok, report_text}

// The rows of the machine as marks: `State#n`, `common#n`, `end:State#n`.
fn all_rows() -> []str {
    ro def = cycle_def()
    mut out = []str.new()
    for st in def.states {
        for r in st.rows { out.push("${st.name}#${r.n}") }
    }
    for r in def.common { out.push("common#${r.n}") }
    for er in def.end_rows { out.push("end:${er.state}#${er.n}") }
    out
}

// The rows that no event can take: the rows `else` of the forks (the conditions before them cover every value that the chain can bring) and the row 6 of the common events (the three
// conditions before it cover every request id). They are defensive: they write `machine_error(fork_no_match)` or `cancel_parse_no_match` and go to the end ERRORED. The row 3 of SessionFailure
// is not among them: a failure of the nested machine with a code other than the two named reaches it.
fn dead_rows() -> []str => [
    "ReviewEntry#5", "Pass#4", "AfterSession#5", "SummaryParsing#5", "NoProbes#3", "PassOutcome#3", "CriterionNotConverging#3", "AfterNarrowing#3", "Ceiling#3",
    "StopStage#5", "Levels#7", "FixOutcome#6", "common#6"
]

// The rows taken after every step of a scenario, from the encoded state of the trace.
fn taken_of(encoded str) -> []str {
    mut out = []str.new()
    match Json.parse(encoded) {
        Ok(j) => match j.object() {
            Some(o) => match o.get("taken") {
                Some(t) => match t.array() {
                    Some(items) => {
                        for item in items {
                            match item.str() {
                                Some(s) => out.push(s)
                                None => ()
                            }
                        }
                    }
                    None => ()
                }
                None => ()
            }
            None => ()
        }
        Err(e) => ()
    }
    out
}

fn taken_by(run ScenarioRun) -> []str {
    mut out = []str.new()
    for t in run.traces {
        for r in taken_of(t.encoded) {
            if !out.contains(r) { out.push(r) }
        }
    }
    out
}

// The name of the scenario of a row: `cycle-review-entry-3`, `cycle-common-1`, `cycle-end-halted-2`.
fn state_word(name str) -> str {
    if name == "ReviewEntry" { return "review-entry" }
    if name == "Pass" { return "pass" }
    if name == "MeetingCall" { return "meeting" }
    if name == "SessionLaunch" { return "launch" }
    if name == "SessionFailure" { return "failure" }
    if name == "AfterSession" { return "after-session" }
    if name == "SummaryParsing" { return "summary" }
    if name == "NoProbes" { return "no-probes" }
    if name == "Retry" { return "retry" }
    if name == "Gate3" { return "gate3" }
    if name == "PassOutcome" { return "outcome" }
    if name == "CriterionNotConverging" { return "criterion" }
    if name == "Gate15" { return "gate15" }
    if name == "AfterNarrowing" { return "narrowing" }
    if name == "Ceiling" { return "ceiling" }
    if name == "Gate9" { return "gate9" }
    if name == "StopStage" { return "stop-stage" }
    if name == "Levels" { return "levels" }
    if name == "FixOutcome" { return "fix-outcome" }
    if name == "Pause" { return "pause" }
    if name == "common" { return "common" }
    if name == "End" { return "end-end" }
    if name == "Halted" { return "end-halted" }
    if name == "Errored" { return "end-errored" }
    panic("a state without a word for the file: ${name}")
}

fn file_of_row(row str) -> str {
    ro body = row.replace("end:", "")
    match body.find("#") {
        Some(at) => "cycle-${state_word(body[..at])}-${body[(at + 1)..]}.scenario.test.json"
        None => panic("a row without a number: ${row}")
    }
}

test "cv rows counted" {
    ro rows = all_rows()
    // 71 rows of the states of the methodology, 4 of the pause, 6 common events, 5 rows of the ends
    assert(rows.len() == 86)
    for dead in dead_rows() { assert(rows.contains(dead)) }
    assert(dead_rows().len() == 13)
}

test "cv dead rows are else" {
    ro def = cycle_def()
    mut seen = 0
    for st in def.states {
        for r in st.rows {
            if dead_rows().contains("${st.name}#${r.n}") {
                seen += 1
                assert(r.is_else)
                assert(r.actions.len() == 1)
                match r.actions[0] {
                    MachineErrorAct { code, params } => assert(code == "fork_no_match")
                    _ => assert(false)
                }
            }
        }
    }
    assert(seen == 12)
    ro last = def.common[5]
    assert(last.n == 6)
    match last.actions[0] {
        MachineErrorAct { code, params } => assert(code == "cancel_parse_no_match")
        _ => assert(false)
    }
}

test "cv every row has a file" {
    mut have = []str.new()
    for f in cycle_scenarios() { have.push(f.name) }
    for row in all_rows() {
        if dead_rows().contains(row) { continue }
        if !have.contains(file_of_row(row)) { panic("no scenario file for the row ${row}: ${file_of_row(row)}") }
    }
    assert(have.len() >= 73)
}

test "cv scenarios agree and take every row" {
    ro runs = all_runs()
    assert(runs.len() >= 73)
    mut covered = []str.new()
    for fr in runs {
        if !run_ok(fr.run) { panic("${fr.name}: ${report_text(fr.run)}") }
        for r in taken_by(fr.run) {
            if !covered.contains(r) { covered.push(r) }
        }
    }
    ro expected = dead_rows()
    mut missing = 0
    for row in all_rows() {
        if !covered.contains(row) {
            missing += 1
            if !expected.contains(row) { panic("no scenario takes the row ${row}") }
        }
    }
    for row in expected {
        if covered.contains(row) { panic("the row ${row} is said to be dead but a scenario takes it") }
    }
    assert(missing == expected.len())
    // the scenario named after a row takes that row
    for row in all_rows() {
        if expected.contains(row) { continue }
        ro file = file_of_row(row)
        mut found = false
        for fr in runs {
            if fr.name == file {
                found = true
                if !taken_by(fr.run).contains(row) { panic("the scenario ${file} does not take the row ${row}") }
            }
        }
        if !found { panic("no scenario file for the row ${row}: ${file}") }
    }
}

test "cv flows" {
    mut flows = 0
    for f in cycle_scenarios() {
        if f.name.starts_with("cycle-flow-") { flows += 1 }
    }
    assert(flows >= 14)
}
