{
  "format": "scenario/0",
  "machine": "DialogSession",
  "name": "restart after the request: no second send, same result",
  "start_at": 1000,
  "params": {"проект.срок_бездействия": 30000},
  "steps": [
    {"do": "feed", "event": {"kind": "signal", "name": "user_message", "input": "привет"}, "expect": {"state": "Awaiting", "sent": ["agent-1"]}},
    {"do": "restart", "expect": {"state": "Awaiting", "open": ["agent-1"], "sent": ["agent-1"]}},
    {"do": "dispatch", "expect": {"sent": ["agent-1"]}},
    {"do": "pump", "expect": {"sent": ["agent-1"]}},
    {"do": "deliver", "event": {"kind": "progress", "name": "agent_chunk", "request": "agent-1", "input": "Здравствуй"}},
    {"do": "deliver", "event": {"kind": "answer", "name": "agent_done", "request": "agent-1"}},
    {"do": "pump", "expect": {"state": "Idle", "outcome": "none", "sent": ["agent-1"]}}
  ]
}
