{
  "format": "scenario/0",
  "machine": "dialog_steps",
  "name": "a chat turn: the agent gives no result; the nested machine ends with the refusal, the session records it and waits for the next word",
  "start_at": 1000,
  "steps": [
    {
      "do": "feed",
      "host": {
        "reply_validation": {
          "$variant": "ReplyCheck",
          "name": "Valid",
          "fields": {}
        },
        "close_agent_turn": null
      },
      "event": {
        "kind": "start",
        "request": "up-1",
        "input": {
          "kind": {
            "$variant": "CallerKind",
            "name": "CycleSession",
            "fields": {}
          },
          "profile": {
            "$record": "AgentProfile",
            "fields": {
              "family": "claude",
              "model": "m1",
              "effort": null
            }
          },
          "session": "s1",
          "dialog_kind": "main",
          "context": "ctx",
          "limits": {
            "$record": "AgentLimits",
            "fields": {
              "silence_term": null,
              "token_budget": null,
              "cost_budget": null,
              "turn_limit": null
            }
          },
          "trace": "t1",
          "step": 0
        }
      },
      "expect": {
        "state": "Turn",
        "open": [
          "call-1"
        ],
        "sent": [
          "call-1"
        ],
        "outcome": "none",
        "data": {
          "open_requests": [
            "call-1"
          ],
          "step_attempt": 1
        }
      },
      "also": {
        "call-1": {
          "state": "AgentTurn",
          "open": [
            "agent-1"
          ],
          "sent": [
            "agent-1"
          ],
          "data": {
            "call_request_id": "call-1",
            "open_requests": [
              "agent-1"
            ]
          }
        }
      }
    },
    {
      "do": "feed",
      "event": {
        "kind": "failure",
        "request": "agent-1",
        "code": "NoResult"
      },
      "on": "call-1",
      "expect": {
        "state": "Halted",
        "outcome": "refusal:NoResult"
      },
      "also": {
        "parent": {
          "queue": [
            "in failure"
          ]
        }
      }
    },
    {
      "do": "pump",
      "expect": {
        "state": "Wait",
        "journal": [
          {
            "code": "turn_refused",
            "params": {
              "code": "no_result"
            }
          }
        ],
        "data": {
          "stop_code": "no_result",
          "turn_count": 1
        }
      }
    }
  ]
}
