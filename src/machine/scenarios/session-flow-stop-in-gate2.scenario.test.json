{
  "format": "scenario/0",
  "machine": "session_start",
  "name": "FLOW: a human stops the launch at B2 and then says continue: the gate is entered again (no request: the gate waits for a word), the launch goes on",
  "start_at": 1000,
  "steps": [
    {
      "do": "feed",
      "host": {
        "reply_validation": {
          "$variant": "ReplyCheck",
          "name": "Valid",
          "fields": {}
        },
        "close_agent_turn": null,
        "launch_scope": {
          "$variant": "LaunchScope",
          "name": "Fits",
          "fields": {}
        },
        "launch_profile": {
          "$record": "AgentProfile",
          "fields": {
            "family": "claude",
            "model": "m1",
            "effort": null
          }
        },
        "session_context": "the prompt of s3",
        "parse_session_artifact": {
          "$record": "SessionParsing",
          "fields": {
            "result": {
              "$variant": "SessionResult",
              "name": "Done",
              "fields": {}
            },
            "summary": null,
            "findings": null
          }
        },
        "stop_agent_group": null
      },
      "event": {
        "kind": "start",
        "request": "up-1",
        "input": {
          "session": "s3",
          "task_dir": "/t",
          "repo_dir": "/r",
          "delivery_mode": "files",
          "route": "full",
          "delivery_short": false
        }
      },
      "expect": {
        "state": "Gate2",
        "journal": [],
        "open": [],
        "sent": [],
        "queue": [],
        "outcome": "none",
        "data": {
          "call_request_id": "up-1",
          "step_attempt": 0,
          "open_requests": [],
          "session": "s3",
          "stop_reason": ""
        }
      }
    },
    {
      "do": "feed",
      "event": {
        "kind": "signal",
        "name": "human_stop",
        "input": {
          "human_word": "stop",
          "author": "ann",
          "source": "console"
        }
      },
      "expect": {
        "state": "Pause",
        "data": {
          "previous": "Gate2"
        }
      }
    },
    {
      "do": "feed",
      "event": {
        "kind": "signal",
        "name": "continue",
        "input": {
          "human_word": "go",
          "author": "ann",
          "source": "console"
        }
      },
      "expect": {
        "state": "Gate2",
        "journal": [
          {
            "code": "human_continue",
            "params": {
              "previous": "Gate2",
              "author": "ann",
              "source": "console",
              "event": "input-4"
            }
          }
        ]
      }
    },
    {
      "do": "feed",
      "event": {
        "kind": "signal",
        "name": "confirm"
      },
      "expect": {
        "state": "Session",
        "open": [
          "agent_step-1"
        ],
        "sent": [
          "agent_step-1"
        ],
        "outcome": "none",
        "data": {
          "step_attempt": 1,
          "open_requests": [
            "agent_step-1"
          ]
        }
      },
      "also": {
        "agent_step-1": {
          "state": "AgentTurn",
          "open": [
            "agent-1"
          ],
          "sent": [
            "agent-1"
          ],
          "outcome": "none",
          "data": {
            "call_request_id": "agent_step-1",
            "open_requests": [
              "agent-1"
            ]
          }
        }
      }
    }
  ]
}
