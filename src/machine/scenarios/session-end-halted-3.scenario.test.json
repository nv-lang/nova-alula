{
  "format": "scenario/0",
  "machine": "session_start",
  "name": "HALTED 3: the cancel of the request of the launch in the middle of the session: the reason cancel_request, the refusal Cancelled, the nested request is cancelled",
  "start_at": 1000,
  "steps": [
    {
      "do": "feed",
      "host": {
        "reply_validation": {
          "$variant": "ReplyCheck",
          "name": "Valid",
          "fields": {}
        },
        "close_agent_turn": null,
        "launch_scope": {
          "$variant": "LaunchScope",
          "name": "Fits",
          "fields": {}
        },
        "launch_profile": {
          "$record": "AgentProfile",
          "fields": {
            "family": "claude",
            "model": "m1",
            "effort": null
          }
        },
        "session_context": "the prompt of s3",
        "parse_session_artifact": {
          "$record": "SessionParsing",
          "fields": {
            "result": {
              "$variant": "SessionResult",
              "name": "Done",
              "fields": {}
            },
            "summary": null,
            "findings": null
          }
        },
        "stop_agent_group": null
      },
      "event": {
        "kind": "start",
        "request": "up-1",
        "input": {
          "session": "s3",
          "task_dir": "/t",
          "repo_dir": "/r",
          "delivery_mode": "files",
          "route": "full",
          "delivery_short": false
        }
      },
      "expect": {
        "state": "Gate2",
        "journal": [],
        "open": [],
        "sent": [],
        "queue": [],
        "outcome": "none",
        "data": {
          "call_request_id": "up-1",
          "step_attempt": 0,
          "open_requests": [],
          "session": "s3",
          "stop_reason": ""
        }
      }
    },
    {
      "do": "feed",
      "event": {
        "kind": "signal",
        "name": "confirm"
      },
      "expect": {
        "state": "Session",
        "open": [
          "agent_step-1"
        ],
        "sent": [
          "agent_step-1"
        ],
        "outcome": "none",
        "data": {
          "step_attempt": 1,
          "open_requests": [
            "agent_step-1"
          ]
        }
      },
      "also": {
        "agent_step-1": {
          "state": "AgentTurn",
          "open": [
            "agent-1"
          ],
          "sent": [
            "agent-1"
          ],
          "outcome": "none",
          "data": {
            "call_request_id": "agent_step-1",
            "open_requests": [
              "agent-1"
            ]
          }
        }
      }
    },
    {
      "do": "feed",
      "event": {
        "kind": "signal",
        "name": "cancel_request",
        "input": "up-1"
      },
      "expect": {
        "state": "Halted",
        "outcome": "refusal:Cancelled",
        "open": [],
        "cancelled": [
          "agent_step-1"
        ],
        "data": {
          "stop_reason": "cancel_request"
        },
        "journal": [
          {
            "code": "request_cancelled",
            "params": {
              "request": "up-1",
              "event": "input-4"
            }
          },
          {
            "code": "session_launch_stopped",
            "params": {
              "reason": "cancel_request"
            }
          },
          {
            "code": "signal_ordered",
            "params": {
              "signal": "cancel",
              "request": "agent_step-1"
            }
          },
          {
            "code": "signal_passed",
            "params": {
              "signal": "cancel",
              "request": "agent_step-1"
            }
          }
        ]
      },
      "also": {
        "agent_step-1": {
          "state": "Halted",
          "outcome": "refusal:Cancelled",
          "cancelled": [
            "agent-1"
          ]
        }
      }
    }
  ]
}
