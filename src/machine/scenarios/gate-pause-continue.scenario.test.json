{
  "format": "scenario/0",
  "machine": "Gate",
  "name": "stop, pause, continue: the previous state is entered again with a new request",
  "start_at": 1000,
  "steps": [
    {"do": "feed", "event": {"kind": "start"}, "expect": {"state": "Work", "sent": ["agent-1"]}},
    {"do": "feed", "event": {"kind": "signal", "name": "stop", "input": {"author": "ann", "source": "console"}}, "expect": {"state": "Pause", "cancelled": ["agent-1"], "open": [], "journal": [{"code": "human_stop", "params": {"author": "ann", "source": "console", "event": "input-3"}}], "data": {"previous": "Work"}}},
    {"do": "feed", "event": {"kind": "signal", "name": "continue", "input": {"author": "ann", "source": "console"}}, "expect": {"state": "Work", "sent": ["agent-1", "agent-2"], "open": ["agent-2"], "journal": [{"code": "human_continue", "params": {"previous": "Work", "author": "ann", "source": "console", "event": "input-4"}}]}},
    {"do": "feed", "event": {"kind": "answer", "name": "answer", "request": "agent-2"}, "expect": {"state": "Done", "outcome": "answer:1"}}
  ]
}
