{
  "format": "scenario/0",
  "machine": "DialogSession",
  "name": "restart after the answer: the session is open, nothing sent again",
  "start_at": 1000,
  "params": {"проект.срок_бездействия": 30000},
  "steps": [
    {"do": "feed", "event": {"kind": "signal", "name": "user_message", "input": "hi"}, "expect": {"state": "Awaiting"}},
    {"do": "feed", "event": {"kind": "progress", "name": "agent_chunk", "request": "agent-1", "input": "fine"}, "expect": {"state": "Awaiting"}},
    {"do": "feed", "event": {"kind": "answer", "name": "agent_done", "request": "agent-1"}, "expect": {"state": "Idle", "outcome": "none"}},
    {"do": "restart", "expect": {"state": "Idle", "outcome": "none", "open": []}},
    {"do": "dispatch", "expect": {"sent": ["agent-1"]}},
    {"do": "feed", "event": {"kind": "answer", "name": "agent_done", "request": "agent-1"}, "expect": {"state": "Idle", "outcome": "none", "sent": ["agent-1"], "cancelled": []}}
  ]
}
