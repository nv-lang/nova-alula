{
  "format": "scenario/0",
  "machine": "session_start",
  "name": "FLOW: the same reply of the nested machine comes twice: the first is taken, the second is dropped (one request - one answer)",
  "start_at": 1000,
  "steps": [
    {
      "do": "feed",
      "host": {
        "reply_validation": {
          "$variant": "ReplyCheck",
          "name": "Valid",
          "fields": {}
        },
        "close_agent_turn": null,
        "launch_scope": {
          "$variant": "LaunchScope",
          "name": "Fits",
          "fields": {}
        },
        "launch_profile": {
          "$record": "AgentProfile",
          "fields": {
            "family": "claude",
            "model": "m1",
            "effort": null
          }
        },
        "session_context": "the prompt of s3",
        "parse_session_artifact": {
          "$record": "SessionParsing",
          "fields": {
            "result": {
              "$variant": "SessionResult",
              "name": "Done",
              "fields": {}
            },
            "summary": null,
            "findings": null
          }
        },
        "stop_agent_group": null
      },
      "event": {
        "kind": "start",
        "request": "up-1",
        "input": {
          "session": "s3",
          "task_dir": "/t",
          "repo_dir": "/r",
          "delivery_mode": "files",
          "route": "full",
          "delivery_short": false
        }
      },
      "expect": {
        "state": "Gate2",
        "journal": [],
        "open": [],
        "sent": [],
        "queue": [],
        "outcome": "none",
        "data": {
          "call_request_id": "up-1",
          "step_attempt": 0,
          "open_requests": [],
          "session": "s3",
          "stop_reason": ""
        }
      }
    },
    {
      "do": "feed",
      "event": {
        "kind": "word",
        "name": "confirm"
      },
      "expect": {
        "state": "Session",
        "open": [
          "agent_step-1"
        ],
        "sent": [
          "agent_step-1"
        ],
        "outcome": "none",
        "data": {
          "step_attempt": 1,
          "open_requests": [
            "agent_step-1"
          ]
        }
      },
      "also": {
        "agent_step-1": {
          "state": "AgentTurn",
          "open": [
            "agent-1"
          ],
          "sent": [
            "agent-1"
          ],
          "outcome": "none",
          "data": {
            "call_request_id": "agent_step-1",
            "open_requests": [
              "agent-1"
            ]
          }
        }
      }
    },
    {
      "do": "feed",
      "event": {
        "kind": "answer",
        "name": "agent_done",
        "request": "agent-1",
        "input": {
          "$variant": "TurnResult",
          "name": "Finished",
          "fields": {
            "text": "Привет, мир",
            "artifact": null,
            "usage": {
              "$record": "TransportUsage",
              "fields": {
                "model": {
                  "$record": "AgentModel",
                  "fields": {
                    "id": "m1",
                    "provider": "p",
                    "variant": null
                  }
                },
                "tokens": {
                  "$record": "TokenUsage",
                  "fields": {
                    "input": 10,
                    "output": 5,
                    "reasoning": null,
                    "cache_read": null,
                    "cache_write": null
                  }
                },
                "cost": null,
                "context_used": null,
                "request_started": 5
              }
            }
          }
        }
      },
      "on": "agent_step-1",
      "expect": {
        "state": "End",
        "open": []
      },
      "also": {
        "parent": {
          "queue": [
            "in answer"
          ]
        }
      }
    },
    {
      "do": "deliver",
      "event": {
        "kind": "answer",
        "request": "agent_step-1",
        "input": "{\"$record\":\"AgentReply\",\"fields\":{\"artifact\":null,\"request_started\":5,\"text\":\"again\",\"usage\":{\"$record\":\"Usage\",\"fields\":{\"context_used\":null,\"cost\":null,\"created\":1000,\"family\":\"claude\",\"model\":{\"$record\":\"AgentModel\",\"fields\":{\"id\":\"m1\",\"provider\":\"p\",\"variant\":null}},\"result\":\"reply\",\"session\":\"s3\",\"step\":0,\"tokens\":{\"$record\":\"TokenUsage\",\"fields\":{\"cache_read\":null,\"cache_write\":null,\"input\":10,\"output\":5,\"reasoning\":null}},\"trace\":\"t\",\"updated\":1000}}}}"
      },
      "expect": {
        "queue": [
          "in answer",
          "in answer"
        ]
      }
    },
    {
      "do": "pump",
      "expect": {
        "state": "End",
        "queue": [],
        "journal": [
          {
            "code": "session_result",
            "params": {
              "session": "s3",
              "outcome": "done"
            }
          }
        ]
      }
    },
    {
      "do": "pump",
      "expect": {
        "state": "End",
        "queue": [],
        "journal": []
      }
    }
  ]
}
