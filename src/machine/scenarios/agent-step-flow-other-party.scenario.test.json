{
  "format": "scenario/0",
  "machine": "agent_step",
  "name": "in the pause the late answer of the agent and the word of the gate are dropped; the pause waits for its own words",
  "start_at": 1000,
  "steps": [
    {"do": "feed", "event": {"kind": "start", "request": "call-1", "input": {"kind": {"$variant": "CallerKind", "name": "CycleSession", "fields": {}}, "profile": {"$record": "AgentProfile", "fields": {"family": "claude", "model": "m1", "effort": null}}, "session": "s1", "dialog_kind": "main", "context": "ctx", "limits": {"$record": "AgentLimits", "fields": {"silence_term": null, "token_budget": null, "cost_budget": null, "turn_limit": null}}, "trace": "t1", "step": 0}}, "host": {"reply_validation": {"$variant": "ReplyCheck", "name": "Valid", "fields": {}}, "close_agent_turn": null}, "expect": {"state": "AgentTurn", "journal": [], "data": {"turn_count": 1, "started": 1000, "turn": "first", "agent_attempt": 1, "open_requests": ["agent-1"], "call_request_id": "call-1"}, "open": ["agent-1"], "sent": ["agent-1"]}},
    {"do": "feed", "event": {"kind": "signal", "name": "human_stop", "input": {"human_word": "w", "author": "ann", "source": "console"}}, "expect": {"state": "Pause"}},
    {"do": "feed", "event": {"kind": "answer", "name": "agent_done", "request": "agent-1", "input": {"$variant": "TurnResult", "name": "Finished", "fields": {"text": "hello", "artifact": null, "usage": {"$record": "TransportUsage", "fields": {"model": {"$record": "AgentModel", "fields": {"id": "m1", "provider": "p", "variant": null}}, "tokens": {"$record": "TokenUsage", "fields": {"input": 10, "output": 5, "reasoning": null, "cache_read": null, "cache_write": null}}, "cost": null, "context_used": null, "request_started": 5}}}}}, "expect": {"state": "Pause", "journal": [], "open": []}},
    {"do": "feed", "event": {"kind": "signal", "name": "allow"}, "expect": {"state": "Pause", "journal": [{"code": "event_ignored", "params": {"event": "allow", "state": "Pause"}}]}},
    {"do": "feed", "event": {"kind": "signal", "name": "continue", "input": {"human_word": "w", "author": "ann", "source": "console"}}, "expect": {"state": "AgentTurn", "sent": ["agent-1", "agent-2"]}}
  ]
}
