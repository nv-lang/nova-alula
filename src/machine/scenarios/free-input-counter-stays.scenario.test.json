{
  "format": "scenario/0",
  "machine": "DialogSession",
  "name": "free input: two turns of the dialog grow the counter of the agent to 2 and leave the counter of the user at 0",
  "start_at": 1000,
  "params": {"проект.срок_бездействия": 30000},
  "steps": [
    {"do": "feed", "event": {"kind": "signal", "name": "user_message", "input": "one"}, "expect": {"state": "Awaiting", "open": ["agent-1"], "data": {"user_attempt": 0, "agent_attempt": 1}}},
    {"do": "feed", "event": {"kind": "answer", "name": "agent_done", "request": "agent-1"}, "expect": {"state": "Idle", "open": [], "data": {"user_attempt": 0, "agent_attempt": 1}}},
    {"do": "feed", "event": {"kind": "signal", "name": "user_message", "input": "two"}, "expect": {"state": "Awaiting", "open": ["agent-2"], "data": {"user_attempt": 0, "agent_attempt": 2}}}
  ]
}
