{
  "format": "scenario/0",
  "machine": "DialogSession",
  "name": "(table only) the word close_session in Idle ends the session: the end Closed answers closed",
  "start_at": 1000,
  "params": {"проект.срок_бездействия": 30000},
  "steps": [
    {"do": "feed", "event": {"kind": "word", "name": "user_message", "input": "hi"}, "expect": {"state": "Awaiting"}},
    {"do": "feed", "event": {"kind": "answer", "name": "agent_done", "request": "agent-1"}, "expect": {"state": "Idle"}},
    {"do": "feed", "event": {"kind": "word", "name": "close_session"}, "expect": {"state": "Closed", "journal": [{"code": "session_closed", "params": {}}], "open": [], "outcome": "answer:closed"}},
    {"do": "feed", "event": {"kind": "word", "name": "user_message", "input": "late"}, "expect": {"state": "Closed", "journal": [{"code": "event_ignored", "params": {"event": "user_message", "state": "Closed"}}], "outcome": "answer:closed"}}
  ]
}
