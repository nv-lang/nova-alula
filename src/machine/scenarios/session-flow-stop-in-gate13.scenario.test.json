{
  "format": "scenario/0",
  "machine": "session_start",
  "name": "FLOW: a human stops the launch at B13 and then says continue: B13 again; the session is repeated after it",
  "start_at": 1000,
  "steps": [
    {
      "do": "feed",
      "host": {
        "reply_validation": {
          "$variant": "ReplyCheck",
          "name": "Valid",
          "fields": {}
        },
        "close_agent_turn": null,
        "launch_scope": {
          "$variant": "LaunchScope",
          "name": "Fits",
          "fields": {}
        },
        "launch_profile": {
          "$record": "AgentProfile",
          "fields": {
            "family": "claude",
            "model": "m1",
            "effort": null
          }
        },
        "session_context": "the prompt of s3",
        "parse_session_artifact": {
          "$record": "SessionParsing",
          "fields": {
            "result": {
              "$variant": "SessionResult",
              "name": "Done",
              "fields": {}
            },
            "summary": null,
            "findings": null
          }
        },
        "stop_agent_group": null
      },
      "event": {
        "kind": "start",
        "request": "up-1",
        "input": {
          "session": "s3",
          "task_dir": "/t",
          "repo_dir": "/r",
          "delivery_mode": "files",
          "route": "full",
          "delivery_short": false
        }
      },
      "expect": {
        "state": "Gate2",
        "journal": [],
        "open": [],
        "sent": [],
        "queue": [],
        "outcome": "none",
        "data": {
          "call_request_id": "up-1",
          "step_attempt": 0,
          "open_requests": [],
          "session": "s3",
          "stop_reason": ""
        }
      }
    },
    {
      "do": "feed",
      "event": {
        "kind": "word",
        "name": "confirm"
      },
      "expect": {
        "state": "Session",
        "open": [
          "agent_step-1"
        ],
        "sent": [
          "agent_step-1"
        ],
        "outcome": "none",
        "data": {
          "step_attempt": 1,
          "open_requests": [
            "agent_step-1"
          ]
        }
      },
      "also": {
        "agent_step-1": {
          "state": "AgentTurn",
          "open": [
            "agent-1"
          ],
          "sent": [
            "agent-1"
          ],
          "outcome": "none",
          "data": {
            "call_request_id": "agent_step-1",
            "open_requests": [
              "agent-1"
            ]
          }
        }
      }
    },
    {
      "do": "feed",
      "event": {
        "kind": "answer",
        "name": "agent_done",
        "request": "agent-1",
        "input": {
          "$variant": "TurnResult",
          "name": "PermanentError",
          "fields": {}
        }
      },
      "on": "agent_step-1",
      "expect": {
        "state": "Halted",
        "open": [],
        "outcome": "refusal:NoResult"
      },
      "also": {
        "parent": {
          "queue": [
            "in failure"
          ]
        }
      }
    },
    {
      "do": "pump",
      "expect": {
        "state": "Gate13Session",
        "open": [],
        "queue": [],
        "outcome": "none",
        "journal": [
          {
            "code": "session_not_finished",
            "params": {
              "session": "s3",
              "reason": "no_result"
            }
          }
        ],
        "data": {
          "step_attempt": 1,
          "open_requests": []
        }
      }
    },
    {
      "do": "feed",
      "event": {
        "kind": "signal",
        "name": "human_stop",
        "input": {
          "human_word": "stop",
          "author": "ann",
          "source": "console"
        }
      },
      "expect": {
        "state": "Pause",
        "data": {
          "previous": "Gate13Session"
        }
      }
    },
    {
      "do": "feed",
      "event": {
        "kind": "word",
        "name": "continue",
        "input": {
          "human_word": "go",
          "author": "ann",
          "source": "console"
        }
      },
      "expect": {
        "state": "Gate13Session"
      }
    },
    {
      "do": "feed",
      "event": {
        "kind": "word",
        "name": "repeat"
      },
      "expect": {
        "state": "Session",
        "open": [
          "agent_step-2"
        ],
        "sent": [
          "agent_step-1",
          "agent_step-2"
        ],
        "journal": [],
        "data": {
          "step_attempt": 2,
          "open_requests": [
            "agent_step-2"
          ]
        }
      },
      "also": {
        "agent_step-2": {
          "state": "AgentTurn",
          "open": [
            "agent-1"
          ],
          "sent": [
            "agent-1"
          ]
        }
      }
    }
  ]
}
