{
  "format": "scenario/0",
  "machine": "ChatSession",
  "name": "the idle term in Awaiting ends the session with Timeout",
  "start_at": 1000,
  "steps": [
    {"do": "feed", "event": {"kind": "signal", "name": "user_message", "input": "hi"}, "expect": {"state": "Awaiting"}},
    {"do": "feed", "event": {"kind": "timeout", "name": "timeout", "request": "agent-1"}, "expect": {"state": "Failed", "journal": [{"code": "no_answer_in_time", "params": {}}], "outcome": "refusal:Timeout", "open": [], "cancelled": ["agent-1"]}}
  ]
}
