{
  "format": "scenario/0",
  "machine": "session_start",
  "name": "PAUSE 3: the parent of the launch stops it (the signal with the id of the request) and then says continue: the launch is paused and goes on",
  "start_at": 1000,
  "steps": [
    {
      "do": "feed",
      "host": {
        "reply_validation": {
          "$variant": "ReplyCheck",
          "name": "Valid",
          "fields": {}
        },
        "close_agent_turn": null,
        "launch_scope": {
          "$variant": "LaunchScope",
          "name": "Fits",
          "fields": {}
        },
        "launch_profile": {
          "$record": "AgentProfile",
          "fields": {
            "family": "claude",
            "model": "m1",
            "effort": null
          }
        },
        "session_context": "the prompt of s3",
        "parse_session_artifact": {
          "$record": "SessionParsing",
          "fields": {
            "result": {
              "$variant": "SessionResult",
              "name": "Done",
              "fields": {}
            },
            "summary": null,
            "findings": null
          }
        },
        "stop_agent_group": null
      },
      "event": {
        "kind": "start",
        "request": "up-1",
        "input": {
          "session": "s3",
          "task_dir": "/t",
          "repo_dir": "/r",
          "delivery_mode": "files",
          "route": "full",
          "delivery_short": false
        }
      },
      "expect": {
        "state": "Gate2",
        "journal": [],
        "open": [],
        "sent": [],
        "queue": [],
        "outcome": "none",
        "data": {
          "call_request_id": "up-1",
          "step_attempt": 0,
          "open_requests": [],
          "session": "s3",
          "stop_reason": ""
        }
      }
    },
    {
      "do": "feed",
      "event": {
        "kind": "word",
        "name": "confirm"
      },
      "expect": {
        "state": "Session",
        "open": [
          "agent_step-1"
        ],
        "sent": [
          "agent_step-1"
        ],
        "outcome": "none",
        "data": {
          "step_attempt": 1,
          "open_requests": [
            "agent_step-1"
          ]
        }
      },
      "also": {
        "agent_step-1": {
          "state": "AgentTurn",
          "open": [
            "agent-1"
          ],
          "sent": [
            "agent-1"
          ],
          "outcome": "none",
          "data": {
            "call_request_id": "agent_step-1",
            "open_requests": [
              "agent-1"
            ]
          }
        }
      }
    },
    {
      "do": "feed",
      "event": {
        "kind": "signal",
        "name": "parent_stop",
        "input": "up-1"
      },
      "expect": {
        "state": "Pause",
        "open": [
          "agent_step-1"
        ],
        "data": {
          "previous": "Session"
        }
      },
      "also": {
        "agent_step-1": {
          "state": "Pause"
        }
      }
    },
    {
      "do": "feed",
      "event": {
        "kind": "signal",
        "name": "parent_continue",
        "input": "up-1"
      },
      "expect": {
        "state": "Session",
        "open": [
          "agent_step-1"
        ],
        "sent": [
          "agent_step-1"
        ]
      },
      "also": {
        "agent_step-1": {
          "state": "AgentTurn",
          "sent": [
            "agent-1",
            "agent-2"
          ],
          "open": [
            "agent-2"
          ]
        }
      }
    }
  ]
}
