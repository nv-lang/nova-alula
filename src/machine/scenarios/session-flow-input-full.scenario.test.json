{
  "format": "scenario/0",
  "machine": "session_start",
  "name": "FLOW: every optional field of the input is given: the data keep them; the launch starts",
  "start_at": 1000,
  "steps": [
    {
      "do": "feed",
      "host": {
        "reply_validation": {
          "$variant": "ReplyCheck",
          "name": "Valid",
          "fields": {}
        },
        "close_agent_turn": null,
        "launch_scope": {
          "$variant": "LaunchScope",
          "name": "Fits",
          "fields": {}
        },
        "launch_profile": {
          "$record": "AgentProfile",
          "fields": {
            "family": "claude",
            "model": "m1",
            "effort": null
          }
        },
        "session_context": "the prompt of s4",
        "parse_session_artifact": {
          "$record": "SessionParsing",
          "fields": {
            "result": {
              "$variant": "SessionResult",
              "name": "Done",
              "fields": {}
            },
            "summary": null,
            "findings": null
          }
        },
        "stop_agent_group": null
      },
      "event": {
        "kind": "start",
        "request": "up-1",
        "input": {
          "session": "s4",
          "task_dir": "/t",
          "repo_dir": "/r",
          "delivery_mode": "files",
          "route": "quick",
          "delivery_short": true,
          "launch_source": "the answers",
          "phase": "analysis",
          "launch_pass": 2,
          "source_list": "a.md, b.md"
        }
      },
      "expect": {
        "state": "Gate2",
        "journal": [],
        "open": [],
        "sent": [],
        "queue": [],
        "outcome": "none",
        "data": {
          "call_request_id": "up-1",
          "step_attempt": 0,
          "open_requests": [],
          "session": "s4",
          "stop_reason": "",
          "launch_source": "the answers",
          "phase": "analysis",
          "launch_pass": 2,
          "source_list": "a.md, b.md",
          "route": "quick",
          "delivery_short": true,
          "task_dir": "/t",
          "repo_dir": "/r",
          "delivery_mode": "files"
        }
      }
    }
  ]
}
