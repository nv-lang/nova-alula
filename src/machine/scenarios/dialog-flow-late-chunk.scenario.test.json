{
  "format": "scenario/0",
  "machine": "DialogSession",
  "name": "a late chunk of a closed request is discarded by the engine and reopens nothing",
  "start_at": 1000,
  "params": {"проект.срок_бездействия": 30000},
  "steps": [
    {"do": "feed", "event": {"kind": "word", "name": "user_message", "input": "hi"}, "expect": {"state": "Awaiting"}},
    {"do": "feed", "event": {"kind": "answer", "name": "agent_done", "request": "agent-1"}, "expect": {"state": "Idle", "outcome": "none"}},
    {"do": "feed", "event": {"kind": "progress", "name": "agent_chunk", "request": "agent-1", "input": "late"}, "expect": {"state": "Idle", "journal": [], "outcome": "none", "open": []}}
  ]
}
