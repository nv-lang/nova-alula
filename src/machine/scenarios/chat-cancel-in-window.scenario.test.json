{
  "format": "scenario/0",
  "machine": "ChatSession",
  "name": "the cancel arrives in the window between the commit and the send",
  "start_at": 1000,
  "steps": [
    {"do": "accept", "event": {"kind": "signal", "name": "user_message", "input": "hi"}, "expect": {"state": "Awaiting", "sent": [], "queue": ["send agent-1"]}},
    {"do": "accept", "event": {"kind": "signal", "name": "cancel"}, "expect": {"state": "Failed", "outcome": "refusal:StoppedByHuman", "open": [], "queue": ["send agent-1", "cancel agent-1"]}},
    {"do": "dispatch", "expect": {"sent": ["agent-1"], "cancelled": ["agent-1"], "queue": []}}
  ]
}
