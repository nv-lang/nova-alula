{
  "format": "scenario/0",
  "machine": "ChatSession",
  "name": "an event with a key of the source is acknowledged after the commit",
  "start_at": 1000,
  "steps": [
    {"do": "feed", "event": {"kind": "word", "name": "user_message", "input": "hi"}, "expect": {"state": "Awaiting"}},
    {"do": "deliver", "event": {"kind": "progress", "name": "agent_chunk", "request": "agent-1", "input": "a", "source": "acp-7"}},
    {"do": "pump", "expect": {"state": "Awaiting", "journal": [{"code": "agent_chunk", "params": {"text": "a"}}]}}
  ]
}
