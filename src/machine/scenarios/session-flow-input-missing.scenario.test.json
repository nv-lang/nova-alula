{
  "format": "scenario/0",
  "machine": "session_start",
  "name": "FLOW: the input has no session: the call is refused with NoResult and the journal says what is missing; nothing is asked of anybody",
  "start_at": 1000,
  "steps": [
    {
      "do": "feed",
      "host": {
        "reply_validation": {
          "$variant": "ReplyCheck",
          "name": "Valid",
          "fields": {}
        },
        "close_agent_turn": null,
        "launch_scope": {
          "$variant": "LaunchScope",
          "name": "Fits",
          "fields": {}
        },
        "launch_profile": {
          "$record": "AgentProfile",
          "fields": {
            "family": "claude",
            "model": "m1",
            "effort": null
          }
        },
        "session_context": "the prompt of s3",
        "parse_session_artifact": {
          "$record": "SessionParsing",
          "fields": {
            "result": {
              "$variant": "SessionResult",
              "name": "Done",
              "fields": {}
            },
            "summary": null,
            "findings": null
          }
        },
        "stop_agent_group": null
      },
      "event": {
        "kind": "start",
        "request": "up-1",
        "input": {
          "task_dir": "/t",
          "repo_dir": "/r",
          "delivery_mode": "files",
          "route": "full",
          "delivery_short": false
        }
      },
      "expect": {
        "outcome": "refusal:NoResult",
        "open": [],
        "sent": [],
        "journal": [
          {
            "code": "input_rejected",
            "params": {
              "reason": "missing",
              "field": "session"
            }
          }
        ]
      }
    }
  ]
}
