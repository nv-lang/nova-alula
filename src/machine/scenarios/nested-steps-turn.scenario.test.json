{
  "format": "scenario/0",
  "machine": "dialog_steps",
  "name": "a chat turn: the agent step is the nested machine; its answer is the answer of the turn and the session waits for the next word",
  "start_at": 1000,
  "steps": [
    {
      "do": "feed",
      "host": {
        "reply_validation": {
          "$variant": "ReplyCheck",
          "name": "Valid",
          "fields": {}
        },
        "close_agent_turn": null
      },
      "event": {
        "kind": "start",
        "request": "up-1",
        "input": {
          "kind": {
            "$variant": "CallerKind",
            "name": "CycleSession",
            "fields": {}
          },
          "profile": {
            "$record": "AgentProfile",
            "fields": {
              "family": "claude",
              "model": "m1",
              "effort": null
            }
          },
          "session": "s1",
          "dialog_kind": "main",
          "context": "ctx",
          "limits": {
            "$record": "AgentLimits",
            "fields": {
              "silence_term": null,
              "token_budget": null,
              "cost_budget": null,
              "turn_limit": null
            }
          },
          "trace": "t1",
          "step": 0
        }
      },
      "expect": {
        "state": "Turn",
        "open": [
          "call-1"
        ],
        "sent": [
          "call-1"
        ],
        "outcome": "none",
        "data": {
          "open_requests": [
            "call-1"
          ],
          "step_attempt": 1
        }
      },
      "also": {
        "call-1": {
          "state": "AgentTurn",
          "open": [
            "agent-1"
          ],
          "sent": [
            "agent-1"
          ],
          "data": {
            "call_request_id": "call-1",
            "open_requests": [
              "agent-1"
            ]
          }
        }
      }
    },
    {
      "do": "feed",
      "event": {
        "kind": "answer",
        "name": "agent_done",
        "request": "agent-1",
        "input": {
          "$variant": "TurnResult",
          "name": "Finished",
          "fields": {
            "text": "Привет, мир",
            "artifact": null,
            "usage": {
              "$record": "TransportUsage",
              "fields": {
                "model": {
                  "$record": "AgentModel",
                  "fields": {
                    "id": "m1",
                    "provider": "p",
                    "variant": null
                  }
                },
                "tokens": {
                  "$record": "TokenUsage",
                  "fields": {
                    "input": 10,
                    "output": 5,
                    "reasoning": null,
                    "cache_read": null,
                    "cache_write": null
                  }
                },
                "cost": null,
                "context_used": null,
                "request_started": 5
              }
            }
          }
        }
      },
      "on": "call-1",
      "expect": {
        "state": "End",
        "open": []
      },
      "also": {
        "parent": {
          "queue": [
            "in answer"
          ]
        }
      }
    },
    {
      "do": "pump",
      "expect": {
        "state": "Wait",
        "open": [],
        "journal": [
          {
            "code": "turn_answered",
            "params": {
              "session": "s1"
            }
          }
        ],
        "data": {
          "turn_count": 1,
          "stop_code": "",
          "open_requests": []
        }
      }
    }
  ]
}
