{
  "format": "scenario/0",
  "machine": "DialogSession",
  "name": "a refusal, a timeout, a cancel and an answer end four turns, the session goes on and numbers the requests",
  "start_at": 1000,
  "params": {"проект.срок_бездействия": 30000},
  "steps": [
    {"do": "feed", "event": {"kind": "signal", "name": "user_message", "input": "a"}, "expect": {"state": "Awaiting", "open": ["agent-1"]}},
    {"do": "feed", "event": {"kind": "failure", "name": "agent_refused", "request": "agent-1", "code": "ModelRefused"}, "expect": {"state": "Idle", "journal": [{"code": "agent_refused", "params": {"code": "model_refused"}}], "open": [], "outcome": "none"}},
    {"do": "feed", "event": {"kind": "signal", "name": "user_message", "input": "b"}, "expect": {"state": "Awaiting", "open": ["agent-2"], "sent": ["agent-1", "agent-2"]}},
    {"do": "advance", "ms": 31000},
    {"do": "pump", "expect": {"state": "Idle", "journal": [{"code": "no_answer_in_time", "params": {}}], "open": [], "cancelled": ["agent-2"], "outcome": "none"}},
    {"do": "feed", "event": {"kind": "signal", "name": "user_message", "input": "c"}, "expect": {"state": "Awaiting", "open": ["agent-3"], "sent": ["agent-1", "agent-2", "agent-3"]}},
    {"do": "feed", "event": {"kind": "signal", "name": "cancel"}, "expect": {"state": "Idle", "journal": [{"code": "cancelled_while_waiting", "params": {}}], "open": [], "cancelled": ["agent-2", "agent-3"], "outcome": "none"}},
    {"do": "feed", "event": {"kind": "signal", "name": "user_message", "input": "d"}, "expect": {"state": "Awaiting", "open": ["agent-4"]}},
    {"do": "feed", "event": {"kind": "progress", "name": "agent_chunk", "request": "agent-4", "input": "fine"}, "expect": {"state": "Awaiting"}},
    {"do": "feed", "event": {"kind": "answer", "name": "agent_done", "request": "agent-4"}, "expect": {"state": "Idle", "open": [], "sent": ["agent-1", "agent-2", "agent-3", "agent-4"], "outcome": "none"}}
  ]
}
