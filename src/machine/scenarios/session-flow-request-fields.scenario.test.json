{
  "format": "scenario/0",
  "machine": "session_start",
  "name": "FLOW: the request of the agent step: the kind of the caller (a cycle session), the profile and the context of the host, the session, the main dialog, no limits",
  "start_at": 1000,
  "steps": [
    {
      "do": "feed",
      "host": {
        "reply_validation": {
          "$variant": "ReplyCheck",
          "name": "Valid",
          "fields": {}
        },
        "close_agent_turn": null,
        "launch_scope": {
          "$variant": "LaunchScope",
          "name": "Fits",
          "fields": {}
        },
        "launch_profile": {
          "$record": "AgentProfile",
          "fields": {
            "family": "claude",
            "model": "m1",
            "effort": null
          }
        },
        "session_context": "the prompt of s3",
        "parse_session_artifact": {
          "$record": "SessionParsing",
          "fields": {
            "result": {
              "$variant": "SessionResult",
              "name": "Done",
              "fields": {}
            },
            "summary": null,
            "findings": null
          }
        },
        "stop_agent_group": null
      },
      "event": {
        "kind": "start",
        "request": "up-1",
        "input": {
          "session": "s3",
          "task_dir": "/t",
          "repo_dir": "/r",
          "delivery_mode": "files",
          "route": "full",
          "delivery_short": false
        }
      },
      "expect": {
        "state": "Gate2",
        "journal": [],
        "open": [],
        "sent": [],
        "queue": [],
        "outcome": "none",
        "data": {
          "call_request_id": "up-1",
          "step_attempt": 0,
          "open_requests": [],
          "session": "s3",
          "stop_reason": ""
        }
      }
    },
    {
      "do": "feed",
      "event": {
        "kind": "signal",
        "name": "confirm"
      },
      "expect": {
        "state": "Session",
        "open": [
          "agent_step-1"
        ],
        "sent": [
          "agent_step-1"
        ],
        "outcome": "none",
        "data": {
          "step_attempt": 1,
          "open_requests": [
            "agent_step-1"
          ]
        }
      },
      "also": {
        "agent_step-1": {
          "state": "AgentTurn",
          "open": [
            "agent-1"
          ],
          "sent": [
            "agent-1"
          ],
          "outcome": "none",
          "data": {
            "call_request_id": "agent_step-1",
            "open_requests": [
              "agent-1"
            ],
            "agent_request": {
              "$record": "AgentRequest",
              "fields": {
                "kind": {
                  "$variant": "CallerKind",
                  "name": "CycleSession",
                  "fields": {}
                },
                "profile": {
                  "$record": "AgentProfile",
                  "fields": {
                    "family": "claude",
                    "model": "m1",
                    "effort": null
                  }
                },
                "session": "s3",
                "dialog_kind": "main",
                "context": "the prompt of s3",
                "limits": {
                  "$record": "AgentLimits",
                  "fields": {
                    "silence_term": null,
                    "token_budget": null,
                    "cost_budget": null,
                    "turn_limit": null
                  }
                },
                "trace": "t1000-chat-1",
                "step": 3
              }
            }
          }
        }
      }
    }
  ]
}
