{
  "format": "scenario/0",
  "machine": "caller",
  "name": "a call: the stop of a human is passed to the nested machine, it pauses; continue is passed too, the nested machine asks its agent again",
  "start_at": 1000,
  "steps": [
    {
      "do": "feed",
      "event": {
        "kind": "start",
        "request": "up-1",
        "input": {
          "task": "t"
        }
      },
      "expect": {
        "state": "Call",
        "journal": [],
        "open": [
          "callee-1"
        ],
        "sent": [
          "callee-1"
        ],
        "queue": [],
        "outcome": "none",
        "data": {
          "call_request_id": "up-1",
          "child_attempt": 1,
          "open_requests": [
            "callee-1"
          ]
        }
      },
      "also": {
        "callee-1": {
          "state": "Ask",
          "open": [
            "agent-1"
          ],
          "sent": [
            "agent-1"
          ],
          "queue": [],
          "outcome": "none",
          "data": {
            "label": "t",
            "count": 3,
            "profile": "fast",
            "call_request_id": "callee-1",
            "agent_attempt": 1,
            "open_requests": [
              "agent-1"
            ]
          }
        }
      }
    },
    {
      "do": "feed",
      "event": {
        "kind": "signal",
        "name": "human_stop",
        "input": {
          "human_word": "stop",
          "author": "ann",
          "source": "console"
        }
      },
      "expect": {
        "state": "Pause",
        "open": [
          "callee-1"
        ],
        "cancelled": [],
        "data": {
          "previous": "Call",
          "open_requests": [
            "callee-1"
          ]
        }
      },
      "also": {
        "callee-1": {
          "state": "Pause",
          "cancelled": [
            "agent-1"
          ],
          "open": [],
          "data": {
            "previous": "Ask"
          }
        }
      }
    },
    {
      "do": "feed",
      "event": {
        "kind": "signal",
        "name": "continue",
        "input": {
          "human_word": "go",
          "author": "ann",
          "source": "console"
        }
      },
      "expect": {
        "state": "Call",
        "open": [
          "callee-1"
        ],
        "sent": [
          "callee-1"
        ],
        "data": {
          "child_attempt": 1
        }
      },
      "also": {
        "callee-1": {
          "state": "Ask",
          "sent": [
            "agent-1",
            "agent-2"
          ],
          "open": [
            "agent-2"
          ],
          "data": {
            "agent_attempt": 2
          }
        }
      }
    },
    {
      "do": "feed",
      "event": {
        "kind": "answer",
        "request": "agent-2",
        "input": "again"
      },
      "on": "callee-1",
      "expect": {
        "state": "Done"
      }
    },
    {
      "do": "pump",
      "expect": {
        "state": "Done",
        "outcome": "answer:again"
      }
    }
  ]
}
