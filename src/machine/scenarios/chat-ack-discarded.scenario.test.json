{
  "format": "scenario/0",
  "machine": "ChatSession",
  "name": "a discarded event with a key is acknowledged too",
  "start_at": 1000,
  "steps": [
    {"do": "feed", "event": {"kind": "signal", "name": "user_message", "input": "hi"}, "expect": {"state": "Awaiting"}},
    {"do": "feed", "event": {"kind": "answer", "name": "agent_done", "request": "agent-1"}, "expect": {"state": "Done"}},
    {"do": "deliver", "event": {"kind": "progress", "name": "agent_chunk", "request": "agent-1", "input": "late", "source": "acp-9"}},
    {"do": "pump", "expect": {"state": "Done", "journal": []}}
  ]
}
