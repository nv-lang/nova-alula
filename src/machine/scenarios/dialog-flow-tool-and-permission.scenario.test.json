{
  "format": "scenario/0",
  "machine": "DialogSession",
  "name": "tool and permission events are not answer text",
  "start_at": 1000,
  "params": {"проект.срок_бездействия": 30000},
  "steps": [
    {"do": "feed", "event": {"kind": "word", "name": "user_message", "input": "hi"}, "expect": {"state": "Awaiting"}},
    {"do": "feed", "event": {"kind": "progress", "name": "tool_call", "request": "agent-1", "input": "{\"id\":\"c1\",\"title\":\"t\"}"}, "expect": {"state": "Awaiting", "journal": [{"code": "event_unknown", "params": {"name": "tool_call"}}], "data": {"reply": ""}}},
    {"do": "feed", "event": {"kind": "progress", "name": "permission_request", "request": "agent-1", "input": "{\"request\":\"5\"}"}, "expect": {"state": "Awaiting", "journal": [{"code": "event_unknown", "params": {"name": "permission_request"}}]}},
    {"do": "feed", "event": {"kind": "progress", "name": "agent_chunk", "request": "agent-1", "input": "text"}, "expect": {"state": "Awaiting"}},
    {"do": "feed", "event": {"kind": "answer", "name": "agent_done", "request": "agent-1"}, "expect": {"state": "Idle", "outcome": "none"}}
  ]
}
