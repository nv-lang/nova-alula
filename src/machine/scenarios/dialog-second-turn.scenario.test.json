{
  "format": "scenario/0",
  "machine": "DialogSession",
  "name": "the next message after an answer opens the request agent-2 and nothing of the first turn is carried over",
  "start_at": 1000,
  "params": {"проект.срок_бездействия": 30000},
  "steps": [
    {"do": "feed", "event": {"kind": "word", "name": "user_message", "input": "one"}, "expect": {"state": "Awaiting", "journal": [{"code": "user_message", "params": {"text": "one"}}], "open": ["agent-1"], "sent": ["agent-1"], "outcome": "none", "data": {"user": "one", "reply": ""}}},
    {"do": "feed", "event": {"kind": "progress", "name": "agent_chunk", "request": "agent-1", "input": "A"}, "expect": {"state": "Awaiting", "data": {"user": "one", "reply": "A"}}},
    {"do": "feed", "event": {"kind": "answer", "name": "agent_done", "request": "agent-1"}, "expect": {"state": "Idle", "journal": [{"code": "agent_done", "params": {}}], "open": [], "outcome": "none", "data": {"user": "", "reply": ""}}},
    {"do": "feed", "event": {"kind": "word", "name": "user_message", "input": "two"}, "expect": {"state": "Awaiting", "journal": [{"code": "user_message", "params": {"text": "two"}}], "open": ["agent-2"], "sent": ["agent-1", "agent-2"], "data": {"user": "two", "reply": ""}}},
    {"do": "feed", "event": {"kind": "progress", "name": "agent_chunk", "request": "agent-2", "input": "B"}, "expect": {"state": "Awaiting", "data": {"user": "two", "reply": "B"}}},
    {"do": "feed", "event": {"kind": "answer", "name": "agent_done", "request": "agent-2"}, "expect": {"state": "Idle", "open": [], "sent": ["agent-1", "agent-2"], "outcome": "none"}}
  ]
}
