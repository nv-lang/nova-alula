// data.nv - the data files that live beside the core and are compiled into the binary: the schemas (`schema/`), the machines written as
// JSON (`machines/`) and the scenarios (`scenarios/`). `embed_str` reads a file at compile time, relative to this file, so the tests and the
// product need no file system to find them. The lists of the files are written here by hand (a new file is a new line; a test of the unit
// `machine_run` fails when a scenario file of the directory is missing from the list - see README.md, "Data").
module alula.machine

/// NamedText: a file of a data directory: its name and its text.
export type NamedText { name str, text str }

/// The machines of `machines/`, by the name of the file (`chat.alula.json`).
export fn machine_files() -> []NamedText => [
    NamedText { name: "agent_step.alula.json", text: embed_str("machines/agent_step.alula.json") },
    NamedText { name: "actions.alula.json", text: embed_str("machines/actions.alula.json") },
    NamedText { name: "calc.alula.json", text: embed_str("machines/calc.alula.json") },
    NamedText { name: "callee.alula.json", text: embed_str("machines/callee.alula.json") },
    NamedText { name: "caller.alula.json", text: embed_str("machines/caller.alula.json") },
    NamedText { name: "chat.alula.json", text: embed_str("machines/chat.alula.json") },
    NamedText { name: "cycle_check.alula.json", text: embed_str("machines/cycle_check.alula.json") },
    NamedText { name: "dialog.alula.json", text: embed_str("machines/dialog.alula.json") },
    NamedText { name: "dialog_steps.alula.json", text: embed_str("machines/dialog_steps.alula.json") },
    NamedText { name: "fan.alula.json", text: embed_str("machines/fan.alula.json") },
    NamedText { name: "gate.alula.json", text: embed_str("machines/gate.alula.json") },
    NamedText { name: "lenses.alula.json", text: embed_str("machines/lenses.alula.json") },
    NamedText { name: "session_start.alula.json", text: embed_str("machines/session_start.alula.json") },
    NamedText { name: "task_runner.alula.json", text: embed_str("machines/task_runner.alula.json") },
    NamedText { name: "variants.alula.json", text: embed_str("machines/variants.alula.json") }
]

/// The machines written as tables in Russian (format 2.5 to 2.7) in `machines/`, by the name of the file (`chat.alula.md`); the translator of `src/machine_text`
/// turns them into the JSON above.
export fn table_files() -> []NamedText => [
    NamedText { name: "agent_step.alula.txt", text: embed_str("machines/agent_step.alula.txt") },
    NamedText { name: "callee.alula.md", text: embed_str("machines/callee.alula.md") },
    NamedText { name: "caller.alula.md", text: embed_str("machines/caller.alula.md") },
    NamedText { name: "chat.alula.md", text: embed_str("machines/chat.alula.md") },
    NamedText { name: "cycle_check.alula.md", text: embed_str("machines/cycle_check.alula.md") },
    NamedText { name: "dialog.alula.md", text: embed_str("machines/dialog.alula.md") },
    NamedText { name: "dialog_steps.alula.md", text: embed_str("machines/dialog_steps.alula.md") },
    NamedText { name: "fan.alula.md", text: embed_str("machines/fan.alula.md") },
    NamedText { name: "session_start.alula.md", text: embed_str("machines/session_start.alula.md") },
    NamedText { name: "task_runner.alula.md", text: embed_str("machines/task_runner.alula.md") }
]

