    NamedText { name: "session-result-parsing-1.scenario.test.json", text: embed_str("scenarios/session-result-parsing-1.scenario.test.json") },
    NamedText { name: "session-scope-1.scenario.test.json", text: embed_str("scenarios/session-scope-1.scenario.test.json") },
    NamedText { name: "session-scope-2.scenario.test.json", text: embed_str("scenarios/session-scope-2.scenario.test.json") },
    NamedText { name: "session-session-1.scenario.test.json", text: embed_str("scenarios/session-session-1.scenario.test.json") },
    NamedText { name: "session-session-2.scenario.test.json", text: embed_str("scenarios/session-session-2.scenario.test.json") },
    NamedText { name: "variants-fail-case.scenario.test.json", text: embed_str("scenarios/variants-fail-case.scenario.test.json") },
    NamedText { name: "variants-malformed-answer.scenario.test.json", text: embed_str("scenarios/variants-malformed-answer.scenario.test.json") },
    NamedText { name: "variants-retry-then-done.scenario.test.json", text: embed_str("scenarios/variants-retry-then-done.scenario.test.json") },
