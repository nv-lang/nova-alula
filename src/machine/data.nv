// data.nv - the data files that live beside the core and are compiled into the binary: the schemas (`schema/`). `embed_str` reads a file at compile time, relative to this file, so the tests and the
// program need no file system to find them. The machines and the tests of the examples live in `examples/` of the package and are embedded by the module `alula.examples` (tests only); the machines
// of a product or of the methodology are the data of their owners (task 158, AL-113).
module alula.machine

/// NamedText: a file of a data directory: its name and its text.
export type NamedText { name str, text str }

/// The schemas of `schema/` (`machine-2.schema.json`, `test-0.schema.json`).
export fn schema_files() -> []NamedText => [
    NamedText { name: "machine-2.schema.json", text: embed_str("schema/machine-2.schema.json") },
    NamedText { name: "test-0.schema.json", text: embed_str("schema/test-0.schema.json") }
]

/// The text of the file with the name; the empty text when there is none.
export fn text_of_file(files []NamedText, name str) -> str {
    for f in files {
        if f.name == name { return f.text }
    }
    ""
}

/// The names of the schemas that the directory `schema/` holds (read at compile time with `embed_dir`): a test compares them with the list above, so a file that is added to the directory and not to the list is found.
export fn data_dir_names(dir str) -> []str {
    if dir == "schema" {
        // the folder holds the schemas and a README that describes them: only the schemas are data
        mut schemas = []str.new()
        for p in embed_dir("schema").paths() {
            if p.ends_with(".json") { schemas.push(p) }
        }
        return schemas
    }
    []str.new()
}

/// Is the name the name of a machine written as tables? The language of the tables is Alula and its files are `*.alula.md`; the former `*.table.md` and `*.table.txt` are not names
/// of the product (no transitional period, Alula 2.11). The translator reads a text and does not look at the extension. A copy kept as `.txt` (its prose links to the files of the
/// methodology, the guard of the links reads `.md` only) is a table too.
export fn is_table_name(name str) -> bool {
    for suffix in [".alula.md", ".alula.txt"] {
        if name.ends_with(suffix) { return true }
    }
    false
}

/// Is the name the name of a compiled machine (the JSON `machine/2`)? Its name is `*.alula.json` (the tree of the JSON is defined by the specification of Alula, section 6);
/// the former `*.machine.json` is not a name of the product (no transitional period, Alula 2.11).
export fn is_machine_json_name(name str) -> bool {
    for suffix in [".alula.json"] {
        if name.ends_with(suffix) { return true }
    }
    false
}

