]

/// The schemas of `schema/` (`machine-2.schema.json`, `scenario-0.schema.json`).
export fn schema_files() -> []NamedText => [
    NamedText { name: "machine-2.schema.json", text: embed_str("schema/machine-2.schema.json") },
    NamedText { name: "scenario-0.schema.json", text: embed_str("schema/scenario-0.schema.json") }
]

/// The text of the file with the name; the empty text when there is none.
export fn text_of_file(files []NamedText, name str) -> str {
    for f in files {
        if f.name == name { return f.text }
    }
    ""
}

/// The text of the machine of the chat session (`machines/chat.alula.json`).
export fn chat_machine_text() -> str => text_of_file(machine_files(), "chat.alula.json")

/// The text of the machine of the many-turn chat session (`machines/dialog.alula.json`), the translation of `dialog.alula.md`: the machine that the session server runs.
export fn dialog_machine_text() -> str => text_of_file(machine_files(), "dialog.alula.json")

/// The text of the machine of the agent step (`machines/agent_step.alula.json`), the translation of its table.
export fn agent_step_machine_text() -> str => text_of_file(machine_files(), "agent_step.alula.json")

/// The text of the agent step written as tables (`machines/agent_step.alula.txt`).
export fn agent_step_table_text() -> str => text_of_file(table_files(), "agent_step.alula.txt")

/// The text of the machine of the cycle check (`machines/cycle_check.alula.json`), the translation of `cycle_check.alula.md` (task 122).
export fn cycle_check_machine_text() -> str => text_of_file(machine_files(), "cycle_check.alula.json")

/// The text of the machine "Task runner" (`machines/task_runner.alula.json`), the translation of its table (task 123).
export fn task_runner_machine_text() -> str => text_of_file(machine_files(), "task_runner.alula.json")

/// The text of the task runner written as tables (`machines/task_runner.alula.md`).
export fn task_runner_table_text() -> str => text_of_file(table_files(), "task_runner.alula.md")

/// The text of the cycle check written as tables (`machines/cycle_check.alula.md`).
export fn cycle_check_table_text() -> str => text_of_file(table_files(), "cycle_check.alula.md")

/// The text of the chat machine written as tables (`machines/chat.alula.md`).
export fn chat_table_text() -> str => text_of_file(table_files(), "chat.alula.md")

/// The text of the many-turn chat machine written as tables (`machines/dialog.alula.md`).
export fn dialog_table_text() -> str => text_of_file(table_files(), "dialog.alula.md")

/// The text of the machine "Session start" (`machines/session_start.alula.json`), the translation of its table (task 121): the machine the runner calls for every session.
export fn session_start_machine_text() -> str => text_of_file(machine_files(), "session_start.alula.json")

/// The text of the machine "Session start" written as tables (`machines/session_start.alula.md`).
export fn session_start_table_text() -> str => text_of_file(table_files(), "session_start.alula.md")

/// The names of the files that the directories hold (read at compile time with `embed_dir`): a test compares them with the lists above, so a
/// file that is added to a directory and not to its list is found.
export fn data_dir_names(dir str) -> []str {
    if dir == "machines" { return machine_json_names(embed_dir("machines").paths()) }
    if dir == "tables" { return table_names(embed_dir("machines").paths()) }
    if dir == "scenarios" { return embed_dir("scenarios").paths() }
    if dir == "schema" { return embed_dir("schema").paths() }
    []str.new()
}

/// Is the name the name of a machine written as tables? The language of the tables is Portolan and its files are `*.alula.md`; the former `*.table.md` and `*.table.txt` are not names
/// of the product (no transitional period, Portolan 2.11). The translator reads a text and does not look at the extension. A copy kept as `.txt` (its prose links to the files of the
/// methodology, the guard of the links reads `.md` only) is a table too.
export fn is_table_name(name str) -> bool {
    for suffix in [".alula.md", ".alula.txt"] {
        if name.ends_with(suffix) { return true }
    }
    false
}

/// Is the name the name of a compiled machine (the JSON `machine/2`)? Its name is `*.alula.json` (the tree of the JSON is defined by the specification of Portolan, section 6);
/// the former `*.machine.json` is not a name of the product (no transitional period, Portolan 2.11).
export fn is_machine_json_name(name str) -> bool {
    for suffix in [".alula.json"] {
        if name.ends_with(suffix) { return true }
    }
    false
}

fn machine_json_names(names []str) -> []str {
    mut out = []str.new()
    for n in names {
        if is_machine_json_name(n) { out.push(n) }
    }
    out
}

fn table_names(names []str) -> []str {
    mut out = []str.new()
    for n in names {
        if is_table_name(n) { out.push(n) }
    }
    out
}
