// registry_test.nv - the registry: registration, the class in the position of a call, the registry of the language, the check of the arguments and of the results against a registry (a fixture of this file). The registry of a host is data (task 158): its tests are with its owner.
module alula.machine

fn rprim(name str, params []ParamSpec, result TypeSpec, class PrimitiveClass) -> Primitive {
    Primitive { name, params, result, class, reads: []str.new(), writes: []str.new() }
}

fn rall_positions() -> []Position {
    [ConditionPos, InputPos, ProfilePos, ForkEntryPos, OperationEntryPos, EndEntryPos, AcceptPos, ActionPos]
}

fn rpos_ok(registry Registry, e Expr, position Position) -> bool {
    match check_expr_positions(registry, e, position) {
        Ok(u) => true
        Err(x) => false
    }
}

fn rpos_path(registry Registry, e Expr, position Position) -> str {
    match check_expr_positions(registry, e, position) {
        Ok(u) => "ok"
        Err(x) => x.path
    }
}

fn rtext(s str) -> Value => Text(s)

// The registry of the tests: the language and primitives of the three classes (`finish_turn` is acting with no result, the other acting ones give a value); the types of their signatures.
fn rfixture() -> Registry {
    mut reg = language_registry()
    for p in [
        rprim("commit_turn", []ParamSpec.new(), BoolType, Acting),
        rprim("finish_turn", []ParamSpec.new(), NothingType, Acting),
        rprim("read_note", []ParamSpec.new(), BoolType, Volatile),
        rprim("step_number", []ParamSpec.new(), IntMin(0), Volatile),
        rprim("seal", [param("object", TextType)], BoolType, Acting),
        rprim("log_all", []ParamSpec.new(), IntType, Acting),
        rprim("profile_of", [param("party", TextType)], RecordType("Profile"), Volatile),
        rprim("log_items", [param("items", ListType(RecordType("Item")))], NothingType, Acting),
        rprim("archive", [param("number", IntMin(0)), param("suffix", IntMin(0))], NothingType, Acting),
        rprim("context_of", [param("context", VariantType("Context"))], TextType, Volatile),
        rprim("summarize", [param("number", IntMin(0))], OptionalType(RecordType("Summary")), Acting),
        rprim("validate", []ParamSpec.new(), VariantType("Check"), Volatile)
    ] {
        match register(reg, p) {
            Ok(u) => ()
            Err(x) => panic("the fixture is wrong: ${x.message}")
        }
    }
    reg
}

fn rfixture_types() -> TypeDefs {
    TypeDefs {
        records: [
            RecordDef { name: "Profile", fields: [field_def("family", TextType), field_def("model", TextType)] },
            RecordDef { name: "Item", fields: [field_def("severity", VariantType("Severity")), field_def("evidence", TextType)] },
            RecordDef { name: "Summary", fields: [field_def("critical", IntMin(0)), field_def("probes", IntMin(0))] }
        ],
        variants: [
            VariantDef { name: "Severity", cases: [CaseDef { name: "Critical", fields: []FieldDef.new() }, CaseDef { name: "Desirable", fields: []FieldDef.new() }], values: []EnumValue.new() },
            VariantDef { name: "Check", cases: [CaseDef { name: "Valid", fields: []FieldDef.new() }, CaseDef { name: "Violated", fields: []FieldDef.new() }], values: []EnumValue.new() },
            VariantDef { name: "Context", cases: [CaseDef { name: "Plain", fields: [field_def("proposal", TextType)] }, CaseDef { name: "Question", fields: [field_def("question", TextType), field_def("proposal", TextType)] }], values: []EnumValue.new() }
        ]
    }
}

fn rargs(name str, args []Value) -> str {
    match check_call_args(rfixture(), rfixture_types(), name, args) {
        Ok(u) => "ok"
        Err(x) => "${x.path}: ${x.message}"
    }
}

fn rresult(name str, v Value) -> bool {
    match check_call_result(rfixture(), rfixture_types(), name, v) {
        Ok(u) => true
        Err(x) => false
    }
}

fn ritem(severity str) -> Value {
    make_record("Item", [
        RecordField { name: "severity", value: enum_value("Severity", severity) },
        RecordField { name: "evidence", value: Text("e") }
    ])
}

test "rg register" {
    mut reg = new_registry()
    ro p = rprim("time_now", []ParamSpec.new(), IntType, Volatile)
    match register(reg, p) {
        Ok(u) => assert(true)
        Err(x) => assert(false)
    }
    match find_primitive(reg, "time_now") {
        Some(found) => assert(found.name == "time_now" && class_word(found.class) == "volatile")
        None => assert(false)
    }
    match find_primitive(reg, "other") {
        Some(found) => assert(false)
        None => assert(true)
    }
    assert(reg.primitives.len() == 1)
}

test "rg bad" {
    mut reg = new_registry()
    ro p = rprim("p", [param("a", IntType)], NothingType, Acting)
    match register(reg, p) { Ok(u) => assert(true), Err(x) => assert(false) }
    match register(reg, p) { Ok(u) => assert(false), Err(x) => assert(x.message == "the primitive p is registered already") }
    match register(reg, rprim("", []ParamSpec.new(), NothingType, Pure)) { Ok(u) => assert(false), Err(x) => assert(x.message == "the name of a primitive is empty") }
    match register(reg, rprim("q", [param("a", IntType), param("a", TextType)], NothingType, Pure)) {
        Ok(u) => assert(false)
        Err(x) => assert(x.message == "the primitive q has the parameter a twice")
    }
    assert(reg.primitives.len() == 1)
}

test "rg words" {
    assert(class_word(Pure) == "pure" && class_word(Volatile) == "volatile" && class_word(Acting) == "acting")
    assert(position_word(ConditionPos) == "condition" && position_word(InputPos) == "input")
    assert(position_word(ProfilePos) == "profile" && position_word(ForkEntryPos) == "fork_entry")
    assert(position_word(OperationEntryPos) == "operation_entry" && position_word(EndEntryPos) == "end_entry")
    assert(position_word(AcceptPos) == "accept" && position_word(ActionPos) == "action")
}

test "cs pure" {
    for pos in rall_positions() { assert(class_allowed(Pure, pos)) }
}

test "cs volatile" {
    assert(!class_allowed(Volatile, ConditionPos))
    assert(class_allowed(Volatile, InputPos))
    assert(class_allowed(Volatile, ProfilePos))
    assert(class_allowed(Volatile, ForkEntryPos))
    assert(class_allowed(Volatile, OperationEntryPos))
    assert(class_allowed(Volatile, EndEntryPos))
    assert(class_allowed(Volatile, AcceptPos))
    // AL-115: the actions of the chosen row run once, a volatile call may stand in them
    assert(class_allowed(Volatile, ActionPos))
}

test "cs acting" {
    assert(!class_allowed(Acting, ConditionPos))
    assert(!class_allowed(Acting, InputPos))
    assert(!class_allowed(Acting, ProfilePos))
    assert(!class_allowed(Acting, ForkEntryPos))
    assert(class_allowed(Acting, OperationEntryPos))
    assert(class_allowed(Acting, EndEntryPos))
    assert(!class_allowed(Acting, AcceptPos))
    assert(class_allowed(Acting, ActionPos))
}

test "ps call" {
    ro reg = rfixture()
    assert(rpos_ok(reg, call_primitive("time_now", []Expr.new()), ForkEntryPos))
    assert(!rpos_ok(reg, call_primitive("time_now", []Expr.new()), ConditionPos))
    assert(rpos_ok(reg, call_primitive("commit_turn", []Expr.new()), EndEntryPos))
    assert(!rpos_ok(reg, call_primitive("commit_turn", []Expr.new()), ForkEntryPos))
    match check_call_position(reg, "commit_turn", InputPos) {
        Ok(u) => assert(false)
        Err(x) => assert(x.message == "the acting primitive commit_turn may not stand in input")
    }
    match check_call_position(reg, "no_such", ActionPos) {
        Ok(u) => assert(false)
        Err(x) => assert(x.message == "the primitive no_such is not registered" && x.primitive == "no_such")
    }
}

test "ps walk" {
    ro reg = rfixture()
    ro cond = en(And, call_primitive("read_note", []Expr.new()), lit_bool(true))
    assert(!rpos_ok(reg, cond, ConditionPos))
    assert(rpos_path(reg, cond, ConditionPos) == "$.left")
    assert(rpos_ok(reg, cond, ForkEntryPos))
    assert(rpos_ok(reg, lit_int(1), ConditionPos))
}

test "ps inside" {
    ro reg = rfixture()
    ro in_lambda = call("map", [name_ref("xs"), lambda1("x", call_primitive("seal", [name_ref("x")]))])
    assert(rpos_ok(reg, in_lambda, ActionPos))
    assert(rpos_ok(reg, in_lambda, OperationEntryPos))
    assert(rpos_path(reg, in_lambda, ForkEntryPos) == "$.args[1].body")
    ro in_arm = MatchOn { subject: name_ref("r"), arms: [arm([AnyPattern], Some(call_primitive("read_note", []Expr.new())), call_primitive("step_number", []Expr.new()))] }
    assert(rpos_path(reg, in_arm, ConditionPos) == "$.arms[0].guard")
    assert(rpos_ok(reg, in_arm, EndEntryPos))
    ro in_let = let_in("a", lit_int(1), if_else(lit_bool(true), call_primitive("log_all", []Expr.new()), lit_int(0)))
    assert(rpos_path(reg, in_let, InputPos) == "$.body.then")
}

test "ps unknown" {
    ro reg = rfixture()
    match check_expr_positions(reg, bin(Add, lit_int(1), call_primitive("nope", []Expr.new())), ActionPos) {
        Ok(u) => assert(false)
        Err(x) => assert(x.path == "$.right" && x.primitive == "nope")
    }
}

test "ps language" {
    // the two primitives of the language (spec 7a) are always there: both of the class volatile, no parameters
    ro reg = language_registry()
    assert(reg.primitives.len() == 2)
    assert(rpos_ok(reg, call_primitive("time_now", []Expr.new()), OperationEntryPos))
    assert(rpos_ok(reg, call_primitive("new_id", []Expr.new()), OperationEntryPos))
    // new_id in the actions of a row is allowed by the class (volatile, AL-115); its own rule (a binding of the entry of an operation) is a check of the table
    assert(rpos_ok(reg, call_primitive("new_id", []Expr.new()), ActionPos))
    assert(!rpos_ok(reg, call_primitive("new_id", []Expr.new()), ConditionPos))
    assert(!rpos_ok(reg, call_primitive("party_profile", []Expr.new()), OperationEntryPos))
}

test "ps acting without a result" {
    // AL-115: an acting primitive without a result is not a value: its call is an action, not an expression and not the value of a binding
    ro reg = rfixture()
    assert(rpos_ok(reg, call_primitive("commit_turn", []Expr.new()), ActionPos))
    match check_call_position(reg, "finish_turn", ActionPos) {
        Ok(u) => assert(true)
        Err(x) => assert(false)
    }
    match check_expr_positions(reg, call_primitive("finish_turn", []Expr.new()), ActionPos) {
        Ok(u) => assert(false)
        Err(x) => {
            assert(x.primitive == "finish_turn")
            assert(x.message.contains("the acting primitive finish_turn has no result"))
        }
    }
    ro inside = bin(Add, lit_int(1), call("max", [lit_int(2), call_primitive("finish_turn", []Expr.new())]))
    assert(rpos_path(reg, inside, OperationEntryPos) == "$.right.args[1]")
    // an acting primitive that gives a value stands in an expression
    assert(rpos_ok(reg, call_primitive("seal", [lit_text("x")]), EndEntryPos))
}

test "rg pure reads its arguments only" {
    mut reg = new_registry()
    ro with_reads = Primitive { name: "p", params: []ParamSpec.new(), result: IntType, class: Pure, reads: ["a"], writes: []str.new() }
    match register(reg, with_reads) {
        Ok(u) => assert(false)
        Err(x) => assert(x.message.contains("the pure primitive p reads its arguments only"))
    }
    ro with_writes = Primitive { name: "p", params: []ParamSpec.new(), result: IntType, class: Pure, reads: []str.new(), writes: ["b"] }
    match register(reg, with_writes) { Ok(u) => assert(false), Err(x) => assert(true) }
    match register(reg, rprim("p", []ParamSpec.new(), IntType, Pure)) { Ok(u) => assert(true), Err(x) => assert(false) }
    ro volatile = Primitive { name: "v", params: []ParamSpec.new(), result: IntType, class: Volatile, reads: ["a"], writes: []str.new() }
    match register(reg, volatile) { Ok(u) => assert(true), Err(x) => assert(false) }
}

test "ag count types" {
    assert(rargs("profile_of", [rtext("witness")]) == "ok")
    assert(rargs("profile_of", []Value.new()) == "$: wrong argument count for profile_of: expected 1, got 0")
    assert(rargs("profile_of", [rtext("a"), rtext("b")]) == "$: wrong argument count for profile_of: expected 1, got 2")
    assert(rargs("profile_of", [Int(1)]) == "$.party: expected text, got int")
    assert(rargs("time_now", []Value.new()) == "ok")
    assert(rargs("no_such", []Value.new()) == "$: the primitive no_such is not registered")
}

test "ag records" {
    assert(rargs("log_items", [List([ritem("Critical"), ritem("Desirable")])]) == "ok")
    assert(rargs("log_items", [List([ritem("Nope")])]) == "$.items[0].severity: Severity has no case Nope")
    assert(rargs("archive", [Int(2), Int(1)]) == "ok")
    assert(rargs("archive", [Int(-1), Int(1)]) == "$.number: -1 is less than the bound 0")
    assert(rargs("seal", [rtext("proposal")]) == "ok")
}

test "ag variant" {
    ro ctx = make_variant("Context", "Plain", [RecordField { name: "proposal", value: Text("p") }])
    assert(rargs("context_of", [ctx]) == "ok")
    assert(rargs("context_of", [Text("p")]) == "$.context: expected Context, got text")
}

test "rs checked" {
    assert(rresult("time_now", Int(1000)))
    assert(!rresult("time_now", Text("1000")))
    assert(rresult("finish_turn", Null))
    assert(rresult("commit_turn", Bool(true)))
    assert(!rresult("finish_turn", Int(1)))
    assert(rresult("validate", enum_value("Check", "Valid")))
    assert(!rresult("validate", enum_value("Check", "Maybe")))
    assert(rresult("summarize", Null))
    assert(rresult("summarize", make_record("Summary", [RecordField { name: "critical", value: Int(0) }, RecordField { name: "probes", value: Int(2) }])))
    assert(!rresult("summarize", Int(1)))
}

test "ps names" {
    ro e = bin(Add, call_primitive("a", [call_primitive("b", []Expr.new())]), bin(Add, call_primitive("b", []Expr.new()), call_primitive("c", []Expr.new())))
    ro names = primitive_names(e)
    assert(names.len() == 3)
    assert(names[0] == "a" && names[1] == "b" && names[2] == "c")
    assert(primitive_names(lit_int(1)).len() == 0)
}
