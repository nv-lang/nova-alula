// journal.nv - the codes of the journal that a machine may write (format sections 5 and 10, 2.12, AL-31): the table of the language (`journal_language.md`, 35 codes: the format itself, the library "Pause", the
// engine and the executor; spec section 7a, AL-113) and the table of the host, a file of the form `Machine | Code | Russian template | Parameters` that the host registers (`journal.md` beside its machines). The
// check takes the union of the two tables. The language holds no table of a host: the codes of the methodology and of the product are data of their owners.
module alula.machine

import std.text

/// JournalCode: a row of a table of templates: the machines that write the code, the code, the template, the required parameters and the optional ones.
export type JournalCode { machine str, code str, template str, params []str, optional []str }

// The names between backticks in a cell: "`a`, `b`" -> ["a", "b"].
fn ticked(cell str) -> []str {
    mut out = []str.new()
    mut rest = cell
    while true {
        ro open = rest.find("`") ?? -1
        if open < 0 { break }
        ro after = rest[open + 1..]
        ro close = after.find("`") ?? -1
        if close < 0 { break }
        out.push(after[..close])
        rest = after[close + 1..]
    }
    out
}

/// The rows of the table of a file: the lines `| machine | `code` | template | parameters |` (the header and the separator are skipped; other lines are skipped too).
export fn parse_journal(text str) -> []JournalCode {
    mut out = []JournalCode.new()
    for raw in text.split("\n") {
        ro line = (raw.strip_suffix("\r") ?? raw).trim_ascii()
        if !line.starts_with("| ") { continue }
        mut cells = []str.new()
        for c in line.split("|") { cells.push(c.trim_ascii()) }
        if cells.len() != 6 { continue }
        if cells[1] == "Машина" { continue }
        ro codes = ticked(cells[2])
        if codes.len() != 1 { continue }
        mut required = []str.new()
        mut optional = []str.new()
        mut first = true
        for part in cells[4].split(";") {
            if first {
                if part.contains("необязательные") { optional = ticked(part) } else { required = ticked(part) }
                first = false
            } else {
                optional = ticked(part)
            }
        }
        out.push(JournalCode { machine: cells[1], code: codes[0], template: cells[3], params: required, optional })
    }
    out
}

/// The table of the language: the 35 codes that the format, the library "Pause", the engine and the executor write (`journal_language.md`).
export fn language_journal() -> []JournalCode => parse_journal(embed_str("journal_language.md"))

/// The union of the table of the language and the table of a host: the codes that a machine of the host may write.
export fn journal_union(host []JournalCode) -> []JournalCode {
    mut out = language_journal()
    for row in host { out.push(row) }
    out
}

/// The row of the code in a table.
export fn journal_find(codes []JournalCode, code str) -> Option[JournalCode] {
    for row in codes {
        if row.code == code { return Some(row) }
    }
    None
}

fn is_code_word(code str) -> bool {
    if code.byte_len() == 0 { return false }
    mut first = true
    for c in code.chars() {
        ro one = "${c}"
        ro letter = one >= "a" && one <= "z"
        ro digit = one >= "0" && one <= "9"
        if first && !letter { return false }
        if !letter && !digit && one != "_" { return false }
        first = false
    }
    true
}

/// The faults of the table of a host against the table of the language: a code that is not lower case latin with underscores, a code that repeats a code of the language (even with the same template: a code that the
/// format, the library "Pause", the engine or the executor writes is not redefined), a code twice in the table.
export fn journal_table_issues(language []JournalCode, host []JournalCode) -> []str {
    mut out = []str.new()
    mut seen = []str.new()
    for row in host {
        if !is_code_word(row.code) {
            out.push("the code ${row.code} of the table of the host is not lower case latin with underscores")
        } else if journal_find(language, row.code).is_some() {
            out.push("the code ${row.code} of the table of the host repeats a code of the language (a code of the language is not replaced)")
        } else if seen.contains(row.code) {
            out.push("the code ${row.code} stands twice in the table of the host")
        }
        seen.push(row.code)
    }
    out
}
