// battle_test.nv - the probes of the battle host (П-2): the real FS roundtrip over a real root,
// the real run_command (exit codes over `Os`), the real process tools (spawn, try_wait,
// kill + wait over `Proc` — the module header of battle.nv), the negatives of REQ-5, and the acting
// through the outbox (the rights are checked, every execution is recorded).

module alula.battle_host

import std.fs.{Path, real_fs, try_exists, remove_dir_all, create_dir_all}
import std.os.{Proc}
import alula.machine.{Value, Text, Bool, Int, Null, List, Record}
import alula.thin_host.{Root}

// ---- the fixtures --------------------------------------------------------------------------------------

// a fresh real root per run
fn fresh_root() Fs -> str {
    ro root = "target/battle-host-test"
    if try_exists(Path.posix(root)) == Ok(true) {
        match remove_dir_all(Path.posix(root)) {
            Ok(_) => ()
            Err(e) => panic("${e}")
        }
    }
    root
}

fn bh() Fs -> BattleThinHost {
    new_battle_host(fresh_root(), "battle-runner")
}

fn bh_with_answers(mut h BattleThinHost, key str, value str) -> () {
    h.effects.state_put("agent:${key}", Text(value))
}

fn run(mut h BattleThinHost, name str, args []Value) Fs Proc -> Result[Value, StepFailure] => run_battle_tool(h, name, args)

fn must(mut h BattleThinHost, name str, args []Value) Fs Proc -> Value {
    match run(h, name, args) {
        Ok(v) => v
        Err(e) => panic(e.message)
    }
}

// ---- the FS tools over the real tree --------------------------------------------------------------

test "bf write then read roundtrip over the real fs" {
    consume h = bh()
    match run_battle_tool(h, "write_file", [Text("notes/a.txt"), Text("hello battle")]) {
        Ok(_) => ()
        Err(e) => panic(e.message)
    }
    match run_battle_tool(h, "read_file", [Text("notes/a.txt")]) {
        Ok(Text(t)) => assert(t == "hello battle")
        _ => panic("the read back is not the text")
    }
}

test "bf move: the source is gone, the destination holds the text" {
    consume h = bh()
    must(h, "write_file", [Text("m/1.txt"), Text("x")])
    match run_battle_tool(h, "move_file", [Text("m/1.txt"), Text("m/2.txt")]) {
        Ok(_) => ()
        Err(e) => panic(e.message)
    }
    match run_battle_tool(h, "read_file", [Text("m/1.txt")]) {
        Err(_) => ()
        Ok(_) => panic("the source survived the move")
    }
    match run_battle_tool(h, "read_file", [Text("m/2.txt")]) {
        Ok(Text(t)) => assert(t == "x")
        _ => panic("the destination is missing")
    }
}

test "bf list_dir is sorted and delete_file removes" {
    consume h = bh()
    must(h, "write_file", [Text("d/b.txt"), Text("2")])
    must(h, "write_file", [Text("d/a.txt"), Text("1")])
    match run_battle_tool(h, "list_dir", [Text("d")]) {
        Ok(List(items)) => {
            assert(items.len() == 2)
            match items[0] {
                Text(t) => assert(t == "a.txt")
                _ => panic("the first entry is not a text")
            }
        }
        _ => panic("list_dir failed")
    }
    match run_battle_tool(h, "delete_file", [Text("d/a.txt")]) {
        Ok(_) => ()
        Err(e) => panic(e.message)
    }
    match run_battle_tool(h, "file_exists", [Text("d/a.txt")]) {
        Ok(Bool(false)) => ()
        _ => panic("the deleted file still exists")
    }
}

test "bf acquire_lock: free true, foreign false, own true" {
    consume h = bh()
    match run_battle_tool(h, "acquire_lock", [Text("job.lock"), Text("t-battle")]) {
        Ok(Bool(true)) => ()
        _ => panic("the free lock is not acquired")
    }
    match run_battle_tool(h, "acquire_lock", [Text("job.lock"), Text("t-other")]) {
        Ok(Bool(false)) => ()
        _ => panic("a foreign token took the lock")
    }
    match run_battle_tool(h, "acquire_lock", [Text("job.lock"), Text("t-battle")]) {
        Ok(Bool(true)) => ()
        _ => panic("the owner lost the own lock")
    }
}

// ---- run_command: the REAL execution over `Os` ---------------------------------------------------------

test "bf run_command runs a real command and reports the exit code 0" {
    consume h = bh()
    must(h, "write_file", [Text("r/keep.txt"), Text("k")])
    match run_battle_tool(h, "run_command", [Text("exit 0"), Text("r")]) {
        Ok(rec) => match field_of(rec, "code") {
            Int(0) => ()
            _ => panic("the exit code is not 0")
        }
        Err(e) => panic(e.message)
    }
}

test "bf run_command reports a non-zero exit code" {
    consume h = bh()
    match run_battle_tool(h, "run_command", [Text("exit 3"), Text(".")]) {
        Ok(rec) => match field_of(rec, "code") {
            Int(3) => ()
            _ => panic("the exit code is not 3")
        }
        Err(e) => panic(e.message)
    }
}

test "bf run_command outside the tree is refused" {
    consume h = bh()
    match run_battle_tool(h, "run_command", [Text("exit 0"), Text("../outside")]) {
        Err(_) => ()
        Ok(_) => panic("a dir outside the tree was accepted")
    }
}

// ---- the process tools: real children over `Proc` ------------------------------------------------

test "bf start_process starts a real child; running is true; stop ends it; a repeat is a no-op; an unknown pid fails" {
    consume h = bh()
    ro started = must(h, "start_process", [Text("ping -n 30 127.0.0.1"), Text("."), Text("proc.log")])
    ro pid = match started {
        Int(n) => n
        _ => panic("the start did not return a pid")
    }
    assert(pid > 0)
    match run(h, "process_running", [Int(pid)]) {
        Ok(Bool(b)) => assert(b)
        _ => panic("process_running of the live child is not a value true")
    }
    // the record of the acting exists (the receipt is held), the real child is killed and waited
    match run(h, "stop_process", [Int(pid)]) {
        Ok(Null) => ()
        _ => panic("the first stop failed")
    }
    match run(h, "process_running", [Int(pid)]) {
        Ok(Bool(b)) => assert(!b)
        _ => panic("process_running after the stop is not a value false")
    }
    // the repeated stop is a no-op
    match run(h, "stop_process", [Int(pid)]) {
        Ok(Null) => ()
        _ => panic("the repeated stop is not a no-op")
    }
    match run(h, "stop_process", [Int(999999)]) {
        Err(_) => ()
        Ok(_) => panic("an unknown pid was stopped silently")
    }
}

test "bf process_running of an unknown pid is a step failure" {
    consume h = bh()
    match run(h, "process_running", [Int(7)]) {
        Err(_) => ()
        Ok(_) => panic("an unknown pid is not a failure")
    }
}

test "bf start_process refuses the dir and the log path outside the tree" {
    consume h = bh()
    match run(h, "start_process", [Text("ping -n 30 127.0.0.1"), Text("../outside"), Text("proc.log")]) {
        Err(_) => ()
        Ok(_) => panic("a dir outside the tree was accepted")
    }
    match run(h, "start_process", [Text("ping -n 30 127.0.0.1"), Text("."), Text("../outside.log")]) {
        Err(_) => ()
        Ok(_) => panic("a log path outside the tree was accepted")
    }
}

// ---- the negatives of REQ-5 ----------------------------------------------------------------------------

test "bf the paths outside the tree are refused" {
    consume h = bh()
    match run_battle_tool(h, "read_file", [Text("../escape.txt")]) {
        Err(_) => ()
        Ok(_) => panic("../ escaped the tree")
    }

    match run_battle_tool(h, "write_file", [Text("C:/abs.txt"), Text("x")]) {
        Err(_) => ()
        Ok(_) => panic("an absolute path was accepted")
    }
    match run_battle_tool(h, "read_file", [Text("no-such.txt")]) {
        Err(_) => ()
        Ok(_) => panic("a missing file was read")
    }
}

// ---- sha256 / parse_agent ------------------------------------------------------------------------------

test "bf sha256 of abc is the known digest" {
    consume h = bh()
    match run_battle_tool(h, "sha256", [Text("abc")]) {
        Ok(Text(d)) => assert(d == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
        _ => panic("sha256 did not return a text")
    }
}

test "bf parse_agent: a valid JSON decodes, an invalid one is a failure" {
    consume h = bh()
    bh_with_answers(h, "agent:do it:input", "{\"status\":\"ok\"}")
    match run_battle_tool(h, "parse_agent", [Text("do it"), Text("input")]) {
        Ok(Text(t)) => assert(t.contains("ok"))
        _ => panic("the valid answer did not come back")
    }
    bh_with_answers(h, "agent:do it:bad", "not-json{")
    match run_battle_tool(h, "parse_agent", [Text("do it"), Text("bad")]) {
        Err(_) => ()
        Ok(_) => panic("a non-JSON answer was accepted")
    }
}

// ---- the acting through the outbox ---------------------------------------------------------------------

test "bf acting without rights is refused; the receipt is held on a grant" {
    consume h = bh()
    // withdraw the self-grant: the acting must refuse
    h.effects.withdraw_rights("", h.producer)
    match run_battle_tool(h, "write_file", [Text("w/1.txt"), Text("x")]) {
        Err(_) => ()
        Ok(_) => panic("acting went through without rights")
    }
    // restore the grant: the execution is recorded in the outbox
    h.effects.grant("", h.producer)
    match run_battle_tool(h, "write_file", [Text("w/1.txt"), Text("x")]) {
        Ok(_) => ()
        Err(e) => panic(e.message)
    }
    match h.effects.state_get("battle:next") {
        Int(n) => assert(n >= 1)
        _ => panic("no acting identity was issued")
    }
}

// ---- П-2а: the mounting points (several INDEPENDENT roots) ---------------------------------------------

fn bm() Fs -> BattleThinHost {
    ro base = "target/battle-host-p2a"
    ro made = create_dir_all(Path.posix(base))
    match new_battle_host_mounts([
        Root { name: "src", path: "${base}/src" },
        Root { name: "run", path: "${base}/run" },
    ], "battle-runner") {
        Ok(consume h) => h
        Err(e) => panic(e.message)
    }
}

test "bf p2a: two independent roots — the FS and a live child across the points" {
    consume h = bm()
    must(h, "write_file", [Text("src/a.txt"), Text("a")])
    must(h, "write_file", [Text("run/b.txt"), Text("b")])
    match run_battle_tool(h, "read_file", [Text("src/a.txt")]) {
        Ok(Text(t)) => assert(t == "a")
        _ => panic("the src point lost its text")
    }
    match run_battle_tool(h, "run_command", [Text("exit 4"), Text("src/.")]) {
        Ok(rec) => match field_of(rec, "code") {
            Int(4) => ()
            _ => panic("the exit code is not 4")
        }
        Err(e) => panic(e.message)
    }
    // the child runs with its dir in src, its log in run: both points are absolute and independent
    ro started = must(h, "start_process", [Text("ping -n 30 127.0.0.1"), Text("src/."), Text("run/child.log")])
    ro pid = match started {
        Int(n) => n
        _ => panic("the start did not return a pid")
    }
    assert(pid > 0)
    match run(h, "process_running", [Int(pid)]) {
        Ok(Bool(b)) => assert(b)
        _ => panic("process_running of the live child is not a value true")
    }
    // a blocking short command gives the child the time to open its log (cmd sets the redirect up
    // asynchronously; no sleep exists in std)
    match run_battle_tool(h, "run_command", [Text("ping -n 2 127.0.0.1 >nul"), Text("src/.")]) {
        Ok(_) => ()
        Err(e) => panic(e.message)
    }
    match run(h, "stop_process", [Int(pid)]) {
        Ok(Null) => ()
        _ => panic("the stop failed")
    }
    match h.tree.file_exists("run/child.log") {
        Ok(Bool(true)) => ()
        _ => panic("the log is not in the run point")
    }
}

test "bf p2a: a bare path and a cross-point move are refused" {
    consume h = bm()
    match run_battle_tool(h, "write_file", [Text("a.txt"), Text("x")]) {
        Err(e) => assert(e.message.contains("does not name a mounting point"))
        Ok(_) => panic("a bare path was accepted")
    }
    must(h, "write_file", [Text("src/x.txt"), Text("v")])
    match run_battle_tool(h, "move_file", [Text("src/x.txt"), Text("run/x.txt")]) {
        Err(e) => assert(e.message.contains("between mounting points"))
        Ok(_) => panic("a cross-point move was accepted")
    }
    match run_battle_tool(h, "start_process", [Text("exit 0"), Text("../outside"), Text("run/x.log")]) {
        Err(_) => ()
        Ok(_) => panic("a dir outside the points was accepted")
    }
}

// ---- the helper ----------------------------------------------------------------------------------------

fn field_of(v Value, name str) -> Value {
    match v {
        Record { fields } => {
            for f in fields {
                if f.name == name { return f.value }
            }
            Null
        }
        _ => Null
    }
}
