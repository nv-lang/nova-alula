// battle.nv - the battle (real) host of the thin host primitives (П-2 of the epic «Тонкий хозяин
// в пакете», methodology task 118; REQ-8, AC-7 of the epic card). The same 13 primitives as П-1,
// but the scenario primitives are REAL:
//   - run_command: a REAL run to completion over `Os` (std/os/os.nv, D453: spawn + wait + exit
//     code; that wave captures no stdout — ExecResult.stdout carries "" in the battle host v1,
//     documented honestly);
//   - processes (start/stop/running): REAL children over the `Proc` effect (std/os/proc.nv):
//     `Command.start` with a process group, the handles live in the host registry (see below),
//     `try_wait` for `process_running`, `kill` + `wait` for `stop_process`;
//     the PATH-form import `std.os.proc` is not the module (`proc.nv` declares `std.os`) and
//     breaks the build — the module is imported as `std.os` (Oracle report, 129 (c));
//   - acquire_lock: atomic create-or-open via `File.create_new` (O_EXCL);
//   - FS/sha256: as in П-1 (HostTree over the real Fs, std.crypto);
//   - parse_agent stays scripted: the cheap agent is an EXTERNAL service — the battle host has no
//     one to call (documented; host-spec 111 keeps it scripted too).
//
// The battle host OWNS the processes it started: their handles live in its registry, so
//   - `process_running` is a `try_wait` on the held child (deterministic, no tasklist race),
//   - `stop_process` kills the held child and waits for it; an unknown pid is a step
//     failure, a repeated stop is a no-op (the battle host never signals a pid it does not own),
//   - the registry does not survive a restart of the host itself — a known methodology
//     limitation (task 114, ряд 15/16).
//
// acting goes through the outbox of the effects host (REQ-1), like in П-1: the rights are checked
// (`may_submit`), every execution is recorded together with its receipt (`record_exec`), and each
// call gets its own identity `b:<name>:<counter>` — the battle host is the real executor, so
// repeated identical calls are NEW executions (the machine-level dedup is the engine's job).
// The FS effects are declared on the free functions (the tree is real); no per-call `with real_*()`
// anywhere — the std convention is `#default_handler` auto-construction; `with` stays at protocol
// boundaries only (see thin_host @call_primitive).

module alula.battle_host

import std.fs.{Path, Fs, read_text, write_text, remove_file, read_dir, create_dir_all, try_exists, DirEntry, File}
import std.os.{Command, Proc, Child, Signal, Tree}
import std.encoding.json.{Json}
import std.crypto.sha256.{Sha256}
import alula.machine.{Value, Text, Bool, Int, Null, List, Dict, DictEntry, RecordField, EvalError, PrimitiveFailed, make_record}
import alula.host.{Intent, TrustedContext, EffectOutcome, EffectHost, new_effect_host}
import alula.thin_host.{HostTree, StepFailure, new_tree}

// ---- BattleThinHost ------------------------------------------------------------------------------------

/// BattleThinHost: the real executor of the thin host primitives. The FS runs over the real
/// handler inside the host (`real_fs`), the processes over `real_proc` (std/os/proc.nv: spawn
/// with `Tree.Group`, kill, try_wait, `Command.run()` for run_command). The acting primitives are
/// recorded in the outbox of the effects host (the rights are checked, every execution holds its
/// receipt). parse_agent is scripted through the answers dict (the cheap agent is external).
export type BattleThinHost consume {
    mut tree HostTree,
    mut effects EffectHost,
    producer str,
    consume procs []Child
}

/// The held children are released by the cleanup of the registry: a still-running child is killed
/// when the host leaves its scope (D492: no orphan outlives its owner); a stopped one is reaped.
export fn BattleThinHost consume @cleanup(_outcome ScopeOutcome) -> () { }

/// A battle host over a REAL tree root (the folder must be creatable/existing) and a trusted
/// producer (self-granted — the battle host is the runner of the machines).
export fn new_battle_host(root str, producer str) Fs -> BattleThinHost {
    ro made = create_dir_all(Path.posix(root))
    mut effects = new_effect_host()
    effects.grant("", producer)
    { tree: new_tree(root), effects, producer, procs: []Child.new() }
}

// The unique identity per acting call: a counter in the effects world (shared through copies).
fn next_battle_id(mut h BattleThinHost, name str) -> str {
    ro n = match h.effects.state_get("battle:next") {
        Int(k) => k
        _ => 0
    }
    h.effects.state_put("battle:next", Int(n + 1))
    "b:${name}:${n}"
}

// ---- process helpers over the Proc effect --------------------------------------------------------------

// The full shell line with the log redirect (Windows `cmd /c`; the battle host v1 is
// Windows-first — the methodology runs on Windows).
fn shell_line(command str, log_abs str) -> str => "${command} > \"${log_abs}\" 2>&1"

fn fail(message str) -> Result[Value, StepFailure] => Err(StepFailure { message })

fn arg_text(args []Value, i int) -> Result[str, StepFailure] {
    if i >= args.len() { return fail("too few arguments") }
    match args[i] {
        Text(s) => Ok(s)
        _ => fail("argument ${i} is not a text")
    }
}

fn arg_int(args []Value, i int) -> Result[int, StepFailure] {
    if i >= args.len() { return fail("too few arguments") }
    match args[i] {
        Int(n) => Ok(n)
        _ => fail("argument ${i} is not an int")
    }
}

fn is_acting(name str) -> bool {
    if name == "write_file" { return true }
    if name == "move_file" { return true }
    if name == "delete_file" { return true }
    if name == "start_process" { return true }
    if name == "stop_process" { return true }
    if name == "run_command" { return true }
    if name == "acquire_lock" { return true }
    false
}

// The index of the held child by its OS pid, or -1.
fn proc_index(h BattleThinHost, pid int) Proc -> int {
    mut i = 0
    while i < h.procs.len() {
        if h.procs[i].pid() == pid { return i }
        i += 1
    }
    -1
}

// Spawn without a Result: the consume handle is bound and stored in one shape the ownership
// checker accepts (a pattern-bound Child in a Result-returning function trips D133 on 0.1.6).
// 0 = the process did not start; the caller turns it into a StepFailure.
fn spawn_child(mut procs []Child, command str, dir_abs str, log_abs str) Proc -> int {
    ro line = if log_abs == "" { command } else { shell_line(command, log_abs) }
    match Command.new("cmd").arg("/c").arg(line).dir(Path.posix(dir_abs)).tree(Tree.Group).start() {
        Err(_) => 0
        Ok(consume c) => {
            ro pid = c.pid()
            procs.push(c)
            pid
        }
    }
}

fn battle_start_process(mut h BattleThinHost, command str, dir str, log_path str) Fs Proc -> Result[Value, StepFailure] {
    ro dir_abs = match h.tree.resolve_path(dir) {
        Ok(f) => f
        Err(e) => return Err(e)
    }
    mut log_abs = ""
    if log_path != "" {
        log_abs = match h.tree.resolve_path(log_path) {
            Ok(f) => f
            Err(e) => return Err(e)
        }
    }
    ro pid = spawn_child(h.procs, command, dir_abs, log_abs)
    if pid < 1 { return fail("the process did not start: ${command}") }
    Ok(Int(pid))
}

fn battle_stop_process(mut h BattleThinHost, pid int) Proc -> Result[Value, StepFailure] {
    ro at = proc_index(h, pid)
    if at < 0 { return fail("an unknown pid: ${pid}") }
    match h.procs[at].try_wait() {
        Ok(Some(_)) => Ok(Null)
        Ok(None) => {
            match h.procs[at].kill(Signal.Kill) {
                Err(_) => return fail("the process ${pid} did not stop")
                Ok(_) => ()
            }
            // wait for the death: stop is synchronous, so process_running is false right after
            match h.procs[at].wait() {
                Ok(_) => Ok(Null)
                Err(_) => fail("the process ${pid} did not stop")
            }
        }
        Err(_) => fail("the process ${pid} cannot be checked")
    }
}

fn battle_process_running(mut h BattleThinHost, pid int) Proc -> Result[Value, StepFailure] {
    ro at = proc_index(h, pid)
    if at < 0 { return fail("an unknown pid: ${pid}") }
    match h.procs[at].try_wait() {
        Ok(Some(_)) => Ok(Bool(false))
        Ok(None) => Ok(Bool(true))
        Err(_) => fail("the process ${pid} cannot be checked")
    }
}

fn battle_run_command(h BattleThinHost, command str, dir str) Fs -> Result[Value, StepFailure] {
    // the REAL run to completion over `Os` (std/os/os.nv — D453: spawn + wait + exit code; the
    // stdout capture is deferred in that wave, so ExecResult.stdout carries "" in the v1).
    // The working dir is resolved INSIDE the tree (the tree is the world — REQ-5).
    ro dir_abs = match h.tree.resolve_path(dir) {
        Ok(f) => f
        Err(e) => return Err(e)
    }
    mut cmd = Command.new("cmd")
    cmd.arg("/c")
    cmd.arg(command)
    cmd.dir(Path.posix(dir_abs))
    match cmd.run() {
        Err(_) => fail("the command did not run: ${command}")
        Ok(out) => {
            mut fields = []RecordField.new()
            fields.push(RecordField { name: "code", value: Int(out.code) })
            fields.push(RecordField { name: "stdout", value: Text("") })
            Ok(make_record("ExecResult", fields))
        }
    }
}

fn battle_sha256(text str) -> Result[Value, StepFailure] {
    mut data = []u8.new()
    for c in text.chars() { data.push(c as u8) }
    // ORACLE-WORKAROUND(128): the fixed [32]u8 of Sha256.hash is copied out by index
    ro digest = Sha256.hash(data)
    mut out = ""
    mut i = 0
    while i < 32 {
        ro b = digest[i]
        out = "${out}${hex_char(b as int >> 4)}${hex_char(b as int & 15)}"
        i += 1
    }
    Ok(Text(out))
}

fn hex_char(n int) -> str {
    if n < 10 { return "${n}" }
    if n == 10 { return "a" }
    if n == 11 { return "b" }
    if n == 12 { return "c" }
    if n == 13 { return "d" }
    if n == 14 { return "e" }
    "f"
}

fn answer_key(h BattleThinHost, key str) -> Result[Value, StepFailure] {
    match h.effects.state_get("agent:${key}") {
        Text(t) => {
            // the mechanical validation of host-spec: the answer is a JSON text
            match Json.parse(t) {
                Ok(_) => Ok(Text(t))
                Err(_) => fail("the answer of parse_agent is not a JSON text")
            }
        }
        _ => fail("no scripted answer: ${key}")
    }
}

fn battle_parse_agent(h BattleThinHost, args []Value) -> Result[Value, StepFailure] {
    ro instruction = match arg_text(args, 0) { Ok(s) => s, Err(e) => return Err(e) }
    ro input = match arg_text(args, 1) { Ok(s) => s, Err(e) => return Err(e) }
    answer_key(h, "agent:${instruction}:${input}")
}

fn execute_acting_battle(mut h BattleThinHost, name str, args []Value) Fs Proc -> Result[Value, StepFailure] {
    if name == "write_file" {
        ro path = match arg_text(args, 0) { Ok(s) => s, Err(e) => return Err(e) }
        ro content = match arg_text(args, 1) { Ok(s) => s, Err(e) => return Err(e) }
        match h.tree.write_file(path, content) {
            Ok(_) => Ok(Null)
            Err(e) => Err(e)
        }
    } else if name == "move_file" {
        ro from_path = match arg_text(args, 0) { Ok(s) => s, Err(e) => return Err(e) }
        ro to_path = match arg_text(args, 1) { Ok(s) => s, Err(e) => return Err(e) }
        match h.tree.move_file(from_path, to_path) {
            Ok(_) => Ok(Null)
            Err(e) => Err(e)
        }
    } else if name == "delete_file" {
        ro path = match arg_text(args, 0) { Ok(s) => s, Err(e) => return Err(e) }
        match h.tree.delete_file(path) {
            Ok(_) => Ok(Null)
            Err(e) => Err(e)
        }
    } else if name == "acquire_lock" {
        ro path = match arg_text(args, 0) { Ok(s) => s, Err(e) => return Err(e) }
        ro token = match arg_text(args, 1) { Ok(s) => s, Err(e) => return Err(e) }
        match h.tree.acquire_lock(path, token) {
            Ok(v) => Ok(v)
            Err(e) => Err(e)
        }
    } else if name == "start_process" {
        ro command = match arg_text(args, 0) { Ok(s) => s, Err(e) => return Err(e) }
        ro dir = match arg_text(args, 1) { Ok(s) => s, Err(e) => return Err(e) }
        ro log_path = match arg_text(args, 2) { Ok(s) => s, Err(e) => return Err(e) }
        battle_start_process(h, command, dir, log_path)
    } else if name == "stop_process" {
        ro pid = match arg_int(args, 0) { Ok(n) => n, Err(e) => return Err(e) }
        battle_stop_process(h, pid)
    } else if name == "run_command" {
        ro command = match arg_text(args, 0) { Ok(s) => s, Err(e) => return Err(e) }
        ro dir = match arg_text(args, 1) { Ok(s) => s, Err(e) => return Err(e) }
        battle_run_command(h, command, dir)
    } else {
        fail("no executor: an unknown acting primitive ${name}")
    }
}

// ---- run_battle_primitive ------------------------------------------------------------------------------

/// `run_battle_primitive`: one call of a thin primitive on the battle host (the free form).
///   - volatile/pure: read_file, file_exists, list_dir, process_running (a real `try_wait`
///     on the held child), parse_agent (scripted: the agent is external), sha256;
///   - acting: write_file, move_file, delete_file, start_process, stop_process, run_command,
///     acquire_lock — the rights are checked, the execution is real, the intent+receipt are fixed
///     together with a unique identity `b:<name>:<counter>`.
export fn run_battle_primitive(mut h BattleThinHost, name str, args []Value) Fs Proc -> Result[Value, StepFailure] {
    if name == "new_id" { return fail("new_id is a primitive of the language, not of the thin host") }
    // volatile/pure — direct
    if name == "read_file" { return h.tree.read_file(arg_text(args, 0)?) }
    if name == "file_exists" { return h.tree.file_exists(arg_text(args, 0)?) }
    if name == "list_dir" { return h.tree.list_dir(arg_text(args, 0)?) }
    if name == "sha256" { return battle_sha256(arg_text(args, 0)?) }
    if name == "parse_agent" { return battle_parse_agent(h, args) }
    if name == "process_running" { return battle_process_running(h, arg_int(args, 0)?) }
    // acting — the rights first, then the real execution, then the record
    if !is_acting(name) { return fail("an unknown primitive: ${name}") }
    mut ctx = TrustedContext { tenant: "", producer: h.producer, principal: h.producer, role: "submit" }
    if !h.effects.may_submit(ctx) {
        return fail("acting ${name} without rights: ${h.producer} cannot submit the intent")
    }
    ro effect_id = next_battle_id(h, name)
    match execute_acting_battle(h, name, args) {
        Ok(v) => {
            h.effects.record_exec(Intent { tenant: "", producer: h.producer, effect_id, action: name, payload: "" }, ctx, EffectOutcome.Applied, Some(v), "battle")
            Ok(v)
        }
        Err(e) => {
            h.effects.record_exec(Intent { tenant: "", producer: h.producer, effect_id, action: name, payload: "" }, ctx, EffectOutcome.Refused, None, e.message)
            fail(e.message)
        }
    }
}