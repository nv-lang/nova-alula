// alula.nv - the program `alula` (task 116): compile Alula to the JSON `machine/2` and back, convert a file from one language to the other, check it, run its tests.
//   alula compile <file.alula.md> [-o <file.alula.json>] [--lenient] [--no-check] [--force]
//   alula render <file.alula.json> [--language ru|en] [-o <file.alula.md>] [--lenient] [--force]
//   alula convert <file.alula.md> --language ru|en [-o <file>] [--no-check] [--lenient] [--force]
//   alula check <file> | summary <file> | run <machine> <test> | test <folder> | version | --help
// The commands are in `src/alula_cli/` (README.md there); this file only ends the process with the exit code. Exit codes: 0 success, 1 errors in a file, 2 wrong use.
// Build: nova build src/alula.nv -o target/alula.exe   (scripts/build-alula.ps1)
module alula.alula

// ORACLE-WORKAROUND(32): std.fs comes first: with the imports of the modules of the product before it, `.join` on a `Vec` resolves to `Path.join` (E_RECV_METHOD_MISMATCH); order the imports freely when item 32 is fixed
import std.fs.{Fs}
import std.os.{exit_process}
import alula.alula_cli.{execute}

fn main() Os Fs Io -> () {
    ro code = execute()
    if code != 0 { exit_process(code) }
}
