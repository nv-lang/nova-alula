// support_test.nv - helpers and fixtures of the tests of the two languages of Alula (task 113): the small machine of `src/machine_text` in Russian and its twin in English, and the way to
// read what the translator says. Only the exported API of `alula.machine_text` is used.
module alula.machine_text_lang

import std.text
import alula.machine.{standard_registry}
import alula.machine_text.{translate_checked, TranslateReport, TranslateError, translate_report}

// A small machine: a gate that waits for a word, a fork, two ends (Russian, format 2.5).
fn tiny_ru() -> str => `# Машина: Малая

- machine: Tiny
- machine_version: 1
- format: 2.22

## Имена

| имя | JSON-имя |
|---|---|
| исполнитель_повышенного_внимания | attention_executor |
| ЖДАТЬ | Wait |
| РЕШИТЬ | Decide |
| КОНЕЦ | Finished |
| СТОП | Stopped |

## Данные

| имя | тип | начальное | не убывает | пишет |
|---|---|---|---|---|
| число_ходов | число>=0 | 0 | да | строки |
| остановка | "" \| "a" \| "b" | "" | — | строки |
| попытка_вратаря | число>=0 | 0 | да | механика |

## Стороны

| имя | идентификатор | вид | профиль | сигналы | счётчик |
|---|---|---|---|---|---|
| gatekeeper | gatekeeper | human или agent по настройке исполнитель_повышенного_внимания(итог ИсходВорот) | — | разрешить, отказать | попытка_вратаря |

## Состояния

Начальное состояние: ЖДАТЬ

### ЖДАТЬ — обращение
Сторона: gatekeeper
Запрос:

| поле запроса | выражение | читает |
|---|---|---|
| turn | число_ходов | исполнитель |

| № | Событие | Условие | Действия | Куда |
|---|---|---|---|---|
| 1 | сигнал(разрешить) | — | число_ходов += 1 | РЕШИТЬ |
| 2 | сигнал(отказать) | — | остановка = "a" | СТОП |

### РЕШИТЬ — развилка
Читает: число_ходов

| № | Условие | Действия | Куда |
|---|---|---|---|
| 1 | число_ходов >= 2 | — | КОНЕЦ |
| 2 | иначе | — | ЖДАТЬ |

### КОНЕЦ — конец
Читает: число_ходов

### СТОП — конец
Читает: остановка
Кроме: остановка в [""]

## Концы

Результат: число

| конец | № | когда | ответ |
|---|---|---|---|
| КОНЕЦ | 1 | истина | Ответ(число_ходов) |
| СТОП | 1 | остановка == "a" | Отказ(FailCode.StoppedByHuman, "stopped") |
| СТОП | 2 | остановка == "b" | Отказ(FailCode.NoResult, "b") |
`

// The same machine written in English (format 2.5, the line `language: en`).
fn tiny_en() -> str => `# Machine: Малая

- machine: Tiny
- machine_version: 1
- format: 2.22
- language: en

## Data

| name | type | initial | non_decreasing | writes |
|---|---|---|---|---|
| turn_count | int>=0 | 0 | yes | rows |
| stop_reason | "" \| "a" \| "b" | "" | — | rows |
| gatekeeper_attempt | int>=0 | 0 | yes | mechanics |

## Parties

| name | id | kind | profile | signals | counter |
|---|---|---|---|---|---|
| gatekeeper | gatekeeper | human or agent by setting attention_executor(result GateOutcome) | — | allow, deny | gatekeeper_attempt |

## States

Initial state: Wait

### Wait — appeal
Party: gatekeeper
Request:

| request_field | expression | reads |
|---|---|---|
| turn | turn_count | executor |

| № | Event | Condition | Actions | To |
|---|---|---|---|---|
| 1 | signal(allow) | — | turn_count += 1 | Decide |
| 2 | signal(deny) | — | stop_reason = "a" | Stopped |

### Decide — fork
Reads: turn_count

| № | Condition | Actions | To |
|---|---|---|---|
| 1 | turn_count >= 2 | — | Finished |
| 2 | else | — | Wait |

### Finished — end
Reads: turn_count

### Stopped — end
Reads: stop_reason
Except: stop_reason in [""]

## Ends

Result: int

| end | № | when | response |
|---|---|---|---|
| Finished | 1 | true | Response(turn_count) |
| Stopped | 1 | stop_reason == "a" | Refusal(FailCode.StoppedByHuman, "stopped") |
| Stopped | 2 | stop_reason == "b" | Refusal(FailCode.NoResult, "b") |
`

fn checked(text str) -> TranslateReport => translate_checked(text, standard_registry())

fn json_of(text str) -> str => checked(text).json

// The notes as lines `line:col kind message`.
fn notes(text str) -> []str {
    mut out = []str.new()
    for e in checked(text).errors { out.push("${e.line}:${e.col} ${e.kind} ${e.message}") }
    out
}

fn note_says(text str, needle str) -> bool {
    for line in notes(text) {
        if line.contains(needle) { return true }
    }
    false
}

// Is there a note of the kind at the line (and, when `col` is above zero, at the column)?
fn has_note_at(text str, line int, col int, kind str) -> bool {
    for e in checked(text).errors {
        if e.line == line && e.kind == kind && (col <= 0 || e.col == col) { return true }
    }
    false
}

fn first_note(text str) -> str {
    ro all = notes(text)
    if all.len() == 0 { return "ok" }
    all[0]
}

fn is_clean(text str) -> bool => checked(text).errors.len() == 0

// The text with a piece replaced.
fn ru_with(old str, new str) -> str => tiny_ru().replace(old, new)

fn en_with(old str, new str) -> str => tiny_en().replace(old, new)

// The JSON without the title (the title is the text of the author in the header).
fn no_title(json str) -> str {
    ro at = json.find("\"title\":\"") ?? -1
    if at < 0 { return json }
    ro rest = json[at + 9..]
    ro end = rest.find("\"") ?? -1
    "${json[..at - 1]}${rest[end + 1..]}"
}

// The number of the line of a text that starts with the given text (1-based), -1 when none.
fn line_of(text str, start str) -> int {
    mut no = 0
    for line in text.split("\n") {
        no += 1
        if line.starts_with(start) { return no }
    }
    -1
}

fn warning_texts(text str) -> []str {
    mut out = []str.new()
    for w in checked(text).warnings { out.push("${w.line}:${w.col} ${w.message}") }
    out
}
