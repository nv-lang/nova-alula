/// The names of the files that the folders hold (read at compile time with `embed_dir`): `machines` (the JSON), `tables`, `tests`.
export fn example_dir_names(dir str) -> []str {
    if dir == "machines" { return only_ending(embed_dir("../../examples").paths(), [".alula.json"]) }
    if dir == "tables" { return only_ending(embed_dir("../../examples").paths(), [".alula.md", ".alula.txt"]) }
    if dir == "tests" { return embed_dir("../../examples/tests").paths() }
    []str.new()
}

fn only_ending(names []str, suffixes []str) -> []str {
    mut out = []str.new()
    for n in names {
        for suffix in suffixes {
            if n.ends_with(suffix) { out.push(n) }
        }
    }
    out
}

/// The registry of the host "examples": the language and the primitives of `examples/registry.md`, the codes of `examples/journal.md`.
export fn example_registry_text() -> str => embed_str("../../examples/registry.md")

/// The table of the codes of the host "examples" (`examples/journal.md`).
export fn example_journal_text() -> str => embed_str("../../examples/journal.md")

/// The registry of the samples of the specification (`spec/samples/registry.md`).
export fn sample_registry_text() -> str => embed_str("../../spec/samples/registry.md")

/// The registry of the host "examples" (the language, the example primitives, the codes of the language and of the examples).
export fn example_registry() -> Registry {
    match load_host(example_registry_text(), example_journal_text()) {
        Ok(reg) => reg
        Err(errors) => panic("the registry of the examples is wrong: ${errors.join(" | ")}")
    }
}

/// The registry of the samples: the language and the primitives of the pilots (`spec/samples/registry.md`); the codes of the journal are not checked (the samples come with no table of a host).
export fn sample_registry() -> Registry {
    match load_host(sample_registry_text(), "") {
        Ok(reg) => without_journal(reg)
        Err(errors) => panic("the registry of the samples is wrong: ${errors.join(" | ")}")
    }
}
