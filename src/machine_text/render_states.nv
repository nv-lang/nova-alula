// render_states.nv - the reverse generator, the states, the ends, the primitives and the whole file (task 113; the pieces before them are in render_expr.nv and render.nv).
module alula.machine_text

// ORACLE-WORKAROUND(32): `import std.text` is needed in `nova build` for `[]str.join` (a `nova test` build has it already); drop the import when item 32 is fixed
import std.text
import alula.machine.{Registry, language_registry, NamedText}

fn rn_binds(cx RnCx, bind RJ) -> str {
    mut parts = []str.new()
    for q in rj_pairs(bind) {
        ro local = rj_str(q.value)
        ro field = rn_field_name(cx, q.key)
        parts.push(if local == field { field } else { "${field}: ${local}" })
    }
    parts.join(", ")
}

fn rn_bind_locals(bind RJ) -> []str {
    mut out = []str.new()
    for q in rj_pairs(bind) { out.push(rj_str(q.value)) }
    out
}

/// RnEvent: the text of the cell "event" and the names that the event binds.
type RnEvent { text str, locals []str }

fn rn_event(cx RnCx, ev RJ, locals []str) -> RnEvent {
    ro kind = rj_gstr(ev, "kind")
    ro bind = match rj_get(ev, "bind") {
        Some(b) => b
        None => RNull
    }
    if kind == "now" { return RnEvent { text: rn_kw(cx, "event", "immediate"), locals } }
    if kind == "timeout" { return RnEvent { text: rn_kw(cx, "event", "deadline"), locals } }
    if kind == "answer" {
        ro name = rj_str(bind)
        if name == "" { return RnEvent { text: rn_kw(cx, "event", "response"), locals } }
        return RnEvent { text: "${rn_kw(cx, "event", "response")}(${name})", locals: rn_with(locals, name) }
    }
    if kind == "answer_variant" {
        ro head = "${rn_kw(cx, "event", "response")}: ${rn_case_name(cx, rj_gstr(ev, "variant"))}"
        ro inner = rn_binds(cx, bind)
        if inner == "" { return RnEvent { text: head, locals } }
        mut all = rn_copy(locals)
        for l in rn_bind_locals(bind) { all.push(l) }
        return RnEvent { text: "${head} { ${inner} }", locals: all }
    }
    if kind == "failure" {
        ro name = if rj_str(bind) == "" && rj_garr(ev, "reasons").len() > 0 { "_" } else { rj_str(bind) }
        ro reasons = rj_garr(ev, "reasons")
        if name == "" { return RnEvent { text: rn_kw(cx, "event", "failure"), locals } }
        if reasons.len() == 0 { return RnEvent { text: "${rn_kw(cx, "event", "failure")}(${name})", locals: rn_with(locals, name) } }
        mut codes = []str.new()
        for r in reasons { codes.push("${rn_type_name(cx, "FailCode")}.${rn_case_name(cx, rj_str(r))}") }
        return RnEvent { text: "${rn_kw(cx, "event", "failure")}(${name} ${rn_kw(cx, "operator", "in")} [${codes.join(", ")}])", locals: rn_with(locals, name) }
    }
    // the part of an answer of 2.26 (section 7а): `часть`, `часть(имя)` (the whole part), `часть { поле: имя }`; the type of the part is the column `части` of the party, not written in the event
    if kind == "progress" && cx.v226 {
        ro head = rn_kw(cx, "event", "part")
        ro whole = rj_str(bind)
        if whole != "" { return RnEvent { text: "${head}(${whole})", locals: rn_with(locals, whole) } }
        ro inner = rn_binds(cx, bind)
        mut all = rn_copy(locals)
        for l in rn_bind_locals(bind) { all.push(l) }
        return RnEvent { text: if inner == "" { head } else { "${head} { ${inner} }" }, locals: all }
    }
    if kind == "signal" || kind == "progress" {
        ro head_key = if kind == "signal" { "signal" } else { "part" }
        ro phrase = rj_gstr(ev, "name")
        ro inner = rn_binds(cx, bind)
        mut all = rn_copy(locals)
        for l in rn_bind_locals(bind) { all.push(l) }
        ro shown = if inner == "" { phrase } else { "${phrase} { ${inner} }" }
        return RnEvent { text: "${rn_kw(cx, "event", head_key)}(${shown})", locals: all }
    }
    RnEvent { text: "—", locals }
}

fn rn_destination(cx RnCx, row RJ) -> str {
    ro to = rj_gstr(row, "to")
    if to == "" { return if cx.v226 { RN_EMPTY } else { "—" } }
    mut text = to
    if to == "@previous" { text = rn_kw(cx, "destination", "previous") }
    if to == "@same" { text = rn_kw(cx, "destination", "same") }
    if to == "@prepare_return" { text = rn_kw(cx, "destination", "preparation_return") }
    // 0.28: the restart mode is the column `заново`, the "Where" holds it not; the seam of 2.25 writes the former suffix (the word `запуск заново` is of the layer of 2.25)
    if !cx.v226 {
        match rj_get(row, "restart") {
            Some(r) => {
                match r {
                    RBool(b) => { if b { text = "${text}, ${rn_kw(cx, "destination", "rerun")}" } }
                    _ => ()
                }
            }
            None => ()
        }
    }
    text
}

fn rn_bind_names_of(actions []RJ) -> []str {
    mut out = []str.new()
    for a in actions {
        if rj_gstr(a, "do") == "bind" { out.push(rj_gstr(a, "name")) }
    }
    out
}

fn rn_rows(mut cx RnCx, rows []RJ, kind str, locals []str) -> []str {
    if cx.v226 { return rn_rows_226(cx, rows, kind, locals) }
    ro fork = kind == "fork"
    mut out = []RnRow.new()
    for r in rows {
        mut cells = []str.new()
        cells.push(rj_gscalar(r, "n"))
        mut row_locals = rn_copy(locals)
        if !fork {
            ro ev = match rj_get(r, "event") {
                Some(e) => rn_event(cx, e, locals)
                None => RnEvent { text: "—", locals }
            }
            cells.push(ev.text)
            row_locals = ev.locals
        }
        ro cond = match rj_get(r, "cond") {
            Some(c) => rn_expr(cx, c, row_locals)
            None => "—"
        }
        match rj_get(r, "else") {
            Some(e) => {
                match e {
                    RBool(b) => {
                        if b { cells.push(rn_kw(cx, "event", "else")) } else { cells.push(cond) }
                    }
                    _ => cells.push(cond)
                }
            }
            None => cells.push(cond)
        }
        cells.push(rn_actions(cx, rj_garr(r, "actions"), row_locals).text)
        cells.push(rn_destination(cx, r))
        out.push(RnRow { cells })
    }
    ro keys = if fork { ["№", "Condition", "Actions", "To"] } else { ["№", "Event", "Condition", "Actions", "To"] }
    rn_table(rn_cols(cx, keys), out)
}

// The rows of 2.26 (AL-137): no `№`; an appeal and a common event `Событие | Условие | Действия | Куда`, a fork `Условие | Действия | Куда`, an operation `Действия | Куда`; "none" is the empty cell.
fn rn_rows_226(mut cx RnCx, rows []RJ, kind str, locals []str) -> []str {
    mut out = []RnRow.new()
    for r in rows {
        mut cells = []str.new()
        mut row_locals = rn_copy(locals)
        if kind != "fork" && kind != "operation" {
            ro ev = match rj_get(r, "event") {
                Some(e) => rn_event(cx, e, locals)
                None => RnEvent { text: RN_EMPTY, locals }
            }
            cells.push(ev.text)
            row_locals = ev.locals
        }
        if kind != "operation" {
            ro cond = match rj_get(r, "cond") {
                Some(c) => rn_expr(cx, c, row_locals)
                None => RN_EMPTY
            }
            ro is_else = match rj_get(r, "else") {
                Some(e) => match e {
                    RBool(b) => b
                    _ => false
                }
                None => false
            }
            cells.push(if is_else { rn_kw(cx, "event", "else") } else { cond })
        }
        ro acts = rj_garr(r, "actions")
        cells.push(if acts.len() == 0 { RN_EMPTY } else { rn_actions_in(cx, acts, row_locals, "<br>").text })
        cells.push(rn_destination(cx, r))
        out.push(RnRow { cells })
    }
    // 0.28: the mode "заново" is the optional last column of the table (written when at least one row has it)
    mut has_rerun = false
    for r in rows {
        match rj_get(r, "restart") {
            Some(rb) => match rb {
                RBool(b) => { if b { has_rerun = true } }
                _ => ()
            }
            None => ()
        }
    }
    if has_rerun {
        mut out2 = []RnRow.new()
        for r in out {
            mut cells2 = r.cells
            cells2.push("")
            out2.push(RnRow { cells: cells2 })
        }
        mut k = 0
        for r in rows {
            match rj_get(r, "restart") {
                Some(rb) => match rb {
                    RBool(b) => { if b { out2[k].cells[out2[k].cells.len() - 1] = rn_kw(cx, "enum_value", "yes") } }
                    _ => ()
                }
                None => ()
            }
            k += 1
        }
        mut keys = rows_columns(kind, true)
        keys.push("rerun")
        return rn_table(rn_cols(cx, keys), out2)
    }
    rn_table(rn_cols(cx, rows_columns(kind, true)), out)
}

fn rn_entry_lines(mut cx RnCx, st RJ, locals []str) -> []str {
    ro actions = rj_garr(st, "entry")
    mut out = []str.new()
    if actions.len() == 0 { return out }
    ro key = rn_kw(cx, "key", "On entry")
    if actions.len() == 1 {
        out.push("- ${key}: ${rn_actions(cx, actions, locals).text}")
        return out
    }
    out.push("- ${key}:")
    mut inner = rn_copy(locals)
    mut at = 0
    for a in actions {
        ro text = rn_action(cx, a, inner)
        if rj_gstr(a, "do") == "bind" { inner = rn_with(inner, rj_gstr(a, "name")) }
        at += 1
        out.push(if at < actions.len() { "  - ${text};" } else { "  - ${text}" })
    }
    out
}

fn rn_state(mut cx RnCx, st RJ, index int) -> []str {
    ro kind = rj_gstr(st, "kind")
    mut out = []str.new()
    out.push("### ${rj_gstr(st, "name")} — ${rn_kw(cx, "kind_state", kind)}")
    if kind == "appeal" {
        ro party_word = rj_gstr(st, "party")
        // 0.28: one key per item of the list: `Набор` is a line of its own; the seam of 2.25 writes `; набор: …` in the line of the party (the word of the layer of 2.25)
        mut party_line = "- ${rn_kw(cx, "key", "Party")}: ${party_word}"
        match rj_get(st, "set") {
            Some(e) => {
                if cx.v226 {
                    out.push(party_line)
                    out.push("- ${rn_kw(cx, "key", "Set")}: ${rn_expr(cx, e, []str.new())}")
                    party_line = ""
                } else {
                    party_line = "${party_line}; ${rn_kw(cx, "key", "set")}: ${rn_expr(cx, e, []str.new())}"
                }
            }
            None => ()
        }
        if party_line != "" { out.push(party_line) }
        match rj_get(st, "silence") {
            Some(e) => { out.push("- ${rn_kw(cx, "key", "Idle term")}: ${rn_expr(cx, e, []str.new())}") }
            None => ()
        }
        if rj_gstr(st, "edits") != "" {
            // 0.28: `Проверка` is an item of its own; the seam of 2.25 writes `; проверка: …` in the line of `Правит` (the word of the layer of 2.25)
            if cx.v226 {
                out.push("- ${rn_kw(cx, "key", "Edits")}: ${rn_global(cx, rj_gstr(st, "edits"))}")
                if rj_gstr(st, "edit_check") != "" { out.push("- ${rn_kw(cx, "key", "Check")}: ${rj_gstr(st, "edit_check")}") }
            } else {
                out.push("- ${rn_kw(cx, "key", "Edits")}: ${rn_global(cx, rj_gstr(st, "edits"))}; ${rn_kw(cx, "key", "check")}: ${rj_gstr(st, "edit_check")}")
            }
        }
        match rj_get(st, "form_returns") {
            Some(n) => { out.push("- ${rn_kw(cx, "key", "Form returns")}: ${rj_gscalar(st, "form_returns")}") }
            None => ()
        }
        ro inputs = rj_garr(st, "inputs")
        // an appeal without the fields of the request writes no line `Запрос:` (format 4.1, 2.13, AL-39, AL-40)
        if inputs.len() > 0 {
            out.push("- ${rn_kw(cx, "key", "Request")}:")
            out.push("")
            mut rows = []RnRow.new()
            for i in inputs {
                // the expression that is the name of the field is written `—` (spec 4.2, 1b (г), AL-56)
                ro same = match rj_get(i, "value") {
                    Some(e) => rj_gstr(e, "op") == "name" && rj_gstr(e, "name") == rj_gstr(i, "field")
                    None => false
                }
                ro value = match rj_get(i, "value") {
                    Some(e) => if same { if cx.v226 { RN_EMPTY } else { "—" } } else { rn_expr(cx, e, []str.new()) }
                    None => "none"
                }
                if cx.v226 {
                    // 2.26 (AL-138): no column `читает`, the field goes to the party
                    rows.push(RnRow { cells: [rn_field_name(cx, rj_gstr(i, "field")), value] })
                } else {
                    ro reads = rn_kw(cx, "enum_value", if rj_gstr(i, "reads") == "party" { "party" } else { "executor" })
                    rows.push(RnRow { cells: [rn_field_name(cx, rj_gstr(i, "field")), value, reads] })
                }
            }
            rn_add(out, rn_table(rn_cols(cx, if cx.v226 { ["request_field", "expression"] } else { ["request_field", "expression", "reads"] }), rows))
        }
        ro accept = rj_garr(st, "accept")
        if accept.len() > 0 {
            out.push("")
            out.push("- ${rn_kw(cx, "key", "On accept")}:")
            out.push("")
            mut rows = []RnRow.new()
            for a in accept {
                ro ev = match rj_get(a, "event") {
                    Some(e) => rn_event(cx, e, []str.new())
                    None => RnEvent { text: "—", locals: []str.new() }
                }
                rows.push(RnRow { cells: [ev.text, rn_actions_in(cx, rj_garr(a, "actions"), ev.locals, rn_cell_sep(cx)).text] })
            }
            rn_add(out, rn_table(rn_cols(cx, ["event", "actions"]), rows))
        }
        out.push("")
        rn_add(out, rn_rows(cx, rj_garr(st, "rows"), "appeal", []str.new()))
        return out
    }
    // an operation, a fork, an end: the names read (no line when it reads nothing, AL-40; no line in 2.26, the reads are derived, AL-138), the entry, the exception, the rows
    if !cx.v226 {
        match rj_get(st, "reads_all") {
            Some(r) => { out.push("- ${rn_kw(cx, "key", "Reads")}: ${rn_kw(cx, "readable", "all_data")}") }
            None => {
                mut names = []str.new()
                for n in rj_garr(st, "reads") { names.push(rn_global(cx, rj_str(n))) }
                if names.len() > 0 { out.push("- ${rn_kw(cx, "key", "Reads")}: ${names.join(", ")}") }
            }
        }
    }
    rn_add(out, rn_entry_lines(cx, st, []str.new()))
    match rj_get(st, "except") {
        Some(e) => {
            mut values = []str.new()
            for v in rj_garr(e, "values") { values.push(rn_quote(rj_str(v))) }
            out.push("- ${rn_kw(cx, "key", "Except")}: ${rn_global(cx, rj_gstr(e, "field"))} ${rn_kw(cx, "operator", "in")} [${values.join(", ")}]")
        }
        None => ()
    }
    if kind != "end" {
        out.push("")
        rn_add(out, rn_rows(cx, rj_garr(st, "rows"), kind, rn_bind_names_of(rj_garr(st, "entry"))))
    }
    out
}

fn rn_sec_states(mut cx RnCx, root RJ) -> []str {
    mut out = []str.new()
    // 0.28: the initial state is the first item of the list of the section
    if cx.v226 {
        out.push("- ${rn_kw(cx, "key", "Initial state")}: ${rj_gstr(root, "initial")}")
    } else {
        out.push("${rn_kw(cx, "key", "Initial state")}: ${rj_gstr(root, "initial")}")
    }
    mut at = 0
    for st in rj_garr(root, "states") {
        out.push("")
        rn_add(out, rn_state(cx, st, at))
        at += 1
    }
    out
}

/// The common events (the rows of the signals that are tried before the rows of a state, and the rows of a connected library): a section of their own, only when there are some.
fn rn_sec_common(mut cx RnCx, root RJ) -> []str {
    ro rows = rj_garr(root, "common_events")
    mut out = []str.new()
    if rows.len() == 0 { return out }
    out.push("## ${rn_kw(cx, "section", "Common events")}")
    out.push("")
    rn_add(out, rn_rows(cx, rows, "appeal", []str.new()))
    out.push("")
    out
}

fn rn_sec_ends(mut cx RnCx, root RJ) -> []str {
    ro ends = match rj_get(root, "ends") {
        Some(e) => e
        None => RNull
    }
    mut out = []str.new()
    out.push("- ${rn_kw(cx, "key", "Result")}: ${rn_type(cx, rj_gstr(ends, "result"))}")
    out.push("")
    mut rows = []RnRow.new()
    for r in rj_garr(ends, "rows") {
        ro when = match rj_get(r, "when") {
            Some(e) => rn_expr(cx, e, []str.new())
            None => "true"
        }
        ro answer = match rj_get(r, "answer") {
            Some(a) => a
            None => RNull
        }
        mut text = "—"
        if rj_gstr(answer, "kind") == "answer" {
            ro value = match rj_get(answer, "value") {
                Some(e) => rn_expr(cx, e, []str.new())
                None => "none"
            }
            text = "${rn_kw(cx, "expr", "Response")}(${value})"
        } else if rj_gstr(answer, "kind") == "refusal" {
            ro code = match rj_get(answer, "code") {
                Some(e) => rn_expr(cx, e, []str.new())
                None => "none"
            }
            ro reason = match rj_get(answer, "text") {
                Some(e) => rn_expr(cx, e, []str.new())
                None => "none"
            }
            text = "${rn_kw(cx, "expr", "Refusal")}(${code}, ${reason})"
        }
        if cx.v226 {
            rows.push(RnRow { cells: [rj_gstr(r, "state"), when, text] })
        } else {
            rows.push(RnRow { cells: [rj_gstr(r, "state"), rj_gscalar(r, "n"), when, text] })
        }
    }
    rn_add(out, rn_table(rn_cols(cx, if cx.v226 { ["end", "when", "response"] } else { ["end", "№", "when", "response"] }), rows))
    out
}

// The section of the external functions (AL-123): the declarations of the tree, one per line, in a block of code. The class of a pure function has no word; the named tail is the last parameter `...имя: Тип` (AL-129).
fn rn_sec_primitives(mut cx RnCx, root RJ) -> []str {
    mut lines = []str.new()
    mut at = 0
    for n in rj_garr(root, "primitives") {
        ro name = rj_gstr(n, "name")
        if name == "" {
            rn_note(cx, "$.primitives[${at}]: since 2.24 an external function is a record `{ name, params, result, class }`, not a name (AL-123)")
            at += 1
            continue
        }
        mut params = []str.new()
        for q in rj_garr(n, "params") {
            ro tail = match rj_get(q, "tail") {
                Some(x) => match x {
                    RBool(b) => b
                    _ => false
                }
                None => false
            }
            if tail {
                params.push("...${rj_gstr(q, "name")}: ${rn_type(cx, rj_gstr(q, "type"))}")
            } else {
                params.push("${rj_gstr(q, "name")} ${rn_type(cx, rj_gstr(q, "type"))}")
            }
        }
        mut line = if cx.v226 { "${name}(${params.join(", ")})" } else { "${rn_kw(cx, "decl", "external")} ${rn_kw(cx, "decl", "fn")} ${name}(${params.join(", ")})" }
        ro class = rj_gstr(n, "class")
        if class == "volatile" || class == "acting" { line = "${line} ${rn_kw(cx, "enum_value", class)}" }
        if rj_gstr(n, "result") != "" { line = "${line} -> ${rn_type(cx, rj_gstr(n, "result"))}" }
        lines.push(line)
        at += 1
    }
    if lines.len() == 0 { return ["—"] }
    mut out = ["```"]
    rn_add(out, lines)
    out.push("```")
    out
}

// ---- the names of the included files ------------------------------------------------------------------------------------------

/// The names that an included file of definitions brings (types, constants, definitions): they are in the tree beside the machine's own, and the file does not write them again.
type RnDropped { types []str, constants []str, definitions []str }

fn rn_dropped(mut cx RnCx, root RJ, copy_includes bool) -> RnDropped {
    mut types = []str.new()
    mut constants = []str.new()
    mut definitions = []str.new()
    // the types that came with a called machine (AL-146) are not written: the caller declares no copy of them
    for p in rj_garr(root, "parties") {
        for n in rj_garr(p, "callee_types") { types.push(rj_str(n)) }
    }
    if !copy_includes {
        for inc in rj_garr(root, "includes") {
            ro name = rj_gstr(inc, "name")
            // a library of 2.26 names what it brought (section 9, 1b (м))
            if rj_has(inc, "file") {
                match rj_get(inc, "brings") {
                    Some(b) => {
                        for n in rj_garr(b, "types") { types.push(rj_str(n)) }
                        for n in rj_garr(b, "constants") { constants.push(rj_str(n)) }
                        for n in rj_garr(b, "definitions") { definitions.push(rj_str(n)) }
                    }
                    None => ()
                }
                continue
            }
            ro text = defs_file_text(name)
            if text == "" {
                rn_note(cx, "$.includes: the file of definitions `${name}` is not in the registry of the translator, its types, constants and definitions are written as the machine's own")
                continue
            }
            match rj_parse(translate_definitions(text).json) {
                Ok(doc) => {
                    match rj_get(doc, "types") {
                        Some(t) => {
                            for n in rn_names_of(t, "records") { types.push(n) }
                            for n in rn_names_of(t, "variants") { types.push(n) }
                        }
                        None => ()
                    }
                    for n in rn_names_of(doc, "constants") { constants.push(n) }
                    for n in rn_names_of(doc, "definitions") { definitions.push(n) }
                }
                Err(e) => rn_note(cx, "$.includes: the file `${name}` gave no tree: ${e}")
            }
        }
    }
    RnDropped { types, constants, definitions }
}

// The lines without the empty ones at the end.
fn rn_trimmed(lines []str) -> []str {
    mut end = lines.len()
    while end > 0 && lines[end - 1] == "" { end -= 1 }
    mut out = []str.new()
    mut i = 0
    while i < end {
        out.push(lines[i])
        i += 1
    }
    out
}

/// Section by section: the heading, the lines, an empty line.
fn rn_section(mut out []str, heading str, lines []str) -> () {
    out.push("## ${heading}")
    // an empty section is the one line `—` right under the heading, a table or a block of code has an empty line before it
    if !(lines.len() == 1 && lines[0] == "—") { out.push("") }
    rn_add(out, lines)
    out.push("")
}

// A section of 2.26: an empty section (a dash, or nothing) is not written (AL-137).
fn rn_section_226(mut out []str, heading str, lines []str) -> () {
    if lines.len() == 0 || (lines.len() == 1 && lines[0] == "—") { return }
    rn_section(out, heading, lines)
}

/// The first former key or kind of a tree of 2.12 (`words` of a party or of an enum, the event kind `word`, the argument `halt_word`): the place and the message, "" when the tree holds none. No transition period (AL-38, AL-41).
fn rn_former_note(v RJ, path str) -> str {
    for pair in rj_pairs(v) {
        if pair.key == "words" { return "${path}.words: the key words is the former name of signals (the signals of a party, AL-38) or of values (the values of an enum, AL-41); there is no transition period" }
        if pair.key == "halt_word" { return "${path}.halt_word: the argument halt_word is the former name of halt_signal (AL-38); there is no transition period" }
        if pair.key == "kind" && rj_str(pair.value) == "word" && rj_has(v, "word") { return "${path}.kind: the event kind word is the former name of signal (AL-38); there is no transition period" }
        ro inner = rn_former_note(pair.value, "${path}.${pair.key}")
        if inner != "" { return inner }
    }
    mut i = 0
    for item in rj_items(v) {
        ro inner = rn_former_note(item, "${path}[${i}]")
        if inner != "" { return inner }
        i += 1
    }
    ""
}

/// The file of Alula for a tree `machine/2` in the language (`ru` or `en`); `copy_includes` writes the types, the constants and the definitions of the included files of definitions as the
/// machine's own (else the line of connection stands and the copies are left out, section 1b (м)).
export fn render_machine_with(machine_json str, language str, copy_includes bool) -> RenderReport => render_machine_in(machine_json, language, copy_includes, language_registry())

/// The same with the registry of the host (kept for the callers: the tree T1 of 2.24 holds the class and the signature of an external function itself, the file is written from the tree alone).
/// A library is named as the tree names it (no files of the libraries are given: `render_machine_libs` names the twin of a library in the other language).
export fn render_machine_in(machine_json str, language str, copy_includes bool, registry Registry) -> RenderReport => rn_machine(machine_json, language, copy_includes, registry, []NamedText.new(), false)

/// The same with the files of the libraries that the tree connects and of their twins, by their paths (2.26, section 9, task 241): a library whose file is in the other language than
/// `language` is named by its twin (`libs/pause.alula.md` <-> `libs/pause.en.alula.md`): its path, its hash, its title, the names of its parameters and the values of the sets of literals
/// in its language. A twin that is not in `libs` (or a library whose own file is not there, so its parameters can not be matched) is a note.
export fn render_machine_libs(machine_json str, language str, copy_includes bool, registry Registry, libs []NamedText) -> RenderReport => rn_machine(machine_json, language, copy_includes, registry, libs, true)

fn rn_machine(machine_json str, language str, copy_includes bool, registry Registry, libs []NamedText, twins bool) -> RenderReport {
    if language != "ru" && language != "en" {
        return RenderReport { text: "", notes: ["the language must be `ru` or `en`, got `${language}`"] }
    }
    match rj_parse(machine_json) {
        Err(e) => RenderReport { text: "", notes: ["not a JSON: ${e}"] }
        Ok(root) => {
            // the root of 0.27 says `kind` and `revision` (AL-147); a tree of the seam of 2.25 says `format` and `version`
            ro seam = !rj_has(root, "kind") && rj_gstr(root, "format") == "machine/2" && (rj_gstr(root, "alula_version") == "" || rj_gstr(root, "alula_version") == "2.25")
            if !seam {
                if rj_has(root, "format") || rj_has(root, "version") {
                    ro message_keys = "с 0.27 — kind и revision: the tree says `format` or `version` (AL-147; there is no transition period)"
                    return RenderReport { text: "", notes: [message_keys] }
                }
                if rj_gstr(root, "kind") != "machine" {
                    return RenderReport { text: "", notes: ["the tree is not a machine: the key `kind` is `${rj_gstr(root, "kind")}`"] }
                }
            }
            // the former key of the version (the language was called Alula before 2.14) is refused by name
            if rj_gstr(root, "portolan_version") != "" { // guard-allow(legacy-name): the former key is named here to be refused
                return RenderReport { text: "", notes: ["the key `portolan_version` is the former name of `alula_version` (the language is called Alula since the format 2.14; there is no transition period)"] } // guard-allow(legacy-name): the message names the former key
            }
            // a tree of another version of the language is not written (no transition period, task 125): the file would say a version that the translator does not read
            if !seam && rj_gstr(root, "alula_version") != "" && rj_gstr(root, "alula_version") != "0.28" {
                return RenderReport { text: "", notes: ["the tree is of the version ${rj_gstr(root, "alula_version")} of the language; the version 0.28 only is read and written (there is no transition period)"] }
            }
            ro former = rn_former_note(root, "$")
            if former != "" { return RenderReport { text: "", notes: [former] } }
            mut cx = rn_cx_in(language, registry)
            cx.v226 = !seam
            cx.libs = libs
            cx.twins = twins
            ro dropped = rn_dropped(cx, root, copy_includes)
            // what the libraries bring is written by the connection, not as the machine's own (1b (м), section 9)
            ro shown = if cx.v226 { rn_without_libraries(root, copy_includes) } else { root }
            mut out = []str.new()
            out.push("# ${rn_kw(cx, "header", "Machine")}: ${rj_gstr(shown, "machine")}")
            out.push("")
            out.push("- machine: ${rj_gstr(shown, "machine")}")
            if seam {
                out.push("- machine_version: ${rj_gstr(shown, "version")}")
                out.push("- format: 2.25")
            } else {
                // the order of the header of 0.27 (1b (а), AL-144): machine, revision, alula_version, language
                ro revision = rj_gscalar(shown, "revision")
                out.push("- revision: ${if revision == "" { "1" } else { revision }}")
                out.push("- alula_version: 0.28")
            }
            out.push("- language: ${language}")
            out.push("")
            if cx.v226 {
                // 2.26 (section 1, 1b (б)): the order of the sections, an empty section is not written, the ends are `## Выход`, the external functions stand before the functions
                rn_section_226(out, rn_kw(cx, "section", "Types"), rn_sec_types(cx, shown, dropped.types))
                rn_section_226(out, rn_kw(cx, "section", "Constants"), rn_sec_constants(cx, shown, dropped.constants))
                rn_section_226(out, rn_kw(cx, "section", "Parameters"), rn_sec_params(cx, shown))
                rn_section_226(out, rn_kw(cx, "section", "Input"), rn_sec_input(cx, shown))
                rn_section_226(out, rn_kw(cx, "section", "Data"), rn_sec_data(cx, shown))
                rn_section_226(out, rn_kw(cx, "section", "Parties"), rn_sec_parties(cx, shown))
                rn_add(out, rn_extra_sections(cx, shown))
                rn_section_226(out, rn_kw(cx, "section", "Includes"), rn_sec_includes(cx, shown, copy_includes))
                rn_section_226(out, rn_kw(cx, "section", "External functions"), rn_sec_primitives(cx, shown))
                rn_section_226(out, rn_kw(cx, "section", "Functions"), rn_sec_definitions(cx, shown, dropped.definitions))
                rn_add(out, rn_sec_common(cx, shown))
                rn_section_226(out, rn_kw(cx, "section", "States"), rn_sec_states(cx, shown))
                rn_section_226(out, rn_kw(cx, "section", "Output"), rn_sec_ends(cx, shown))
                return RenderReport { text: "${rn_trimmed(out).join("\n")}\n", notes: cx.notes }
            }
            rn_section(out, rn_kw(cx, "section", "Types"), rn_sec_types(cx, shown, dropped.types))
            rn_section(out, rn_kw(cx, "section", "Constants"), rn_sec_constants(cx, shown, dropped.constants))
            rn_section(out, rn_kw(cx, "section", "Parameters"), rn_sec_params(cx, shown))
            rn_section(out, rn_kw(cx, "section", "Input"), rn_sec_input(cx, shown))
            rn_section(out, rn_kw(cx, "section", "Data"), rn_sec_data(cx, shown))
            rn_section(out, rn_kw(cx, "section", "Parties"), rn_sec_parties(cx, shown))
            rn_add(out, rn_extra_sections(cx, shown))
            rn_section(out, rn_kw(cx, "section", "Functions"), rn_sec_definitions(cx, shown, dropped.definitions))
            rn_section(out, rn_kw(cx, "section", "Includes"), rn_sec_includes(cx, shown, copy_includes))
            rn_add(out, rn_sec_common(cx, shown))
            rn_section(out, rn_kw(cx, "section", "States"), rn_sec_states(cx, shown))
            rn_section(out, rn_kw(cx, "section", "Ends"), rn_sec_ends(cx, shown))
            rn_section(out, rn_kw(cx, "section", "External functions"), rn_sec_primitives(cx, shown))
            RenderReport { text: "${rn_trimmed(out).join("\n")}\n", notes: cx.notes }
        }
    }
}

/// The file of Alula for a tree `machine/2` in the language; the line of connection for an included file of definitions.
export fn render_machine(machine_json str, language str) -> RenderReport => render_machine_with(machine_json, language, false)

/// The text of the file only.
export fn render(machine_json str, language str) -> str => render_machine(machine_json, language).text
