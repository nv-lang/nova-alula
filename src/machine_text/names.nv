// names.nv - the table of names: a Russian word of a table -> the Latin word of the JSON, by the dictionary of the methodology (version 10).
//
// Two files are compiled in: `names.tsv` (made from the dictionary by `scripts/glossary-names.py`) and `names_format.tsv` (the names of the format that the
// dictionary does not have: the functions of the catalog, the names of the executor, the words and the signals, and the names of the machines of the
// product). A line is `kind<TAB>Russian<TAB>English`; a later line beats an earlier one on the same kind. The kind says where the word stands: a datum
// `расход` is `transport_usage`, the field `расход` is `usage` (the dictionary, section 2.15), so the translator asks for the kind it needs.
//
// A word that is not in the table is an error with the nearest word as a hint; a name that the table itself introduces (a parameter of a definition, a
// binding, a variable of a lambda) is looked up under `variable` and, when the dictionary has it not, written in Latin letters by `tx_translit`.
module alula.machine_text

// ORACLE-WORKAROUND(32): `import std.text` is needed in `nova build` for `[]str.join` (a `nova test` build has it already); drop the import when item 32 is fixed
import std.text
import std.collections.hash_map.{HashMap}

/// TxName: a line of the table of names: the kind, the word as the language of the file writes it (`ru` for a Russian file, the English word for an English one) and the Latin word of the JSON.
type TxName { kind str, ru str, en str }

/// TxNames: the lines in order, the index "kind, word of the file" -> the Latin word, and the reverse one "kind, Latin word" -> the word of the file (the first line of the table that has it).
type TxNames { rows []TxName, index HashMap[str, str], rev HashMap[str, str] }

fn names_text() -> str => embed_str("names.tsv")

fn names_format_text() -> str => embed_str("names_format.tsv")

fn names_aliases_text() -> str => embed_str("names_aliases.tsv")

fn names_key(kind str, ru str) -> str => "${kind}\t${ru}"

// The kinds whose words are keywords of the language (the table of words has them): an English file does not take their Russian words as names (section 1a).
fn names_keyword_kinds() -> []str => ["catalog", "executor"]

// The lines of one file of names. A Russian file reads "Russian -> Latin"; an English file reads "Latin -> Latin" and, for the kinds that are not keywords, the Russian words too (the
// names that the author invents may be of any language, section 1a).
fn names_read(text str, lang str, mut rows []TxName, mut index HashMap[str, str], mut rev HashMap[str, str]) -> () {
    for raw in text.split("\n") {
        ro line = raw.strip_suffix("\r") ?? raw
        if line.byte_len() == 0 || line.starts_with("#") { continue }
        ro parts = line.split("\t")
        mut cells = []str.new()
        for part in parts { cells.push(part) }
        if cells.len() < 3 { continue }
        ro mine = if lang == "en" { cells[2] } else { cells[1] }
        rows.push(TxName { kind: cells[0], ru: mine, en: cells[2] })
        ro old = index.insert(names_key(cells[0], mine), cells[2])
        match rev.get(names_key(cells[0], cells[2])) {
            Some(first) => ()
            None => {
                ro old_rev = rev.insert(names_key(cells[0], cells[2]), mine)
            }
        }
        if lang == "en" && !names_keyword_kinds().contains(cells[0]) {
            ro old_ru = index.insert(names_key(cells[0], cells[1]), cells[2])
        }
    }
}

// The synonyms of the English files: a line "kind, the English word, the Latin word of the JSON" makes the word a name of that kind (it beats the identity of the dictionary).
fn names_read_aliases(text str, mut index HashMap[str, str]) -> () {
    for raw in text.split("\n") {
        ro line = raw.strip_suffix("\r") ?? raw
        if line.byte_len() == 0 || line.starts_with("#") { continue }
        ro parts = line.split("\t")
        mut cells = []str.new()
        for part in parts { cells.push(part) }
        if cells.len() < 3 { continue }
        ro old = index.insert(names_key(cells[0], cells[1]), cells[2])
    }
}

/// The table of names of this build for a language of the file.
fn names_load_for(lang str) -> TxNames {
    mut rows = []TxName.new()
    mut index = HashMap[str, str].new()
    mut rev = HashMap[str, str].new()
    names_read(names_text(), lang, rows, index, rev)
    names_read(names_format_text(), lang, rows, index, rev)
    if lang == "en" { names_read_aliases(names_aliases_text(), index) }
    TxNames { rows, index, rev }
}

/// The table of names for a Russian file.
fn names_load() -> TxNames => names_load_for("ru")

/// The word of the language of the file for a Latin word under a kind (the reverse of `names_get`).
fn names_file_word(n TxNames, kind str, en str) -> Option[str] => n.rev.get(names_key(kind, en))

/// The English word of the Russian one under a kind.
fn names_get(n TxNames, kind str, ru str) -> Option[str] => n.index.get(names_key(kind, ru))

/// The English word under the first of the kinds that has it.
fn names_first(n TxNames, kinds []str, ru str) -> Option[str] {
    for kind in kinds {
        match n.index.get(names_key(kind, ru)) {
            Some(en) => return Some(en)
            None => ()
        }
    }
    None
}

// ---- the nearest word -------------------------------------------------------------------------------------------------------

/// The distance of Levenshtein of two words (by letters).
fn tx_distance(first str, second str) -> int => tx_distance_chars(first.chars().collect(), second.chars().collect())

fn tx_distance_chars(first []char, second []char) -> int {
    mut prev = []int.new()
    mut j = 0
    while j <= second.len() {
        prev.push(j)
        j += 1
    }
    mut i = 1
    while i <= first.len() {
        mut cur = []int.new()
        cur.push(i)
        j = 1
        while j <= second.len() {
            ro cost = if first[i - 1] == second[j - 1] { 0 } else { 1 }
            mut best = prev[j - 1] + cost
            if prev[j] + 1 < best { best = prev[j] + 1 }
            if cur[j - 1] + 1 < best { best = cur[j - 1] + 1 }
            cur.push(best)
            j += 1
        }
        prev = cur
        i += 1
    }
    prev[second.len()]
}

/// The hint for an unknown word: `; возможно, `x`` for the nearest word of the kinds when it is near enough, else the empty text.
fn names_hint(n TxNames, kinds []str, ru str) -> str {
    ro word []char = ru.chars().collect()
    mut best = ""
    mut best_distance = 1000
    for row in n.rows {
        if !kinds.contains(row.kind) { continue }
        ro d = tx_distance_chars(word, row.ru.chars().collect())
        if d < best_distance {
            best_distance = d
            best = row.ru
        }
    }
    ro limit = if word.len() / 3 > 2 { word.len() / 3 } else { 2 }
    if best != "" && best_distance <= limit { return "; возможно, `${best}`" }
    ""
}

// ---- Latin letters for a word that no table has ------------------------------------------------------------------------------

fn translit_pairs() -> []str => [
    "а=a", "б=b", "в=v", "г=g", "д=d", "е=e", "ё=yo", "ж=zh", "з=z", "и=i", "й=j", "к=k", "л=l", "м=m", "н=n", "о=o", "п=p", "р=r", "с=s", "т=t", "у=u",
    "ф=f", "х=kh", "ц=c", "ч=ch", "ш=sh", "щ=shch", "ъ=", "ы=y", "ь=", "э=e", "ю=yu", "я=ya"
]

// The lower case of a char (any alphabet that has the case); a char without one stays.
fn tx_lower_char(c char) -> str {
    if c >= 'A' && c <= 'Z' { return "${c.to_ascii_lowercase()}" }
    if (c as int) < 128 { return "${c}" }
    c.to_lowercase()
}

/// The lower case of a text, char by char (`Ä` -> `ä`, `Σ` -> `σ`, `Я` -> `я`); a char without a case stays.
fn tx_lower(s str) -> str {
    mut out = []str.new()
    for c in s.chars() { out.push(tx_lower_char(c)) }
    out.join("")
}

/// A Russian word in Latin letters (the letters of the table above, lower case; digits and underscores stay). Used only for the names that the
/// table introduces itself and the dictionary has not.
fn tx_translit(ru str) -> str {
    mut out = []str.new()
    for c in ru.chars() {
        ro one = tx_lower_char(c)
        mut done = false
        for pair in translit_pairs() {
            ro at = pair.find("=") ?? -1
            if at > 0 && pair[..at] == one {
                out.push(pair[at + 1..])
                done = true
                break
            }
        }
        if !done { out.push(one) }
    }
    out.join("")
}
