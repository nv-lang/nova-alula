// names.nv - the names that the HOST of the machine owns, as data (task 149, format 2.14, AL-46). A name that a file declares gets its JSON name from the brackets of the declaration (`число_ходов (turn_count)`):
// the dictionary of the methodology is no longer read (spec 1a: "the dictionary is only a source of proposed names"). What stays here is not a dictionary but the registry of the host: the names of the nested
// machines (`шаг_агента` -> `agent_step`, the registry of the caller, rule 35) and the names of the signals of the call protocol that the fragment Pause reads with their fields (the fragment has no file of its own
// that declares them, spec section 9, AL-35).
//
// The file `names_host.tsv` is `kind<TAB>Russian<TAB>English`. An English file reads the English word as the key.
module alula.machine_text

// ORACLE-WORKAROUND(32): `import std.text` is needed in `nova build` for `[]str.join` (a `nova test` build has it already); drop the import when item 32 is fixed
import std.text
import std.collections.hash_map.{HashMap}

/// TxName: a line of the table of the host: the kind, the word as the language of the file writes it and the Latin word of the JSON.
type TxName { kind str, ru str, en str }

/// TxNames: the lines in order, the index "kind, word of the file" -> the Latin word, and the reverse one "kind, Latin word" -> the word of the file.
type TxNames { rows []TxName, index HashMap[str, str], rev HashMap[str, str] }

fn names_host_text() -> str => embed_str("names_host.tsv")

fn names_key(kind str, ru str) -> str => "${kind}\t${ru}"

// The lines of the table. A Russian file reads "Russian -> Latin"; an English file reads "Latin -> Latin".
fn names_read(text str, lang str, mut rows []TxName, mut index HashMap[str, str], mut rev HashMap[str, str]) -> () {
    for raw in text.split("\n") {
        ro line = raw.strip_suffix("\r") ?? raw
        if line.byte_len() == 0 || line.starts_with("#") { continue }
        ro parts = line.split("\t")
        mut cells = []str.new()
        for part in parts { cells.push(part) }
        if cells.len() < 3 { continue }
        ro mine = if lang == "en" { cells[2] } else { cells[1] }
        rows.push(TxName { kind: cells[0], ru: mine, en: cells[2] })
        ro old = index.insert(names_key(cells[0], mine), cells[2])
        match rev.get(names_key(cells[0], cells[2])) {
            Some(first) => ()
            None => {
                ro old_rev = rev.insert(names_key(cells[0], cells[2]), mine)
            }
        }
    }
}

/// The table of the host for a language of the file.
fn names_load_for(lang str) -> TxNames {
    mut rows = []TxName.new()
    mut index = HashMap[str, str].new()
    mut rev = HashMap[str, str].new()
    names_read(names_host_text(), lang, rows, index, rev)
    TxNames { rows, index, rev }
}

/// The table of the host for a Russian file.
fn names_load() -> TxNames => names_load_for("ru")

/// The word of the language of the file for a Latin word under a kind (the reverse of `names_get`).
fn names_file_word(n TxNames, kind str, en str) -> Option[str] => n.rev.get(names_key(kind, en))

/// The Latin word of the word of the file under a kind.
fn names_get(n TxNames, kind str, ru str) -> Option[str] => n.index.get(names_key(kind, ru))

// ---- the nearest word -------------------------------------------------------------------------------------------------------

/// The distance of Levenshtein of two words (by letters).
fn tx_distance(first str, second str) -> int => tx_distance_chars(first.chars().collect(), second.chars().collect())

fn tx_distance_chars(first []char, second []char) -> int {
    mut prev = []int.new()
    mut j = 0
    while j <= second.len() {
        prev.push(j)
        j += 1
    }
    mut i = 1
    while i <= first.len() {
        mut cur = []int.new()
        cur.push(i)
        j = 1
        while j <= second.len() {
            ro cost = if first[i - 1] == second[j - 1] { 0 } else { 1 }
            mut best = prev[j - 1] + cost
            if prev[j] + 1 < best { best = prev[j] + 1 }
            if cur[j - 1] + 1 < best { best = cur[j - 1] + 1 }
            cur.push(best)
            j += 1
        }
        prev = cur
        i += 1
    }
    prev[second.len()]
}

// The lower case of a char (any alphabet that has the case); a char without one stays.
fn tx_lower_char(c char) -> str {
    if c >= 'A' && c <= 'Z' { return "${c.to_ascii_lowercase()}" }
    if (c as int) < 128 { return "${c}" }
    c.to_lowercase()
}

/// The lower case of a text, char by char (`Ä` -> `ä`, `Σ` -> `σ`, `Я` -> `я`); a char without a case stays.
fn tx_lower(s str) -> str {
    mut out = []str.new()
    for c in s.chars() { out.push(tx_lower_char(c)) }
    out.join("")
}

