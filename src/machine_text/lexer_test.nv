// lexer_test.nv - the lossless lexer (AL-90 ... AL-92): `lx_reserialize(lx_lex(src)) == src` on every file of the package and on mutations of them, the numbers (D44), the order of the
// signs, the text literals (the escapes, the insertions), the comments, the broken places.
module alula.machine_text

import std.text
import alula.machine.{table_files, NamedText}

// The tokens as `kind:text`, the broken ones as `!text`, the end token left out.
fn lk(src str) -> str {
    mut parts = []str.new()
    for t in lx_lex(src) {
        if t.kind == LK_EOF { continue }
        if t.kind == LK_ERROR {
            parts.push("!${t.text}")
        } else if t.kind == LK_NAME {
            parts.push("n:${t.text}")
        } else if t.kind == LK_INT {
            parts.push("i:${t.text}")
        } else if t.kind == LK_FLOAT {
            parts.push("f:${t.text}")
        } else if t.kind == LK_STR {
            parts.push("s:${t.text}")
        } else {
            parts.push(t.text)
        }
    }
    parts.join(" ")
}

fn round_trips(src str) -> bool => lx_reserialize(lx_lex(src)) == src

// ---- the lead invariant ----------------------------------------------------------------------------------------------------------

test "lx reserialize empty and small" {
    assert(round_trips(""))
    assert(round_trips(" "))
    assert(round_trips("\n\n"))
    assert(round_trips("a"))
    assert(round_trips("a // b\n"))
    assert(round_trips("\r\n"))
    assert(round_trips("— ≥ …"))
}

test "lx reserialize machines of the package" {
    for f in table_files() {
        assert(round_trips(f.text))
    }
}

test "lx reserialize sources and tables" {
    for text in [embed_str("lexer.nv"), embed_str("parse.nv"), embed_str("alula-keywords.tsv"), embed_str("keywords_product.tsv"), embed_str("glossary_names.tsv"), embed_str("fragments/pause.fragment.md"), embed_str("fragments/pause.fragment.en.md"), embed_str("defs/cycle-arithmetic.alula.md"), embed_str("defs/cycle-arithmetic.en.alula.md")] {
        assert(round_trips(text))
    }
}

test "lx reserialize crlf" {
    ro src = "a = 1\r\n// c\r\n\"s\" 2\r\n"
    assert(round_trips(src))
    assert(lk(src) == "n:a = i:1 s:\"s\" i:2")
}

// A deterministic generator of numbers for the mutations.
fn lx_next(seed int) -> int => (seed * 1103515245 + 12345) % 2147483648

fn lx_pieces() -> []str => ["\"", "\${", "}", "\\", "//", "\\u{", "..", "..=", "...", "1_", "e", "0x", "—", "≥", "\n", "\r", "#", "'", "`", "\\|"]

// A text with one mutation at the char `at`: a char deleted, a piece put in, or a char replaced by a piece.
fn lx_mutate(chars []char, at int, how int, piece str) -> str {
    mut out = []str.new()
    mut k = 0
    for c in chars {
        if k == at {
            if how == 1 {
                out.push(piece)
                out.push("${c}")
            } else if how == 2 {
                out.push(piece)
            }
        } else {
            out.push("${c}")
        }
        k += 1
    }
    out.join("")
}

fn lx_mutations_hold(src str, count int, seed0 int) -> bool {
    ro chars []char = src.chars().collect()
    if chars.len() == 0 { return true }
    mut seed = seed0
    mut k = 0
    while k < count {
        seed = lx_next(seed)
        ro at = seed % chars.len()
        seed = lx_next(seed)
        ro how = seed % 3
        seed = lx_next(seed)
        ro piece = lx_pieces()[seed % lx_pieces().len()]
        ro mutated = lx_mutate(chars, at, how, piece)
        if !round_trips(mutated) { return false }
        k += 1
    }
    true
}

test "lx mutations small files" {
    assert(lx_mutations_hold(embed_str("fragments/pause.fragment.md"), 60, 7))
    assert(lx_mutations_hold(embed_str("defs/cycle-arithmetic.alula.md"), 60, 11))
    assert(lx_mutations_hold(embed_str("defs/cycle-arithmetic.en.alula.md"), 60, 13))
}

test "lx mutations machines" {
    mut seed = 3
    for f in table_files() {
        seed += 1
        if f.name == "task_runner.alula.md" || f.name == "cycle_check.alula.md" || f.name == "agent_step.alula.txt" { continue }
        assert(lx_mutations_hold(f.text, 40, seed))
    }
}

test "lx mutations cut at every place of a line" {
    ro line = "x = \"a\${b + \"c\"}d\" ?? 1_000..=2e-7 // end"
    ro chars []char = line.chars().collect()
    mut at = 0
    while at <= chars.len() {
        assert(round_trips(lx_mutate(chars, at, 0, "")))
        assert(round_trips(lx_mutate(chars, at, 1, "\"")))
        assert(round_trips(lx_mutate(chars, at, 2, "\${")))
        at += 1
    }
}

test "lx prefixes of a file round-trip" {
    ro src = embed_str("defs/cycle-arithmetic.alula.md")
    ro chars []char = src.chars().collect()
    mut n = 0
    while n <= chars.len() {
        mut out = []str.new()
        mut k = 0
        for c in chars {
            if k < n { out.push("${c}") }
            k += 1
        }
        assert(round_trips(out.join("")))
        n += 1
    }
}

// ---- names, the signs ------------------------------------------------------------------------------------------------------------

test "lx names of any alphabet" {
    assert(lk("a b_1 Имя ёж_Ё _x _") == "n:a n:b_1 n:Имя n:ёж_Ё n:_x n:_")
}

test "lx underscore first is a name" {
    assert(lk("_1") == "n:_1")
    assert(lk("_1_000") == "n:_1_000")
}

test "lx signs one two three" {
    assert(lk("a == b != c <= d >= e += f ?? g -> h => i") == "n:a == n:b != n:c <= n:d >= n:e += n:f ?? n:g -> n:h => n:i")
    assert(lk("( ) [ ] { } , : ; . ? | + - * / % < > = — !") == "( ) [ ] { } , : ; . ? | + - * / % < > = — !")
}

test "lx range signs longest match" {
    assert(lk("a...b") == "n:a ... n:b")
    assert(lk("a..=b") == "n:a ..= n:b")
    assert(lk("a..b") == "n:a .. n:b")
    assert(lk("a....b") == "n:a ... . n:b")
    assert(lk("a...=b") == "n:a ... = n:b")
}

test "lx inclusive range with a space or two signs" {
    assert(lk("a.. =b") == "n:a .. = n:b")
    assert(lk("a..==b") == "n:a ..= = n:b")
}

test "lx fat arrow and arrow" {
    assert(lk("x => y") == "n:x => n:y")
    assert(lk("x=>y") == "n:x => n:y")
    assert(lk("x==>y") == "n:x == > n:y")
    assert(lk("-> =>") == "-> =>")
}

test "lx escaped bar is a sign" {
    assert(lk("a \\| b") == "n:a \\| n:b")
}

// ---- numbers (D44, AL-91) ---------------------------------------------------------------------------------------------------------

test "lx integers" {
    assert(lk("0 12 1_000 1_000_000") == "i:0 i:12 i:1_000 i:1_000_000")
}

test "lx floats" {
    assert(lk("0.5 1.5 1_000.25 1_000.5") == "f:0.5 f:1.5 f:1_000.25 f:1_000.5")
}

test "lx exponents" {
    assert(lk("1e3 1E3 1e-7 1e+7 1.5e3 1.5e-3 2E5 1.5e+3") == "f:1e3 f:1E3 f:1e-7 f:1e+7 f:1.5e3 f:1.5e-3 f:2E5 f:1.5e+3")
}

test "lx exponent in one token" {
    assert(lk("1e3") == "f:1e3")
    assert(lk("1_0e1_0") == "f:1_0e1_0")
}

test "lx dot after a number needs a digit" {
    assert(lk("1.") == "i:1 .")
    assert(lk("1..n") == "i:1 .. n:n")
    assert(lk("0..3") == "i:0 .. i:3")
    assert(lk("1_000..2_000") == "i:1_000 .. i:2_000")
    assert(lk("0.5..2") == "f:0.5 .. i:2")
    assert(lk("1..=3") == "i:1 ..= i:3")
}

test "lx range with a name of any alphabet" {
    assert(lk("1..п") == "i:1 .. n:п")
    assert(lk("с_захода..до_захода") == "n:с_захода .. n:до_захода")
}

test "lx broken numbers" {
    assert(lk("1__0") == "!1__0")
    assert(lk("1_") == "!1_")
    assert(lk("1_e5") == "!1_e5")
    assert(lk("1.5_") == "!1.5_")
    assert(lk("1e") == "!1e")
    assert(lk("1e+") == "!1e +")
    assert(lk("1abc") == "!1abc")
}

test "lx no hexadecimal binary octal suffix" {
    assert(lk("0x1F") == "!0x1F")
    assert(lk("0b101") == "!0b101")
    assert(lk("0o7") == "!0o7")
    assert(lk("10u8") == "!10u8")
}

test "lx number touched by a letter of another alphabet" {
    assert(lk("1шт") == "!1шт")
    assert(lk("1 шт") == "i:1 n:шт")
}

test "lx field index with a float" {
    assert(lk("к.0.1") == "n:к . f:0.1")
    assert(lk("a.1.2") == "n:a . f:1.2")
}

// ---- text literals ---------------------------------------------------------------------------------------------------------------------

test "lx string whole" {
    assert(lk("\"ab\" \"\"") == "s:\"ab\" s:\"\"")
    assert(lk("\"слово | и\"") == "s:\"слово | и\"")
}

test "lx string with an escaped quote" {
    assert(lk("\"a\\\"b\" c") == "s:\"a\\\"b\" n:c")
}

test "lx string with a backslash at the end" {
    assert(lk("\"a\\\\\" b") == "s:\"a\\\\\" n:b")
}

test "lx string unclosed stops at the line" {
    assert(lk("\"open\nb") == "!\"open n:b")
    assert(lk("x \"open") == "n:x !\"open")
}

test "lx string with an escape before the line break is unclosed" {
    assert(lk("\"a\\\nb\"") == "!\"a\\ n:b !\"")
}

test "lx insertion is one token" {
    assert(lk("\"\${x}\"") == "s:\"\${x}\"")
    assert(lk("\"a\${x}b\${y}c\" z") == "s:\"a\${x}b\${y}c\" n:z")
}

test "lx insertion holds a literal with its own quotes" {
    assert(lk("\"a\${\"b\"}c\" z") == "s:\"a\${\"b\"}c\" n:z")
}

test "lx insertion nested to any depth" {
    ro src = "\"\${if has(x) then { \"has \${require(x)}\" } else { \"none\" }}\" end"
    assert(lk(src) == "s:\"\${if has(x) then { \"has \${require(x)}\" } else { \"none\" }}\" n:end")
}

test "lx insertion with braces inside" {
    assert(lk("\"\${ {a: 1} }\" b") == "s:\"\${ {a: 1} }\" n:b")
}

test "lx insertion not closed" {
    assert(lk("\"a\${x\" b").starts_with("!"))
}

test "lx escaped insertion is plain text" {
    assert(lk("\"\\\${x}\" b") == "s:\"\\\${x}\" n:b")
}

test "lx quote inside an insertion does not end the literal" {
    assert(lk("\"\${f(\"q\")}\"") == "s:\"\${f(\"q\")}\"")
}

// ---- the escapes (AL-92) ---------------------------------------------------------------------------------------------------------

fn unesc(inner str) -> str {
    ro r = lx_unescape(inner)
    if r.bad >= 0 { return "BAD ${r.bad}" }
    r.text
}

test "lx escapes closed list" {
    assert(unesc("a\\\"b") == "a\"b")
    assert(unesc("a\\\\b") == "a\\b")
    assert(unesc("a\\$b") == "a$b")
    assert(unesc("a\\nb") == "a\nb")
    assert(unesc("a\\tb") == "a\tb")
    assert(unesc("a\\rb") == "a\rb")
}

test "lx escape null" {
    assert(unesc("a\\0b").byte_len() == 3)
}

test "lx escape unicode" {
    assert(unesc("\\u{41}") == "A")
    assert(unesc("\\u{0041}") == "A")
    assert(unesc("\\u{1F600}") == "\u{1F600}")
    assert(unesc("\\u{10FFFF}").byte_len() == 4)
    assert(unesc("\\u{44f}") == "я")
}

test "lx escape unicode wrong" {
    assert(unesc("\\u{110000}") == "BAD 0")
    assert(unesc("\\u{D800}") == "BAD 0")
    assert(unesc("\\u{DFFF}") == "BAD 0")
    assert(unesc("\\u{}") == "BAD 0")
    assert(unesc("\\u{1234567}") == "BAD 0")
    assert(unesc("\\u41") == "BAD 0")
    assert(unesc("\\u{41") == "BAD 0")
    assert(unesc("\\u{G}") == "BAD 0")
}

test "lx escape other signs wrong" {
    assert(unesc("a\\q") == "BAD 1")
    assert(unesc("\\x41") == "BAD 0")
    assert(unesc("\\'") == "BAD 0")
    assert(unesc("ab\\") == "BAD 2")
    assert(unesc("\\|") == "BAD 0")
}

test "lx escape message names the list" {
    ro r = lx_unescape("\\q")
    assert(r.why.contains("AL-92"))
    assert(r.why.contains("\\q"))
}

test "lx escape position inside the content" {
    assert(unesc("абв\\q").contains("BAD"))
    ro r = lx_unescape("абв\\q")
    assert(r.bad == 6)
}

// ---- the parts of a literal (insertions, AL-80) -------------------------------------------------------------------------------

fn parts_text(inner str) -> str {
    ro r = lx_parts(inner)
    if r.bad >= 0 { return "BAD ${r.bad}" }
    mut out = []str.new()
    for p in r.parts { out.push(if p.code { "{${p.text}}" } else { "'${p.text}'" }) }
    out.join(" ")
}

test "lx parts of a plain literal" {
    assert(parts_text("abc") == "'abc'")
    assert(parts_text("") == "")
}

test "lx parts of a single insertion" {
    assert(parts_text("\${x}") == "{x}")
}

test "lx parts in order" {
    assert(parts_text("\${file}:\${line}") == "{file} ':' {line}")
    assert(parts_text("a\${x}") == "'a' {x}")
    assert(parts_text("turn \${n} of \${m}!") == "'turn ' {n} ' of ' {m} '!'")
}

test "lx parts empty insertion is a part with no code" {
    assert(parts_text("a\${}b") == "'a' {} 'b'")
}

test "lx parts escaped insertion" {
    assert(parts_text("\\\${x}") == "'\${x}'")
    assert(parts_text("a\\\${x}b\${y}") == "'a\${x}b' {y}")
}

test "lx parts insertion with a literal inside" {
    assert(parts_text("\${f(\"a\")}z") == "{f(\"a\")} 'z'")
}

test "lx parts not closed" {
    assert(parts_text("a\${x") == "BAD 1")
}

test "lx parts wrong escape" {
    assert(parts_text("a\${x}\\q") == "BAD 5")
}

test "lx has insertion" {
    assert(lx_has_insertion("a\${x}"))
    assert(!lx_has_insertion("a\\\${x}"))
    assert(!lx_has_insertion("a$ {x}"))
    assert(!lx_has_insertion("a$"))
}

// ---- comments (AL-90) ------------------------------------------------------------------------------------------------------------

test "lx comment is trivia" {
    ro toks = lx_lex("a // b c\nd")
    assert(toks.len() == 3)
    assert(toks[1].leading == " // b c\n")
    assert(lk("a // b c\nd") == "n:a n:d")
}

test "lx comment in a literal is text" {
    assert(lk("\"http://x\" // c") == "s:\"http://x\"")
    assert(lx_cut_comment("A \"http://x\" // c") == "A \"http://x\"")
}

test "lx comment cut" {
    assert(lx_cut_comment("Common events     // parsed before the rows") == "Common events")
    assert(lx_cut_comment("Common events") == "Common events")
    assert(lx_cut_comment("// all") == "")
    assert(lx_cut_comment("a / b") == "a / b")
}

test "lx comment only at the first double slash" {
    assert(lx_comment_at("  // a // b") == 2)
    assert(lx_comment_at(" / / ") == -1)
}

test "lx comment at the end of the text carries to the end token" {
    ro toks = lx_lex("a // end")
    assert(toks[toks.len() - 1].kind == LK_EOF)
    assert(toks[toks.len() - 1].leading == " // end")
}

test "lx triple slash is a comment too" {
    assert(lk("a /// doc") == "n:a")
}

test "lx division is not a comment" {
    assert(lk("a / b /c") == "n:a / n:b / n:c")
}

// ---- the broken places -----------------------------------------------------------------------------------------------------------

test "lx unknown signs" {
    assert(lk("a # b") == "n:a !# n:b")
    assert(lk("a @ b") == "n:a !@ n:b")
    assert(lk("a & b") == "n:a !& n:b")
}

test "lx former signs are broken tokens" {
    assert(lk("a ≥ b") == "n:a !≥ n:b")
    assert(lk("a → b") == "n:a !→ n:b")
    assert(lk("a ∈ b") == "n:a !∈ n:b")
    assert(lk("a … b") == "n:a !… n:b")
}

test "lx error messages" {
    assert(lx_error_message("\"x").contains("кавычках"))
    assert(lx_error_message("1_").contains("AL-91"))
    assert(lx_error_message("≥").contains(">="))
    assert(lx_error_message("#").contains("недопустимый знак"))
}

test "lx end token carries the trivia" {
    ro toks = lx_lex("a  \n  ")
    assert(toks[toks.len() - 1].kind == LK_EOF)
    assert(toks[toks.len() - 1].leading == "  \n  ")
    assert(toks[toks.len() - 1].text == "")
}

test "lx adaptor numbers lose the separator" {
    match tx_lex("1_000 1e-7 0.5", 1, 1) {
        Ok(t) => {
            assert(t.len() == 3)
            assert(t[0].text == "1000" && t[0].raw == "1_000" && t[0].kind == TK_INT)
            assert(t[1].text == "1e-7" && t[1].kind == TK_FLOAT)
            assert(t[2].text == "0.5")
        }
        Err(e) => assert(false)
    }
}

test "lx adaptor strings read the escapes" {
    match tx_lex("\"a\\nb\\u{41}\" \"x\${y}\"", 1, 1) {
        Ok(t) => {
            assert(t.len() == 2)
            assert(t[0].text == "a\nbA" && !t[0].interp)
            assert(t[1].interp && t[1].text == "x\${y}")
        }
        Err(e) => assert(false)
    }
}

test "lx adaptor wrong escape is an error at its place" {
    match tx_lex("a \"bc\\q\"", 3, 5) {
        Ok(t) => assert(false)
        Err(e) => {
            assert(e.line == 3)
            assert(e.col == 10)
            assert(e.message.contains("AL-92"))
        }
    }
}

test "lx adaptor comment in a cell is an error" {
    match tx_lex("a // b", 2, 4) {
        Ok(t) => assert(false)
        Err(e) => {
            assert(e.col == 6)
            assert(e.message.contains("AL-90"))
        }
    }
}

test "lx adaptor comment in a block is not read" {
    match tx_lex_in("a // b c", 1, 1, true) {
        Ok(t) => assert(t.len() == 1)
        Err(e) => assert(false)
    }
}

test "lx adaptor cell escape of the bar inside a literal" {
    match tx_lex("\"a \\| b\"", 1, 1) {
        Ok(t) => assert(t[0].text == "a | b")
        Err(e) => assert(false)
    }
}

test "lx adaptor broken token says what" {
    match tx_lex("x 1__0", 1, 1) {
        Ok(t) => assert(false)
        Err(e) => {
            assert(e.col == 3)
            assert(e.message.contains("AL-91"))
        }
    }
}

test "lx adaptor columns after a comment-free line" {
    match tx_lex("  ab  \"cd\" 12", 7, 3) {
        Ok(t) => {
            assert(t[0].col == 5 && t[1].col == 9 && t[2].col == 14)
        }
        Err(e) => assert(false)
    }
}
