// parse.nv - the reader of the words of a cell: the parser, the context of the translation (the errors, the names), the scope of the bindings,
// the types of the format (section 2) written out as the type strings of the JSON, and the expressions (section 3) written out as the trees of the core.
//
// An error is hard (the cell cannot be read: `Err`) or soft (a word that the table of names does not know: it is put into `cx.errors` and the translation of
// the cell goes on with the Russian word in its place, so that one cell with two unknown words says both).
module alula.machine_text

// ORACLE-WORKAROUND(32): `import std.text` is needed in `nova build` for `[]str.join` (a `nova test` build has it already); drop the import when item 32 is fixed
import std.text

/// TxPair: a Russian word and the Latin word of the JSON.
// ORACLE-WORKAROUND(39): the type names are global to the program, so the pair is `TxPair` and not `Pair`; the `Tx` prefix of every type of the translator can go when item 39 is fixed
type TxPair { ru str, en str }

/// TxEnv: the names that the file itself introduces, collected before the sections are translated: states (the Latin name is in the heading), the data,
/// the constants and the parameters (`globals`), the definitions, the declared types and their cases, the fields of the records, of the forms of enumerations and of the signals (`fields`), the primitives,
/// the parties, the signals of the parties (`psignals`), the parts of an answer and the signals of the machine, the nested machines that a fragment is given empty (`empty_lists`) or not empty (`nested_lists`: the name of the parameter and the Latin names of the
/// machines, joined by a comma). Since 2.13 (AL-46) a name gets its JSON name from the brackets of its declaration, never from a dictionary.
type TxEnv {
    states []TxPair, globals []TxPair, defs []TxPair, types []TxPair, cases []TxPair, prims []TxPair,
    parties []TxPair, psignals []TxPair, parts []TxPair, signals []TxPair, input_fields []TxPair, fields []TxPair, empty_lists []str,
    nested_lists []TxPair, owner str, opath []str, case_types []TxPair
}

fn env_new() -> TxEnv {
    TxEnv {
        states: []TxPair.new(), globals: []TxPair.new(), defs: []TxPair.new(), types: []TxPair.new(), cases: []TxPair.new(), prims: []TxPair.new(),
        parties: []TxPair.new(), psignals: []TxPair.new(), parts: []TxPair.new(), signals: []TxPair.new(), input_fields: []TxPair.new(), fields: []TxPair.new(), empty_lists: []str.new(),
        nested_lists: []TxPair.new(), owner: "", opath: []str.new(), case_types: []TxPair.new()
    }
}

/// TxPlace: a place of the JSON (`$.states[2].rows[0]`) and the line of the file that it comes from; the checks of the table speak in paths.
type TxPlace { path str, line int }

/// TxCx: the context of one translation: the errors and the warnings, the table of names of the host, the names of the file, the JSON names that it declares (`jn`, jname.nv), the counts of the rows, the places of the JSON and
/// the words of the language of the file.
type TxCx { errors []TranslateError, warnings []TranslateError, names TxNames, env TxEnv, jn TxJn, rows_total int, rows_noted int, places []TxPlace, words TxWords }

fn cx_place(mut cx TxCx, path str, line int) -> () {
    cx.places.push(TxPlace { path, line })
}

// ORACLE-WORKAROUND(41): the list is called `pairs_in`, not `list` or `pairs`: a name that means a list of one type in one function and a list of another type in another function of the unit is mixed up by the code generator; use plain names when item 41 is fixed
fn pair_get(pairs_in []TxPair, ru str) -> Option[str] {
    for p in pairs_in {
        if p.ru == ru { return Some(p.en) }
    }
    None
}

fn pair_has(pairs_in []TxPair, ru str) -> bool {
    match pair_get(pairs_in, ru) {
        Some(en) => true
        None => false
    }
}

fn pair_add(mut pairs_in []TxPair, ru str, en str) -> () {
    pairs_in.push(TxPair { ru, en })
}

/// TxScope: the names bound in the place of an expression (a parameter of a definition, a `пусть`, a variable of a lambda, a name of an event).
type TxScope { names []TxPair }

fn sc_empty() -> TxScope => { names: []TxPair.new() }

// A copy.
// ORACLE-WORKAROUND(45): a copy of a `ro` parameter built by hand in a loop; write `mut out = sc.names` when item 45 is fixed
fn sc_clone(sc TxScope) -> TxScope {
    mut out = []TxPair.new()
    for p in sc.names { out.push(p) }
    TxScope { names: out }
}

fn sc_with(sc TxScope, ru str, en str) -> TxScope {
    mut out = []TxPair.new()
    for p in sc.names { out.push(p) }
    out.push(TxPair { ru, en })
    TxScope { names: out }
}

fn sc_get(sc TxScope, ru str) -> Option[str] {
    // the latest binding hides the earlier ones
    mut i = sc.names.len() - 1
    while i >= 0 {
        if sc.names[i].ru == ru { return Some(sc.names[i].en) }
        i -= 1
    }
    None
}

// ---- the parser over the tokens of a cell ------------------------------------------------------------------------------------

/// TxP: the tokens of a cell (or of several lines of one statement) and the place in them.
type TxP { toks []TxTok, pos int, end_line int, end_col int }

fn p_new(toks []TxTok, line int, col int) -> TxP => { toks, pos: 0, end_line: line, end_col: col }

// A copy of a parser that can be moved.
// ORACLE-WORKAROUND(45): a copy of a `ro` parameter built by hand in a loop; write `mut q = p` when item 45 is fixed
fn p_copy(p TxP) -> TxP {
    mut toks = []TxTok.new()
    for t in p.toks { toks.push(t) }
    TxP { toks, pos: p.pos, end_line: p.end_line, end_col: p.end_col }
}

fn p_tok(p TxP) -> TxTok {
    if p.pos < p.toks.len() { return p.toks[p.pos] }
    tk(TK_EOF, "", p.end_line, p.end_col)
}

fn p_ahead(p TxP, k int) -> TxTok {
    if p.pos + k < p.toks.len() { return p.toks[p.pos + k] }
    tk(TK_EOF, "", p.end_line, p.end_col)
}

fn p_adv(mut p TxP) -> () {
    p.pos += 1
}

fn p_done(p TxP) -> bool => p.pos >= p.toks.len()

fn t_is(t TxTok, s str) -> bool => t.kind == TK_SYM && t.text == s

fn t_is_word(t TxTok, w str) -> bool => t.kind == TK_NAME && t.text == w

fn p_is(p TxP, s str) -> bool => t_is(p_tok(p), s)

fn p_is_word(p TxP, w str) -> bool => t_is_word(p_tok(p), w)

fn p_eat(mut p TxP, s str) -> bool {
    if p_is(p, s) {
        p.pos += 1
        return true
    }
    false
}

fn p_eat_word(mut p TxP, w str) -> bool {
    if p_is_word(p, w) {
        p.pos += 1
        return true
    }
    false
}

// What stands under the reader, for the text of an error.
fn t_shown(t TxTok) -> str {
    if t.kind == TK_EOF { return "конец текста" }
    if t.kind == TK_STR { return "строку \"${t.text}\"" }
    "`${t.text}`"
}

fn p_fail(p TxP, message str) -> TranslateError {
    ro t = p_tok(p)
    tx_err(t.line, t.col, "syntax", "${message}, найдено: ${t_shown(t)}")
}

fn p_expect(mut p TxP, s str) -> Result[(), TranslateError] {
    if p_eat(p, s) { return Ok(()) }
    Err(p_fail(p, "ожидается `${s}`"))
}

fn p_expect_word(mut p TxP, w str) -> Result[(), TranslateError] {
    if p_eat_word(p, w) { return Ok(()) }
    Err(p_fail(p, "ожидается `${w}`"))
}

// ---- the words of the language of the file --------------------------------------------------------------------------------------

// The tokens of a word or of a phrase of the table of words (`for each`, `human or agent by setting`, `Idle term`): how many of the next tokens spell it, 0 when they do not.
fn p_phrase_len(p TxP, phrase str) -> int {
    if !phrase.contains(" ") && !phrase.contains("/") {
        ro t = p_tok(p)
        if t.kind == TK_NAME && t.text == phrase { return 1 }
        return 0
    }
    match tx_lex(phrase, 0, 0) {
        Ok(toks) => {
            mut n = 0
            for want in toks {
                ro t = p_ahead(p, n)
                if t.kind != want.kind || t.text != want.text { return 0 }
                n += 1
            }
            n
        }
        Err(e) => 0
    }
}

/// Does the word of the table (a kind and an English key) stand next, in the language of the file?
fn p_is_kw(p TxP, w TxWords, kind str, key str) -> bool => p_phrase_len(p, kw(w, kind, key)) > 0

/// Eat the word of the table when it stands next.
fn p_eat_kw(mut p TxP, w TxWords, kind str, key str) -> bool {
    ro n = p_phrase_len(p, kw(w, kind, key))
    if n == 0 { return false }
    p.pos += n
    true
}

fn p_expect_kw(mut p TxP, w TxWords, kind str, key str) -> Result[(), TranslateError] {
    if p_eat_kw(p, w, kind, key) { return Ok(()) }
    Err(p_fail(p, "ожидается `${kw(w, kind, key)}`"))
}

/// Is the token the word of the table (one word)?
fn t_is_kw(t TxTok, w TxWords, kind str, key str) -> bool => t.kind == TK_NAME && t.text == kw(w, kind, key)

fn p_end(p TxP) -> Result[(), TranslateError] {
    if p_done(p) { return Ok(()) }
    Err(p_fail(p, "лишний текст после конструкции"))
}

/// The reserved words of the language of the file (format 3.1, СГ12): `then`, `else`, `and`, `or`, `not`, `let`, `match`, `if`, `true`, `false`, `none`, `unreachable`, the words of the loop `for` and `in`
/// and the sign of the membership (Russian `в`, English `in`, AL-100).
fn tx_keywords(w TxWords) -> []str {
    mut out = kw_all(w, "expr", ["then", "else", "and", "or", "not", "let", "match", "if", "true", "false", "none", "unreachable"])
    for word in [kw(w, "action", "for"), kw(w, "action", "in"), kw(w, "operator", "in")] {
        if !out.contains(word) { out.push(word) }
    }
    out
}

fn is_keyword(w TxWords, text str) -> bool => tx_keywords(w).contains(text)

// A word that belongs to the other language only, in the position of a name: the error of the language (section 1a) at its place, or None.
fn foreign_find(cx TxCx, t TxTok, kinds []str) -> Option[TranslateError] {
    match kw_foreign_any(cx.words, kinds, t.text) {
        Some(key) => {
            ro kind = foreign_kind(cx.words, kinds, t.text)
            Some(foreign_error(cx.words, t.line, t.col, t.text, kind, key))
        }
        None => None
    }
}

// The same, put among the errors of the translation; returns whether the word was a foreign one.
fn cx_foreign(mut cx TxCx, t TxTok, kinds []str) -> bool {
    match foreign_find(cx, t, kinds) {
        Some(e) => {
            cx.errors.push(e)
            true
        }
        None => false
    }
}

// The kind under which the word is foreign (the first of the kinds).
fn foreign_kind(w TxWords, kinds []str, text str) -> str {
    for kind in kinds {
        match kw_foreign(w, kind, text) {
            Some(k) => return kind
            None => ()
        }
    }
    ""
}

fn cx_error(mut cx TxCx, t TxTok, kind str, message str) -> () {
    cx.errors.push(tx_err(t.line, t.col, kind, message))
}

// ---- the names ---------------------------------------------------------------------------------------------------------------

/// TxDeclared: a declared name as the file writes it (the token) and its JSON name.
type TxDeclared { tok TxTok, json str }

/// The JSON name of a name that is being declared (spec 1a, AL-53, AL-60): the row of the section `## Имена`, else the name built by itself (jname.nv); it is recorded for the checks of the end of the file.
/// `what` is the kind of the declaration (`данного`, `типа`, `поля`, …), `space` the space of the distinctness of the JSON names (AL-58) and `path` the qualified name (`Тип.Форма.поле`). The brackets
/// after the name, `число_ходов (turn_count)` of 2.14, are an error: the JSON name is not written at the declaration any more.
fn decl_json(mut p TxP, mut cx TxCx, t TxTok, what str, space str, path []str) -> Result[str, TranslateError] => decl_json_text(p, cx, t, t.text, what, space, path)

/// The same for a name of several words (`остановить совещание`, a phrase of a signal): `text` is the whole name, `t` its first word.
fn decl_json_text(mut p TxP, mut cx TxCx, t TxTok, text str, what str, space str, path []str) -> Result[str, TranslateError] {
    if p_is(p, "(") && p_ahead(p, 1).kind == TK_NAME && t_is(p_ahead(p, 2), ")") {
        ro open = p_tok(p)
        ro bracket = p_ahead(p, 1)
        cx_error(cx, open, "name", "скобки `(${bracket.text})` после имени ${what} `${text}` убраны из языка (AL-60): JSON-имя задаёт строка раздела `## Имена` (`| имя | JSON-имя |`), без строки оно строится само; переходного периода нет")
        p.pos += 3
    }
    Ok(jn_declare(cx, t, text, what, space, path))
}

/// The JSON name of a name that a table cell declares (the first cell of `## Данные`, `## Вход`, `## Примитивы`). The cell is read to its end.
fn cell_decl_json(cell TxCell, line int, mut cx TxCx, what str, space str) -> Result[TxDeclared, TranslateError] {
    mut p = cell_p(cell, line)?
    ro t = p_tok(p)
    if t.kind != TK_NAME { return Err(p_fail(p, "ожидается имя")) }
    p_adv(p)
    // a readable name of the contract (`трасса`, `номер_шага`) has the JSON name of the table of words: no row names it (1a, AL-49)
    match readable_json(cx.words, t.text) {
        Some(key) => {
            if !p_is(p, "(") {
                p_end(p)?
                jn_declare_fixed(cx, t.line, t.col, t.text, what, space, [t.text], key)
                return Ok(TxDeclared { tok: t, json: key })
            }
        }
        None => ()
    }
    ro json = decl_json(p, cx, t, what, space, [t.text])?
    p_end(p)?
    Ok(TxDeclared { tok: t, json })
}

fn kinds_foreign_expr() -> []str => ["enum_value", "readable"]

/// The JSON name of a readable word of the file's language (`причина` -> `reason`, `остановка` -> `stop_reason`, 1a, AL-49): the English word of the table, kind `readable`; the words with a dot (`событие.сторона`) are no names.
fn readable_json(w TxWords, text str) -> Option[str] {
    match kw_key(w, "readable", text) {
        Some(k) => {
            if k.contains(".") { return None }
            Some(k)
        }
        None => None
    }
}

fn name_not_declared(cx TxCx, t TxTok, what str) -> str {
    "${what} `${t.text}` не объявлено в этой машине${env_hint(cx, t.text)}"
}

fn env_scan(pairs_in []TxPair, word []char, mut best_name str, mut best_distance int) -> () {
    for pair in pairs_in {
        ro d = tx_distance_chars(word, pair.ru.chars().collect())
        if d < best_distance {
            best_distance = d
            best_name = pair.ru
        }
    }
}

/// The hint for an unknown name: the nearest declared name when it is near enough.
fn env_hint(cx TxCx, ru str) -> str {
    ro word []char = ru.chars().collect()
    mut best_name = ""
    mut best_distance = 1000
    env_scan(cx.env.globals, word, best_name, best_distance)
    env_scan(cx.env.defs, word, best_name, best_distance)
    env_scan(cx.env.types, word, best_name, best_distance)
    env_scan(cx.env.cases, word, best_name, best_distance)
    env_scan(cx.env.fields, word, best_name, best_distance)
    env_scan(cx.env.states, word, best_name, best_distance)
    ro limit = if word.len() / 3 > 2 { word.len() / 3 } else { 2 }
    if best_name != "" && best_distance <= limit { return "; возможно, `${best_name}`" }
    ""
}

/// A name that a table introduces (a parameter, a binding, a variable of a lambda): the readable word of the file's language is its JSON name (`причина`, AL-49), any other name is written as it is (AL-46).
fn tr_binder(mut cx TxCx, t TxTok) -> str {
    if is_keyword(cx.words, t.text) {
        cx_error(cx, t, "name", "`${t.text}` — служебное слово, именем быть не может")
        return t.text
    }
    if t.text == "_" { return "_" }
    match readable_json(cx.words, t.text) {
        Some(en) => return en
        None => ()
    }
    // a field of a signal of the call protocol that the fragment Pause binds (`автор`, `источник`): the name of the registry, so that the fragment of either language gives one tree
    match names_get(cx.names, "signal_field", t.text) {
        Some(en) => en
        None => t.text
    }
}

/// The name of the local that a field of a pattern binds when the pattern gives it none (`Форма(поле)`): the readable word or the field of a signal of the protocol have their JSON names, any other name is as written.
fn binder_of_field(cx TxCx, t TxTok) -> str {
    match readable_json(cx.words, t.text) {
        Some(en) => return en
        None => ()
    }
    match names_get(cx.names, "signal_field", t.text) {
        Some(en) => en
        None => t.text
    }
}

/// A name of a datum, a constant or a parameter that the file declares, a readable name of the executor or of the contract, or a Latin name as it is.
fn tr_global(mut cx TxCx, t TxTok) -> str {
    match pair_get(cx.env.globals, t.text) {
        Some(en) => return en
        None => ()
    }
    match readable_json(cx.words, t.text) {
        Some(en) => return en
        None => ()
    }
    if is_identifier_latin(t.text) { return t.text }
    if cx_foreign(cx, t, kinds_foreign_expr()) { return t.text }
    cx_error(cx, t, "name", name_not_declared(cx, t, "имя"))
    t.text
}

/// The type name: declared in the file, else a Latin name as it is.
fn tr_type_name(mut cx TxCx, t TxTok) -> str {
    match pair_get(cx.env.types, t.text) {
        Some(en) => return en
        None => ()
    }
    if t.text == "HashMap" {
        cx_error(cx, t, "type", "тип `HashMap[K, V]` не принимается: словарь пишется `${kw(cx.words, "type", "map")}[K, V]`, у типов нет синонимов (Я-43)")
        return t.text
    }
    if is_identifier_latin(t.text) { return t.text }
    if cx_foreign(cx, t, ["type"]) { return t.text }
    cx_error(cx, t, "name", name_not_declared(cx, t, "тип"))
    t.text
}

/// The form or the element of an enumeration: declared in the file, else a Latin name as it is.
fn tr_case_name(mut cx TxCx, t TxTok) -> str {
    match pair_get(cx.env.cases, t.text) {
        Some(en) => return en
        None => ()
    }
    if is_identifier_latin(t.text) { return t.text }
    cx_error(cx, t, "name", name_not_declared(cx, t, "форма"))
    t.text
}

/// The name of a field: declared in a type, a form of an enumeration or a signal; a request field may be named as a field of the input or as a datum; the fields of the event `событие.идентификатор`; a Latin name as it is.
fn tr_field_name(mut cx TxCx, t TxTok) -> str {
    match pair_get(cx.env.fields, t.text) {
        Some(en) => {
            if pair_has(cx.env.fields, "?${t.text}") {
                cx_error(cx, t, "name", "поле `${t.text}` объявлено в машине с разными JSON-именами: ссылка без типа владельца неоднозначна; у поля с таким именем одно JSON-имя (Я-46)")
            }
            return en
        }
        None => ()
    }
    match pair_get(cx.env.input_fields, t.text) {
        Some(en) => return en
        None => ()
    }
    match pair_get(cx.env.globals, t.text) {
        Some(en) => return en
        None => ()
    }
    ro prefix = "${kw(cx.words, "readable", "event")}."
    match kw_key(cx.words, "readable", "${prefix}${t.text}") {
        Some(k) => {
            ro dot = k.find(".") ?? -1
            if dot >= 0 { return k[dot + 1..] }
        }
        None => ()
    }
    match names_get(cx.names, "field", t.text) {
        Some(en) => return en
        None => ()
    }
    if is_identifier_latin(t.text) { return t.text }
    cx_error(cx, t, "name", name_not_declared(cx, t, "поле"))
    t.text
}

/// A field that a declaration introduces: its JSON name is put into the table of the fields. The same word with another JSON name in another declaration (a record, a case) is allowed
/// (the sample of the methodology has `утверждение (statement)` and `утверждение (claim)`): the word is then marked ambiguous (the pair `?word`), and a reference to it that does not
/// name the owner is an error, because the translator does not know the types of the expressions.
fn declare_field(mut cx TxCx, t TxTok, json str) -> () {
    match pair_get(cx.env.fields, t.text) {
        Some(known) => {
            if known != json && !pair_has(cx.env.fields, "?${t.text}") { pair_add(cx.env.fields, "?${t.text}", known) }
        }
        None => pair_add(cx.env.fields, t.text, json)
    }
    // the same field under its owner (a record, a form of an enumeration, a signal, a part): a literal or a pattern of that owner finds the JSON name without the ambiguity
    if cx.env.owner != "" { pair_add(cx.env.fields, "${cx.env.owner}.${t.text}", json) }
}

/// The JSON name of a field of a known owner (`Тип { поле: … }`, `Случай(поле)`, `сигнал(поле)`): the field declared under the owner, else the field of the machine.
fn tr_field_in(mut cx TxCx, owner str, t TxTok) -> str {
    if owner != "" {
        match pair_get(cx.env.fields, "${owner}.${t.text}") {
            Some(en) => return en
            None => ()
        }
    }
    tr_field_name(cx, t)
}

// Does the word look like a type (`Использование`, `КодСбоя`): the first letter is upper case and a lower case letter follows somewhere.
fn looks_like_type(w str) -> bool {
    mut first = true
    mut upper_first = false
    mut has_lower = false
    for c in w.chars() {
        if first {
            upper_first = tx_is_upper(c)
            first = false
        } else if tx_is_lower(c) {
            has_lower = true
        }
    }
    upper_first && has_lower
}

// ---- the types (format section 2) -------------------------------------------------------------------------------------------

fn ty_is_type_end(t TxTok) -> bool => t.kind == TK_EOF

/// A type of the format as the type string of the JSON (`int>=0`, `?text`, `[]Finding`, `{text: int}`, `"a" | "b"`, `id`, `full {K: V}`, `(A, B)`).
fn ty_parse(mut p TxP, mut cx TxCx) -> Result[str, TranslateError] {
    ro t = p_tok(p)
    if t.kind == TK_STR { return ty_set(p) }
    if p_eat(p, "?") {
        ro inner = ty_under(p, cx)?
        return Ok("?${inner}")
    }
    if p_is(p, "[") && t_is(p_ahead(p, 1), "]") {
        p_adv(p)
        p_adv(p)
        ro inner = ty_under(p, cx)?
        return Ok("[]${inner}")
    }
    if p_eat(p, "(") {
        mut items = []str.new()
        while true {
            items.push(ty_parse(p, cx)?)
            if p_eat(p, ",") { continue }
            break
        }
        p_expect(p, ")")?
        if items.len() == 1 {
            if items[0].starts_with("\"") { return Ok(items[0]) }
            return Err(tx_err(t.line, t.col, "syntax", "кортеж — от двух полей"))
        }
        return Ok("(${items.join(", ")})")
    }
    if t.kind != TK_NAME { return Err(p_fail(p, "ожидается тип")) }
    ro words = cx.words
    match former_find(words.lang, "type", t.text) {
        Some(f) => return Err(tx_err(t.line, t.col, "type", former_message(f)))
        None => ()
    }
    if p_eat_kw(p, words, "type", "int") {
        if p_eat(p, ">=") {
            ro n = p_tok(p)
            if n.kind != TK_INT { return Err(p_fail(p, "после `>=` ожидается целое число")) }
            p_adv(p)
            return Ok("int>=${n.text}")
        }
        return Ok("int")
    }
    // the types of the file are `вещественное`/`f64` and `строка`/`str`; the tree names them `float` and `text` (AL-94 ... AL-96)
    if p_eat_kw(p, words, "type", "f64") { return Ok("float") }
    if p_eat_kw(p, words, "type", "str") { return Ok("text") }
    if p_eat_kw(p, words, "type", "id") { return Ok("id") }
    if p_eat_kw(p, words, "type", "State") { return Ok("State") }
    if p_eat_kw(p, words, "type", "Signal") { return Ok("Signal") }
    if p_eat_kw(p, words, "type", "bool") { return Ok("bool") }
    if p_is_kw(p, words, "type", "full map") || p_is_kw(p, words, "type", "map") {
        ro full = p_eat_kw(p, words, "type", "full map")
        if !full {
            ro plain = p_eat_kw(p, words, "type", "map")
        }
        p_expect(p, "[")?
        ro key = ty_parse(p, cx)?
        p_expect(p, ",")?
        ro value = ty_parse(p, cx)?
        p_expect(p, "]")?
        return Ok(if full { "full {${key}: ${value}}" } else { "{${key}: ${value}}" })
    }
    if p_eat_kw(p, words, "type", "JournalEvent") { return Ok("JournalEvent") }
    p_adv(p)
    Ok(tr_type_name(cx, t))
}

// The type under `?` or `[]`: a set of literals there is in parentheses.
fn ty_under(mut p TxP, mut cx TxCx) -> Result[str, TranslateError] {
    if p_tok(p).kind == TK_STR { return Err(p_fail(p, "набор литералов под ? или [] пишется в скобках")) }
    ro inner = ty_parse(p, cx)?
    if inner.starts_with("\"") { return Ok("(${inner})") }
    Ok(inner)
}

// A set of literals: two string literals or more with `|` between them.
fn ty_set(mut p TxP) -> Result[str, TranslateError] {
    mut words = []str.new()
    ro first = p_tok(p)
    while true {
        ro t = p_tok(p)
        if t.kind != TK_STR { return Err(p_fail(p, "в наборе литералов ожидается строка")) }
        words.push(tx_quote(t.text))
        p_adv(p)
        if p_eat(p, "|") { continue }
        break
    }
    if words.len() < 2 { return Err(tx_err(first.line, first.col, "type", "набор литералов — два значения и больше")) }
    Ok(words.join(" | "))
}

// ---- the expressions (format section 3) --------------------------------------------------------------------------------------

fn tx_arrow(t TxTok) -> bool => t.kind == TK_SYM && t.text == "->"

/// The sign `=>`: the body of a function of one expression, a `match` branch, a lambda (AL-67 ... AL-69).
fn tx_fat(t TxTok) -> bool => t.kind == TK_SYM && t.text == "=>"

/// The error about a former sign `->` where `=>` stands now (a lambda, a `match` branch): what to write instead; there is no transition period.
fn former_arrow_error(t TxTok, where_ str, label str) -> TranslateError => tx_err(t.line, t.col, "syntax", "знак `->` ${where_} в формате 2.22 не бывает: пишется `=>` (${label}); `->` стоит только перед типом результата; переходного периода нет")

fn is_lambda_start(p TxP, w TxWords) -> bool {
    ro t0 = p_tok(p)
    if t0.kind == TK_NAME && !is_keyword(w, t0.text) && (tx_fat(p_ahead(p, 1)) || tx_arrow(p_ahead(p, 1))) { return true }
    t_is(t0, "(") && p_ahead(p, 1).kind == TK_NAME && t_is(p_ahead(p, 2), ",") && p_ahead(p, 3).kind == TK_NAME && t_is(p_ahead(p, 4), ")") && (tx_fat(p_ahead(p, 5)) || tx_arrow(p_ahead(p, 5)))
}

fn ex_lambda(mut p TxP, mut cx TxCx, sc TxScope) -> Result[TxJ, TranslateError] {
    mut names = []TxTok.new()
    if p_eat(p, "(") {
        names.push(p_tok(p))
        p_adv(p)
        p_expect(p, ",")?
        names.push(p_tok(p))
        p_adv(p)
        p_expect(p, ")")?
    } else {
        names.push(p_tok(p))
        p_adv(p)
    }
    if tx_arrow(p_tok(p)) { return Err(former_arrow_error(p_tok(p), "в лямбде", "AL-69")) }
    if !tx_fat(p_tok(p)) { return Err(p_fail(p, "ожидается стрелка `=>`")) }
    p_adv(p)
    mut inner = sc_clone(sc)
    mut params = []str.new()
    for n in names {
        ro en = tr_binder(cx, n)
        if params.contains(en) && en != "_" { cx_error(cx, n, "name", "параметр `${n.text}` повторён") }
        params.push(en)
        inner = sc_with(inner, n.text, en)
    }
    // the body is an expression, a block expression `x => { let y = x * 2; y + 1 }` too (AL-84)
    ro body = ex_expr(p, cx, inner)?
    Ok(x_lambda(params, body))
}

/// An expression. `если` and `выбор` take everything to their right; the range `a..b` is the lowest operator (AL-76).
fn ex_expr(mut p TxP, mut cx TxCx, sc TxScope) -> Result[TxJ, TranslateError] {
    if p_is_kw(p, cx.words, "expr", "if") { return ex_if(p, cx, sc) }
    if p_is_kw(p, cx.words, "expr", "match") { return ex_match(p, cx, sc) }
    ex_range(p, cx, sc)
}

/// `a..b` (half-open, the call `range(a, b)`) and `a..=b` (inclusive, `range(a, b + 1)`): the lowest operators, not chained (AL-76, AL-86).
fn ex_range(mut p TxP, mut cx TxCx, sc TxScope) -> Result[TxJ, TranslateError] {
    ro left = ex_coalesce(p, cx, sc)?
    if p_is(p, "..") || p_is(p, "..=") {
        ro inclusive = p_is(p, "..=")
        p_adv(p)
        ro right = ex_coalesce(p, cx, sc)?
        if p_is(p, "..") || p_is(p, "..=") { return Err(tx_err(p_tok(p).line, p_tok(p).col, "syntax", "диапазоны не цепляются: `a..b..c` не бывает (AL-76); второй диапазон пишется в скобках")) }
        if inclusive { return Ok(x_call("range", [left, x_bin("+", right, x_lit(TxRaw("1")))])) }
        return Ok(x_call("range", [left, right]))
    }
    Ok(left)
}

/// A block expression `{ пусть имя = выр; …; выр }` (AL-75): zero or more bindings and lastly one expression, the value of the block. The block is not empty; it ends at the closing brace.
fn ex_block(mut p TxP, mut cx TxCx, sc TxScope) -> Result[TxJ, TranslateError] {
    ro open = p_tok(p)
    p_expect(p, "{")?
    if p_is(p, "}") { return Err(tx_err(open.line, open.col, "syntax", "пустой блок `{ }` и пустой словарь `{}` в формате 2.22 не бывают (AL-71, AL-85): в блоке есть выражение, пустой словарь — `[]` по ожидаемому типу")) }
    ro made = ex_block_items(p, cx, sc)?
    if p_is(p, ":") { return Err(tx_err(open.line, open.col, "syntax", "словарь в фигурных скобках `{ключ: значение}` в формате 2.22 не бывает: пишется `[ключ: значение]` (AL-85); фигурные скобки — только блок, запись и образец")) }
    p_expect(p, "}")?
    Ok(made)
}

// The bindings of a block expression and its last expression.
fn ex_block_items(mut p TxP, mut cx TxCx, sc TxScope) -> Result[TxJ, TranslateError] {
    if p_is_kw(p, cx.words, "expr", "let") {
        p_adv(p)
        ro n = p_tok(p)
        if n.kind != TK_NAME { return Err(p_fail(p, "после `${kw(cx.words, "expr", "let")}` ожидается имя")) }
        p_adv(p)
        p_expect(p, "=")?
        ro value = ex_expr(p, cx, sc)?
        if p_is_kw(p, cx.words, "operator", "in") || p_is_kw(p, cx.words, "action", "in") {
            return Err(tx_err(p_tok(p).line, p_tok(p).col, "syntax", "`${kw(cx.words, "expr", "let")} … ${p_tok(p).text} …` в формате 2.22 не бывает: локальное имя — блок `{ ${kw(cx.words, "expr", "let")} имя = выр; выр }` (AL-73, AL-75); переходного периода нет"))
        }
        p_expect(p, ";")?
        ro en = tr_binder(cx, n)
        ro body = ex_block_items(p, cx, sc_with(sc, n.text, en))?
        return Ok(x_let(en, value, body))
    }
    ex_expr(p, cx, sc)
}

fn ex_if(mut p TxP, mut cx TxCx, sc TxScope) -> Result[TxJ, TranslateError] {
    p_adv(p)
    ro cond = ex_expr(p, cx, sc)?
    p_expect_kw(p, cx.words, "expr", "then")?
    if !p_is(p, "{") { return Err(p_fail(p, "после `${kw(cx.words, "expr", "then")}` ожидается блок `{ … }` (AL-71)")) }
    ro a = ex_block(p, cx, sc)?
    if !p_is_kw(p, cx.words, "expr", "else") { return Err(p_fail(p, "ожидается `${kw(cx.words, "expr", "else")}`: у условного выражения ветка `${kw(cx.words, "expr", "else")}` обязательна (AL-71)")) }
    p_adv(p)
    if !p_is(p, "{") { return Err(p_fail(p, "после `${kw(cx.words, "expr", "else")}` ожидается блок `{ … }` (AL-71)")) }
    ro b = ex_block(p, cx, sc)?
    Ok(x_if(cond, a, b))
}

// ---- `выбор` ------------------------------------------------------------------------------------------------------------------

// The binds of a pattern `Форма(поле, поле: имя)`: the object {field: local} and the scope with the locals.
type TxBinds { pairs []TxKV, scope TxScope }

// The binds of a pattern `Форма { поле, поле: имя }` (AL-77, AL-82): the object {field: local} and the scope with the locals. A pattern without braces binds nothing; the former record
// `Форма(поле)` is an error.
fn ex_pattern_binds(mut p TxP, mut cx TxCx, sc TxScope, owner str) -> Result[TxBinds, TranslateError] {
    mut pairs = []TxKV.new()
    mut inner = sc_clone(sc)
    if p_is(p, "(") {
        return Err(tx_err(p_tok(p).line, p_tok(p).col, "syntax", "образец `${owner}(…)` в формате 2.22 не бывает: поля формы пишутся в фигурных скобках `${owner} { поле, поле: имя }` (AL-77, AL-82); круглые скобки — только у функций; переходного периода нет"))
    }
    if !p_eat(p, "{") { return Ok(TxBinds { pairs, scope: inner }) }
    if p_eat(p, "}") { return Ok(TxBinds { pairs, scope: inner }) }
    while true {
        ro f = p_tok(p)
        if f.kind != TK_NAME { return Err(p_fail(p, "в образце ожидается поле")) }
        p_adv(p)
        ro field_en = tr_field_in(cx, owner, f)
        mut local_ru = f.text
        mut local_en = binder_of_field(cx, f)
        if p_eat(p, ":") {
            ro l = p_tok(p)
            if l.kind != TK_NAME { return Err(p_fail(p, "после `:` в образце ожидается имя")) }
            p_adv(p)
            local_ru = l.text
            local_en = tr_binder(cx, l)
            // no shadowing: a name that binds a field is not the name of a datum, a constant or a parameter of the machine
            if pair_has(cx.env.globals, local_ru) {
                cx_error(cx, l, "name", "имя `${local_ru}` уже занято данным, константой или параметром машины: затенения нет (no shadowing)")
            }
        } else if pair_has(cx.env.globals, local_ru) {
            cx_error(cx, f, "name", "имя `${local_ru}` уже занято данным, константой или параметром машины: затенения нет (no shadowing)")
        }
        pairs.push(kv(field_en, js(local_en)))
        inner = sc_with(inner, local_ru, local_en)
        if p_eat(p, ",") {
            if p_is(p, "}") { break }
            continue
        }
        break
    }
    p_expect(p, "}")?
    Ok(TxBinds { pairs, scope: inner })
}

fn ex_literal_pattern(t TxTok, w TxWords) -> Option[TxJ] {
    if t.kind == TK_INT || t.kind == TK_FLOAT { return Some(pat_lit(TxRaw(t.text))) }
    if t.kind == TK_STR { return Some(pat_lit(js(t.text))) }
    if t_is_kw(t, w, "expr", "true") { return Some(pat_lit(TxBool(true))) }
    if t_is_kw(t, w, "expr", "false") { return Some(pat_lit(TxBool(false))) }
    None
}

// One alternative of an arm: a literal, `Тип.Значение`, `Форма`, `Форма(поле, поле: имя)`. Returns the pattern and the scope for the guard and the body.
fn ex_pattern(mut p TxP, mut cx TxCx, sc TxScope) -> Result[TxBinds, TranslateError] {
    ro t = p_tok(p)
    match ex_literal_pattern(t, cx.words) {
        Some(pat) => {
            p_adv(p)
            return Ok(TxBinds { pairs: [kv("pattern", pat)], scope: sc })
        }
        None => ()
    }
    if t.kind != TK_NAME { return Err(p_fail(p, "ожидается образец")) }
    p_adv(p)
    if p_is(p, ".") && p_ahead(p, 1).kind == TK_NAME {
        p_adv(p)
        ro c = p_tok(p)
        p_adv(p)
        ro type_en = tr_type_name(cx, t)
        ro case_en = tr_case_name(cx, c)
        return Ok(TxBinds { pairs: [kv("pattern", pat_case(type_en, case_en, []))], scope: sc })
    }
    ro case_en = tr_case_name(cx, t)
    ro binds = ex_pattern_binds(p, cx, sc, t.text)?
    Ok(TxBinds { pairs: [kv("pattern", pat_case("", case_en, binds.pairs))], scope: binds.scope })
}

/// `выбор выр { альт | альт если выр => выр, … , иначе => выр }` (AL-68, AL-87): on one line the branches are separated by `,` (none after the last one); in the multi-line form (the first branch is on a line
/// after the `{`) every branch stands on its own line, with no `,` or `;` at the end, and the `}` on a line of its own.
fn ex_match(mut p TxP, mut cx TxCx, sc TxScope) -> Result[TxJ, TranslateError] {
    p_adv(p)
    ro subject = ex_expr(p, cx, sc)?
    ro open = p_tok(p)
    p_expect(p, "{")?
    ro multi = !p_done(p) && p_tok(p).line > open.line
    mut arms = []TxJ.new()
    mut prev_end = open.line
    while !p_is(p, "}") {
        if p_done(p) { return Err(p_fail(p, "в конце `${kw(cx.words, "expr", "match")}` ожидается `}`")) }
        ro first = p_tok(p)
        if multi && first.line == prev_end {
            return Err(tx_err(first.line, first.col, "syntax", "в многострочном `${kw(cx.words, "expr", "match")}` каждая ветка стоит на своей строке (AL-87): две ветки на одной строке и ветка на строке `{` не бывают"))
        }
        mut patterns = []TxJ.new()
        mut arm_scope = sc_clone(sc)
        if p_eat_kw(p, cx.words, "expr", "else") {
            patterns.push(pat_any())
        } else {
            while true {
                ro one = ex_pattern(p, cx, sc)?
                patterns.push(one.pairs[0].value)
                arm_scope = one.scope
                if p_eat(p, "|") { continue }
                break
            }
        }
        mut guards = []TxJ.new()
        if p_eat_kw(p, cx.words, "expr", "if") { guards.push(ex_expr(p, cx, arm_scope)?) }
        if tx_arrow(p_tok(p)) { return Err(former_arrow_error(p_tok(p), "в ветке `${kw(cx.words, "expr", "match")}`", "AL-68")) }
        if !tx_fat(p_tok(p)) { return Err(p_fail(p, "в ветке `${kw(cx.words, "expr", "match")}` ожидается стрелка `=>`")) }
        p_adv(p)
        ro body = ex_expr(p, cx, arm_scope)?
        arms.push(x_arm(patterns, guards, body))
        ro last = p.toks[p.pos - 1]
        prev_end = last.line
        if p_is(p, ";") {
            return Err(tx_err(p_tok(p).line, p_tok(p).col, "syntax", "знак `;` между ветками `${kw(cx.words, "expr", "match")}` в формате 2.22 не бывает (AL-87): ветки — альтернативы, на одной строке они разделены `,`, в многострочной записи — переводом строки; переходного периода нет"))
        }
        if p_is(p, ",") {
            if multi { return Err(tx_err(p_tok(p).line, p_tok(p).col, "syntax", "запятая в конце ветки многострочного `${kw(cx.words, "expr", "match")}` не бывает (AL-87): ветки разделяет перевод строки")) }
            p_adv(p)
            if p_is(p, "}") { return Err(tx_err(p_tok(p).line, p_tok(p).col, "syntax", "запятая после последней ветки `${kw(cx.words, "expr", "match")}` не бывает (AL-87)")) }
            continue
        }
        if p_is(p, "}") {
            if multi && p_tok(p).line == prev_end { return Err(tx_err(p_tok(p).line, p_tok(p).col, "syntax", "в многострочном `${kw(cx.words, "expr", "match")}` закрывающая `}` стоит на своей строке (AL-87)")) }
            break
        }
        if !multi { return Err(p_fail(p, "после ветки `${kw(cx.words, "expr", "match")}` ожидается `,` или `}` (AL-87)")) }
    }
    p_expect(p, "}")?
    if arms.len() == 0 { return Err(p_fail(p, "`${kw(cx.words, "expr", "match")}` needs an arm")) }
    Ok(x_match(subject, arms))
}

// ---- the operators -----------------------------------------------------------------------------------------------------------

fn ex_coalesce(mut p TxP, mut cx TxCx, sc TxScope) -> Result[TxJ, TranslateError] {
    ro left = ex_or(p, cx, sc)?
    if p_eat(p, "??") {
        ro right = ex_coalesce(p, cx, sc)?
        return Ok(x_bin("??", left, right))
    }
    Ok(left)
}

fn ex_or(mut p TxP, mut cx TxCx, sc TxScope) -> Result[TxJ, TranslateError] {
    mut left = ex_and(p, cx, sc)?
    while p_is_kw(p, cx.words, "expr", "or") {
        p_eat_kw(p, cx.words, "expr", "or")
        ro right = ex_and(p, cx, sc)?
        left = x_bin("or", left, right)
    }
    Ok(left)
}

fn ex_and(mut p TxP, mut cx TxCx, sc TxScope) -> Result[TxJ, TranslateError] {
    mut left = ex_not(p, cx, sc)?
    while p_is_kw(p, cx.words, "expr", "and") {
        p_eat_kw(p, cx.words, "expr", "and")
        ro right = ex_not(p, cx, sc)?
        left = x_bin("and", left, right)
    }
    Ok(left)
}

fn ex_not(mut p TxP, mut cx TxCx, sc TxScope) -> Result[TxJ, TranslateError] {
    if p_eat_kw(p, cx.words, "expr", "not") {
        ro inner = ex_not(p, cx, sc)?
        return Ok(x_un("not", inner))
    }
    ex_cmp(p, cx, sc)
}

fn cmp_op(t TxTok) -> str {
    if t.kind != TK_SYM { return "" }
    if t.text == "==" || t.text == "!=" || t.text == "<" || t.text == "<=" || t.text == ">" || t.text == ">=" { return t.text }
    ""
}

fn ex_cmp(mut p TxP, mut cx TxCx, sc TxScope) -> Result[TxJ, TranslateError] {
    mut left = ex_add(p, cx, sc)?
    while true {
        ro t = p_tok(p)
        if is_member_sign(p, cx.words) {
            p_adv(p)
            left = ex_member(p, cx, sc, left)?
            continue
        }
        match member_former(p, cx.words) {
            Some(e) => return Err(e)
            None => ()
        }
        ro op = cmp_op(t)
        if op == "" { break }
        p_adv(p)
        ro right = ex_add(p, cx, sc)?
        left = x_bin(op, left, right)
    }
    Ok(left)
}

// The sign of a membership (AL-79, AL-100): the word `в` of a Russian file, `in` of an English one, before a bracket `[` of the list.
fn is_member_sign(p TxP, w TxWords) -> bool {
    ro t = p_tok(p)
    t.kind == TK_NAME && t.text == kw(w, "operator", "in") && t_is(p_ahead(p, 1), "[")
}

// The former writing of a membership: the word of the other language (`in` in a Russian file, `в` in an English one, AL-100) or the set in braces `in {…}` (AL-79).
fn member_former(p TxP, w TxWords) -> Option[TranslateError] {
    ro t = p_tok(p)
    if t.kind != TK_NAME { return None }
    ro after = p_ahead(p, 1)
    if !(t_is(after, "[") || t_is(after, "{")) { return None }
    ro right = kw(w, "operator", "in")
    mut other = ""
    match kw_foreign(w, "operator", t.text) {
        Some(k) => { other = t.text }
        None => ()
    }
    if t.text == right && t_is(after, "{") {
        return Some(tx_err(t.line, t.col, "syntax", "множество в фигурных скобках `${t.text} {…}` в формате 2.22 не бывает: пишется `${right} […]` — список (AL-79); переходного периода нет"))
    }
    if other != "" {
        return Some(tx_err(t.line, t.col, "syntax", "знак принадлежности в этом файле — `${right}`, а не `${other}` (AL-100); множество — список `[…]` (AL-79); переходного периода нет"))
    }
    None
}

// `x в [a, b]` is `x == a или x == b` (AL-79); the elements are values of a closed type, bare names of the elements too (AL-88).
fn ex_member(mut p TxP, mut cx TxCx, sc TxScope, left TxJ) -> Result[TxJ, TranslateError] {
    p_expect(p, "[")?
    mut result = x_lit(TxBool(false))
    mut first = true
    if !p_is(p, "]") {
        while true {
            ro item = ex_add(p, cx, sc)?
            ro same = x_bin("==", left, item)
            result = if first { same } else { x_bin("or", result, same) }
            first = false
            if p_eat(p, ",") { continue }
            break
        }
    }
    p_expect(p, "]")?
    Ok(result)
}

fn ex_add(mut p TxP, mut cx TxCx, sc TxScope) -> Result[TxJ, TranslateError] {
    mut left = ex_mul(p, cx, sc)?
    while p_is(p, "+") || p_is(p, "-") {
        ro op = p_tok(p).text
        p_adv(p)
        ro right = ex_mul(p, cx, sc)?
        left = x_bin(op, left, right)
    }
    Ok(left)
}

fn ex_mul(mut p TxP, mut cx TxCx, sc TxScope) -> Result[TxJ, TranslateError] {
    mut left = ex_unary(p, cx, sc)?
    while p_is(p, "*") || p_is(p, "/") || p_is(p, "%") {
        ro op = p_tok(p).text
        p_adv(p)
        ro right = ex_unary(p, cx, sc)?
        left = x_bin(op, left, right)
    }
    Ok(left)
}

fn ex_unary(mut p TxP, mut cx TxCx, sc TxScope) -> Result[TxJ, TranslateError] {
    if p_is(p, "-") {
        p_adv(p)
        ro t = p_tok(p)
        if t.kind == TK_INT || t.kind == TK_FLOAT {
            p_adv(p)
            return ex_postfix(p, cx, sc, x_lit(TxRaw("-${t.text}")))
        }
        ro inner = ex_unary(p, cx, sc)?
        return Ok(x_un("neg", inner))
    }
    ex_postfix_start(p, cx, sc)
}

fn ex_postfix_start(mut p TxP, mut cx TxCx, sc TxScope) -> Result[TxJ, TranslateError] {
    ro base = ex_primary(p, cx, sc)?
    ex_postfix(p, cx, sc, base)
}

// `.поле`, `.0`, `[ключ]`, the method of a list function `.фильтр(х => выр)` after an operand (AL-78).
fn ex_postfix(mut p TxP, mut cx TxCx, sc TxScope, e TxJ) -> Result[TxJ, TranslateError] {
    if p_is(p, ".") {
        p_adv(p)
        ro t = p_tok(p)
        if t.kind == TK_INT {
            p_adv(p)
            return ex_postfix(p, cx, sc, x_field(e, t.text))
        }
        if t.kind == TK_FLOAT {
            // `к.0.1` is read by the lexer as `к`, `.`, `0.1`
            p_adv(p)
            ro at = t.text.find(".") ?? 0
            return ex_postfix(p, cx, sc, x_field(x_field(e, t.text[..at]), t.text[at + 1..]))
        }
        if t.kind == TK_NAME {
            if t_is(p_ahead(p, 1), "(") {
                // a name with a bracket after a dot is a method; only the eight list functions are methods
                match macro_key(cx.words, t.text) {
                    Some(key) => {
                        p_adv(p)
                        ro args = ex_args(p, cx, sc)?
                        if args.named.len() > 0 { return Err(tx_err(args.named_tokens[0].line, args.named_tokens[0].col, "syntax", "у метода `${t.text}` именованных аргументов нет")) }
                        mut all = [e]
                        for a in args.positional { all.push(a) }
                        return ex_postfix(p, cx, sc, x_call(key, all))
                    }
                    None => ()
                }
                match foreign_find(cx, t, ["catalog"]) {
                    Some(err) => return Err(err)
                    None => ()
                }
                return Err(tx_err(t.line, t.col, "syntax", "метод `.${t.text}(…)` бывает только у функций списка (${list_function_words(cx.words)}); остальные функции вызываются как `имя(…)` (AL-78)"))
            }
            p_adv(p)
            return ex_postfix(p, cx, sc, x_field(e, tr_field_name(cx, t)))
        }
        return Err(p_fail(p, "после `.` ожидается поле"))
    }
    if p_is(p, "[") {
        p_adv(p)
        ro index = ex_expr(p, cx, sc)?
        p_expect(p, "]")?
        return ex_postfix(p, cx, sc, x_index(e, index))
    }
    Ok(e)
}

/// The eight list functions of the catalog (section 12), by their English key: they are called as methods of a list (AL-78).
fn macro_names_en() -> []str => ["filter", "map", "any", "all", "count", "first_where", "fold", "dict"]

/// The key of a list function for a word of the catalog in the language of the file.
fn macro_key(w TxWords, word str) -> Option[str] {
    match kw_key(w, "catalog", word) {
        Some(k) => {
            if macro_names_en().contains(k) { return Some(k) }
        }
        None => ()
    }
    None
}

/// Is the word a list function of the catalog in the language of the file?
fn is_macro_word(w TxWords, word str) -> bool {
    match macro_key(w, word) {
        Some(k) => true
        None => false
    }
}

fn list_function_words(w TxWords) -> str => kw_all(w, "catalog", macro_names_en()).join(", ")

// ---- primary expressions -----------------------------------------------------------------------------------------------------

fn ex_primary(mut p TxP, mut cx TxCx, sc TxScope) -> Result[TxJ, TranslateError] {
    ro t = p_tok(p)
    if t.kind == TK_INT || t.kind == TK_FLOAT {
        p_adv(p)
        return Ok(x_lit(TxRaw(t.text)))
    }
    if t.kind == TK_STR {
        p_adv(p)
        if t.interp { return ex_interp(p, cx, sc, t) }
        return Ok(x_lit(js(t.text)))
    }
    if t_is(t, "(") { return ex_paren(p, cx, sc) }
    if t_is(t, "[") { return ex_list(p, cx, sc) }
    if t_is(t, "{") { return ex_brace(p, cx, sc) }
    if t.kind != TK_NAME { return Err(p_fail(p, "ожидается выражение")) }
    ro w = t.text
    ro words = cx.words
    if p_eat_kw(p, words, "expr", "true") { return Ok(x_lit(TxBool(true))) }
    if p_eat_kw(p, words, "expr", "false") { return Ok(x_lit(TxBool(false))) }
    if p_eat_kw(p, words, "expr", "none") { return Ok(x_null()) }
    if p_eat_kw(p, words, "expr", "unreachable") { return Ok(x_call("require", [x_null()])) }
    if p_is_kw(p, words, "expr", "if") || p_is_kw(p, words, "expr", "match") { return ex_expr(p, cx, sc) }
    if p_is_kw(p, words, "expr", "let") { return Err(p_fail(p, "`${kw(words, "expr", "let")}` стоит в начале блока `{ ${kw(words, "expr", "let")} имя = выр; выр }` (AL-75)")) }
    if is_keyword(words, w) { return Err(p_fail(p, "ожидается выражение")) }
    if p_is_kw(p, words, "action", "call") && t_is(p_ahead(p, 1), "(") { return ex_primitive_call(p, cx, sc) }
    p_adv(p)
    if p_is(p, "(") { return ex_call(p, cx, sc, t) }
    if is_bare_use(p, cx, w) && bare_clash(cx, sc, t) { return Ok(ex_name(cx, sc, t)) }
    // a name that looks like a type is a type, unless a binding or a state of the machine has it (an English state `Pause` looks like a type, a Russian `ПАУЗА` does not)
    if looks_like_type(w) && pair_get(sc.names, w) == None && (pair_get(cx.env.states, w) == None || pair_has(cx.env.types, w)) { return ex_typed(p, cx, sc, t) }
    // a bare name of an element written in capitals (`ВКЛ`, `ON`) does not look like a type, and it is looked up among the elements all the same (AL-104) unless it is a name of the machine
    if is_bare_use(p, cx, w) && sc_get(sc, w) == None && pair_get(cx.env.globals, w) == None && readable_json(cx.words, w) == None && pair_get(cx.env.states, w) == None {
        match bare_case(cx, t) {
            Some(j) => return Ok(j)
            None => ()
        }
    }
    Ok(ex_name(cx, sc, t))
}

/// A bare name: a binding, a datum, a constant, a parameter, a readable name of the executor, a state.
fn ex_name(mut cx TxCx, sc TxScope, t TxTok) -> TxJ {
    match sc_get(sc, t.text) {
        Some(en) => return x_name(en)
        None => ()
    }
    match pair_get(cx.env.globals, t.text) {
        Some(en) => return x_name(en)
        None => ()
    }
    match readable_json(cx.words, t.text) {
        Some(en) => return x_name(en)
        None => ()
    }
    match pair_get(cx.env.states, t.text) {
        Some(latin) => return x_lit(js(latin))
        None => ()
    }
    if is_identifier_latin(t.text) { return x_name(t.text) }
    if cx_foreign(cx, t, kinds_foreign_names()) { return x_name(t.text) }
    cx_error(cx, t, "name", name_not_declared(cx, t, "имя"))
    x_name(t.text)
}

fn ex_args_end(p TxP) -> bool => p_is(p, ")")

// The arguments of a call after `(`: positional ones, then `имя: выр`; a lambda is an argument. Returns the positional and the named.
type TxArgs { positional []TxJ, named []TxKV, named_tokens []TxTok }

fn ex_args(mut p TxP, mut cx TxCx, sc TxScope) -> Result[TxArgs, TranslateError] {
    mut positional = []TxJ.new()
    mut named = []TxKV.new()
    mut named_tokens = []TxTok.new()
    p_expect(p, "(")?
    if p_eat(p, ")") { return Ok(TxArgs { positional, named, named_tokens }) }
    while true {
        ro t = p_tok(p)
        if t.kind == TK_NAME && t_is(p_ahead(p, 1), ":") && !is_keyword(cx.words, t.text) {
            p_adv(p)
            p_adv(p)
            ro value = ex_expr(p, cx, sc)?
            named.push(kv(t.text, value))
            named_tokens.push(t)
        } else if is_lambda_start(p, cx.words) {
            positional.push(ex_lambda(p, cx, sc)?)
        } else {
            if named.len() > 0 { return Err(p_fail(p, "позиционный аргумент не может идти после именованного")) }
            positional.push(ex_expr(p, cx, sc)?)
        }
        if p_eat(p, ",") { continue }
        break
    }
    p_expect(p, ")")?
    Ok(TxArgs { positional, named, named_tokens })
}

/// A call `имя(арг, …)` of a function of the catalog or of a definition of the file; `событие_журнала(код, имя: выр, …)` carries the pairs flat.
fn ex_call(mut p TxP, mut cx TxCx, sc TxScope, name TxTok) -> Result[TxJ, TranslateError] {
    match macro_key(cx.words, name.text) {
        Some(key) => return Err(tx_err(name.line, name.col, "syntax", "функция списка `${name.text}(…)` вызывается как метод списка: `список.${name.text}(…)` (AL-78); переходного периода нет"))
        None => ()
    }
    match former_find(cx.words.lang, "call", name.text) {
        Some(f) => return Err(tx_err(name.line, name.col, "syntax", former_message(f)))
        None => ()
    }
    ro args = ex_args(p, cx, sc)?
    mut fn_en = ""
    match kw_key(cx.words, "catalog", name.text) {
        Some(en) => { fn_en = en }
        None => {
            match pair_get(cx.env.defs, name.text) {
                Some(en) => { fn_en = en }
                None => {
                    // a primitive that the machine names in `## Примитивы` is called as a function too (format 4.6, 2.12, AL-29): the same node as `вызвать(имя, арг)`; which class may stand where is the check's
                    match pair_get(cx.env.prims, name.text) {
                        Some(prim_en) => {
                            if args.named.len() > 0 { return Err(tx_err(args.named_tokens[0].line, args.named_tokens[0].col, "syntax", "именованные аргументы — только у `${kw(cx.words, "catalog", "journal_event")}`")) }
                            return Ok(x_prim(prim_en, args.positional))
                        }
                        None => ()
                    }
                    if cx_foreign(cx, name, ["catalog"]) {
                        fn_en = name.text
                    } else if is_identifier_latin(name.text) {
                        fn_en = name.text
                    } else {
                        cx_error(cx, name, "name", name_not_declared(cx, name, "функция"))
                        fn_en = name.text
                    }
                }
            }
        }
    }
    mut args_all = []TxJ.new()
    for a in args.positional { args_all.push(a) }
    if fn_en == "journal_event" {
        for n in args.named {
            args_all.push(x_lit(js(n.key)))
            args_all.push(n.value)
        }
    } else if args.named.len() > 0 {
        return Err(tx_err(args.named_tokens[0].line, args.named_tokens[0].col, "syntax", "именованные аргументы — только у `${kw(cx.words, "catalog", "journal_event")}`"))
    }
    Ok(x_call(fn_en, args_all))
}

/// `вызвать(примитив, арг, …)`: the primitive is named by its word of the table `## Примитивы` or by the table of names.
fn ex_primitive_call(mut p TxP, mut cx TxCx, sc TxScope) -> Result[TxJ, TranslateError] {
    p_adv(p)
    p_expect(p, "(")?
    ro n = p_tok(p)
    if n.kind != TK_NAME { return Err(p_fail(p, "ожидается имя примитива")) }
    p_adv(p)
    ro en = tr_primitive(cx, n)
    mut args = []TxJ.new()
    while p_eat(p, ",") {
        args.push(ex_expr(p, cx, sc)?)
    }
    p_expect(p, ")")?
    Ok(x_prim(en, args))
}

fn tr_primitive(mut cx TxCx, t TxTok) -> str {
    match pair_get(cx.env.prims, t.text) {
        Some(en) => return en
        None => ()
    }
    match kw_key(cx.words, "catalog", t.text) {
        Some(en) => {
            if en == "new_id" { return en }
        }
        None => ()
    }
    cx_error(cx, t, "name", "примитива `${t.text}` нет в таблице `## Примитивы` машины, и он не встроенный")
    t.text
}

/// `(выр)` or the tuple `(выр, выр, …)`.
fn ex_paren(mut p TxP, mut cx TxCx, sc TxScope) -> Result[TxJ, TranslateError] {
    p_adv(p)
    mut items = []TxJ.new()
    while true {
        items.push(ex_expr(p, cx, sc)?)
        if p_eat(p, ",") { continue }
        break
    }
    p_expect(p, ")")?
    if items.len() == 1 { return Ok(items[0]) }
    Ok(x_tuple(items))
}

/// `[]`, `[выр, …]` a list, `[ключ: значение, …]` a map (AL-85): after `[` the first expression is read, and the sign `:` after it makes a map. The empty `[]` is a list or a map by the expected type,
/// which `elab.nv` finds; here it is a mark.
fn ex_list(mut p TxP, mut cx TxCx, sc TxScope) -> Result[TxJ, TranslateError] {
    ro open = p_tok(p)
    p_adv(p)
    mut items = []TxJ.new()
    if p_eat(p, "]") { return Ok(x_empty_br(open.line, open.col)) }
    ro first = ex_expr(p, cx, sc)?
    if p_eat(p, ":") {
        mut entries = []TxJ.new()
        ro v0 = ex_expr(p, cx, sc)?
        entries.push(x_entry(first, v0))
        while p_eat(p, ",") {
            if p_is(p, "]") { break }
            ro k = ex_expr(p, cx, sc)?
            p_expect(p, ":")?
            ro v = ex_expr(p, cx, sc)?
            entries.push(x_entry(k, v))
        }
        p_expect(p, "]")?
        return Ok(x_dict(entries))
    }
    items.push(first)
    while p_eat(p, ",") {
        if p_is(p, "]") { break }
        items.push(ex_expr(p, cx, sc)?)
    }
    p_expect(p, "]")?
    Ok(x_list(items))
}

/// `{ ...выр, поле: выр }` a copy of a record with changed fields, or a block expression `{ пусть имя = выр; выр }` (AL-75). There is no map in braces any more (AL-85).
fn ex_brace(mut p TxP, mut cx TxCx, sc TxScope) -> Result[TxJ, TranslateError] {
    if t_is(p_ahead(p, 1), "...") {
        p_adv(p)
        p_adv(p)
        ro base = ex_expr(p, cx, sc)?
        ro fields = ex_field_pairs(p, cx, sc, true, "")?
        p_expect(p, "}")?
        return Ok(x_with(base, fields))
    }
    ex_block(p, cx, sc)
}

/// A literal with insertions (AL-80): `"a${x}b"` is `concat("a", text(x), "b")`; a single insertion `"${x}"` is `text(x)`; empty fragments are dropped. The code of an insertion is lexed again and read as an expression.
fn ex_interp(mut p TxP, mut cx TxCx, sc TxScope, t TxTok) -> Result[TxJ, TranslateError] {
    ro made = lx_parts(t.text)
    if made.bad >= 0 { return Err(tx_err(t.line, t.col + 1 + tx_cols(t.text, 0, made.bad), "syntax", made.why)) }
    mut items = []TxJ.new()
    for part in made.parts {
        if !part.code {
            if part.text != "" { items.push(x_lit(js(part.text))) }
            continue
        }
        ro code_col = t.col + 1 + tx_cols(t.text, 0, part.at)
        if part.text.trim_ascii() == "" { return Err(tx_err(t.line, code_col, "syntax", "пустая вставка `\${}` (AL-80): внутри пишется выражение")) }
        ro toks = tx_lex(part.text, t.line, code_col)?
        mut q = p_new(toks, t.line, code_col + part.text.chars().count())
        ro e = ex_expr(q, cx, sc)?
        p_end(q)?
        if tj_is_bool_lit(e) { return Err(tx_err(t.line, code_col, "type", "во вставке `\${…}` тип `${kw(cx.words, "type", "bool")}` не бывает (AL-80): строкой делается число, текст, набор литералов, ид, перечисление, состояние")) }
        items.push(x_call("text", [e]))
    }
    if items.len() == 1 { return Ok(items[0]) }
    Ok(x_call("concat", items))
}

// Is the tree a literal `true` or `false`?
fn tj_is_bool_lit(j TxJ) -> bool {
    match j {
        TxObj(pairs) => {
            mut is_lit = false
            mut is_bool = false
            for q in pairs {
                if q.key == "op" {
                    match q.value {
                        TxStr(s) => { is_lit = s == "lit" }
                        _ => ()
                    }
                }
                if q.key == "value" {
                    match q.value {
                        TxBool(b) => { is_bool = true }
                        _ => ()
                    }
                }
            }
            is_lit && is_bool
        }
        _ => false
    }
}

// The fields `поле: выр, …` of a record literal; after `...выр` the list starts with a comma.
fn ex_field_pairs(mut p TxP, mut cx TxCx, sc TxScope, after_base bool, owner str) -> Result[[]TxKV, TranslateError] {
    mut fields = []TxKV.new()
    if after_base {
        if !p_eat(p, ",") { return Ok(fields) }
    }
    if p_is(p, "}") { return Ok(fields) }
    while true {
        ro f = p_tok(p)
        if f.kind != TK_NAME { return Err(p_fail(p, "ожидается поле")) }
        p_adv(p)
        p_expect(p, ":")?
        ro value = ex_expr(p, cx, sc)?
        ro en = tr_field_in(cx, owner, f)
        for seen in fields {
            if seen.key == en { cx_error(cx, f, "syntax", "поле `${f.text}` повторено") }
        }
        fields.push(kv(en, value))
        if p_eat(p, ",") {
            if p_is(p, "}") { break }
            continue
        }
        break
    }
    Ok(fields)
}

/// The name of a type as the author wrote it (the JSON name of the type is looked up in the declared types; a type with no written name keeps the JSON name).
fn type_shown(cx TxCx, json str) -> str {
    for t in cx.env.types {
        if t.en == json { return t.ru }
    }
    json
}

/// The JSON names of the types that declare an element or a form without fields with this name.
fn case_owners(cx TxCx, name str) -> []str {
    mut owners = []str.new()
    for q in cx.env.case_types {
        if q.ru == name && !owners.contains(q.en) { owners.push(q.en) }
    }
    owners
}

/// A bare name of an element of an enumeration or of a form without fields (AL-88, AL-104; D478 of Nova): it is looked up among the enumerations declared in the machine, in the files of functions and in the
/// fragments, whatever the place expects; the type of the name is the type that declares it. A name that two types declare is an error that asks for the qualification `Тип.Эл`.
fn bare_case(mut cx TxCx, t TxTok) -> Option[TxJ] {
    ro owners = case_owners(cx, t.text)
    if owners.len() == 0 { return None }
    if owners.len() > 1 {
        mut shown = []str.new()
        mut ways = []str.new()
        for o in owners {
            shown.push(type_shown(cx, o))
            ways.push("`${type_shown(cx, o)}.${t.text}`")
        }
        cx_error(cx, t, "name", "имя `${t.text}` объявлено в нескольких типах (${shown.join(", ")}): нужна квалификация ${ways.join(" или ")} (AL-88, AL-104)")
    }
    Some(x_variant(owners[0], tr_case_name(cx, t), []))
}

/// Is the name written alone, as a value: no `.Имя` and no `{` after it, and it is no type.
fn is_bare_use(p TxP, cx TxCx, w str) -> bool => !(p_is(p, ".") && p_ahead(p, 1).kind == TK_NAME) && !p_is(p, "{") && !pair_has(cx.env.types, w)

/// AL-104: a bare name that an enumeration declares and that is also a binding, a datum, a constant or a parameter is an error of the check (the translator does not guess which one is meant); the element is
/// written `Тип.Эл`.
fn bare_clash(mut cx TxCx, sc TxScope, t TxTok) -> bool {
    ro owners = case_owners(cx, t.text)
    if owners.len() == 0 { return false }
    if !(pair_has(sc.names, t.text) || pair_has(cx.env.globals, t.text)) { return false }
    ro message_what = if pair_has(sc.names, t.text) { "привязка" } else { "данное, константа, параметр" }
    cx_error(cx, t, "name", "имя `${t.text}` — и элемент перечисления (`${type_shown(cx, owners[0])}.${t.text}`), и ${message_what}: голое имя неоднозначно (AL-88, AL-104); элемент пишется с именем типа, как `${type_shown(cx, owners[0])}.${t.text}`")
    true
}

/// A name that looks like a type: `Тип { поле: выр }`, `Тип.Форма`, `Тип.Форма { поле: выр }`.
fn ex_typed(mut p TxP, mut cx TxCx, sc TxScope, t TxTok) -> Result[TxJ, TranslateError] {
    // a bare name of an element of an enumeration or of a form without fields (AL-88): no `.` and no `{` after a name that is no type
    if !(p_is(p, ".") && p_ahead(p, 1).kind == TK_NAME) && !p_is(p, "{") && !pair_has(cx.env.types, t.text) {
        match bare_case(cx, t) {
            Some(j) => return Ok(j)
            None => ()
        }
    }
    ro type_en = tr_type_name(cx, t)
    if p_is(p, ".") && p_ahead(p, 1).kind == TK_NAME {
        p_adv(p)
        ro c = p_tok(p)
        p_adv(p)
        ro case_en = tr_case_name(cx, c)
        if p_is(p, "{") {
            p_adv(p)
            ro fields = ex_field_pairs(p, cx, sc, false, c.text)?
            p_expect(p, "}")?
            return Ok(x_variant(type_en, case_en, fields))
        }
        return Ok(x_variant(type_en, case_en, []))
    }
    if p_is(p, "{") {
        p_adv(p)
        ro fields = ex_field_pairs(p, cx, sc, false, t.text)?
        p_expect(p, "}")?
        return Ok(x_record(type_en, fields))
    }
    Err(tx_err(t.line, t.col, "syntax", "тип `${t.text}` использован как значение: пишется `${t.text}.Эл` (элемент или форма) или `${t.text} { поле: выр }`"))
}
