// party.nv - the parties (format section 1, `## Стороны`), the signals and the parts of an answer, the definitions (section 8), the primitives (section 7).
module alula.machine_text

// ORACLE-WORKAROUND(32): `import std.text` is needed in `nova build` for `[]str.join` (a `nova test` build has it already); drop the import when item 32 is fixed
import std.text

// ---- the parties -----------------------------------------------------------------------------------------------------------------------

/// TxPartyRow: a party read from its row: the names, the id and the pairs of its JSON object.
type TxPartyRow { ru str, en str, pairs []TxKV }

fn party_id_of(row TxPartyRow) -> str {
    for q in row.pairs {
        if q.key == "id" {
            match q.value {
                TxStr(x) => return x
                _ => ()
            }
        }
    }
    ""
}

// The list of the column `сигналы`: `—`, or `сигнал`, `сигнал { поле тип, … }`, … separated by commas (AL-38, AL-82: the fields in braces). Returns the JSON of the signals; the JSON names are built by themselves
// (AL-53, AL-60), the signals of one party are one space (AL-58).
fn party_signals(cell TxCell, line int, mut cx TxCx, party str) -> Result[[]TxJ, TranslateError] {
    mut out = []TxJ.new()
    if cell.text == "—" || cell.text == "" { return Ok(out) }
    mut p = cell_p(cell, line)?
    while true {
        ro first = p_tok(p)
        ro phrase = ev_phrase(p)?
        ro en = decl_json_text(p, cx, first, phrase, "сигнала", "сигналы:${party}", [party, phrase])?
        pair_add(cx.env.psignals, phrase, en)
        if p_is(p, "(") {
            return Err(tx_err(p_tok(p).line, p_tok(p).col, "syntax", "сигнал с полями `${phrase}(поле тип)` в формате 2.22 не бывает (AL-82): поля пишутся в фигурных скобках `${phrase} { поле тип }`; круглые скобки — только у функций; переходного периода нет"))
        }
        if p_eat(p, "{") {
            cx.env.owner = phrase
            cx.env.opath = [party, phrase]
            ro fields = decl_fields(p, cx, "}", "поля сигнала")?
            cx.env.owner = ""
            cx.env.opath = []str.new()
            p_expect(p, "}")?
            out.push(jobj([kv("name", js(en)), kv("fields", TxArr(fields))]))
        } else {
            out.push(jobj([kv("name", js(en))]))
        }
        if p_eat(p, ",") { continue }
        break
    }
    p_end(p)?
    Ok(out)
}

// A party: its name is internal (AL-46): the tree has it as it is written.
fn party_en(mut cx TxCx, n TxTok, id str) -> str {
    if is_keyword(cx.words, n.text) { cx_error(cx, n, "name", "`${n.text}` — служебное слово, именем быть не может") }
    n.text
}

// The counter: a datum (`попытка_агента`) or a path (`линзы[*].попытка`); `—` is no counter (a party of a free input, AL-52, the caller checks the kind).
fn party_counter(cell TxCell, line int, mut cx TxCx) -> Result[str, TranslateError] {
    mut p = cell_p(cell, line)?
    ro root = p_tok(p)
    if root.kind != TK_NAME { return Err(p_fail(p, "ожидается имя данного — счётчика попыток")) }
    p_adv(p)
    ro root_en = tr_global(cx, root)
    mut text = root_en
    if p_eat(p, "[") {
        p_expect(p, "*")?
        p_expect(p, "]")?
        text = "${text}[*]"
        while p_eat(p, ".") {
            ro f = p_tok(p)
            if f.kind != TK_NAME { return Err(p_fail(p, "после `.` ожидается поле")) }
            p_adv(p)
            text = "${text}.${tr_field_name(cx, f)}"
        }
    }
    p_end(p)?
    Ok(text)
}

// The cell `вид`: agent(итог Тип), human(итог ИсходВорот), enhanced(итог ИсходВорот), human или agent по настройке имя(итог ИсходВорот), machine имя(вход Тип, итог Тип)[; разбор: примитив[("роль")] -> Тип].
// A party of the kind `machine` is a nested machine (rule 35): the name of the machine of the registry of the caller, the record type of its input, the type of its result and the parse.
type TxKind { kind str, result str, setting str, nested str, input_type str, parse_primitive str, parse_type str }

fn kind_plain(kind str, result str, setting str) -> TxKind => { kind, result, setting, nested: "", input_type: "", parse_primitive: "", parse_type: "" }

// The name of the nested machine in the registry of the caller: the registry of the host (kind `machine` of `names_host.tsv`), else a Latin name as it is.
fn nested_name(mut cx TxCx, t TxTok) -> str => nested_name_text(cx, t, t.text)

// The same for a name given as a text (a list of the machines in the parameter of a fragment) at the place of a token.
fn nested_name_text(mut cx TxCx, at TxTok, name str) -> str {
    match names_get(cx.names, "machine", name) {
        Some(en) => return en
        None => ()
    }
    if is_identifier_latin(name) { return name }
    cx_error(cx, at, "name", "вложенной машины `${name}` нет в реестре хозяина; латинское имя читается само")
    name
}

// The message about a literal of the role in `разбор:` (AL-131, section 7 of the specification): the hint names the three functions in the language of the file.
fn role_literal_message(lang str) -> str {
    ro message_names = if lang == "en" { "`parse_witness_reply`, `parse_author_reply`, `parse_lens_reply`" } else { "`разобрать_ответ_свидетеля`, `разобрать_ответ_автора`, `разобрать_ответ_линзы`" }
    ro message_text = "литерал роли в разбор: с 2.24 — отдельная функция на роль: ${message_names}; разбор называется именем без скобок и аргументов; переходного периода нет"
    message_text
}

fn party_machine(mut p TxP, mut cx TxCx) -> Result[TxKind, TranslateError] {
    ro words = cx.words
    ro n = p_tok(p)
    if n.kind != TK_NAME { return Err(p_fail(p, "после `${kw(words, "kind_party", "machine")}` ожидается имя вызываемой машины")) }
    p_adv(p)
    ro nested = nested_name(cx, n)
    p_expect(p, "(")?
    p_expect_kw(p, words, "kind_party", "input")?
    ro input_type = ty_parse(p, cx)?
    p_expect(p, ",")?
    p_expect_kw(p, words, "kind_party", "result")?
    ro result = ty_parse(p, cx)?
    p_expect(p, ")")?
    mut prim = ""
    mut parse_type = ""
    if p_eat(p, ";") {
        p_expect_kw(p, words, "kind_party", "parse")?
        p_expect(p, ":")?
        ro f = p_tok(p)
        if f.kind != TK_NAME { return Err(p_fail(p, "после `${kw(words, "kind_party", "parse")}:` ожидается имя примитива")) }
        p_adv(p)
        // a literal of the role after the name of the parse is an error since 2.24 (AL-131): the parse is one function per role and takes the answer only
        if p_eat(p, "(") { return Err(p_fail(p, role_literal_message(cx.words.lang))) }
        prim = tr_primitive(cx, f)
        if !tx_arrow(p_tok(p)) { return Err(p_fail(p, "после разбора ожидается `->` и тип его результата")) }
        p_adv(p)
        parse_type = ty_parse(p, cx)?
    }
    p_end(p)?
    Ok(TxKind { kind: "machine", result, setting: "", nested, input_type, parse_primitive: prim, parse_type })
}

fn party_kind(cell TxCell, line int, mut cx TxCx) -> Result[TxKind, TranslateError] {
    mut p = cell_p(cell, line)?
    ro w = p_tok(p)
    if w.kind != TK_NAME { return Err(p_fail(p, "ожидается вид стороны")) }
    ro words = cx.words
    if p_eat_kw(p, words, "kind_party", "machine") { return party_machine(p, cx) }
    mut setting = ""
    mut kind = ""
    if p_eat_kw(p, words, "kind_party", "human or agent by setting") {
        ro s = p_tok(p)
        if s.kind != TK_NAME { return Err(p_fail(p, "ожидается имя настройки проекта")) }
        p_adv(p)
        setting = decl_json(p, cx, s, "настройки вратаря", "параметры и константы", [s.text])?
        kind = "gatekeeper"
    } else if p_eat_kw(p, words, "kind_party", "agent") {
        kind = "agent"
    } else if p_eat_kw(p, words, "kind_party", "human") {
        kind = "human"
    } else if p_eat_kw(p, words, "kind_party", "enhanced") {
        kind = "enhanced"
    } else {
        return Err(tx_err(w.line, w.col, "syntax", "вид стороны: ${kw(words, "kind_party", "agent")}, ${kw(words, "kind_party", "human")}, ${kw(words, "kind_party", "enhanced")}, ${kw(words, "kind_party", "human or agent by setting")} …, ${kw(words, "kind_party", "machine")}"))
    }
    p_expect(p, "(")?
    p_expect_kw(p, words, "kind_party", "result")?
    mut result = ""
    if kind == "agent" {
        result = ty_parse(p, cx)?
    } else {
        if !p_eat_kw(p, words, "type", "GateOutcome") { return Err(p_fail(p, "у этой стороны итог — `${kw(words, "type", "GateOutcome")}`")) }
    }
    p_expect(p, ")")?
    p_end(p)?
    Ok(kind_plain(kind, result, setting))
}

// The column `части` of 2.26 (section 7а): `—` or the name of the type of the parts that the party sends before its answer (a record of the machine or of a library).
fn party_parts(cell TxCell, line int, mut cx TxCx, party str) -> Result[str, TranslateError] {
    if cell.text == "—" || cell.text == "" { return Ok("") }
    mut p = cell_p(cell, line)?
    ro n = p_tok(p)
    if n.kind != TK_NAME { return Err(p_fail(p, "в столбце `${kw(cx.words, "column", "parts")}` — имя типа части")) }
    p_adv(p)
    p_end(p)?
    ro en = tr_type_name(cx, n)
    pair_add(cx.env.party_parts, party, n.text)
    Ok(en)
}

fn party_row(r TxEntry, mut cx TxCx) -> Result[TxPartyRow, TranslateError] => party_row_in(r, cx, false)

/// A row of `## Стороны`; `with_parts`: the table of 2.26 has the column `части` after `сигналы` (the type of the parts, the pair `parts_type` of the row for the tree).
fn party_row_in(r TxEntry, mut cx TxCx, with_parts bool) -> Result[TxPartyRow, TranslateError] {
    ro n = cell_name(r.cells[0], r.line)?
    ro id = if r.cells[1].text == "—" { "" } else { r.cells[1].text }
    ro k = party_kind(r.cells[2], r.line, cx)?
    ro en = party_en(cx, n, id)
    if pair_has(cx.env.parties, n.text) { return Err(tx_err(n.line, n.col, "name", "сторона `${n.text}` уже объявлена")) }
    pair_add(cx.env.parties, n.text, en)
    mut profile = TxNull
    mut has_profile = false
    if r.cells[3].text != "—" && r.cells[3].text != "" {
        profile = cell_expr(r.cells[3], r.line, cx, sc_empty())?
        has_profile = true
    }
    ro signals = party_signals(r.cells[4], r.line, cx, n.text)?
    mut parts_type = ""
    if with_parts { parts_type = party_parts(r.cells[5], r.line, cx, n.text)? }
    ro counter_cell = if with_parts { r.cells[6] } else { r.cells[5] }
    mut counter = ""
    if counter_cell.text == "—" || counter_cell.text == "" {
        if k.kind != "human" {
            return Err(tx_err(r.line, counter_cell.col, "structure", "у стороны вида `${k.kind}` счётчик обязателен: `—` (нет значения, свободный ввод, AL-52) допустим только у стороны вида `${kw(cx.words, "kind_party", "human")}`"))
        }
    } else {
        counter = party_counter(counter_cell, r.line, cx)?
    }
    mut pairs = [kv("name", js(en)), kv("id", js(id)), kv("kind", js(k.kind))]
    if k.nested != "" { pairs.push(kv("nested", js(k.nested))) }
    if k.input_type != "" { pairs.push(kv("input_type", js(k.input_type))) }
    if k.result != "" { pairs.push(kv("result", js(k.result))) }
    if k.parse_primitive != "" {
        mut parse_pairs = [kv("primitive", js(k.parse_primitive))]
        parse_pairs.push(kv("type", js(k.parse_type)))
        pairs.push(kv("parse", jobj(parse_pairs)))
    }
    if has_profile { pairs.push(kv("profile", profile)) }
    if k.setting != "" { pairs.push(kv("setting", js(k.setting))) }
    if counter != "" { pairs.push(kv("counter", js(counter))) }
    if signals.len() > 0 { pairs.push(kv("signals", TxArr(signals))) }
    // the type of the parts: the machine puts the record of the type as the `progress` of the party (machine.nv, `party_json`)
    if parts_type != "" { pairs.push(kv("parts_type", js(parts_type))) }
    Ok(TxPartyRow { ru: n.text, en, pairs })
}

fn party_columns() -> []str => ["name", "id", "kind", "profile", "signals", "counter"]

// The columns of `## Стороны` of 2.26 with the column `части` (section 7а: what the party sends before its answer, by the pattern of `сигналы`).
fn party_columns_parts() -> []str => ["name", "id", "kind", "profile", "signals", "parts", "counter"]

fn limit_expression(line TxKv, mut cx TxCx) -> Result[TxJ, TranslateError] {
    mut p = lex_segs(line.segs)?
    ro x = ex_expr(p, cx, sc_empty())?
    p_end(p)?
    Ok(x)
}

/// The line `Предел запросов: выражение` of the section `## Стороны` (format 1, rule 21): the expression, or nothing when the line is not written.
fn decl_request_limit(entries []TxEntry, sec TxSection, mut cx TxCx) -> []TxJ {
    mut out = []TxJ.new()
    mut i = sec.first
    while i < sec.last {
        ro e = entries[i]
        if e.kind == EN_TEXT && kv_colon(e) >= 0 {
            ro line = kv_read(entries, i)
            if line.key == "Request limit" {
                match limit_expression(line, cx) {
                    Ok(x) => { out.push(x) }
                    Err(err) => note(cx, err)
                }
            }
            i += line.taken
        } else {
            i += 1
        }
    }
    out
}

/// The section `## Стороны`: the parties; the line `Предел запросов: …` is read by `decl_request_limit`.
fn decl_parties(entries []TxEntry, sec TxSection, mut cx TxCx) -> []TxPartyRow {
    mut out = []TxPartyRow.new()
    mut i = sec.first
    while i < sec.last {
        ro e = entries[i]
        if e.kind == EN_ROW {
            // a file of 2.26 may have the column `части` after `сигналы` (section 7а)
            ro with_parts = cx.v226 && e.cells.len() == party_columns_parts().len()
            ro t = tab_read(entries, i, sec.last, if with_parts { party_columns_parts() } else { party_columns() }, cx)
            for r in t.rows {
                cx.rows_total += 1
                ro before = cx.errors.len()
                match party_row_in(r, cx, with_parts) {
                    Ok(row) => {
                        out.push(row)
                        cx_place(cx, "$.parties[${out.len() - 1}]", r.line)
                    }
                    Err(err) => note(cx, err)
                }
                if cx.errors.len() > before { cx.rows_noted += 1 }
            }
            i = tab_end(entries, i, sec.last, cx.words)
        } else if e.kind == EN_TEXT && kv_colon(e) >= 0 {
            ro line = kv_read(entries, i)
            if line.key == "Request limit" {
                // read by `decl_request_limit`
                cx.rows_total += 0
            } else {
                note(cx, struct_error(e.line, 1, "в разделе `Стороны` бывают таблица и строка `Предел запросов: …`"))
            }
            i += line.taken
        } else if e.kind == EN_TEXT && e.text == "—" {
            dash_line(cx, e)
            i += 1
        } else {
            note(cx, struct_error(e.line, e.indent + 1, "лишняя строка в разделе `Стороны`"))
            i += 1
        }
    }
    // a party is also called by its id (the identifier of the party is its external name, spec section 1): the text of a fragment says `enhanced`
    mut aliases = []TxPair.new()
    for row in out {
        ro id = party_id_of(row)
        if id != "" && !pair_has(cx.env.parties, id) { aliases.push(TxPair { ru: id, en: row.en }) }
    }
    for al in aliases {
        if !pair_has(cx.env.parties, al.ru) { pair_add(cx.env.parties, al.ru, al.en) }
    }
    out
}

// ---- the signals and the parts of an answer (not in the format: the proposals of section 14 of its changelog) --------------------------------------------

// Fields in a cell: `—` or `поле тип, поле тип`.
fn cell_fields(cell TxCell, line int, mut cx TxCx, what str) -> Result[[]TxJ, TranslateError] {
    mut out = []TxJ.new()
    if cell.text == "—" || cell.text == "" { return Ok(out) }
    mut p = cell_p(cell, line)?
    while !p_done(p) {
        out.push(decl_field(p, cx, what)?)
        if p_eat(p, ",") { continue }
        break
    }
    p_end(p)?
    Ok(out)
}

fn cell_phrase(cell TxCell, line int, mut cx TxCx, what str, space str, prefix []str) -> Result[TxPhrase, TranslateError] {
    mut p = cell_p(cell, line)?
    ro first = p_tok(p)
    ro phrase = ev_phrase(p)?
    mut path = []str.new()
    for x in prefix { path.push(x) }
    path.push(phrase)
    ro json = decl_json_text(p, cx, first, phrase, what, space, path)?
    p_end(p)?
    Ok(TxPhrase { text: phrase, first, json, path })
}

type TxPhrase { text str, first TxTok, json str, path []str }

/// The section `## Сигналы`: `| имя | поля |`; returns the JSON of the signals.
fn decl_signals(entries []TxEntry, sec TxSection, mut cx TxCx) -> []TxJ {
    mut out = []TxJ.new()
    for r in section_table(entries, sec, ["name", "fields"], cx) {
        cx.rows_total += 1
        ro before = cx.errors.len()
        match signal_row(r, cx) {
            Ok(j) => out.push(j)
            Err(err) => note(cx, err)
        }
        if cx.errors.len() > before { cx.rows_noted += 1 }
    }
    out
}

fn signal_row(r TxEntry, mut cx TxCx) -> Result[TxJ, TranslateError] {
    ro ph = cell_phrase(r.cells[0], r.line, cx, "сигнала машины", "сигналы машины", []str.new())?
    ro en = ph.json
    cx.env.owner = ph.text
    cx.env.opath = ph.path
    ro fields = cell_fields(r.cells[1], r.line, cx, "поля сигнала машины")?
    cx.env.owner = ""
    cx.env.opath = []str.new()
    pair_add(cx.env.signals, ph.text, en)
    if fields.len() == 0 { return Ok(jobj([kv("name", js(en))])) }
    Ok(jobj([kv("name", js(en)), kv("fields", TxArr(fields))]))
}

/// TxPartItem: a part of an answer of one party.
type TxPartItem { party_ru str, item TxJ }

/// The section `## Части ответа`: `| сторона | имя | поля |`.
fn decl_parts(entries []TxEntry, sec TxSection, mut cx TxCx) -> []TxPartItem {
    mut out = []TxPartItem.new()
    for r in section_table(entries, sec, ["party", "name", "fields"], cx) {
        cx.rows_total += 1
        ro before = cx.errors.len()
        match part_row(r, cx) {
            Ok(row) => out.push(row)
            Err(err) => note(cx, err)
        }
        if cx.errors.len() > before { cx.rows_noted += 1 }
    }
    out
}

fn part_row(r TxEntry, mut cx TxCx) -> Result[TxPartItem, TranslateError] {
    ro party = cell_name(r.cells[0], r.line)?
    if !pair_has(cx.env.parties, party.text) { cx_error(cx, party, "name", "стороны `${party.text}` нет в таблице «Стороны»") }
    ro ph = cell_phrase(r.cells[1], r.line, cx, "части ответа", "части ответа:${party.text}", [party.text])?
    ro en = ph.json
    cx.env.owner = ph.text
    cx.env.opath = ph.path
    ro fields = cell_fields(r.cells[2], r.line, cx, "поля части ответа")?
    cx.env.owner = ""
    cx.env.opath = []str.new()
    pair_add(cx.env.parts, ph.text, en)
    ro item = if fields.len() == 0 { jobj([kv("name", js(en))]) } else { jobj([kv("name", js(en)), kv("fields", TxArr(fields))]) }
    Ok(TxPartItem { party_ru: party.text, item })
}

// ---- the definitions --------------------------------------------------------------------------------------------------------------------

fn def_segs(entries []TxEntry, sec TxSection, mut cx TxCx) -> []TxSeg {
    mut segs = []TxSeg.new()
    mut i = sec.first
    while i < sec.last {
        ro e = entries[i]
        if e.kind == EN_TEXT {
            if e.text != "—" { segs.push(TxSeg { text: e.text, line: e.line, col: e.indent + 1, code: e.fenced }) } else { dash_line(cx, e) }
        } else {
            note(cx, struct_error(e.line, 1, "в разделе `${sec.name}` таблиц нет"))
        }
        i += 1
    }
    segs
}

/// AL-81: the name of a definition or of a primitive is no word of the catalog in either language and is not `range` (the name of the call of a range in the tree); the JSON name is checked too.
fn call_clash(mut cx TxCx, n TxTok, json str) -> () {
    ro ru_words = words_load("ru")
    ro en_words = words_load("en")
    // AL-107: `new_id` (`новый_ид`) is the built-in primitive of the host; it stands in the table of words under the kind `catalog` (section 12) but is no function of the catalog, so the name, as written and as JSON, is not checked
    ro ru_new_id = kw(ru_words, "catalog", "new_id")
    for cand in [n.text, json] {
        if cand == "new_id" || cand == ru_new_id { continue }
        if cand == "range" || kw_has(ru_words, "catalog", cand) || kw_has(en_words, "catalog", cand) {
            cx_error(cx, n, "check", "имя `${cand}` совпадает с функцией каталога (AL-81): определение и примитив называются иначе, чем `фильтр`/`filter`, `склеить`/`concat`, `range` и другие функции каталога")
            return
        }
    }
}

/// The names of the functions are known before the bodies are read (a function may call one that comes later).
fn defs_register(entries []TxEntry, sec TxSection, mut cx TxCx) -> () {
    ro segs = def_segs(entries, sec, cx)
    match lex_segs(segs) {
        Ok(p0) => {
            mut k = 0
            while k + 1 < p0.toks.len() {
                // `внешняя функция имя` declares an external function (AL-123), not a function of the author: the word before `функция` tells
                if t_is_kw(p0.toks[k], cx.words, "decl", "fn") && p0.toks[k + 1].kind == TK_NAME && !(k > 0 && t_is_kw(p0.toks[k - 1], cx.words, "decl", "external")) {
                    ro n = p0.toks[k + 1]
                    ro en = decl_internal(cx, n)
                    call_clash(cx, n, en)
                    if pair_has(cx.env.defs, n.text) {
                        cx_error(cx, n, "name", "функция `${n.text}` повторена")
                    } else {
                        pair_add(cx.env.defs, n.text, en)
                    }
                }
                k += 1
            }
        }
        Err(e) => note(cx, e)
    }
}

// One function after `функция` (AL-83): `имя(арг тип, …) -> тип => выр` or `имя(арг тип, …) -> тип { пусть …; выр }` (AL-67, AL-84).
fn def_one(mut p TxP, mut cx TxCx) -> Result[TxJ, TranslateError] {
    ro n = p_tok(p)
    if n.kind != TK_NAME { return Err(p_fail(p, "после `${kw(cx.words, "decl", "fn")}` ожидается имя")) }
    p_adv(p)
    ro en = match pair_get(cx.env.defs, n.text) {
        Some(x) => x
        None => n.text
    }
    p_expect(p, "(")?
    mut params = []TxJ.new()
    mut scope = sc_empty()
    while !p_is(p, ")") {
        ro a = p_tok(p)
        if t_is(a, "...") { return Err(tx_err(a.line, a.col, "check", "именованный хвост `...имя: Тип` бывает только у внешней функции, у функции автора его нет (AL-129)")) }
        if a.kind != TK_NAME { return Err(p_fail(p, "ожидается имя параметра")) }
        p_adv(p)
        ro a_en = tr_binder(cx, a)
        if pair_has(scope.names, a.text) { cx_error(cx, a, "name", "параметр `${a.text}` повторён") }
        ro type_text = ty_parse(p, cx)?
        params.push(jobj([kv("name", js(a_en)), kv("type", js(type_text))]))
        scope = sc_with(scope, a.text, a_en)
        if p_eat(p, ",") { continue }
        break
    }
    p_expect(p, ")")?
    if !tx_arrow(p_tok(p)) { return Err(p_fail(p, "после параметров ожидается `->` и тип результата")) }
    p_adv(p)
    ro result = ty_parse(p, cx)?
    mut body = x_null()
    if tx_fat(p_tok(p)) {
        ro fat = p_tok(p)
        p_adv(p)
        if p_is(p, "{") { return Err(tx_err(fat.line, fat.col, "syntax", "`=> {` после заголовка функции в формате 2.22 не бывает (AL-84): тело — выражение после `=>` или блок `{ … }` без `=>`; запись как всё тело пишется в скобках `=> ({ ...r, поле: выр })`; переходного периода нет")) }
        body = ex_expr(p, cx, scope)?
    } else if p_is(p, "{") {
        body = ex_block(p, cx, scope)?
    } else if p_is(p, "=") {
        return Err(tx_err(p_tok(p).line, p_tok(p).col, "syntax", "знак `=` перед телом функции в формате 2.22 не бывает: пишется `=>` (AL-67) или блок `{ … }` (AL-84); переходного периода нет"))
    } else {
        return Err(p_fail(p, "после типа результата ожидается `=>` и выражение или блок `{ … }`"))
    }
    Ok(jobj([kv("name", js(en)), kv("params", TxArr(params)), kv("result", js(result)), kv("body", body)]))
}

// Does a function of the author start under the reader? The word `функция` after `внешняя` begins a declaration of an external function, not this.
fn fn_starts(p TxP, cx TxCx) -> bool => p_is_kw(p, cx.words, "decl", "fn") && !(p.pos > 0 && t_is_kw(p.toks[p.pos - 1], cx.words, "decl", "external"))

/// The section `## Функции`: `функция имя(арг тип, …) -> тип => выр` or with a block body (AL-83, AL-84).
fn decl_definitions(entries []TxEntry, sec TxSection, mut cx TxCx) -> []TxJ {
    mut out = []TxJ.new()
    ro segs = def_segs(entries, sec, cx)
    match lex_segs(segs) {
        Ok(p0) => {
            mut p = p_copy(p0)
            while !p_done(p) {
                ro head = p_tok(p)
                if !t_is_kw(head, cx.words, "decl", "fn") {
                    match former_find(cx.words.lang, "decl", head.text) {
                        Some(f) => note(cx, tx_err(head.line, head.col, "syntax", former_message(f)))
                        None => {
                            if t_is_kw(head, cx.words, "decl", "external") && cx.env.in_defs_file {
                                note(cx, tx_err(head.line, head.col, "syntax", "в файле функций внешних функций нет (AL-123): внешняя функция объявляется в машине, в разделе `## ${kw(cx.words, "section", "External functions")}`; файл функций — чистые типы, константы и функции"))
                            } else if t_is_kw(head, cx.words, "decl", "external") {
                                note(cx, tx_err(head.line, head.col, "syntax", "внешняя функция объявляется в разделе `## ${kw(cx.words, "section", "External functions")}`, в `## ${kw(cx.words, "section", "Functions")}` пишутся функции с телом (AL-123)"))
                            } else {
                                note(cx, tx_err(head.line, head.col, "syntax", "ожидается `${kw(cx.words, "decl", "fn")}`, найдено: ${t_shown(head)}"))
                            }
                        }
                    }
                    p_adv(p)
                    while !p_done(p) && !(fn_starts(p, cx) || (p_tok(p).col == 1 && p_tok(p).kind == TK_NAME && former_is(cx.words.lang, "decl", p_tok(p).text))) { p_adv(p) }
                    continue
                }
                p_adv(p)
                cx.rows_total += 1
                ro before = cx.errors.len()
                match def_one(p, cx) {
                    Ok(j) => {
                        out.push(j)
                        cx_place(cx, "$.definitions[${out.len() - 1}]", head.line)
                    }
                    Err(e) => {
                        note(cx, e)
                        while !p_done(p) && !fn_starts(p, cx) { p_adv(p) }
                    }
                }
                if cx.errors.len() > before { cx.rows_noted += 1 }
            }
        }
        Err(e) => note(cx, e)
    }
    out
}

// ---- the external functions ---------------------------------------------------------------------------------------------------------------

/// The keys of the classes of an external function of the host (AL-116); the words of a file are `kw(.., "enum_value", key)`. The file writes `volatile` and `acting`; a pure function has no class word (AL-123).
fn primitive_classes() -> []str => ["pure", "volatile", "acting"]

/// The tokens of the next declaration are skipped up to the next `внешняя` (or the end): after an error in a declaration the next one is read.
fn ext_skip(mut p TxP, cx TxCx, head_line int) -> () {
    p_adv(p)
    if cx.v226 {
        // a declaration of 2.26 has no word before it (AL-142): the next one begins a line
        while !p_done(p) && !(p_tok(p).line > head_line && p_tok(p).col == 1) { p_adv(p) }
        return
    }
    while !p_done(p) && !p_is_kw(p, cx.words, "decl", "external") { p_adv(p) }
}

/// A parameter of a declaration: `имя тип`, or the named tail `...имя: Тип` (AL-129), which is the last one. Returns the JSON of the parameter and whether it is the tail.
fn ext_param(mut p TxP, mut cx TxCx) -> Result[TxJ, TranslateError] {
    ro tail = p_eat(p, "...")
    ro a = p_tok(p)
    if a.kind != TK_NAME { return Err(p_fail(p, if tail { "после `...` ожидается имя хвоста" } else { "ожидается имя параметра" })) }
    p_adv(p)
    ro a_en = tr_binder(cx, a)
    if tail {
        p_expect(p, ":")?
        ro type_text = ty_parse(p, cx)?
        return Ok(jobj([kv("name", js(a_en)), kv("type", js(type_text)), kv("tail", TxBool(true))]))
    }
    ro type_text = ty_parse(p, cx)?
    Ok(jobj([kv("name", js(a_en)), kv("type", js(type_text))]))
}

/// One declaration `внешняя функция имя(арг тип, …) [класс] [-> тип]` without a body (AL-123).
fn ext_one(mut p TxP, mut cx TxCx) -> Result[TxJ, TranslateError] {
    ro head = p_tok(p)
    if cx.v226 {
        // 2.26 (AL-142): `имя(арг тип, …) [класс] [-> тип]`, no word before the name
        if t_is_kw(head, cx.words, "decl", "external") {
            return Err(tx_err(head.line, head.col, "syntax", "с 2.26 внешняя функция пишется без слов `${kw(cx.words, "decl", "external")} ${kw(cx.words, "decl", "fn")}`: `имя(арг тип, …) [класс] [-> тип]` (AL-142); переходного периода нет"))
        }
        if t_is_kw(head, cx.words, "decl", "fn") {
            return Err(tx_err(head.line, head.col, "syntax", "в разделе `## ${kw(cx.words, "section", "External functions")}` объявление — `имя(арг тип, …) [класс] [-> тип]` без слова `${kw(cx.words, "decl", "fn")}` (AL-142)"))
        }
    } else if !t_is_kw(head, cx.words, "decl", "external") {
        match former_find(cx.words.lang, "decl", head.text) {
            Some(f) => return Err(tx_err(head.line, head.col, "syntax", former_message(f)))
            None => ()
        }
        if t_is_kw(head, cx.words, "decl", "fn") {
            return Err(tx_err(head.line, head.col, "syntax", "в разделе `## ${kw(cx.words, "section", "External functions")}` объявление начинается со слова `${kw(cx.words, "decl", "external")}`: `${kw(cx.words, "decl", "external")} ${kw(cx.words, "decl", "fn")} имя(арг тип, …) [класс] [-> тип]` (AL-123)"))
        }
        return Err(tx_err(head.line, head.col, "syntax", "ожидается `${kw(cx.words, "decl", "external")} ${kw(cx.words, "decl", "fn")}`, найдено: ${t_shown(head)}"))
    }
    if !cx.v226 {
        p_adv(p)
        p_expect_kw(p, cx.words, "decl", "fn")?
    }
    ro n = p_tok(p)
    if n.kind != TK_NAME { return Err(p_fail(p, if cx.v226 { "ожидается имя внешней функции" } else { "после `${kw(cx.words, "decl", "external")} ${kw(cx.words, "decl", "fn")}` ожидается имя" })) }
    p_adv(p)
    mut json = n.text
    match readable_json(cx.words, n.text) {
        Some(key) => {
            if !p_is(p, "(") { jn_declare_fixed(cx, n.line, n.col, n.text, "примитива", "примитивы", [n.text], key) }
            json = key
        }
        None => { json = decl_json(p, cx, n, "примитива", "примитивы", [n.text])? }
    }
    // AL-134: the former function of the time is gone with 2.25, a declaration of an external function by that name is refused with the same hint as a call
    match former_find(cx.words.lang, "call", n.text) {
        Some(f) => return Err(tx_err(n.line, n.col, "syntax", former_message(f)))
        None => ()
    }
    if standard_call(cx, n.text) || json == "new_id" {
        return Err(tx_err(n.line, n.col, "syntax", "`${n.text}` — стандартная внешняя функция языка (7а): она заранее объявлена и в разделе `## ${kw(cx.words, "section", "External functions")}` не пишется (AL-123)"))
    }
    if pair_has(cx.env.prims, n.text) { cx_error(cx, n, "name", "внешняя функция `${n.text}` объявлена повторно (AL-123)") }
    call_clash(cx, n, json)
    p_expect(p, "(")?
    mut params = []TxJ.new()
    mut names = []str.new()
    mut tail = false
    while !p_is(p, ")") {
        if tail { return Err(tx_err(p_tok(p).line, p_tok(p).col, "syntax", "именованный хвост `...имя: Тип` — последний параметр (AL-129)")) }
        ro at = p_tok(p)
        tail = t_is(at, "...")
        ro pname = if tail { p_ahead(p, 1).text } else { at.text }
        ro one = ext_param(p, cx)?
        if names.contains(pname) { cx_error(cx, at, "name", "параметр `${pname}` повторён") }
        names.push(pname)
        params.push(one)
        if p_eat(p, ",") { continue }
        break
    }
    ro close = p_tok(p)
    p_expect(p, ")")?
    mut class = "pure"
    ro ct = p_tok(p)
    // in 2.26 a declaration is one line (AL-142): a name on a later line begins the next declaration, it is no word of the class
    ro next_decl = cx.v226 && ct.line > close.line
    if ct.kind == TK_NAME && !t_is_kw(ct, cx.words, "decl", "external") && !next_decl {
        ro key = kw_key(cx.words, "enum_value", ct.text) ?? ""
        if key == "volatile" || key == "acting" {
            class = key
        } else if key == "pure" {
            return Err(tx_err(ct.line, ct.col, "syntax", "слово класса `${ct.text}` в файле не пишется: у чистой внешней функции слова класса нет (AL-123); пишутся `${kw(cx.words, "enum_value", "volatile")}` и `${kw(cx.words, "enum_value", "acting")}`"))
        } else {
            match former_find(cx.words.lang, "class", ct.text) {
                Some(f) => return Err(tx_err(ct.line, ct.col, "syntax", former_message(f)))
                None => return Err(tx_err(ct.line, ct.col, "syntax", "класс внешней функции: ${kw_all(cx.words, "enum_value", ["volatile", "acting"]).join(", ")} (у чистой слова нет), найдено: ${t_shown(ct)}"))
            }
        }
        p_adv(p)
    }
    mut pairs = [kv("name", js(json)), kv("params", TxArr(params))]
    if tx_arrow(p_tok(p)) {
        p_adv(p)
        pairs.push(kv("result", js(ty_parse(p, cx)?)))
    }
    pairs.push(kv("class", js(class)))
    if tx_fat(p_tok(p)) || p_is(p, "{") {
        return Err(tx_err(p_tok(p).line, p_tok(p).col, "syntax", "объявление внешней функции — без тела (AL-123): тело у неё в хозяине; функция с телом пишется в разделе `## ${kw(cx.words, "section", "Functions")}`"))
    }
    if !p_done(p) && !p_is_kw(p, cx.words, "decl", "external") && !(cx.v226 && p_tok(p).line > n.line && p_tok(p).col == 1) { return Err(p_fail(p, "после объявления ожидается следующее объявление")) }
    pair_add(cx.env.prims, n.text, json)
    if tail { pair_add(cx.env.tails, n.text, json) }
    Ok(jobj(pairs))
}

/// The section `## Внешние функции`: the declarations of the external functions of the host that the machine calls, in the order of the file (AL-123). The section is a block of code, as `## Функции` is.
fn decl_externals(entries []TxEntry, sec TxSection, mut cx TxCx) -> []TxJ {
    mut out = []TxJ.new()
    ro segs = def_segs(entries, sec, cx)
    match lex_segs(segs) {
        Ok(p0) => {
            mut p = p_copy(p0)
            while !p_done(p) {
                ro head = p_tok(p)
                cx.rows_total += 1
                ro before = cx.errors.len()
                match ext_one(p, cx) {
                    Ok(j) => {
                        out.push(j)
                        cx_place(cx, "$.primitives[${out.len() - 1}]", head.line)
                    }
                    Err(e) => {
                        note(cx, e)
                        ext_skip(p, cx, head.line)
                    }
                }
                if cx.errors.len() > before { cx.rows_noted += 1 }
            }
        }
        Err(e) => note(cx, e)
    }
    out
}
