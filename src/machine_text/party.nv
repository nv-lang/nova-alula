// party.nv - the parties (format section 1, `## Стороны`), the signals and the parts of an answer, the definitions (section 8), the primitives (section 7).
module alula.machine_text

// ORACLE-WORKAROUND(32): `import std.text` is needed in `nova build` for `[]str.join` (a `nova test` build has it already); drop the import when item 32 is fixed
import std.text

// ---- the parties -----------------------------------------------------------------------------------------------------------------------

/// TxPartyRow: a party read from its row: the names, the id and the pairs of its JSON object.
type TxPartyRow { ru str, en str, pairs []TxKV }

fn party_id_of(row TxPartyRow) -> str {
    for q in row.pairs {
        if q.key == "id" {
            match q.value {
                TxStr(x) => return x
                _ => ()
            }
        }
    }
    ""
}

// The list of the column `сигналы`: `—`, or `сигнал`, `сигнал { поле тип, … }`, … separated by commas (AL-38, AL-82: the fields in braces). Returns the JSON of the signals; the JSON names are built by themselves
// (AL-53, AL-60), the signals of one party are one space (AL-58).
fn party_signals(cell TxCell, line int, mut cx TxCx, party str) -> Result[[]TxJ, TranslateError] {
    mut out = []TxJ.new()
    if cell.text == "—" || cell.text == "" { return Ok(out) }
    mut p = cell_p(cell, line)?
    while true {
        ro first = p_tok(p)
        ro phrase = ev_phrase(p)?
        ro en = decl_json_text(p, cx, first, phrase, "сигнала", "сигналы:${party}", [party, phrase])?
        pair_add(cx.env.psignals, phrase, en)
        if p_is(p, "(") {
            return Err(tx_err(p_tok(p).line, p_tok(p).col, "syntax", "сигнал с полями `${phrase}(поле тип)` в формате 2.22 не бывает (AL-82): поля пишутся в фигурных скобках `${phrase} { поле тип }`; круглые скобки — только у функций; переходного периода нет"))
        }
        if p_eat(p, "{") {
            cx.env.owner = phrase
            cx.env.opath = [party, phrase]
            ro fields = decl_fields(p, cx, "}", "поля сигнала")?
            cx.env.owner = ""
            cx.env.opath = []str.new()
            p_expect(p, "}")?
            out.push(jobj([kv("name", js(en)), kv("fields", TxArr(fields))]))
        } else {
            out.push(jobj([kv("name", js(en))]))
        }
        if p_eat(p, ",") { continue }
        break
    }
    p_end(p)?
    Ok(out)
}

// A party: its name is internal (AL-46): the tree has it as it is written.
fn party_en(mut cx TxCx, n TxTok, id str) -> str {
    if is_keyword(cx.words, n.text) { cx_error(cx, n, "name", "`${n.text}` — служебное слово, именем быть не может") }
    n.text
}

// The counter: a datum (`попытка_агента`) or a path (`линзы[*].попытка`); `—` is no counter (a party of a free input, AL-52, the caller checks the kind).
fn party_counter(cell TxCell, line int, mut cx TxCx) -> Result[str, TranslateError] {
    mut p = cell_p(cell, line)?
    ro root = p_tok(p)
    if root.kind != TK_NAME { return Err(p_fail(p, "ожидается имя данного — счётчика попыток")) }
    p_adv(p)
    ro root_en = tr_global(cx, root)
    mut text = root_en
    if p_eat(p, "[") {
        p_expect(p, "*")?
        p_expect(p, "]")?
        text = "${text}[*]"
        while p_eat(p, ".") {
            ro f = p_tok(p)
            if f.kind != TK_NAME { return Err(p_fail(p, "после `.` ожидается поле")) }
            p_adv(p)
            text = "${text}.${tr_field_name(cx, f)}"
        }
    }
    p_end(p)?
    Ok(text)
}

// The cell `вид`: agent(итог Тип), human(итог ИсходВорот), enhanced(итог ИсходВорот), human или agent по настройке имя(итог ИсходВорот), machine имя(вход Тип, итог Тип)[; разбор: примитив[("роль")] -> Тип].
// A party of the kind `machine` is a nested machine (rule 35): the name of the machine of the registry of the caller, the record type of its input, the type of its result and the parse.
type TxKind { kind str, result str, setting str, nested str, input_type str, parse_primitive str, parse_role str, parse_type str }

fn kind_plain(kind str, result str, setting str) -> TxKind => { kind, result, setting, nested: "", input_type: "", parse_primitive: "", parse_role: "", parse_type: "" }

// The name of the nested machine in the registry of the caller: the registry of the host (kind `machine` of `names_host.tsv`), else a Latin name as it is.
fn nested_name(mut cx TxCx, t TxTok) -> str => nested_name_text(cx, t, t.text)

// The same for a name given as a text (a list of the machines in the parameter of a fragment) at the place of a token.
fn nested_name_text(mut cx TxCx, at TxTok, name str) -> str {
    match names_get(cx.names, "machine", name) {
        Some(en) => return en
        None => ()
    }
    if is_identifier_latin(name) { return name }
    cx_error(cx, at, "name", "вложенной машины `${name}` нет в реестре хозяина; латинское имя читается само")
    name
}

fn party_machine(mut p TxP, mut cx TxCx) -> Result[TxKind, TranslateError] {
    ro words = cx.words
    ro n = p_tok(p)
    if n.kind != TK_NAME { return Err(p_fail(p, "после `${kw(words, "kind_party", "machine")}` ожидается имя вызываемой машины")) }
    p_adv(p)
    ro nested = nested_name(cx, n)
    p_expect(p, "(")?
    p_expect_kw(p, words, "kind_party", "input")?
    ro input_type = ty_parse(p, cx)?
    p_expect(p, ",")?
    p_expect_kw(p, words, "kind_party", "result")?
    ro result = ty_parse(p, cx)?
    p_expect(p, ")")?
    mut prim = ""
    mut role = ""
    mut parse_type = ""
    if p_eat(p, ";") {
        p_expect_kw(p, words, "kind_party", "parse")?
        p_expect(p, ":")?
        ro f = p_tok(p)
        if f.kind != TK_NAME { return Err(p_fail(p, "после `${kw(words, "kind_party", "parse")}:` ожидается имя примитива")) }
        p_adv(p)
        prim = tr_primitive(cx, f)
        if p_eat(p, "(") {
            ro r = p_tok(p)
            if r.kind != TK_STR { return Err(p_fail(p, "роль — текст в кавычках")) }
            p_adv(p)
            role = r.text
            p_expect(p, ")")?
        }
        if !tx_arrow(p_tok(p)) { return Err(p_fail(p, "после разбора ожидается `->` и тип его результата")) }
        p_adv(p)
        parse_type = ty_parse(p, cx)?
    }
    p_end(p)?
    Ok(TxKind { kind: "machine", result, setting: "", nested, input_type, parse_primitive: prim, parse_role: role, parse_type })
}

fn party_kind(cell TxCell, line int, mut cx TxCx) -> Result[TxKind, TranslateError] {
    mut p = cell_p(cell, line)?
    ro w = p_tok(p)
    if w.kind != TK_NAME { return Err(p_fail(p, "ожидается вид стороны")) }
    ro words = cx.words
    if p_eat_kw(p, words, "kind_party", "machine") { return party_machine(p, cx) }
    mut setting = ""
    mut kind = ""
    if p_eat_kw(p, words, "kind_party", "human or agent by setting") {
        ro s = p_tok(p)
        if s.kind != TK_NAME { return Err(p_fail(p, "ожидается имя настройки проекта")) }
        p_adv(p)
        setting = decl_json(p, cx, s, "настройки вратаря", "параметры и константы", [s.text])?
        kind = "gatekeeper"
    } else if p_eat_kw(p, words, "kind_party", "agent") {
        kind = "agent"
    } else if p_eat_kw(p, words, "kind_party", "human") {
        kind = "human"
    } else if p_eat_kw(p, words, "kind_party", "enhanced") {
        kind = "enhanced"
    } else {
        return Err(tx_err(w.line, w.col, "syntax", "вид стороны: ${kw(words, "kind_party", "agent")}, ${kw(words, "kind_party", "human")}, ${kw(words, "kind_party", "enhanced")}, ${kw(words, "kind_party", "human or agent by setting")} …, ${kw(words, "kind_party", "machine")}"))
    }
    p_expect(p, "(")?
    p_expect_kw(p, words, "kind_party", "result")?
    mut result = ""
    if kind == "agent" {
        result = ty_parse(p, cx)?
    } else {
        if !p_eat_kw(p, words, "type", "GateOutcome") { return Err(p_fail(p, "у этой стороны итог — `${kw(words, "type", "GateOutcome")}`")) }
    }
    p_expect(p, ")")?
    p_end(p)?
    Ok(kind_plain(kind, result, setting))
}

fn party_row(r TxEntry, mut cx TxCx) -> Result[TxPartyRow, TranslateError] {
    ro n = cell_name(r.cells[0], r.line)?
    ro id = if r.cells[1].text == "—" { "" } else { r.cells[1].text }
    ro k = party_kind(r.cells[2], r.line, cx)?
    ro en = party_en(cx, n, id)
    if pair_has(cx.env.parties, n.text) { return Err(tx_err(n.line, n.col, "name", "сторона `${n.text}` уже объявлена")) }
    pair_add(cx.env.parties, n.text, en)
    mut profile = TxNull
    mut has_profile = false
    if r.cells[3].text != "—" && r.cells[3].text != "" {
        profile = cell_expr(r.cells[3], r.line, cx, sc_empty())?
        has_profile = true
    }
    ro signals = party_signals(r.cells[4], r.line, cx, n.text)?
    mut counter = ""
    if r.cells[5].text == "—" || r.cells[5].text == "" {
        if k.kind != "human" {
            return Err(tx_err(r.line, r.cells[5].col, "structure", "у стороны вида `${k.kind}` счётчик обязателен: `—` (нет значения, свободный ввод, AL-52) допустим только у стороны вида `${kw(cx.words, "kind_party", "human")}`"))
        }
    } else {
        counter = party_counter(r.cells[5], r.line, cx)?
    }
    mut pairs = [kv("name", js(en)), kv("id", js(id)), kv("kind", js(k.kind))]
    if k.nested != "" { pairs.push(kv("nested", js(k.nested))) }
    if k.input_type != "" { pairs.push(kv("input_type", js(k.input_type))) }
    if k.result != "" { pairs.push(kv("result", js(k.result))) }
    if k.parse_primitive != "" {
        mut parse_pairs = [kv("primitive", js(k.parse_primitive))]
        if k.parse_role != "" { parse_pairs.push(kv("role", js(k.parse_role))) }
        parse_pairs.push(kv("type", js(k.parse_type)))
        pairs.push(kv("parse", jobj(parse_pairs)))
    }
    if has_profile { pairs.push(kv("profile", profile)) }
    if k.setting != "" { pairs.push(kv("setting", js(k.setting))) }
    if counter != "" { pairs.push(kv("counter", js(counter))) }
    if signals.len() > 0 { pairs.push(kv("signals", TxArr(signals))) }
    Ok(TxPartyRow { ru: n.text, en, pairs })
}

fn party_columns() -> []str => ["name", "id", "kind", "profile", "signals", "counter"]

fn limit_expression(line TxKv, mut cx TxCx) -> Result[TxJ, TranslateError] {
    mut p = lex_segs(line.segs)?
    ro x = ex_expr(p, cx, sc_empty())?
    p_end(p)?
    Ok(x)
}

/// The line `Предел запросов: выражение` of the section `## Стороны` (format 1, rule 21): the expression, or nothing when the line is not written.
fn decl_request_limit(entries []TxEntry, sec TxSection, mut cx TxCx) -> []TxJ {
    mut out = []TxJ.new()
    mut i = sec.first
    while i < sec.last {
        ro e = entries[i]
        if e.kind == EN_TEXT && kv_colon(e) >= 0 {
            ro line = kv_read(entries, i)
            if line.key == "Request limit" {
                match limit_expression(line, cx) {
                    Ok(x) => { out.push(x) }
                    Err(err) => note(cx, err)
                }
            }
            i += line.taken
        } else {
            i += 1
        }
    }
    out
}

/// The section `## Стороны`: the parties; the line `Предел запросов: …` is read by `decl_request_limit`.
fn decl_parties(entries []TxEntry, sec TxSection, mut cx TxCx) -> []TxPartyRow {
    mut out = []TxPartyRow.new()
    mut i = sec.first
    while i < sec.last {
        ro e = entries[i]
        if e.kind == EN_ROW {
            ro t = tab_read(entries, i, sec.last, party_columns(), cx)
            for r in t.rows {
                cx.rows_total += 1
                ro before = cx.errors.len()
                match party_row(r, cx) {
                    Ok(row) => {
                        out.push(row)
                        cx_place(cx, "$.parties[${out.len() - 1}]", r.line)
                    }
                    Err(err) => note(cx, err)
                }
                if cx.errors.len() > before { cx.rows_noted += 1 }
            }
            i = tab_end(entries, i, sec.last, cx.words)
        } else if e.kind == EN_TEXT && kv_colon(e) >= 0 {
            ro line = kv_read(entries, i)
            if line.key == "Request limit" {
                // read by `decl_request_limit`
                cx.rows_total += 0
            } else {
                note(cx, struct_error(e.line, 1, "в разделе `Стороны` бывают таблица и строка `Предел запросов: …`"))
            }
            i += line.taken
        } else if e.kind == EN_TEXT && e.text == "—" {
            i += 1
        } else {
            note(cx, struct_error(e.line, e.indent + 1, "лишняя строка в разделе `Стороны`"))
            i += 1
        }
    }
    // a party is also called by its id (the identifier of the party is its external name, spec section 1): the text of a fragment says `enhanced`
    mut aliases = []TxPair.new()
    for row in out {
        ro id = party_id_of(row)
        if id != "" && !pair_has(cx.env.parties, id) { aliases.push(TxPair { ru: id, en: row.en }) }
    }
    for al in aliases {
        if !pair_has(cx.env.parties, al.ru) { pair_add(cx.env.parties, al.ru, al.en) }
    }
    out
}

// ---- the signals and the parts of an answer (not in the format: the proposals of section 14 of its changelog) --------------------------------------------

// Fields in a cell: `—` or `поле тип, поле тип`.
fn cell_fields(cell TxCell, line int, mut cx TxCx, what str) -> Result[[]TxJ, TranslateError] {
    mut out = []TxJ.new()
    if cell.text == "—" || cell.text == "" { return Ok(out) }
    mut p = cell_p(cell, line)?
    while !p_done(p) {
        out.push(decl_field(p, cx, what)?)
        if p_eat(p, ",") { continue }
        break
    }
    p_end(p)?
    Ok(out)
}

fn cell_phrase(cell TxCell, line int, mut cx TxCx, what str, space str, prefix []str) -> Result[TxPhrase, TranslateError] {
    mut p = cell_p(cell, line)?
    ro first = p_tok(p)
    ro phrase = ev_phrase(p)?
    mut path = []str.new()
    for x in prefix { path.push(x) }
    path.push(phrase)
    ro json = decl_json_text(p, cx, first, phrase, what, space, path)?
    p_end(p)?
    Ok(TxPhrase { text: phrase, first, json, path })
}

type TxPhrase { text str, first TxTok, json str, path []str }

/// The section `## Сигналы`: `| имя | поля |`; returns the JSON of the signals.
fn decl_signals(entries []TxEntry, sec TxSection, mut cx TxCx) -> []TxJ {
    mut out = []TxJ.new()
    for r in section_table(entries, sec, ["name", "fields"], cx) {
        cx.rows_total += 1
        ro before = cx.errors.len()
        match signal_row(r, cx) {
            Ok(j) => out.push(j)
            Err(err) => note(cx, err)
        }
        if cx.errors.len() > before { cx.rows_noted += 1 }
    }
    out
}

fn signal_row(r TxEntry, mut cx TxCx) -> Result[TxJ, TranslateError] {
    ro ph = cell_phrase(r.cells[0], r.line, cx, "сигнала машины", "сигналы машины", []str.new())?
    ro en = ph.json
    cx.env.owner = ph.text
    cx.env.opath = ph.path
    ro fields = cell_fields(r.cells[1], r.line, cx, "поля сигнала машины")?
    cx.env.owner = ""
    cx.env.opath = []str.new()
    pair_add(cx.env.signals, ph.text, en)
    if fields.len() == 0 { return Ok(jobj([kv("name", js(en))])) }
    Ok(jobj([kv("name", js(en)), kv("fields", TxArr(fields))]))
}

/// TxPartItem: a part of an answer of one party.
type TxPartItem { party_ru str, item TxJ }

/// The section `## Части ответа`: `| сторона | имя | поля |`.
fn decl_parts(entries []TxEntry, sec TxSection, mut cx TxCx) -> []TxPartItem {
    mut out = []TxPartItem.new()
    for r in section_table(entries, sec, ["party", "name", "fields"], cx) {
        cx.rows_total += 1
        ro before = cx.errors.len()
        match part_row(r, cx) {
            Ok(row) => out.push(row)
            Err(err) => note(cx, err)
        }
        if cx.errors.len() > before { cx.rows_noted += 1 }
    }
    out
}

fn part_row(r TxEntry, mut cx TxCx) -> Result[TxPartItem, TranslateError] {
    ro party = cell_name(r.cells[0], r.line)?
    if !pair_has(cx.env.parties, party.text) { cx_error(cx, party, "name", "стороны `${party.text}` нет в таблице «Стороны»") }
    ro ph = cell_phrase(r.cells[1], r.line, cx, "части ответа", "части ответа:${party.text}", [party.text])?
    ro en = ph.json
    cx.env.owner = ph.text
    cx.env.opath = ph.path
    ro fields = cell_fields(r.cells[2], r.line, cx, "поля части ответа")?
    cx.env.owner = ""
    cx.env.opath = []str.new()
    pair_add(cx.env.parts, ph.text, en)
    ro item = if fields.len() == 0 { jobj([kv("name", js(en))]) } else { jobj([kv("name", js(en)), kv("fields", TxArr(fields))]) }
    Ok(TxPartItem { party_ru: party.text, item })
}

// ---- the definitions --------------------------------------------------------------------------------------------------------------------

fn def_segs(entries []TxEntry, sec TxSection, mut cx TxCx) -> []TxSeg {
    mut segs = []TxSeg.new()
    mut i = sec.first
    while i < sec.last {
        ro e = entries[i]
        if e.kind == EN_TEXT {
            if e.text != "—" { segs.push(TxSeg { text: e.text, line: e.line, col: e.indent + 1, code: e.fenced }) }
        } else {
            note(cx, struct_error(e.line, 1, "в разделе `${sec.name}` таблиц нет"))
        }
        i += 1
    }
    segs
}

/// AL-81: the name of a definition or of a primitive is no word of the catalog in either language and is not `range` (the name of the call of a range in the tree); the JSON name is checked too.
fn call_clash(mut cx TxCx, n TxTok, json str) -> () {
    ro ru_words = words_load("ru")
    ro en_words = words_load("en")
    // AL-107: `new_id` (`новый_ид`) is the built-in primitive of the host; it stands in the table of words under the kind `catalog` (section 12) but is no function of the catalog, so the name, as written and as JSON, is not checked
    ro ru_new_id = kw(ru_words, "catalog", "new_id")
    for cand in [n.text, json] {
        if cand == "new_id" || cand == ru_new_id { continue }
        if cand == "range" || kw_has(ru_words, "catalog", cand) || kw_has(en_words, "catalog", cand) {
            cx_error(cx, n, "check", "имя `${cand}` совпадает с функцией каталога (AL-81): определение и примитив называются иначе, чем `фильтр`/`filter`, `склеить`/`concat`, `range` и другие функции каталога")
            return
        }
    }
}

/// The names of the functions are known before the bodies are read (a function may call one that comes later).
fn defs_register(entries []TxEntry, sec TxSection, mut cx TxCx) -> () {
    ro segs = def_segs(entries, sec, cx)
    match lex_segs(segs) {
        Ok(p0) => {
            mut k = 0
            while k + 1 < p0.toks.len() {
                if t_is_kw(p0.toks[k], cx.words, "decl", "fn") && p0.toks[k + 1].kind == TK_NAME {
                    ro n = p0.toks[k + 1]
                    ro en = decl_internal(cx, n)
                    call_clash(cx, n, en)
                    if pair_has(cx.env.defs, n.text) {
                        cx_error(cx, n, "name", "функция `${n.text}` повторена")
                    } else {
                        pair_add(cx.env.defs, n.text, en)
                    }
                }
                k += 1
            }
        }
        Err(e) => note(cx, e)
    }
}

// One function after `функция` (AL-83): `имя(арг тип, …) -> тип => выр` or `имя(арг тип, …) -> тип { пусть …; выр }` (AL-67, AL-84).
fn def_one(mut p TxP, mut cx TxCx) -> Result[TxJ, TranslateError] {
    ro n = p_tok(p)
    if n.kind != TK_NAME { return Err(p_fail(p, "после `${kw(cx.words, "decl", "fn")}` ожидается имя")) }
    p_adv(p)
    ro en = match pair_get(cx.env.defs, n.text) {
        Some(x) => x
        None => n.text
    }
    p_expect(p, "(")?
    mut params = []TxJ.new()
    mut scope = sc_empty()
    while !p_is(p, ")") {
        ro a = p_tok(p)
        if a.kind != TK_NAME { return Err(p_fail(p, "ожидается имя параметра")) }
        p_adv(p)
        ro a_en = tr_binder(cx, a)
        if pair_has(scope.names, a.text) { cx_error(cx, a, "name", "параметр `${a.text}` повторён") }
        ro type_text = ty_parse(p, cx)?
        params.push(jobj([kv("name", js(a_en)), kv("type", js(type_text))]))
        scope = sc_with(scope, a.text, a_en)
        if p_eat(p, ",") { continue }
        break
    }
    p_expect(p, ")")?
    if !tx_arrow(p_tok(p)) { return Err(p_fail(p, "после параметров ожидается `->` и тип результата")) }
    p_adv(p)
    ro result = ty_parse(p, cx)?
    mut body = x_null()
    if tx_fat(p_tok(p)) {
        ro fat = p_tok(p)
        p_adv(p)
        if p_is(p, "{") { return Err(tx_err(fat.line, fat.col, "syntax", "`=> {` после заголовка функции в формате 2.22 не бывает (AL-84): тело — выражение после `=>` или блок `{ … }` без `=>`; запись как всё тело пишется в скобках `=> ({ ...r, поле: выр })`; переходного периода нет")) }
        body = ex_expr(p, cx, scope)?
    } else if p_is(p, "{") {
        body = ex_block(p, cx, scope)?
    } else if p_is(p, "=") {
        return Err(tx_err(p_tok(p).line, p_tok(p).col, "syntax", "знак `=` перед телом функции в формате 2.22 не бывает: пишется `=>` (AL-67) или блок `{ … }` (AL-84); переходного периода нет"))
    } else {
        return Err(p_fail(p, "после типа результата ожидается `=>` и выражение или блок `{ … }`"))
    }
    Ok(jobj([kv("name", js(en)), kv("params", TxArr(params)), kv("result", js(result)), kv("body", body)]))
}

/// The section `## Функции`: `функция имя(арг тип, …) -> тип => выр` or with a block body (AL-83, AL-84).
fn decl_definitions(entries []TxEntry, sec TxSection, mut cx TxCx) -> []TxJ {
    mut out = []TxJ.new()
    ro segs = def_segs(entries, sec, cx)
    match lex_segs(segs) {
        Ok(p0) => {
            mut p = p_copy(p0)
            while !p_done(p) {
                ro head = p_tok(p)
                if !t_is_kw(head, cx.words, "decl", "fn") {
                    match former_find(cx.words.lang, "decl", head.text) {
                        Some(f) => note(cx, tx_err(head.line, head.col, "syntax", former_message(f)))
                        None => note(cx, tx_err(head.line, head.col, "syntax", "ожидается `${kw(cx.words, "decl", "fn")}`, найдено: ${t_shown(head)}"))
                    }
                    p_adv(p)
                    while !p_done(p) && !(p_is_kw(p, cx.words, "decl", "fn") || (p_tok(p).col == 1 && p_tok(p).kind == TK_NAME && former_is(cx.words.lang, "decl", p_tok(p).text))) { p_adv(p) }
                    continue
                }
                p_adv(p)
                cx.rows_total += 1
                ro before = cx.errors.len()
                match def_one(p, cx) {
                    Ok(j) => {
                        out.push(j)
                        cx_place(cx, "$.definitions[${out.len() - 1}]", head.line)
                    }
                    Err(e) => {
                        note(cx, e)
                        while !p_done(p) && !p_is_kw(p, cx.words, "decl", "fn") { p_adv(p) }
                    }
                }
                if cx.errors.len() > before { cx.rows_noted += 1 }
            }
        }
        Err(e) => note(cx, e)
    }
    out
}

// ---- the primitives ---------------------------------------------------------------------------------------------------------------------

/// The keys of the classes of a primitive of the host (AL-115); the words of a file are `kw(.., "enum_value", key)`: `pure`, `изменчивая`, `действующая` in a Russian file and `pure`, `volatile`, `acting` in an English one.
fn primitive_classes() -> []str => ["pure", "volatile", "acting"]

fn prim_row(r TxEntry, mut cx TxCx) -> Result[str, TranslateError] {
    ro d = cell_decl_json(r.cells[0], r.line, cx, "примитива", "примитивы")?
    ro class_cell = r.cells[3]
    ro class_key = kw_key(cx.words, "enum_value", class_cell.text) ?? ""
    if !primitive_classes().contains(class_key) {
        match former_find(cx.words.lang, "class", class_cell.text) {
            Some(f) => return Err(tx_err(r.line, class_cell.col, "syntax", former_message(f)))
            None => ()
        }
        return Err(tx_err(r.line, class_cell.col, "syntax", "класс примитива: ${kw_all(cx.words, "enum_value", primitive_classes()).join(", ")}"))
    }
    call_clash(cx, d.tok, d.json)
    pair_add(cx.env.prims, d.tok.text, d.json)
    Ok(d.json)
}

/// The section `## Примитивы`: the names of the primitives (the host's registry has their signatures).
fn decl_primitives(entries []TxEntry, sec TxSection, mut cx TxCx) -> []str {
    mut out = []str.new()
    for r in section_table(entries, sec, ["name", "parameters", "result", "class", "reads", "writes"], cx) {
        cx.rows_total += 1
        ro before = cx.errors.len()
        match prim_row(r, cx) {
            Ok(en) => {
                if !out.contains(en) { out.push(en) }
            }
            Err(e) => note(cx, e)
        }
        if cx.errors.len() > before { cx.rows_noted += 1 }
    }
    out
}
