// marker_test.nv - the optional list marker `- ` before a line `Ключ: значение` (format 2.6): with and without it the JSON is the same, the columns of the
// errors stay the columns of the file.
module alula.machine_text

import std.text

fn pieces(text str, sep str) -> []str {
    mut out = []str.new()
    for p in text.split(sep) { out.push(p) }
    out
}

// The text with the marker put before the line that starts with the given text.
fn marked(text str, start str) -> str => text.replace("\n${start}", "\n- ${start}")

fn json_of(text str) -> str => checked(text).json

test "mk each key" {
    ro plain = json_of(tiny_text())
    assert(plain.byte_len() > 100)
    assert(json_of(marked(tiny_text(), "machine: ")) == plain)
    assert(json_of(marked(tiny_text(), "Начальное состояние: ")) == plain)
    assert(json_of(marked(tiny_text(), "Сторона: ")) == plain)
    assert(json_of(marked(tiny_text(), "Запрос:")) == plain)
    assert(json_of(marked(tiny_text(), "Читает: ")) == plain)
    assert(json_of(marked(tiny_text(), "Кроме: ")) == plain)
    assert(json_of(marked(tiny_text(), "Результат: ")) == plain)
}

test "mk all and mixed" {
    ro plain = json_of(tiny_text())
    mut all = tiny_text()
    for key in ["machine: ", "machine_version: ", "format: ", "Начальное состояние: ", "Сторона: ", "Запрос:", "Читает: ", "Кроме: ", "Результат: "] {
        all = marked(all, key)
    }
    assert(all != tiny_text())
    assert(json_of(all) == plain)
    ro mixed = marked(marked(marked(tiny_text(), "Сторона: "), "Запрос:"), "Результат: ")
    assert(json_of(mixed) == plain)
    assert(checked(all).errors.len() == 0)
}

test "mk wide marker" {
    ro plain = json_of(tiny_text())
    assert(json_of(tiny_text().replace("\nСторона: ", "\n-   Сторона: ")) == plain)
}

test "mk table after list" {
    ro plain = json_of(tiny_text())
    ro text = tiny_text().replace("\nЗапрос:\n\n|", "\n- Запрос:\n\n|")
    assert(text != tiny_text())
    assert(json_of(text) == plain)
    ro tight = tiny_text().replace("\nЗапрос:\n\n|", "\n- Запрос:\n|")
    assert(json_of(tight) == plain)
}

test "mk columns" {
    // the key line `Сторона:` names a party that the table does not have: the note stands at the name, with and without the marker (two letters further)
    ro bad = tiny_text().replace("Сторона: вратарь", "Сторона: нет_такого_имени")
    ro bad_marked = bad.replace("\nСторона: ", "\n- Сторона: ")
    ro at = line_in(bad, "Сторона: нет_такого_имени")
    assert(name_note(bad) == "${at}:10")
    assert(name_note(bad_marked) == "${at}:12")
}

// The number of the line (1-based) that starts with the text.
fn line_in(text str, start str) -> int {
    mut no = 0
    for line in text.split("\n") {
        no += 1
        if line.starts_with(start) { return no }
    }
    -1
}

// The place of the first note of the kind `name`.
fn name_note(text str) -> str {
    for n in notes(text) {
        ro parts = pieces(n, " ")
        if parts.len() > 1 && parts[1] == "name" { return parts[0] }
    }
    ""
}

test "mk not a key" {
    ro text = tiny_text().replace("\nСторона: вратарь", "\n- Прочее: вратарь\nСторона: вратарь")
    assert(note_says(text, "лишняя строка"))
}

test "mk nested list" {
    ro flat = tiny_text().replace("\n### РЕШИТЬ — развилка\nЧитает: число_ходов\n", "\n### РЕШИТЬ — развилка\nЧитает: число_ходов\nПри входе: пусть к = число_ходов + 1;\n           пусть м = к + 1\n")
    ro nested = tiny_text().replace("\n### РЕШИТЬ — развилка\nЧитает: число_ходов\n", "\n### РЕШИТЬ — развилка\n- Читает: число_ходов\n- При входе:\n  - пусть к = число_ходов + 1;\n  - пусть м = к + 1\n")
    assert(flat != tiny_text() && nested != tiny_text())
    assert(checked(flat).errors.len() == 0)
    assert(json_of(nested) == json_of(flat))
    ro one = tiny_text().replace("\n### РЕШИТЬ — развилка\nЧитает: число_ходов\n", "\n### РЕШИТЬ — развилка\n- Читает: число_ходов\n- При входе: пусть к = число_ходов + 1\n")
    assert(checked(one).errors.len() == 0)
}

test "mk nested columns" {
    ro text = tiny_text().replace("\n### РЕШИТЬ — развилка\nЧитает: число_ходов\n", "\n### РЕШИТЬ — развилка\n- Читает: число_ходов\n- При входе:\n  - пусть к = нет_такого + 1\n")
    assert(name_note(text).ends_with(":15"))
}

test "mk format 2.23" {
    ro report = checked(tiny_text())
    assert(report.errors.len() == 0)
    assert(report.json.starts_with("{\"format\":\"machine/2\",\"alula_version\":\"2.23\",\"machine\":\"Tiny\""))
    assert(note_says(tiny_text().replace("format: 2.23", "format: 2.11"), "читает формат 2.23"))
}

test "mk format 2.12 and 2.13 are refused" {
    assert(note_says(tiny_text().replace("format: 2.23", "format: 2.12"), "формат 2.12: версия не известна переводчику, он читает формат 2.23"))
    assert(note_says(tiny_text().replace("format: 2.23", "format: 2.13"), "формат 2.13: версия не известна переводчику, он читает формат 2.23"))
    assert(note_says(tiny_text().replace("format: 2.23", "format: 2.12"), "переходного периода нет"))
}
