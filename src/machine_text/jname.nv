// jname.nv - the JSON names of the names that a file declares (task 151, format 2.17, AL-53 ... AL-62). STUB of the red probe: the signatures that the tests of the probe compile against.
module alula.machine_text

import std.text
import std.collections.hash_map.{HashMap}

/// JsonName: a name that leaves the machine with its JSON name: the line of the declaration, the kind of the declaration, the name as written, the path (`Тип.Вариант.поле`) and the JSON name.
export type JsonName { line int, where str, name str, path str, json str }

/// The names that leave the machine, with their JSON names.
export fn translate_names(file_text str) -> []JsonName => []JsonName.new()

type TxGlossary { names HashMap[str, str] }

fn glossary_table_text() -> str => ""

fn glossary_hash_text(tsv str) -> str => ""

fn glossary_markdown_pairs(md str) -> str => ""

fn glossary_pinned_hash(format str) -> str => ""

fn glossary_check() -> str => "stub"

fn glossary_check_text(tsv str, format str) -> str => "stub"

fn glossary_load() -> TxGlossary => { names: HashMap[str, str].new() }

fn glossary_get(g TxGlossary, name str) -> str => ""

fn jn_translit(word str) -> str => word

fn jn_auto(name str, pascal bool, g TxGlossary) -> str => name

fn jn_mixed(name str) -> str => ""
