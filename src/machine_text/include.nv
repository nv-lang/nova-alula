// include.nv - the section `## Подключения` of a file of 2.25 (the files of definitions `функции: имя версия N хеш H`, read by `defs_includes`) and the signals of the call
// protocol that a library brings (section 9). A library of 2.26 is connected by its file only (`### Имя` with `- Файл:`, library.nv); the old call `Пауза(…)` is an error.
module alula.machine_text

fn only_connections(e TxEntry) -> TranslateError => tx_err(e.line, e.indent + 1, "structure", "в разделе `Подключения` только строки подключения `определения: имя версия N хеш H` (проза и список сюда не пишутся)")

/// The section `## Подключения` of a file of 2.25: the lines of the files of definitions are for `defs_includes`; an old call `Имя(…)` is the error with the hint of the
/// library (since 0.9.1 a library is connected by its file only, section 9); anything else (prose, a list, a table, a heading, a key of a state) is an error (format 2.7, P-2).
fn includes_225_check(entries []TxEntry, sec TxSection, mut cx TxCx) -> () {
    mut in_table = false
    mut i = sec.first
    while i < sec.last {
        ro e = entries[i]
        if e.kind == EN_TEXT && e.indent == 0 && kv_colon(e) < 0 && e.text == "—" {
            i += 1
        } else if e.kind == EN_TEXT && e.indent == 0 && kv_colon(e) < 0 && is_call_start(e.text) {
            in_table = false
            note(cx, tx_err(e.line, 1, "structure", lib_old_message(lib_cut(e.text))))
            mut k = i + 1
            while k < sec.last && entries[k].kind == EN_TEXT && entries[k].indent > 0 { k += 1 }
            i = k
        } else if e.kind == EN_TEXT && e.indent == 0 && kv_colon(e) >= 0 {
            ro line = kv_read(entries, i)
            if line.key != "functions" { note(cx, only_connections(e)) }
            in_table = false
            i += line.taken
        } else if e.kind == EN_ROW {
            if !in_table { note(cx, only_connections(e)) }
            in_table = true
            i += 1
        } else {
            in_table = false
            note(cx, only_connections(e))
            i += 1
        }
    }
}

// ---- the signals of the protocol -----------------------------------------------------------------------------------------------------------

/// TxProto: a signal of the call protocol that a library reads: the Latin name of the JSON and the Latin names of its fields (the texts).
type TxProto { en str, fields []str }

fn protocol_signals() -> []TxProto => [
    TxProto { en: "human_stop", fields: ["human_word", "author", "source"] },
    TxProto { en: "parent_stop", fields: ["id"] },
    TxProto { en: "cancel_request", fields: ["id"] },
    TxProto { en: "parent_continue", fields: ["id"] },
    TxProto { en: "parent_halt", fields: ["id"] }
]

// The word of the language of the file for a Latin name of the host registry (the kind `signal`): the Russian phrase of the library, the Latin name itself in an English file.
fn proto_word(cx TxCx, en str) -> str {
    match names_file_word(cx.names, "signal", en) {
        Some(x) => x
        None => en
    }
}

// The word of a field of a signal of the protocol in the language of the file (the kind `signal_field`).
fn proto_field_word(cx TxCx, en str) -> str {
    match names_file_word(cx.names, "signal_field", en) {
        Some(x) => x
        None => en
    }
}

/// The signals of the protocol put into the environment; returns their JSON (the fields are texts).
fn protocol_signals_json(mut cx TxCx) -> []TxJ {
    mut out = []TxJ.new()
    // `continue` is declared by the party that the library names (the machine writes its fields), the library reads it by the word of the registry
    pair_add(cx.env.signals, proto_word(cx, "continue"), "continue")
    for s in protocol_signals() {
        pair_add(cx.env.signals, proto_word(cx, s.en), s.en)
        // the signals of the protocol are signals of the machine: their JSON names are the registry's, no row changes them, they are in the space of the signals of the machine (AL-58)
        jn_declare_fixed(cx, 0, 0, proto_word(cx, s.en), "сигнала машины", "сигналы машины", [s.en], s.en)
        mut fields = []TxJ.new()
        for f in s.fields {
            fields.push(jobj([kv("name", js(f)), kv("type", js("text"))]))
            ro f_word = proto_field_word(cx, f)
            if !pair_has(cx.env.fields, f_word) { pair_add(cx.env.fields, f_word, f) }
        }
        out.push(jobj([kv("name", js(s.en)), kv("fields", TxArr(fields))]))
    }
    out
}
