// event.nv - the events of the rows of an appeal and of "On accept" (format 4.3), the conditions and the "Where" of a row.
//
// Events: `ответ`, `ответ(имя)`, `ответ: Вариант(поле, поле: имя)`, `ответ: Тип.Вариант(…)`, `сбой`, `сбой(причина)`, `сбой(причина ∈ {КодСбоя.…})`,
// `слово(слово(поле, поле: имя))`, `сигнал(сигнал(поле, …))`, `сразу`. Two events are not in the format (the proposals of its section 14, И-4) and the
// interpreter has them: `часть(имя(поле: имя))` for a part of an answer that keeps the request open, and `срок` for the term made by the executor.
module alula.machine_text

// ORACLE-WORKAROUND(32): `import std.text` is needed in `nova build` for `[]str.join` (a `nova test` build has it already); drop the import when item 32 is fixed
import std.text

/// TxEvent: the JSON of the event and the scope with the names that it binds.
type TxEvent { json TxJ, scope TxScope }

fn ev_json(kind str, rest []TxKV) -> TxJ {
    mut pairs = [kv("kind", js(kind))]
    for r in rest { pairs.push(r) }
    jobj(pairs)
}

// A phrase of words (`остановить совещание`, `стоп человека`) up to a `(`, `)` or the end; the words are joined by a space.
fn ev_phrase(mut p TxP) -> Result[str, TranslateError] {
    mut words = []str.new()
    while p_tok(p).kind == TK_NAME {
        words.push(p_tok(p).text)
        p_adv(p)
    }
    if words.len() == 0 { return Err(p_fail(p, "ожидается слово")) }
    Ok(words.join(" "))
}

// The binds `(поле, поле: имя)` of an event; no parentheses is no binds.
fn ev_binds(mut p TxP, mut cx TxCx, sc TxScope, kinds []str) -> Result[TxBinds, TranslateError] {
    ex_pattern_binds(p, cx, sc, kinds)
}

fn ev_bind_object(binds TxBinds) -> TxKV => kv("bind", TxObj(binds.pairs))

fn ev_with_binds(kind str, name_key str, name str, binds TxBinds) -> TxJ {
    mut rest = [kv(name_key, js(name))]
    if binds.pairs.len() > 0 { rest.push(ev_bind_object(binds)) }
    ev_json(kind, rest)
}

fn ev_one_name(mut p TxP, mut cx TxCx, pairs []TxPair, what str) -> Result[TxTok, TranslateError] {
    ro t = p_tok(p)
    if t.kind != TK_NAME { return Err(p_fail(p, "ожидается ${what}")) }
    Ok(t)
}

fn ev_word_en(mut cx TxCx, t TxTok, ru str, known []TxPair, kind str, what str) -> str {
    match pair_get(known, ru) {
        Some(en) => en
        None => {
            match names_get(cx.names, kind, ru) {
                Some(en) => en
                None => {
                    cx_error(cx, t, "name", "${what} `${ru}` не объявлено в этой машине${names_hint(cx.names, [kind], ru)}")
                    ru
                }
            }
        }
    }
}

/// The event of a row of an appeal (or of "On accept"). `sc` is the scope outside the row.
fn ev_parse(mut p TxP, mut cx TxCx, sc TxScope) -> Result[TxEvent, TranslateError] {
    ro t = p_tok(p)
    if t.kind != TK_NAME { return Err(p_fail(p, "ожидается событие")) }
    p_adv(p)
    ro w = t.text
    ro words = cx.words
    if t_is_kw(t, words, "event", "immediate") { return Ok(TxEvent { json: ev_json("now", []), scope: sc }) }
    if t_is_kw(t, words, "event", "deadline") { return Ok(TxEvent { json: ev_json("timeout", []), scope: sc }) }
    if t_is_kw(t, words, "event", "response") { return ev_answer(p, cx, sc) }
    if t_is_kw(t, words, "event", "failure") { return ev_failure(p, cx, sc) }
    if t_is_kw(t, words, "event", "word") { return ev_named(p, cx, sc, "word") }
    if t_is_kw(t, words, "event", "signal") { return ev_named(p, cx, sc, "signal") }
    if t_is_kw(t, words, "event", "part") { return ev_named(p, cx, sc, "part") }
    match foreign_find(cx, t, ["event"]) {
        Some(e) => return Err(e)
        None => ()
    }
    Err(tx_err(t.line, t.col, "syntax", "неизвестное событие `${w}`: ожидается ${kw_all(words, "event", ["response", "failure", "word", "signal", "immediate"]).join(", ")}"))
}

fn ev_answer(mut p TxP, mut cx TxCx, sc TxScope) -> Result[TxEvent, TranslateError] {
    if p_eat(p, ":") {
        ro first = p_tok(p)
        if first.kind != TK_NAME { return Err(p_fail(p, "после `ответ:` ожидается вариант")) }
        p_adv(p)
        mut case_en = ""
        if p_is(p, ".") && p_ahead(p, 1).kind == TK_NAME {
            p_adv(p)
            ro second = p_tok(p)
            p_adv(p)
            case_en = tr_case_name(cx, second)
        } else {
            case_en = tr_case_name(cx, first)
        }
        ro binds = ev_binds(p, cx, sc, kinds_field())?
        mut rest = [kv("variant", js(case_en))]
        if binds.pairs.len() > 0 { rest.push(ev_bind_object(binds)) }
        return Ok(TxEvent { json: ev_json("answer_variant", rest), scope: binds.scope })
    }
    if p_eat(p, "(") {
        ro n = p_tok(p)
        if n.kind != TK_NAME { return Err(p_fail(p, "в скобках `ответ(…)` ожидается имя")) }
        p_adv(p)
        p_expect(p, ")")?
        ro en = tr_binder(cx, n)
        return Ok(TxEvent { json: ev_json("answer", [kv("bind", js(en))]), scope: sc_with(sc, n.text, en) })
    }
    Ok(TxEvent { json: ev_json("answer", []), scope: sc })
}

// A reason of a failure: `КодСбоя.Case` or `Case`; returns the English case.
fn ev_reason(mut p TxP, mut cx TxCx) -> Result[str, TranslateError] {
    ro first = p_tok(p)
    if first.kind != TK_NAME { return Err(p_fail(p, "ожидается код сбоя")) }
    p_adv(p)
    if p_is(p, ".") && p_ahead(p, 1).kind == TK_NAME {
        p_adv(p)
        ro c = p_tok(p)
        p_adv(p)
        return Ok(tr_case_name(cx, c))
    }
    Ok(tr_case_name(cx, first))
}

fn ev_failure(mut p TxP, mut cx TxCx, sc TxScope) -> Result[TxEvent, TranslateError] {
    if !p_eat(p, "(") { return Ok(TxEvent { json: ev_json("failure", []), scope: sc }) }
    ro n = p_tok(p)
    if n.kind != TK_NAME { return Err(p_fail(p, "в скобках `сбой(…)` ожидается имя")) }
    p_adv(p)
    ro en = tr_binder(cx, n)
    mut reasons = []str.new()
    if is_member_sign(p, cx.words) {
        p_adv(p)
        p_expect(p, "{")?
        while true {
            reasons.push(ev_reason(p, cx)?)
            if p_eat(p, ",") { continue }
            break
        }
        p_expect(p, "}")?
    }
    p_expect(p, ")")?
    mut rest = []TxKV.new()
    if reasons.len() > 0 { rest.push(kv("reasons", jstrs(reasons))) }
    // `_` names no value: the event binds nothing (the tree of a failure with a set of reasons and no name)
    if en == "_" { return Ok(TxEvent { json: ev_json("failure", rest), scope: sc }) }
    rest.push(kv("bind", js(en)))
    Ok(TxEvent { json: ev_json("failure", rest), scope: sc_with(sc, n.text, en) })
}

// `слово(слово(поле, …))`, `сигнал(сигнал(поле, …))`, `часть(имя(поле, …))`; `head` is the key of the event word: `word`, `signal`, `part`.
fn ev_named(mut p TxP, mut cx TxCx, sc TxScope, head str) -> Result[TxEvent, TranslateError] {
    p_expect(p, "(")?
    ro first = p_tok(p)
    ro phrase = ev_phrase(p)?
    mut kinds = kinds_field()
    mut en = ""
    mut kind_word = "word"
    if head == "word" {
        en = ev_word_en(cx, first, phrase, cx.env.words, "word", kw(cx.words, "event", "word"))
    } else if head == "signal" {
        kinds = ["signal_field", "field", "data", "variable"]
        kind_word = "signal"
        en = ev_word_en(cx, first, phrase, cx.env.signals, "signal", kw(cx.words, "event", "signal"))
    } else {
        kind_word = "progress"
        en = ev_word_en(cx, first, phrase, cx.env.parts, "part", kw(cx.words, "event", "part"))
    }
    ro binds = ev_binds(p, cx, sc, kinds)?
    p_expect(p, ")")?
    if head == "word" { return Ok(TxEvent { json: ev_with_binds("word", "word", en, binds), scope: binds.scope }) }
    Ok(TxEvent { json: ev_with_binds(kind_word, "name", en, binds), scope: binds.scope })
}

// ---- the condition and the "Where" ---------------------------------------------------------------------------------------------------

/// TxCond: the condition of a row: none (`—`), `иначе`, or an expression.
type TxCond { has_expr bool, is_else bool, expr TxJ }

fn cond_parse(mut p TxP, mut cx TxCx, sc TxScope) -> Result[TxCond, TranslateError] {
    if p_done(p) || (p_is(p, "—") && p_tok(p).kind == TK_SYM) {
        if !p_done(p) { p_adv(p) }
        return Ok(TxCond { has_expr: false, is_else: false, expr: x_null() })
    }
    if p_eat_kw(p, cx.words, "event", "else") { return Ok(TxCond { has_expr: false, is_else: true, expr: x_null() }) }
    ro e = ex_expr(p, cx, sc)?
    Ok(TxCond { has_expr: true, is_else: false, expr: e })
}

/// TxWhere: the "Where" of a row: the JSON name (`@previous`, `@same`, a state) or none, and the restart mark.
type TxWhere { to str, restart bool }

fn where_parse(mut p TxP, mut cx TxCx) -> Result[TxWhere, TranslateError] {
    ro t = p_tok(p)
    mut to = ""
    if t.kind == TK_SYM && t.text == "—" {
        p_adv(p)
    } else if t.kind == TK_NAME {
        if p_eat_kw(p, cx.words, "destination", "previous") {
            to = "@previous"
        } else if p_eat_kw(p, cx.words, "destination", "preparation_return") {
            to = "@prepare_return"
        } else if p_eat_kw(p, cx.words, "destination", "same") {
            to = "@same"
        } else {
            p_adv(p)
            match pair_get(cx.env.states, t.text) {
                Some(latin) => { to = latin }
                None => {
                    cx_error(cx, t, "name", "состояния `${t.text}` нет в этой машине${state_hint(cx, t.text)}")
                    to = t.text
                }
            }
        }
    } else {
        return Err(p_fail(p, "ожидается состояние, `предыдущее`, `то же` или `—`"))
    }
    mut restart = false
    if p_eat(p, ",") {
        if p_eat_kw(p, cx.words, "destination", "rerun") {
            restart = true
        } else {
            return Err(p_fail(p, "после запятой ожидается `${kw(cx.words, "destination", "rerun")}`"))
        }
    }
    Ok(TxWhere { to, restart })
}

fn state_hint(cx TxCx, ru str) -> str {
    ro word []char = ru.chars().collect()
    mut best = ""
    mut best_distance = 1000
    for pair in cx.env.states {
        ro d = tx_distance_chars(word, pair.ru.chars().collect())
        if d < best_distance {
            best_distance = d
            best = pair.ru
        }
    }
    ro limit = if word.len() / 3 > 2 { word.len() / 3 } else { 2 }
    if best != "" && best_distance <= limit { return "; возможно, `${best}`" }
    ""
}
