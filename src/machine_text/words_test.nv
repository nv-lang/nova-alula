type NamedText2 { name str, text str }

fn word_user_marks() -> []str => ["kw(", "p_is_kw(", "p_eat_kw(", "p_expect_kw(", "t_is_kw(", "kw_key(", "kw_foreign("]

// The literals of a line, the content of each "…" without the escapes read.
fn line_literals(line str) -> []str {
    mut out = []str.new()
    ro n = line.byte_len()
    mut i = 0
    while i < n {
        ro c = tx_at(line, i)
        if c == '/' && line[i + 1..].starts_with("/") { break }
        if c == '"' {
            mut j = i + 1
            mut parts = []str.new()
            while j < n && tx_at(line, j) != '"' {
                ro d = tx_at(line, j)
                if d == '\\' && j + 1 < n {
                    ro e = tx_at(line, j + 1)
                    parts.push(line[j + 1..j + 1 + e.len_utf8()])
                    j += 1 + e.len_utf8()
                    continue
                }
                parts.push(line[j..j + d.len_utf8()])
                j += d.len_utf8()
            }
            out.push(parts.join(""))
            i = j + 1
            continue
        }
        i += c.len_utf8()
    }
    out
}

fn is_cyrillic_text(s str) -> bool {
    for c in s.chars() {
        ro cp = c as int
        if cp >= 1024 && cp <= 1279 { return true }
    }
    false
}

test "wt asked words exist" {
    ro rows = words_rows()
    mut asked = 0
    for f in source_files() {
        for line in f.text.split("\n") {
            mut uses = false
            for m in word_user_marks() {
                if line.contains(m) { uses = true }
            }
            if !uses || line.trim_ascii().starts_with("//") { continue }
            ro lits = line_literals(line)
            mut i = 0
            while i + 1 < lits.len() {
                if all_kinds().contains(lits[i]) || lits[i] == "fragment" || lits[i] == "fragment_param" {
                    // `"kind", "key"`: the pair is looked up; a list `"kind", [...]` is read by kw_all below
                    if has_row(rows, lits[i], lits[i + 1]) {
                        asked += 1
                        i += 1
                    }
                }
                i += 1
            }
        }
    }
    assert(asked > 60)
}

test "wt every key listed" {
    ro rows = words_rows()
    for k in line_keys() { assert(has_row(rows, "key", k)) }
    for k in header_keys() { assert(has_row(rows, "header", k)) }
    for k in section_keys() { assert(has_row(rows, "section", k)) }
    for k in pause_param_keys() { assert(has_row(rows, "fragment_param", k)) }
    for k in ["rows", "mechanics", "rows_and_mechanics", "fragment", "rows_and_fragment", "party", "executor", "yes", "nothing", "requests_from_to_send", "without_return_to_send", "stop_transport_turn"] {
        assert(has_row(rows, "enum_value", k))
    }
    for k in ["column"] { assert(kind_count(rows, k) > 0) }
    for k in ["№", "Event", "Condition", "Actions", "To", "event", "actions", "request_field", "expression", "reads", "end", "response", "when", "name", "type", "value", "default", "project_override", "note", "initial", "non_decreasing", "writes", "id", "kind", "profile", "signals", "allowed_values", "counter", "parameters", "result", "class", "fields", "party"] {
        assert(has_row(rows, "column", k))
    }
}

// ---- no Cyrillic word of the structure in the code of the translator -----------------------------------------------

// A line may hold a Cyrillic literal when the literal is (a piece of) the message of an error, or a letter of the alphabet.
fn allowed_marks() -> []str => [
    "why:", "ro message_", "ro form_what =", "ro form_space =", "fn former_message(", "p_fail(", "tx_err(", "struct_error(", "cx_error(", "cx_unsupported(", "unsupported(", "note(", "cls_flush(", "foreign_error(", "Err(", "message:",
    "jn_peek(", "jn_declare(", "jn_declare_fixed(", "jn_declare_internal(", "decl_name(", "decl_exported(", "fn is_expansion_heading(", "cell_decl_json(", "decl_json(", "decl_json_text(", "ev_phrase_json(", "cell_phrase(", "cell_fields(", "\"слова ворот\"", "t.text == \"слово\"", "\"слово_остановки\"", "t.text == \"нет\"", "не объявлено в этой машине", "\"знак `",  "\"ключ `", "decl_fields(", "decl_internal(", "decl_field(", "tr_word(", "tr_word_f(", "decl_name_phrase(", "decl_name_phrase_in(", "ro message =", "ro why =", "ro shown =", "возможно", "конец текста", "строку", "фрагменты не подключены", "подключён:",
    "английский", "русский", "найдено", "\"а=a\"", "\"ф=f\""
]

fn cyrillic_offenders() -> []str {
    mut out = []str.new()
    for f in source_files() {
        mut no = 0
        for line in f.text.split("\n") {
            no += 1
            if line.trim_ascii().starts_with("//") { continue }
            mut cyr = false
            for lit in line_literals(line) {
                if is_cyrillic_text(lit) { cyr = true }
            }
            if !cyr { continue }
            mut ok = false
            for m in allowed_marks() {
                if line.contains(m) { ok = true }
            }
            if !ok { out.push("${f.name}:${no}: ${line.trim_ascii()}") }
        }
    }
    out
}

test "wt no cyrillic words" {
    ro bad = cyrillic_offenders()
    if bad.len() > 0 { panic(bad[0]) }
    assert(bad.len() == 0)
}

test "wt lint sees a word" {
    assert(is_cyrillic_text("если"))
    assert(!is_cyrillic_text("if"))
    assert(line_literals("ro w = \"если\" // \"нет\"").len() == 1)
    assert(line_literals("f(\"a\", \"b\\\"c\")").len() == 2)
}

// ---- the names of an English file -------------------------------------------------------------------------------------------

// ---- the language of a file -----------------------------------------------------------------------------------------------

fn lines_in(text str) -> []str => lines_of(text)

test "wt lang default" {
    ro info = detect_language(lines_in("# Машина: М\n\n- machine: m\n- format: 2.22\n\n## Типы\n—\n"))
    assert(info.lang == "ru")
    assert(info.version == "2.22")
    assert(info.strict)
    assert(info.errors.len() == 0)
    assert(!detect_language(lines_in("# Машина: М\n\nmachine: m\nformat: 2.5\n")).strict)
}

test "wt lang declared" {
    ro en = detect_language(lines_in("# Machine: M\n\n- machine: m\n- format: 2.22\n- language: en\n\n## Types\n—\n"))
    assert(en.lang == "en")
    assert(en.errors.len() == 0)
    assert(en.strict)
    ro ru = detect_language(lines_in("# Машина: М\n\n- machine: m\n- format: 2.22\n- language: ru\n"))
    assert(ru.lang == "ru")
    assert(ru.errors.len() == 0)
    ro defs = detect_language(lines_in("# Functions: d\n\n- functions_version: 1\n- format: 2.22\n- language: en\n"))
    assert(defs.lang == "en" && defs.errors.len() == 0)
    ro frag = detect_language(lines_in("# Fragment: Pause\n\n- fragment: Pause\n- format: 2.22\n- language: en\n"))
    assert(frag.lang == "en" && frag.errors.len() == 0)
}

test "wt lang english undeclared" {
    ro info = detect_language(lines_in("\n# Machine: M\n\n- machine: m\n- format: 2.22\n"))
    assert(info.errors.len() == 1)
    assert(info.errors[0].kind == "language")
    assert(info.errors[0].line == 2)
    assert(info.errors[0].message.contains("язык шапки английский, а language не объявлен"))
    assert(info.lang == "en")
}

test "wt lang header mismatch" {
    ro a = detect_language(lines_in("# Machine: M\n\n- machine: m\n- language: ru\n"))
    assert(a.errors.len() == 1)
    assert(a.errors[0].line == 1)
    assert(a.errors[0].message.contains("а в строке language объявлен ru"))
    ro b = detect_language(lines_in("# Машина: М\n\n- machine: m\n- format: 2.22\n- language: en\n"))
    assert(b.errors.len() == 1)
    assert(b.errors[0].line == 5)
    assert(b.errors[0].message.contains("язык шапки русский"))
    assert(b.lang == "ru")
}

test "wt lang bad value" {
    ro info = detect_language(lines_in("# Машина: М\n\n- machine: m\n- language: de\n"))
    assert(info.errors.len() == 1)
    assert(info.errors[0].line == 4)
    assert(info.errors[0].kind == "language")
    assert(info.errors[0].message.contains("`ru` или `en`"))
    assert(info.lang == "ru")
}

test "wt lang inside fence" {
    ro info = detect_language(lines_in("# Машина: М\n\n- machine: m\n\n## Типы\n\n```\n- language: en\n```\n"))
    assert(info.lang == "ru")
    assert(info.errors.len() == 0)
}

test "wt versions" {
    assert(format_versions() == ["2.22"])
    assert(version_strict("2.22"))
    assert(!version_strict("2.11") && !version_strict("2.10") && !version_strict("2.9") && !version_strict(""))
}

// ---- the classification of the lines ---------------------------------------------------------------------------------------

fn classify_en(text str, strict bool) -> TxClassified => tx_classify_in(lines_in(text), words_load("en"), strict, strict)

fn classify_ru(text str, strict bool) -> TxClassified => tx_classify_in(lines_in(text), words_load("ru"), strict, strict)

test "wt key lines en" {
    ro c = classify_en("## States\n\n- Party: agent\n- Idle term: 0\n- Request: none\nInitial state: Start\n", false)
    assert(c.entries.len() == 5)
    assert(c.entries[1].key == "Party" && c.entries[1].colon == 5 && c.entries[1].shift == 2)
    assert(c.entries[2].key == "Idle term")
    assert(c.entries[3].key == "Request")
    assert(c.entries[4].key == "Initial state")
    assert(c.errors.len() == 0)
}

test "wt key lines ru" {
    ro c = classify_ru("## Состояния\n\n- Сторона: агент\n- Срок тишины: 0\nНачальное состояние: ЖДАТЬ\nmachine: x\n", false)
    assert(c.entries[1].key == "Party")
    assert(c.entries[2].key == "Idle term")
    assert(c.entries[3].key == "Initial state")
    assert(c.entries[4].key == "machine")
}

test "wt key foreign" {
    ro c = classify_ru("## Состояния\n\n- Party: агент\nRequest: нет\n", false)
    assert(c.errors.len() == 2)
    assert(c.errors[0].line == 3 && c.errors[0].kind == "language")
    assert(c.errors[0].message.contains("`Party`"))
    assert(c.errors[0].message.contains("`Сторона`"))
    assert(c.errors[1].line == 4 && c.errors[1].col == 1)
    ro e = classify_en("## States\n\n- Сторона: agent\n", false)
    assert(e.errors.len() == 1)
    assert(e.errors[0].message.contains("`Party`"))
}

test "wt touching strict" {
    ro text = "## Data\n\nA paragraph that touches the table\n| name | type |\n| a | b |\n\nA comment\n\n| name | type |\n"
    ro strict = classify_en(text, true)
    assert(strict.warnings.len() == 1)
    assert(strict.warnings[0].line == 3)
    assert(strict.warnings[0].message.contains("вплотную к таблице"))
    assert(strict.entries[1].kind == EN_TEXT && strict.entries[1].text == "A paragraph that touches the table")
    ro loose = classify_en(text, false)
    assert(loose.warnings.len() == 0)
    assert(loose.entries.len() == 4)
}

test "wt touching heading and list" {
    ro c = classify_en("## Data\n\nA line\n## States\n\nAnother\n- Party: agent\n", true)
    assert(c.warnings.len() == 2)
    assert(c.warnings[0].message.contains("заголовку"))
    assert(c.warnings[1].message.contains("элементу списка"))
}

test "wt paragraph comment" {
    ro c = classify_en("## Data\n\nA comment line one\nline two\n\n| name | type |\n", true)
    assert(c.warnings.len() == 0)
    assert(c.entries.len() == 2)
}

test "wt declaration outside" {
    ro text = "## Types\n\ntype T { a int }\nmore\n\n```\ntype U { b int }\n```\n"
    ro strict = classify_en(text, true)
    assert(strict.warnings.len() == 1)
    assert(strict.warnings[0].line == 3)
    assert(strict.warnings[0].message.contains("объявление вне блока кода"))
    assert(strict.entries.len() == 2)
    assert(strict.entries[1].text == "type U { b int }")
    ro loose = classify_en(text, false)
    assert(loose.warnings.len() == 0)
    assert(loose.entries.len() == 4)
    ro fenced_only = tx_classify_in(lines_in(text), words_load("en"), true, false)
    assert(fenced_only.entries.len() == 4)
}

test "wt prose key where" {
    ro c = classify_en("## States\n\nParty without a colon\n\nTo somewhere\n", true)
    assert(c.warnings.len() == 1)
    assert(c.warnings[0].line == 3)
    assert(c.warnings[0].message.contains("«Party»"))
}

test "wt expansion sections" {
    ro ru = classify_ru("## Типы\n—\n\n## Раскрытие фрагмента «Пауза»\n\n### x\n| a |\n\n## Состояния\n", true)
    assert(ru.expansions.len() == 1)
    assert(ru.expansions[0].line == 4 && ru.expansions[0].name == "Раскрытие фрагмента «Пауза»")
    ro en = classify_en("## Types\n—\n\n## Fragment expansion \"Pause\"\n\n## States\n", true)
    assert(en.expansions.len() == 1 && en.expansions[0].name == "Fragment expansion \"Pause\"")
    assert(en.entries.len() == 4)
}
