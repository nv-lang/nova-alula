// words_test.nv - task 113: the table of words as data (`alula-keywords.tsv`, the copy of `spec/alula-keywords.tsv`, `keywords_product.tsv` of the product), the reading of a word by its kind and its key in the
// language of the file, the language of a file (`- language: ru|en`), the names of an English file. Every word that the code asks for is in the table; the code of the translator has no
// Cyrillic word of the structure (only the messages of the errors and the letters of the alphabet).
module alula.machine_text

import std.text

fn all_kinds() -> []str => ["header", "section", "column", "kind_state", "key", "kind_party", "kind_param", "event", "destination", "decl", "type", "expr", "action", "operator", "readable", "enum_value", "catalog"]

fn method_rows() -> []TxWord {
    mut rows = []TxWord.new()
    words_read(keywords_text(), rows)
    rows
}

fn product_rows() -> []TxWord {
    mut rows = []TxWord.new()
    words_read(keywords_product_text(), rows)
    rows
}

fn kind_count(rows []TxWord, kind str) -> int {
    mut n = 0
    for r in rows {
        if r.kind == kind { n += 1 }
    }
    n
}

fn has_row(rows []TxWord, kind str, key str) -> bool {
    for r in rows {
        if r.kind == kind && r.en == key { return true }
    }
    false
}

// ---- the table of the methodology -----------------------------------------------------------------------------------------

test "wt table shape" {
    ro rows = method_rows()
    assert(rows.len() == 218)
    for k in all_kinds() { assert(kind_count(rows, k) > 0) }
    for r in rows {
        assert(all_kinds().contains(r.kind))
        assert(r.ru != "" && r.en != "")
    }
    assert(kind_count(rows, "operator") == 11)
    assert(kind_count(rows, "catalog") == 26)
}

test "wt table unique" {
    ro rows = method_rows()
    mut seen_ru = []str.new()
    mut seen_en = []str.new()
    for r in rows {
        ro a = "${r.kind}/${r.ru}"
        ro b = "${r.kind}/${r.en}"
        assert(!seen_ru.contains(a))
        assert(!seen_en.contains(b))
        seen_ru.push(a)
        seen_en.push(b)
    }
}

test "wt product layer" {
    ro rows = product_rows()
    assert(rows.len() == 14)
    ro method = method_rows()
    for r in rows {
        assert(all_kinds().contains(r.kind) || r.kind == "fragment" || r.kind == "fragment_param")
        for m in method {
            if m.kind == r.kind {
                assert(m.ru != r.ru)
                assert(m.en != r.en)
            }
        }
    }
    assert(has_row(rows, "section", "Signals"))
    assert(has_row(rows, "section", "Response parts"))
    assert(has_row(rows, "event", "deadline"))
    assert(has_row(rows, "event", "part"))
    assert(kind_count(rows, "fragment_param") == 6)
}

test "wt all rows loaded" {
    assert(words_rows().len() == 232)
}

// ---- reading a word -----------------------------------------------------------------------------------------------------

test "wt kw ru" {
    ro w = words_load("ru")
    assert(kw(w, "section", "Parties") == "Стороны")
    assert(kw(w, "section", "Signals") == "Сигналы")
    assert(kw(w, "key", "Idle term") == "Срок тишины")
    assert(kw(w, "key", "Initial state") == "Начальное состояние")
    assert(kw(w, "expr", "if") == "если")
    assert(kw(w, "expr", "else") == "иначе")
    assert(kw(w, "action", "for") == "для")
    assert(kw(w, "action", "in") == "из")
    assert(kw(w, "type", "bool") == "булево")
    assert(kw(w, "type", "full map") == "полный словарь")
    assert(kw(w, "kind_party", "human or agent by setting") == "human или agent по настройке")
    assert(kw(w, "destination", "same") == "то же")
    assert(kw(w, "destination", "rerun") == "запуск заново")
    assert(kw(w, "fragment", "Pause") == "Пауза")
    assert(kw(w, "fragment_param", "halt_signal") == "сигнал_остановки")
    assert(kw(w, "column", "№") == "№")
    assert(kw(w, "header", "machine") == "machine")
}

test "wt kw en" {
    ro w = words_load("en")
    assert(kw(w, "section", "Parties") == "Parties")
    assert(kw(w, "key", "Idle term") == "Idle term")
    assert(kw(w, "expr", "if") == "if")
    assert(kw(w, "action", "for each") == "for each")
    assert(kw(w, "type", "bool") == "bool")
    assert(kw(w, "fragment", "Pause") == "Pause")
    assert(kw(w, "nothing", "x") == "x")
}

test "wt key of" {
    ro ru = words_load("ru")
    ro en = words_load("en")
    assert(kw_key(ru, "section", "Стороны") == Some("Parties"))
    assert(kw_key(ru, "section", "Parties") == None)
    assert(kw_key(en, "section", "Parties") == Some("Parties"))
    assert(kw_key(en, "section", "Стороны") == None)
    assert(kw_has(ru, "expr", "если"))
    assert(!kw_has(ru, "expr", "if"))
    assert(kw_key(ru, "event", "срок") == Some("deadline"))
    assert(kw_key(en, "event", "deadline") == Some("deadline"))
}

test "wt foreign" {
    ro ru = words_load("ru")
    ro en = words_load("en")
    assert(kw_foreign(ru, "section", "Parties") == Some("Parties"))
    assert(kw_foreign(ru, "section", "Стороны") == None)
    assert(kw_foreign(en, "section", "Стороны") == Some("Parties"))
    assert(kw_foreign(ru, "header", "machine") == None)
    assert(kw_foreign(ru, "kind_party", "agent") == None)
    assert(kw_foreign_any(ru, ["action", "expr"], "journal") == Some("journal"))
    assert(kw_foreign_any(en, ["action", "expr"], "журнал") == Some("journal"))
    assert(kw_foreign_any(ru, ["action", "expr"], "незнакомое") == None)
}

test "wt cols" {
    ro ru = words_load("ru")
    ro en = words_load("en")
    assert(ru.cols.contains("имя"))
    assert(ru.cols.contains("событие"))
    assert(en.cols.contains("name"))
    assert(en.cols.contains("non_decreasing"))
    assert(!en.cols.contains("имя"))
}

test "wt phrases" {
    ro ru = words_load("ru")
    ro en = words_load("en")
    ro toks = match tx_lex("для некоторого х из y", 1, 1) {
        Ok(t) => t
        Err(e) => []TxTok.new()
    }
    ro p = p_new(toks, 1, 1)
    assert(p_phrase_len(p, "для некоторого") == 2)
    assert(p_phrase_len(p, "для") == 1)
    assert(p_phrase_len(p, "для каждого") == 0)
    assert(p_is_kw(p, ru, "action", "for"))
    assert(!p_is_kw(p, en, "action", "for"))
    ro bool_toks = match tx_lex("да/нет", 1, 1) {
        Ok(t) => t
        Err(e) => []TxTok.new()
    }
    assert(p_phrase_len(p_new(bool_toks, 1, 1), "да/нет") == 3)
}

test "wt reserved" {
    ro ru = words_load("ru")
    ro en = words_load("en")
    assert(is_keyword(ru, "если"))
    assert(is_keyword(ru, "из"))
    assert(is_keyword(ru, "в"))
    assert(!is_keyword(ru, "каждого"))
    assert(!is_keyword(ru, "if"))
    assert(is_keyword(en, "if"))
    assert(is_keyword(en, "in"))
    assert(!is_keyword(en, "each"))
    assert(!is_keyword(en, "если"))
    assert(tx_keywords(ru).len() == 15)
    assert(tx_keywords(en).len() == 14)
}

