// expr_test.nv - the types and the expressions of the format (sections 2 and 3) as the JSON of the core: every construction, the errors.
module alula.machine_text

import std.text

fn scope_data() -> []str => piece_entries()

// The JSON of an expression, or `ERR kind: message`.
fn ex(text str) -> str {
    match translate_expression(text, scope_data()) {
        Ok(j) => j
        Err(problems) => "ERR ${problems[0].kind}: ${problems[0].message}"
    }
}

fn exj(text str) -> str => ex(text)

fn ty(text str) -> str {
    match translate_type_with(text, piece_entries(), "ru") {
        Ok(j) => j
        Err(problems) => "ERR ${problems[0].kind}: ${problems[0].message}"
    }
}

fn is_err(text str) -> bool => ex(text).starts_with("ERR")

// The errors of an expression (empty when it is translated).
fn errs(text str) -> []TranslateError {
    match translate_expression(text, scope_data()) {
        Ok(j) => []TranslateError.new()
        Err(problems) => problems
    }
}

fn nm(name str) -> TxJ => x_name(name)

fn li(n int) -> TxJ => x_lit(jint(n))

// ---- types ---------------------------------------------------------------------------------------------------------------------

test "ty base" {
    assert(ty("число") == "int")
    assert(ty("число>=0") == "int>=0")
    assert(ty("число>=1") == "int>=1")
    assert(ty("число >= 5") == "int>=5")
    assert(ty("дробное") == "float")
    assert(ty("текст") == "text")
    assert(ty("да/нет") == "bool")
    assert(ty("ид") == "id")
    assert(ty("Состояние") == "State")
    assert(ty("Сигнал") == "Signal")
    assert(ty("?Состояние") == "?State")
}

test "ty compound" {
    assert(ty("?текст") == "?text")
    assert(ty("[]текст") == "[]text")
    assert(ty("[]?число>=0") == "[]?int>=0")
    assert(ty("словарь[текст, число]") == "{text: int}")
    assert(ty("полный словарь[КодСбоя, текст]") == "full {FailCode: text}")
    assert(ty("(текст, число>=0)") == "(text, int>=0)")
    assert(ty("(текст, число, да/нет)") == "(text, int, bool)")
    assert(ty("?ид") == "?id")
    assert(ty("словарь[число>=0, []Токены]") == "{int>=0: []TokenUsage}")
}

test "ty sets" {
    assert(ty("\"a\" | \"b\"") == "\"a\" | \"b\"")
    assert(ty("\"\" | \"no_result\" | \"max_tokens\"") == "\"\" | \"no_result\" | \"max_tokens\"")
    assert(ty("?(\"allow\" | \"deny\")") == "?(\"allow\" | \"deny\")")
    assert(ty("[](\"a\" | \"b\")") == "[](\"a\" | \"b\")")
    assert(ty("(\"a\" | \"b\")") == "\"a\" | \"b\"")
    assert(ty("(\"a\" | \"b\", число)") == "(\"a\" | \"b\", int)")
    assert(ty("словарь[текст, \"a\" | \"b\"]") == "{text: \"a\" | \"b\"}")
    assert(ty("\"a\" \\| \"b\"") == "\"a\" | \"b\"")
}

test "ty names" {
    assert(ty("КодСбоя") == "FailCode")
    assert(ty("?РасходТранспорта") == "?TransportUsage")
    assert(ty("[]Находка") == "[]Finding")
    assert(ty("СобытиеЖурнала") == "JournalEvent")
}

test "ty errors" {
    for t in ["", "?", "[]", "\"a\"", "?\"a\" | \"b\"", "[]\"a\" | \"b\"", "(текст)", "словарь[текст]", "число>=", "число>=x", "текст текст", "да/", "полный текст", "(\"a\" | \"b\"", "\"a\" | число"] {
        assert(ty(t).starts_with("ERR"))
    }
    assert(ty("Нетакоготипа").starts_with("ERR name:"))
}

// ---- literals, names, fields, indexes ------------------------------------------------------------------------------------------

test "ex literals" {
    assert(ex("12") == tx_text(li(12)))
    assert(ex("0.5") == tx_text(x_lit(TxRaw("0.5"))))
    assert(ex("-3") == tx_text(x_lit(TxRaw("-3"))))
    assert(ex("-0.25") == tx_text(x_lit(TxRaw("-0.25"))))
    assert(ex("\"привет\"") == tx_text(x_lit(js("привет"))))
    assert(ex("истина") == tx_text(x_lit(TxBool(true))))
    assert(ex("ложь") == tx_text(x_lit(TxBool(false))))
    assert(ex("пусто") == tx_text(x_null()))
    assert(ex("недостижимо") == tx_text(x_call("require", [x_null()])))
    assert(ex("12") == "{\"op\":\"lit\",\"value\":12}")
}

test "ex names" {
    assert(ex("число_повторов") == tx_text(nm("retry_count")))
    assert(ex("ЧИСЛО_ПОВТОРОВ") == tx_text(nm("RETRIES")))
    assert(ex("расход") == tx_text(nm("transport_usage")))
    assert(ex("вход") == tx_text(nm("input")))
    assert(ex("событие") == tx_text(nm("event")))
    assert(ex("сторона") == tx_text(nm("party")))
    assert(ex("состояние") == tx_text(nm("state")))
    assert(ex("запись_перехода") == tx_text(nm("transition_note")))
    assert(ex("все_данные") == tx_text(nm("all_data")))
    assert(ex("трасса") == tx_text(nm("trace")))
    assert(ex("номер_шага") == tx_text(nm("step")))
}

test "ex fields" {
    assert(ex("запрос_агента.сессия") == tx_text(x_field(nm("agent_request"), "session")))
    assert(ex("запрос_агента.пределы.бюджет_токенов") == tx_text(x_field(x_field(nm("agent_request"), "limits"), "token_budget")))
    assert(ex("событие.идентификатор") == tx_text(x_field(nm("event"), "id")))
    assert(ex("ход.0") == tx_text(x_field(nm("turn"), "0")))
    assert(ex("ход.0.1") == tx_text(x_field(x_field(nm("turn"), "0"), "1")))
    assert(ex("линзы[сессия]") == tx_text(x_index(nm("lenses"), nm("session"))))
    assert(ex("линзы[сессия].сессия") == tx_text(x_field(x_index(nm("lenses"), nm("session")), "session")))
    assert(ex("линзы[(сессия, номер_захода)]") == tx_text(x_index(nm("lenses"), x_tuple([nm("session"), nm("number")]))))
}

// ---- operators ---------------------------------------------------------------------------------------------------------------

test "ex arithmetic" {
    assert(ex("число_повторов + 1") == tx_text(x_bin("+", nm("retry_count"), li(1))))
    assert(ex("1 + 2 * 3") == tx_text(x_bin("+", li(1), x_bin("*", li(2), li(3)))))
    assert(ex("1 * 2 + 3") == tx_text(x_bin("+", x_bin("*", li(1), li(2)), li(3))))
    assert(ex("(1 + 2) * 3") == tx_text(x_bin("*", x_bin("+", li(1), li(2)), li(3))))
    assert(ex("10 - 4 - 3") == tx_text(x_bin("-", x_bin("-", li(10), li(4)), li(3))))
    assert(ex("7 / 2 % 3") == tx_text(x_bin("%", x_bin("/", li(7), li(2)), li(3))))
    assert(ex("-число_повторов") == tx_text(x_un("neg", nm("retry_count"))))
    assert(ex("2 * -3") == tx_text(x_bin("*", li(2), x_lit(TxRaw("-3")))))
}

test "ex compare" {
    assert(ex("ход == \"retry\"") == tx_text(x_bin("==", nm("turn"), x_lit(js("retry")))))
    assert(ex("ход != \"retry\"") == tx_text(x_bin("!=", nm("turn"), x_lit(js("retry")))))
    assert(ex("1 < 2") == tx_text(x_bin("<", li(1), li(2))))
    assert(ex("1 <= 2") == tx_text(x_bin("<=", li(1), li(2))))
    assert(ex("1 > 2") == tx_text(x_bin(">", li(1), li(2))))
    assert(ex("1 >= 2") == tx_text(x_bin(">=", li(1), li(2))))
    assert(ex("1 >= 2") == tx_text(x_bin(">=", li(1), li(2))))
    assert(ex("1 <= 2") == tx_text(x_bin("<=", li(1), li(2))))
    assert(ex("1 + 1 == 2") == tx_text(x_bin("==", x_bin("+", li(1), li(1)), li(2))))
}

test "ex logic" {
    assert(ex("истина и ложь") == tx_text(x_bin("and", x_lit(TxBool(true)), x_lit(TxBool(false)))))
    assert(ex("истина или ложь") == tx_text(x_bin("or", x_lit(TxBool(true)), x_lit(TxBool(false)))))
    assert(ex("не истина") == tx_text(x_un("not", x_lit(TxBool(true)))))
    assert(ex("не ложь и истина") == tx_text(x_bin("and", x_un("not", x_lit(TxBool(false))), x_lit(TxBool(true)))))
    assert(ex("ложь или истина и ложь") == tx_text(x_bin("or", x_lit(TxBool(false)), x_bin("and", x_lit(TxBool(true)), x_lit(TxBool(false))))))
    assert(ex("1 < 2 и 3 < 4") == tx_text(x_bin("and", x_bin("<", li(1), li(2)), x_bin("<", li(3), li(4)))))
    assert(ex("не 1 < 2") == tx_text(x_un("not", x_bin("<", li(1), li(2)))))
}

test "ex coalesce" {
    assert(ex("ход ?? \"x\"") == tx_text(x_bin("??", nm("turn"), x_lit(js("x")))))
    assert(ex("ход ?? остановка ?? \"x\"") == tx_text(x_bin("??", nm("turn"), x_bin("??", nm("stop_reason"), x_lit(js("x"))))))
    assert(ex("(ход ?? 0) + 1") == tx_text(x_bin("+", x_bin("??", nm("turn"), li(0)), li(1))))
    assert(ex("1 или 2 ?? 3") == tx_text(x_bin("??", x_bin("or", li(1), li(2)), li(3))))
}

test "ex member" {
    ro one = x_bin("==", nm("stop_reason"), x_lit(js("a")))
    ro two = x_bin("==", nm("stop_reason"), x_lit(js("b")))
    assert(ex("остановка in {\"a\"}") == tx_text(one))
    assert(ex("остановка in {\"a\", \"b\"}") == tx_text(x_bin("or", one, two)))
    assert(ex("остановка in {}") == tx_text(x_lit(TxBool(false))))
}

// ---- constructions -----------------------------------------------------------------------------------------------------------

test "ex if let" {
    assert(ex("если ход == \"a\" то 1 иначе 2") == tx_text(x_if(x_bin("==", nm("turn"), x_lit(js("a"))), li(1), li(2))))
    assert(ex("если истина то 1 иначе если ложь то 2 иначе 3") == tx_text(x_if(x_lit(TxBool(true)), li(1), x_if(x_lit(TxBool(false)), li(2), li(3)))))
    assert(ex("пусть p = 5 в p + 1") == tx_text(x_let("p", li(5), x_bin("+", nm("p"), li(1)))))
    assert(ex("пусть p = 5 в пусть a = 2 в p * a") == tx_text(x_let("p", li(5), x_let("a", li(2), x_bin("*", nm("p"), nm("a"))))))
    assert(ex("(если истина то 1 иначе 2) + 3") == tx_text(x_bin("+", x_if(x_lit(TxBool(true)), li(1), li(2)), li(3))))
    assert(ex("1 + если истина то 1 иначе 2") == tx_text(x_bin("+", li(1), x_if(x_lit(TxBool(true)), li(1), li(2)))))
}

test "ex call" {
    assert(ex("есть(расход)") == tx_text(x_call("has", [nm("transport_usage")])))
    assert(ex("обязательно(расход).начато") == tx_text(x_field(x_call("require", [nm("transport_usage")]), "started")))
    assert(ex("текст(число_повторов)") == tx_text(x_call("text", [nm("retry_count")])))
    assert(ex("наибольшее(1, число_повторов)") == tx_text(x_call("max", [li(1), nm("retry_count")])))
    assert(ex("длина(линзы)") == tx_text(x_call("length", [nm("lenses")])))
    assert(ex("конец(состояние)") == tx_text(x_call("end", [nm("state")])))
    assert(ex("непустое(остановка)") == tx_text(x_call("non_empty", [nm("stop_reason")])))
    assert(ex("текст_записи(запись_перехода)") == tx_text(x_call("record_text", [nm("transition_note")])))
    assert(ex("дробное(1)") == tx_text(x_call("float", [li(1)])))
    assert(ex("число(1.5)") == tx_text(x_call("int", [x_lit(TxRaw("1.5"))])))
    assert(ex("без_ключа(линзы, сессия)") == tx_text(x_call("without_key", [nm("lenses"), nm("session")])))
    assert(ex("убрать([1, 2], 2)") == tx_text(x_call("remove", [x_list([li(1), li(2)]), li(2)])))
}

test "ex macros" {
    assert(ex("фильтр([1, 2], kh -> kh > 1)") == tx_text(x_call("filter", [x_list([li(1), li(2)]), x_lambda(["kh"], x_bin(">", nm("kh"), li(1)))])))
    assert(ex("отобразить([1], n -> n * 2)") == tx_text(x_call("map", [x_list([li(1)]), x_lambda(["n"], x_bin("*", nm("n"), li(2)))])))
    assert(ex("любой([1], n -> n == 1)") == tx_text(x_call("any", [x_list([li(1)]), x_lambda(["n"], x_bin("==", nm("n"), li(1)))])))
    assert(ex("свёртка(диапазон(1, 3), ПАУЗА_ПОВТОРА, (n, _) -> n * 2)") == tx_text(x_call("fold", [x_call("range", [li(1), li(3)]), nm("RETRY_PAUSE"), x_lambda(["n", "_"], x_bin("*", nm("n"), li(2)))])))
    assert(ex("словарь([1], n -> n, n -> n + 1)") == tx_text(x_call("dict", [x_list([li(1)]), x_lambda(["n"], nm("n")), x_lambda(["n"], x_bin("+", nm("n"), li(1)))])))
    assert(ex("количество([1], n -> истина)") == tx_text(x_call("count", [x_list([li(1)]), x_lambda(["n"], x_lit(TxBool(true)))])))
    assert(ex("первый_где([1], n -> истина)") == tx_text(x_call("first_where", [x_list([li(1)]), x_lambda(["n"], x_lit(TxBool(true)))])))
    assert(ex("все([1], n -> истина)") == tx_text(x_call("all", [x_list([li(1)]), x_lambda(["n"], x_lit(TxBool(true)))])))
}

test "ex literals of collections" {
    assert(ex("[]") == tx_text(x_list([])))
    assert(ex("[1, 2]") == tx_text(x_list([li(1), li(2)])))
    assert(ex("{}") == tx_text(x_dict([])))
    assert(ex("{\"a\": 1, \"b\": 2}") == tx_text(x_dict([x_entry(x_lit(js("a")), li(1)), x_entry(x_lit(js("b")), li(2))])))
    assert(ex("(1, \"a\")") == tx_text(x_tuple([li(1), x_lit(js("a"))])))
    assert(ex("(1)") == tx_text(li(1)))
    assert(ex("[(1, 2), (3, 4)]") == tx_text(x_list([x_tuple([li(1), li(2)]), x_tuple([li(3), li(4)])])))
}

test "ex records" {
    assert(ex("Токены { вход: 1, выход: пусто }") == tx_text(x_record("TokenUsage", [kv("input", li(1)), kv("output", x_null())])))
    assert(ex("{ ...запрос_агента, сессия: \"s\" }") == tx_text(x_with(nm("agent_request"), [kv("session", x_lit(js("s")))])))
    assert(ex("{ ...запрос_агента }") == tx_text(x_with(nm("agent_request"), [])))
    assert(ex("{ ...запрос_агента, сессия: \"s\", начато: 1, }") == tx_text(x_with(nm("agent_request"), [kv("session", x_lit(js("s"))), kv("started", li(1))])))
    assert(ex("КодСбоя.НетРезультата") == tx_text(x_variant("FailCode", "NoResult", [])))
    assert(ex("ВидДействия.Удаление") == tx_text(x_variant("ActionKind", "Delete", [])))
    assert(ex("ИтогХода.Закончен { текст: \"t\" }") == tx_text(x_variant("TurnResult", "Finished", [kv("text", x_lit(js("t")))])))
}

test "ex state names" {
    ro problems = errs("состояние != ПАУЗА")
    assert(problems.len() == 1 && problems[0].kind == "name")
}

test "ex match" {
    ro a = x_arm([pat_case("ActionKind", "Delete", []), pat_case("ActionKind", "Move", [])], [], x_lit(TxBool(true)))
    ro b = x_arm([pat_any()], [], x_lit(TxBool(false)))
    assert(ex("выбор ход { ВидДействия.Удаление | ВидДействия.Перенос -> истина; иначе -> ложь }") == tx_text(x_match(nm("turn"), [a, b])))
    ro c = x_arm([pat_case("", "Finished", [kv("text", js("текст")), kv("usage", js("полученный"))])], [], nm("полученный"))
    assert(ex("выбор ход { Закончен(текст, расход: полученный) -> полученный }") == tx_text(x_match(nm("turn"), [c])))
    ro d = x_arm([pat_lit(js("a"))], [x_bin(">", li(1), li(0))], li(1))
    assert(ex("выбор ход { \"a\" если 1 > 0 -> 1 }") == tx_text(x_match(nm("turn"), [d])))
    ro e = x_arm([pat_case("", "Finished", [])], [], li(1))
    assert(ex("выбор ход { Закончен -> 1 }") == tx_text(x_match(nm("turn"), [e])))
    ro f = x_arm([pat_lit(TxRaw("1")), pat_lit(TxRaw("2"))], [], li(5))
    assert(ex("выбор ход { 1 | 2 -> 5 }") == tx_text(x_match(nm("turn"), [f])))
}

test "ex call primitive" {
    assert(ex("вызвать(новый_ид)") == tx_text(x_prim("new_id", [])))
}

// ---- errors ------------------------------------------------------------------------------------------------------------------

test "ex errors syntax" {
    for t in ["", "1 +", "(1", "[1", "{ 1 }", "1 2", "если истина то 1", "пусть а = 1 а", "выбор ход { }", "выбор ход { Закончен 1 }", "f(", "а.", "а[", "не", "1 ==", "\"a", "в", "то"] {
        assert(is_err(t))
    }
}

test "ex errors names" {
    assert(ex("нет_такого").starts_with("ERR name:"))
    assert(ex("запрос_агнта").contains("возможно, `запрос_агента`"))
    assert(ex("расход.нет_поля").starts_with("ERR name:"))
    assert(ex("нет_функции(1)").starts_with("ERR name:"))
    assert(ex("Нетакоготипа { a: 1 }").starts_with("ERR name:"))
    assert(ex("КодСбоя.НетТакого").starts_with("ERR name:"))
    assert(ex("Токены").starts_with("ERR syntax:"))
}

test "ex errors places" {
    ro problems = errs("1 + нет_слова + тоже_нет")
    assert(problems.len() == 2)
    assert(problems[0].line == 1 && problems[0].col == 5)
    assert(problems[1].col == 17)
    assert(problems[0].quote == "1 + нет_слова + тоже_нет")
    ro open = errs("1 + ")
    assert(open.len() == 1 && open[0].kind == "syntax")
}

test "ex named args" {
    assert(ex("событие_журнала(\"agent_usage\", session: сессия, cost: 1)") == tx_text(x_call("journal_event", [x_lit(js("agent_usage")), x_lit(js("session")), nm("session"), x_lit(js("cost")), li(1)])))
    assert(is_err("текст(a: 1)"))
    assert(is_err("событие_журнала(a: 1, 2)"))
}
