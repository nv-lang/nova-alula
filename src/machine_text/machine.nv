// machine.nv - the translator of a file of a machine: `translate` (the Result), `translate_report` (the JSON and every note), the header of the file, the
// order of the sections, the JSON of the machine.
//
// The order of the work is the order of the dependencies, not of the file: the names of the states, of the definitions are collected first (a row may
// lead to a state that comes later), then the types, the constants, the parameters, the input, the data, the parties, the signals, the parts of an answer, the
// definitions, the external functions, the common events, the states, the ends. Every error of every part is kept: the translation does not stop at the first.
module alula.machine_text

// ORACLE-WORKAROUND(32): `import std.text` is needed in `nova build` for `[]str.join` (a `nova test` build has it already); drop the import when item 32 is fixed
import std.text
import alula.machine.{NamedText}
import alula.machine_table.{StateReads}

/// TranslateReport: what a translation gave. `json` is the machine (complete when `errors` is empty, else what could be translated); `errors` are all the
/// notes of the translator, by place; `rows_total` is the number of the rows of the tables (and definitions) that were read, `rows_noted` the number of those
/// that carry a note (an error or "not supported"). `reads` are the reads of the states that the check derives for a machine of 2.26 (AL-138: they are shown in the report of the
/// check, `translate_checked`); empty without the checks and before 2.26.
export type TranslateReport { json str, errors []TranslateError, warnings []TranslateError, rows_total int, rows_noted int, places []TxPlace, names []JsonName, reads []StateReads }

/// The context of a translation of a file in the language `lang` (`ru` or `en`).
fn cx_new_in(lang str) -> TxCx {
    TxCx { errors: []TranslateError.new(), warnings: []TranslateError.new(), names: names_load_for(lang), env: env_new(), jn: jn_new(), rows_total: 0, rows_noted: 0, places: []TxPlace.new(), words: words_load(lang), v226: false, callees: []TxCallee.new() }
}

fn cx_new() -> TxCx => cx_new_in("ru")

// ---- the header ------------------------------------------------------------------------------------------------------------------------------

/// TxHeader: the title, the Latin name, the revision of the machine (`revision`, "1" by default since 2.27; the line `machine_version` of the seam of 2.25), the version of the language.
type TxHeader { title str, machine str, version str, format str }

/// The hint of the old keys of the header (AL-144).
fn header_old_hint() -> str {
    ro message_text = "с 2.27 — revision и alula_version: `machine_version: …` пишется `revision: <целое>`, `format: 2.NN` — `alula_version: 2.27`; переходного периода нет"
    message_text
}

/// Is the text an integer (the digits only)?
fn is_integer_text(s str) -> bool {
    if s.byte_len() == 0 { return false }
    for c in s.chars() {
        if !tx_is_digit(c) { return false }
    }
    true
}

fn header_read(entries []TxEntry, mut cx TxCx) -> TxHeader {
    mut title = ""
    mut machine = ""
    mut version = ""
    mut revision = ""
    mut revision_line = 0
    mut format = ""
    mut alula_version = ""
    mut old_lines = []int.new()
    mut machine_line = 1
    mut machine_col = 10
    ro head_word = "${kw(cx.words, "header", "Machine")}:"
    if entries.len() == 0 || entries[0].kind != EN_HEAD || entries[0].level != 1 || !entries[0].text.starts_with(head_word) {
        note(cx, struct_error(1, 1, "файл машины начинается со строки `# ${head_word} <Имя>`"))
    } else {
        title = entries[0].text[head_word.byte_len()..].trim_ascii()
    }
    mut i = 1
    while i < entries.len() && entries[i].kind != EN_HEAD {
        ro e = entries[i]
        if kv_colon(e) >= 0 {
            ro line = kv_read(entries, i)
            ro value = line.segs[0].text
            if line.key == "machine" {
                machine = value
                machine_line = e.line
                machine_col = 10 + e.shift
            } else if line.key == "revision" {
                revision = value
                revision_line = e.line
            } else if line.key == "alula_version" {
                alula_version = value
            } else if line.key == "machine_version" {
                version = value
                old_lines.push(e.line)
            } else if line.key == "format" {
                format = value
                old_lines.push(e.line)
            } else if line.key == "language" {
                // read by the detection of the language, before the translation
                ()
            } else {
                note(cx, struct_error(e.line, 1, "в шапке бывают строки machine, revision, alula_version, language"))
            }
            i += line.taken
        } else {
            note(cx, struct_error(e.line, e.indent + 1, "лишняя строка в шапке файла"))
            i += 1
        }
    }
    if machine == "" {
        note(cx, struct_error(1, 1, "в шапке нет строки `machine: <латинское_имя>`"))
    } else if !is_identifier_latin(machine) {
        note(cx, struct_error(machine_line, machine_col, "имя машины — латинский идентификатор, найдено `${machine}`"))
    }
    // the seam of 2.25: the texts of the tests of the package keep `machine_version` and `format: 2.25`; in every other file the old keys are an error with the hint (AL-144)
    ro seam = alula_version == "" && format == "2.25"
    if !seam {
        for no in old_lines { note(cx, struct_error(no, 1, header_old_hint())) }
        if revision != "" && !is_integer_text(revision) {
            note(cx, struct_error(revision_line, 1, "ревизия — целое число (ревизия самой машины, по умолчанию 1), найдено `${revision}`; версия языка пишется строкой `alula_version`"))
        }
        version = if revision == "" { "1" } else { revision }
        format = alula_version
        if old_lines.len() == 0 && !format_versions().contains(format) {
            ro shown = if format == "" { "не указана" } else { format }
            note(cx, struct_error(1, 1, "версия языка ${shown}: переводчик читает Алулу 2.27 (строка `alula_version: 2.27`); переходного периода нет"))
        }
    }
    TxHeader { title, machine, version, format }
}

// ---- sorting and quoting the errors ---------------------------------------------------------------------------------------------------------

fn error_before(a TranslateError, b TranslateError) -> bool {
    if a.line != b.line { return a.line < b.line }
    a.col < b.col
}

// ORACLE-WORKAROUND(41): the list is called `errors_in`, not `errors`: the same name for lists of different types in two functions of a unit is mixed up by the code generator; use a plain name when item 41 is fixed
fn errors_sorted(errors_in []TranslateError) -> []TranslateError {
    mut out = []TranslateError.new()
    for e in errors_in {
        mut at = out.len()
        while at > 0 && error_before(e, out[at - 1]) { at -= 1 }
        mut next = []TranslateError.new()
        mut k = 0
        while k < out.len() {
            if k == at { next.push(e) }
            next.push(out[k])
            k += 1
        }
        if at == out.len() { next.push(e) }
        out = next
    }
    out
}

fn errors_quoted(errors_in []TranslateError, lines []str) -> []TranslateError {
    mut out = []TranslateError.new()
    for e in errors_in {
        mut quote = e.quote
        if quote == "" && e.line >= 1 && e.line <= lines.len() {
            quote = lines[e.line - 1].trim_ascii()
            if quote.chars().count() > 160 {
                mut cut = []str.new()
                mut k = 0
                for c in quote.chars() {
                    if k < 160 { cut.push("${c}") }
                    k += 1
                }
                quote = "${cut.join("")}…"
            }
        }
        out.push(TranslateError { line: e.line, col: e.col, kind: e.kind, message: e.message, quote })
    }
    out
}

// ---- the machine ------------------------------------------------------------------------------------------------------------------------------

fn lines_of(text str) -> []str {
    mut out = []str.new()
    for raw in text.split("\n") { out.push(raw) }
    out
}

fn party_json(row TxPartyRow, parts []TxPartItem) -> TxJ => party_json_in(row, parts, []TxJ.new())

/// The party of the tree; the column `части` of 2.26 (the pair `parts_type` of the row) gives the `progress` of the party: the record of the type, its JSON name and its fields (section 7а).
fn party_json_in(row TxPartyRow, parts []TxPartItem, records []TxJ) -> TxJ {
    mut pairs = []TxKV.new()
    mut parts_type = ""
    for q in row.pairs {
        if q.key == "parts_type" {
            match q.value {
                TxStr(x) => { parts_type = x }
                _ => ()
            }
        } else {
            pairs.push(q)
        }
    }
    if parts_type != "" {
        mut item = jobj([kv("name", js(parts_type))])
        for r in records {
            if tj_name(r) == parts_type {
                match r {
                    TxObj(rp) => {
                        for q in rp {
                            if q.key == "fields" { item = jobj([kv("name", js(parts_type)), kv("fields", q.value)]) }
                        }
                    }
                    _ => ()
                }
            }
        }
        pairs.push(kv("progress", TxArr([item])))
        return jobj(pairs)
    }
    mut progress = []TxJ.new()
    for part in parts {
        if part.party_ru == row.ru { progress.push(part.item) }
    }
    if progress.len() > 0 { pairs.push(kv("progress", TxArr(progress))) }
    jobj(pairs)
}

/// The translation of a file of a machine with every note. The files of definitions that a machine may include are those that come with the translator.
export fn translate_report(file_text str) -> TranslateReport => translate_report_with(file_text, defs_files())

/// The same with the registry of the files of definitions of the caller (the name, the text).
export fn translate_report_with(file_text str, registry []NamedText) -> TranslateReport => translate_full(file_text, registry).report

/// TxFull: the report of a translation and its JSON tree (the checked translation writes the derived reads into the tree, AL-138).
type TxFull { report TranslateReport, tree TxJ }

fn translate_full(file_text str, registry []NamedText) -> TxFull {
    ro lines = lines_of(file_text)
    ro info = detect_language(lines)
    ro classified = tx_classify_in(lines, words_load(info.lang), info.strict, info.strict)
    ro entries = classified.entries
    mut cx = cx_new_in(info.lang)
    // the rules of 2.26 and later: a file of 2.27 (and a file that still names 2.26 by an old key: the header refuses the key with the hint, the body is read by the rules of 2.27)
    cx.v226 = info.version != "2.25"
    ro own226 = cx.v226
    for e in info.errors { cx.errors.push(e) }
    for e in classified.errors { cx.errors.push(e) }
    if own226 {
        key_lines_226(entries, cx)
        // the library `контракт` is connected without a line (section 7а)
        contract_register(cx)
    }
    ro header = header_read(entries, cx)
    ro sections = sections_of(entries, cx)
    // the dictionary of the names is pinned by the hash of its normative part: the format and the hash change together (AL-62)
    if format_versions().contains(header.format) {
        ro dictionary = glossary_check_text(glossary_table_text(), header.format)
        if dictionary != "" { note(cx, struct_error(1, 1, dictionary)) }
    }
    // the rows of `## Имена` are read first: every declaration looks for its row
    match section_of(sections, "Names") {
        Some(sec) => { jn_rows_read(entries, sec, cx) }
        None => ()
    }

    // the files of definitions (2.25) and the libraries (2.26)
    mut signals = []TxJ.new()
    mut included = TxIncluded { types: TxTypes { records: []TxJ.new(), variants: []TxJ.new() }, constants: []TxJ.new(), definitions: []TxJ.new(), includes: []TxJ.new() }
    // the libraries of 2.26 (section 9, task 197): the subheadings of `## Подключения`; the rows of `## Имена` of a library hold until its data are declared
    mut lib_runs = []TxLibRun.new()
    mut lib_signals = []str.new()
    ro jn_rows_machine = cx.jn.rows.len()
    mut lib_decls = TxLibDecls { types: TxTypes { records: []TxJ.new(), variants: []TxJ.new() }, constants: []TxJ.new(), definitions: []TxJ.new(), names: []TxLibNames.new() }
    if own226 {
        match section_of(sections, "Includes") {
            Some(sec) => {
                lib_runs = libs_open(entries, sec, registry, cx)
                for sj in libs_protocol_json(libs_protocol_used(lib_runs, cx), cx) {
                    signals.push(sj)
                    lib_signals.push(tj_name(sj))
                }
                lib_decls = libs_decls(lib_runs, cx)
            }
            None => ()
        }
    }
    match section_of(sections, "Includes") {
        Some(sec) => {
          if !own226 {
            included = defs_includes(entries, sec, registry, cx)
            includes_225_check(entries, sec, cx)
          }
        }
        None => ()
    }

    // the names that the rows need before their declarations are read
    mut blocks = []TxBlock.new()
    match section_of(sections, "States") {
        Some(sec) => { blocks = states_register(entries, sec, cx) }
        None => note(cx, struct_error(1, 1, "нет раздела `## ${kw(cx.words, "section", "States")}`"))
    }
    match section_of(sections, "Functions") {
        Some(sec) => defs_register(entries, sec, cx)
        None => ()
    }

    mut types = TxTypes { records: []TxJ.new(), variants: []TxJ.new() }
    match section_of(sections, "Types") {
        Some(sec) => {
            if own226 { lib_types_contract(entries, sec, cx) }
            types = decl_types(entries, sec, cx)
        }
        None => ()
    }
    // the called machines of the parties `machine <имя>` (AL-146): their types are declared in the caller, after its own (a type that the caller declares is its own)
    if own226 {
        ro brought = callees_import(entries, sections, registry, types, cx)
        if brought.records.len() > 0 || brought.variants.len() > 0 {
            mut with_records = []TxJ.new()
            for r in types.records { with_records.push(r) }
            for r in brought.records { with_records.push(r) }
            mut with_variants = []TxJ.new()
            for v in types.variants { with_variants.push(v) }
            for v in brought.variants { with_variants.push(v) }
            types = TxTypes { records: with_records, variants: with_variants }
        }
    }
    // the external functions are declared after the types (a signature names them) and before the parties, the data and the rows that call them (a profile, a parse and a check of `Правит` name them too)
    mut primitives = []TxJ.new()
    match section_of(sections, "External functions") {
        Some(sec) => { primitives = decl_externals(entries, sec, cx) }
        None => ()
    }
    mut constants = []TxJ.new()
    match section_of(sections, "Constants") {
        Some(sec) => { constants = decl_constants(entries, sec, cx) }
        None => ()
    }
    mut params = []TxJ.new()
    match section_of(sections, "Parameters") {
        Some(sec) => { params = decl_params(entries, sec, cx) }
        None => ()
    }
    mut input = TxInput { fields: []TxJ.new(), invariants: []TxJ.new(), scope: sc_empty() }
    mut has_input = false
    match section_of(sections, "Input") {
        Some(sec) => {
            input = decl_input(entries, sec, cx)
            // a section that holds only `—` declares no input (the canonical file writes all eleven sections, an empty one as a dash)
            has_input = input.fields.len() > 0 || input.invariants.len() > 0
        }
        None => ()
    }
    // the data: the data of the libraries first, then the data of the machine (the order of `все_данные`, format section 5)
    mut data = []TxJ.new()
    mut lib_data = TxLibData { data: []TxJ.new(), names: []TxLibNames.new() }
    if own226 {
        lib_data = libs_data(lib_runs, cx)
        for d in lib_data.data { data.push(d) }
        // the rows of `## Имена` of the libraries named the declarations of the libraries; the check of the rows of the machine sees its own
        mut kept_rows = []TxJnRow.new()
        mut row_at = 0
        for jn_row in cx.jn.rows {
            if row_at < jn_rows_machine { kept_rows.push(jn_row) }
            row_at += 1
        }
        cx.jn.rows = kept_rows
    }
    match section_of(sections, "Data") {
        Some(sec) => {
            if own226 { contract_data_check(entries, sec, cx) }
            for d in decl_data(entries, sec, cx) { data.push(d) }
        }
        None => ()
    }
    mut party_rows = []TxPartyRow.new()
    mut request_limit = []TxJ.new()
    match section_of(sections, "Parties") {
        Some(sec) => {
            party_rows = decl_parties(entries, sec, cx)
            request_limit = decl_request_limit(entries, sec, cx)
        }
        None => ()
    }
    // the requirements of the libraries: the data, the parties, the ends of the machine (section 9)
    if own226 { libs_requires(lib_runs, blocks, data, cx) }
    match section_of(sections, "Signals") {
        Some(sec) => {
            for sj in decl_signals(entries, sec, cx) { signals.push(sj) }
        }
        None => ()
    }
    mut parts = []TxPartItem.new()
    match section_of(sections, "Response parts") {
        Some(sec) => { parts = decl_parts(entries, sec, cx) }
        None => ()
    }
    mut definitions = []TxJ.new()
    match section_of(sections, "Functions") {
        Some(sec) => { definitions = decl_definitions(entries, sec, cx) }
        None => ()
    }
    // what the included files bring comes before the machine's own
    if own226 && lib_runs.len() > 0 {
        included = TxIncluded { types: lib_decls.types, constants: lib_decls.constants, definitions: lib_decls.definitions, includes: []TxJ.new() }
    }
    if included.includes.len() > 0 || (own226 && lib_runs.len() > 0) {
        mut all_records = []TxJ.new()
        for r in included.types.records { all_records.push(r) }
        for r in types.records { all_records.push(r) }
        mut all_variants = []TxJ.new()
        for v in included.types.variants { all_variants.push(v) }
        for v in types.variants { all_variants.push(v) }
        types = TxTypes { records: all_records, variants: all_variants }
        mut all_constants = []TxJ.new()
        for c in included.constants { all_constants.push(c) }
        for c in constants { all_constants.push(c) }
        constants = all_constants
        mut all_definitions = []TxJ.new()
        for d in included.definitions { all_definitions.push(d) }
        for d in definitions { all_definitions.push(d) }
        definitions = all_definitions
    }

    // the states and the rows that lead between them
    mut initial = ""
    mut common = []TxJ.new()
    mut lib_common = TxLibRows { rows: []TxJ.new(), counts: []int.new() }
    if own226 {
        lib_common = libs_common(lib_runs, cx)
        for r in lib_common.rows { common.push(r) }
    }
    match section_of(sections, "Common events") {
        Some(sec) => {
            for r in common_events_at(entries, sec, cx, common.len()) { common.push(r) }
        }
        None => ()
    }
    mut states = []TxJ.new()
    mut error_end = ""
    match section_of(sections, "States") {
        Some(sec) => {
            initial = initial_state(entries, sec, cx)
            for blk in blocks {
                states.push(state_translate(entries, blk, states.len(), cx))
                if blk.latin == "Errored" && blk.kind == "end" { error_end = blk.latin }
            }
        }
        None => ()
    }
    // the fields of the request of a call are exactly the fields of the input of the called machine (AL-146)
    if own226 && cx.callees.len() > 0 {
        mut callers = []TxJ.new()
        for row in party_rows { callers.push(TxObj(row.pairs)) }
        callees_request_check(states, callers, blocks, cx)
    }
    mut lib_states = TxLibStates { states: []TxJ.new(), names: []TxLibNames.new() }
    if own226 {
        lib_states = libs_states(lib_runs, states.len(), cx)
        for lib_st in lib_states.states { states.push(lib_st) }
    }
    mut ends = TxEnds { result: "", rows: []TxJ.new() }
    match section_of(sections, "Ends") {
        Some(sec) => { ends = decl_ends(entries, sec, cx) }
        None => note(cx, struct_error(1, 1, "нет раздела `## ${kw(cx.words, "section", if cx.v226 { "Output" } else { "Ends" })}`"))
    }
    // the section of the expansion of 2.12 is removed in 2.13 (AL-44)
    for x in classified.expansions { cx.errors.push(expansion_error(x.line, x.name)) }

    // the JSON
    // the root of 2.27 (AL-147): `kind`, `alula_version`, `machine`, `revision` (an integer); the seam of 2.25 keeps `format` and `version`
    mut root = if header.format == "2.25" {
        [kv("format", js("machine/2")), kv("alula_version", js("2.25")), kv("machine", js(header.machine)), kv("version", js(header.version))]
    } else {
        [kv("kind", js("machine")), kv("alula_version", js("2.27")), kv("machine", js(header.machine)), kv("revision", TxRaw(if is_integer_text(header.version) { header.version } else { "1" }))]
    }
    if header.title != "" { root.push(kv("title", js(header.title))) }
    if types.records.len() > 0 || types.variants.len() > 0 {
        mut tp = []TxKV.new()
        if types.records.len() > 0 { tp.push(kv("records", TxArr(types.records))) }
        if types.variants.len() > 0 { tp.push(kv("variants", TxArr(types.variants))) }
        root.push(kv("types", TxObj(tp)))
    }
    if constants.len() > 0 { root.push(kv("constants", TxArr(constants))) }
    if params.len() > 0 { root.push(kv("params", TxArr(params))) }
    if has_input {
        mut ip = [kv("fields", TxArr(input.fields))]
        if input.invariants.len() > 0 { ip.push(kv("invariants", TxArr(input.invariants))) }
        root.push(kv("input", TxObj(ip)))
    }
    if own226 {
        // the data of the engine of the library `контракт` (section 7а) that the machine and its libraries read come first; the engine writes them (`engine: true`)
        ro used = contract_data_used("${tx_text(TxArr(states))}${tx_text(TxArr(common))}${tx_text(TxArr(ends.rows))}")
        if used.len() > 0 {
            mut all_data = []TxJ.new()
            for d in used { all_data.push(d) }
            for d in data { all_data.push(d) }
            data = all_data
        }
    }
    root.push(kv("data", TxArr(data)))
    mut party_list = []TxJ.new()
    for row in party_rows { party_list.push(party_json_in(row, parts, types.records)) }
    root.push(kv("parties", TxArr(party_list)))
    if request_limit.len() > 0 { root.push(kv("request_limit", request_limit[0])) }
    if signals.len() > 0 { root.push(kv("signals", TxArr(signals))) }
    if definitions.len() > 0 { root.push(kv("definitions", TxArr(definitions))) }
    if included.includes.len() > 0 { root.push(kv("includes", TxArr(included.includes))) }
    if own226 && lib_runs.len() > 0 { root.push(kv("includes", TxArr(libs_includes_json(lib_runs, lib_decls, lib_data, lib_common, lib_states, lib_signals, cx)))) }
    root.push(kv("initial", js(initial)))
    if error_end != "" { root.push(kv("error_end", js(error_end))) }
    if common.len() > 0 { root.push(kv("common_events", TxArr(common))) }
    root.push(kv("states", TxArr(states)))
    root.push(kv("ends", jobj([kv("result", js(ends.result)), kv("rows", TxArr(ends.rows))])))
    if primitives.len() > 0 { root.push(kv("primitives", TxArr(primitives))) }

    ro elaborated = el_root(jobj(root))
    for e in el_errors(elaborated) { cx.errors.push(e) }
    jn_finish(cx)
    ro sorted = errors_sorted(cx.errors)
    ro report = TranslateReport { json: tx_text(elaborated.json), errors: errors_quoted(sorted, lines), warnings: errors_quoted(errors_sorted(warnings_all(classified.warnings, cx.warnings)), lines), rows_total: cx.rows_total, rows_noted: cx.rows_noted, places: cx.places, names: jn_report(cx), reads: []StateReads.new() }
    TxFull { report, tree: elaborated.json }
}

// The keys of a file of 2.26 that are items of a list (format 4.1, AL-137): the marker `- ` is obligatory, a key without it is an error (the reading "the marker is optional" of 2.5 is gone);
// the line `Читает:` is no key any more (AL-138: the reads are derived by the check). The header and `Начальное состояние:` are not items of the list of a state.
fn key_lines_226(entries []TxEntry, mut cx TxCx) -> () {
    ro listed = ["Party", "Idle term", "Edits", "Form returns", "Request", "On entry", "On accept", "Except", "Result", "Request limit", "Invariant"]
    for e in entries {
        if e.kind != EN_TEXT || e.indent != 0 || e.colon < 0 || e.fenced { continue }
        if e.key == "Reads" {
            note(cx, struct_error(e.line, 1, "строки `${e.text[..e.colon].trim_ascii()}:` нет: с 2.26 чтения выводятся (AL-138) — проверка выводит их из выражений строк, «${kw(cx.words, "key", "Request")}», «${kw(cx.words, "key", "On accept")}», «${kw(cx.words, "key", "On entry")}» и списков `читает` внешних функций"))
        } else if e.shift == 0 && listed.contains(e.key) {
            note(cx, struct_error(e.line, 1, "строка-ключ без маркера `- `: с 2.26 строка-ключ пишется элементом списка (`- ${e.text[..e.colon].trim_ascii()}: …`, AL-137); markdown склеивает строки без маркера в один абзац"))
        }
    }
}

fn warnings_all(first []TranslateError, second []TranslateError) -> []TranslateError {
    mut out = []TranslateError.new()
    for e in first { out.push(e) }
    for e in second { out.push(e) }
    out
}

/// The first line of the section `## Состояния`: `Начальное состояние: ИМЯ`.
fn initial_state(entries []TxEntry, sec TxSection, mut cx TxCx) -> str {
    mut i = sec.first
    while i < sec.last && entries[i].kind != EN_HEAD {
        if entries[i].kind == EN_TEXT && kv_colon(entries[i]) >= 0 {
            ro line = kv_read(entries, i)
            if line.key == "Initial state" {
                match lex_segs(line.segs) {
                    Ok(p0) => {
                        mut p = p_copy(p0)
                        ro t = p_tok(p)
                        if t.kind == TK_NAME {
                            match pair_get(cx.env.states, t.text) {
                                Some(latin) => return latin
                                None => {
                                    cx_error(cx, t, "name", "состояния `${t.text}` нет в этой машине${state_hint(cx, t.text)}")
                                    return t.text
                                }
                            }
                        }
                        note(cx, p_fail(p, "после `${kw(cx.words, "key", "Initial state")}:` ожидается имя состояния"))
                    }
                    Err(e) => note(cx, e)
                }
                return ""
            }
        }
        i += 1
    }
    note(cx, struct_error(sec.line, 4, "в разделе `${sec.title}` первая строка — `${kw(cx.words, "key", "Initial state")}: ИМЯ`"))
    ""
}

/// The section `## Общие события`: the rows of signals that are tried before the rows of a state. `already` rows are before them (the libraries').
fn common_events_at(entries []TxEntry, sec TxSection, mut cx TxCx, already int) -> []TxJ {
    mut out = []TxJ.new()
    mut i = sec.first
    while i < sec.last {
        ro e = entries[i]
        if e.kind == EN_ROW {
            out = rows_read_from(entries, i, sec.last, "appeal", "$.common_events", already, cx, sc_empty())
            i = tab_end(entries, i, sec.last, cx.words)
        } else if e.kind == EN_TEXT && e.text == "—" {
            dash_line(cx, e)
            i += 1
        } else {
            note(cx, struct_error(e.line, e.indent + 1, "лишняя строка в разделе `${sec.title}`"))
            i += 1
        }
    }
    out
}

/// The translation of a file of a machine: the JSON `machine/2` or every error with `line:column` and the quoted line.
export fn translate(file_text str) -> Result[str, []TranslateError] {
    ro report = translate_report(file_text)
    if report.errors.len() > 0 { return Err(report.errors) }
    Ok(report.json)
}
