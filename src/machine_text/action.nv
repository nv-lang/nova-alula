// action.nv - the actions of a row, of "On accept" and of "On entry" (format section 5) as the actions of the JSON.
//
// A list of actions is separated by `;` and every action sees the results of the earlier ones. `пусть имя = выр` binds a name for the actions after it in "On entry" and "On accept";
// inside a block `{ … }` (AL-73, AL-74) the name lives up to the closing brace: `{ пусть имя = выр; действия }` (the action `пусть … в` is gone). A conditional action and the body of a loop are
// blocks (AL-70, AL-72). What the format has and this version does not run (`передать` to nested machines, the exceptions of `отменить_открытые`) is a soft error of the kind `unsupported`: it is
// written down with its place and the translation goes on without it.
module alula.machine_text

import std.text

/// The error "not supported in this version", with the place.
fn unsupported(t TxTok, what str) -> TranslateError => { line: t.line, col: t.col, kind: "unsupported", message: "не поддержано в этой версии: ${what}", quote: "" }

fn cx_unsupported(mut cx TxCx, t TxTok, what str) -> () {
    cx.errors.push(unsupported(t, what))
}

/// TxStmt: the JSON of an action (none for a construction that is a no-op or not supported) and the name that a `пусть` binds for the next ones (with its value, for a block).
type TxStmt { actions []TxJ, bind_ru str, bind_en str, bind_value TxJ }

fn stmt_of(actions []TxJ) -> TxStmt => { actions, bind_ru: "", bind_en: "", bind_value: x_null() }

fn stmt_none() -> TxStmt => { actions: []TxJ.new(), bind_ru: "", bind_en: "", bind_value: x_null() }

fn is_latin_code(w str) -> bool {
    if w.byte_len() == 0 { return false }
    for c in w.chars() {
        ro one = "${c}"
        ro ok = (one >= "a" && one <= "z") || (one >= "0" && one <= "9") || one == "_"
        if !ok { return false }
    }
    true
}

/// A block of actions `{ действия }` (AL-74): the actions in order; a `пусть` inside binds its name up to the closing brace (AL-73). The block is not empty.
fn ac_block(mut p TxP, mut cx TxCx, sc TxScope) -> Result[[]TxJ, TranslateError] {
    ro open = p_tok(p)
    p_expect(p, "{")?
    if p_is(p, "}") { return Err(tx_err(open.line, open.col, "syntax", "пустой блок `{ }` не бывает (AL-70, AL-74): в блоке есть действие")) }
    ro out = ac_block_items(p, cx, sc)?
    p_expect(p, "}")?
    Ok(out)
}

// The actions of a block up to its closing brace; a `пусть` takes the rest of the block as its body.
fn ac_block_items(mut p TxP, mut cx TxCx, sc TxScope) -> Result[[]TxJ, TranslateError] {
    mut out = []TxJ.new()
    while true {
        if p_done(p) || p_is(p, "}") { break }
        ro one = ac_stmt(p, cx, sc)?
        if one.bind_ru != "" {
            ro more = p_eat(p, ";")
            ro rest = ac_block_items(p, cx, sc_with(sc, one.bind_ru, one.bind_en))?
            if rest.len() == 0 { return Err(p_fail(p, "после `${kw(cx.words, "action", "let")}` в блоке ожидается действие (AL-73)")) }
            out.push(a_let(one.bind_en, one.bind_value, rest))
            return Ok(out)
        }
        for a in one.actions { out.push(a) }
        if p_eat(p, ";") { continue }
        break
    }
    Ok(out)
}

// The branch of a conditional action: a block; the word before it is `то`/`else` (AL-70).
fn ac_branch(mut p TxP, mut cx TxCx, sc TxScope, word str) -> Result[[]TxJ, TranslateError] {
    if !p_is(p, "{") {
        ro message_tail = if p_is(p, "(") { ": круглые скобки вокруг действий в формате 2.22 не бывают" } else { "" }
        return Err(p_fail(p, "после `${word}` ожидается блок `{ … }` (AL-70)${message_tail}"))
    }
    ac_block(p, cx, sc)
}

/// TxActList: the actions of a list and the scope after them (the bindings of `пусть` that the rows of the state see).
type TxActList { actions []TxJ, scope TxScope }

/// The actions up to the end of the tokens or a `)`. A lone `—` is no action.
fn ac_list(mut p TxP, mut cx TxCx, sc TxScope) -> Result[[]TxJ, TranslateError] {
    ro all = ac_list_scoped(p, cx, sc)?
    Ok(all.actions)
}

fn ac_list_scoped(mut p TxP, mut cx TxCx, sc TxScope) -> Result[TxActList, TranslateError] {
    mut out = []TxJ.new()
    mut scope = sc_clone(sc)
    while true {
        if p_done(p) || p_is(p, ")") { break }
        if p_is(p, "—") {
            p_adv(p)
            if p_eat(p, ";") { continue }
            break
        }
        ro one = ac_stmt(p, cx, scope)?
        for a in one.actions { out.push(a) }
        if one.bind_ru != "" { scope = sc_with(scope, one.bind_ru, one.bind_en) }
        if p_eat(p, ";") { continue }
        break
    }
    Ok(TxActList { actions: out, scope })
}

fn ac_stmt(mut p TxP, mut cx TxCx, sc TxScope) -> Result[TxStmt, TranslateError] {
    ro t = p_tok(p)
    if t_is(t, "{") { return Ok(stmt_of(ac_block(p, cx, sc)?)) }
    if t.kind != TK_NAME { return Err(p_fail(p, "ожидается действие")) }
    ro w = t.text
    ro words = cx.words
    ro opens = t_is(p_ahead(p, 1), "(")
    if t_is_kw(t, words, "action", "journal") && opens { return ac_journal(p, cx, sc) }
    if t_is_kw(t, words, "action", "machine_error") && opens { return ac_machine_error(p, cx, sc) }
    if t_is_kw(t, words, "action", "for") { return ac_for(p, cx, sc) }
    if t_is_kw(t, words, "action", "if") { return ac_if(p, cx, sc) }
    if t_is_kw(t, words, "action", "let") { return ac_let(p, cx, sc) }
    if t_is_kw(t, words, "action", "cancel_open") { return ac_cancel(p, cx, sc) }
    if t_is_kw(t, words, "action", "pass") && opens { return ac_pass(p, cx) }
    if is_keyword(words, w) { return Err(p_fail(p, "ожидается действие")) }
    match foreign_find(cx, t, ["action"]) {
        Some(e) => return Err(e)
        None => ()
    }
    // `имя(арг);` — a call of an external function as an action (AL-123); `вызвать(…)` of the formats before 2.24 is refused with the new writing
    if opens {
        match former_find(words.lang, "call", w) {
            Some(f) => return Err(tx_err(t.line, t.col, "syntax", former_message(f)))
            None => ()
        }
        if pair_has(cx.env.prims, w) || standard_call(cx, w) { return ac_call(p, cx, sc) }
        // a name with brackets in the place of an action is a call of an external function; it must be declared (AL-123)
        if !pair_has(cx.env.defs, w) && kw_key(words, "catalog", w) == None {
            return Err(tx_err(t.line, t.col, "name", "внешняя функция `${w}` не объявлена: она объявляется строкой раздела `## ${kw(words, "section", "External functions")}` (AL-123)"))
        }
    }
    ac_assign(p, cx, sc)
}

// Is the word the external function that the language declares beforehand (`новый_ид`, 7а)?
fn standard_call(cx TxCx, w str) -> bool {
    match kw_key(cx.words, "catalog", w) {
        Some(en) => en == "new_id"
        None => false
    }
}

// `поле = выр`, `поле += выр`, `поле[ключ] = выр`, `поле[ключ].поле = выр`.
fn ac_assign(mut p TxP, mut cx TxCx, sc TxScope) -> Result[TxStmt, TranslateError] {
    ro root = p_tok(p)
    p_adv(p)
    ro root_en = tr_global(cx, root)
    mut steps = []TxJ.new()
    while true {
        if p_eat(p, "[") {
            ro key = ex_expr(p, cx, sc)?
            p_expect(p, "]")?
            steps.push(a_step_key(key))
            continue
        }
        if p_is(p, ".") && p_ahead(p, 1).kind == TK_NAME {
            p_adv(p)
            ro f = p_tok(p)
            p_adv(p)
            steps.push(a_step_field(tr_field_name(cx, f)))
            continue
        }
        break
    }
    ro target = a_target(root_en, steps)
    if p_eat(p, "=") {
        ro value = ex_expr(p, cx, sc)?
        return Ok(stmt_of([a_assign(target, value)]))
    }
    if p_eat(p, "+=") {
        ro value = ex_expr(p, cx, sc)?
        return Ok(stmt_of([a_add(target, value)]))
    }
    Err(p_fail(p, "после имени ожидается `=` или `+=`"))
}

// The named parameters `имя: выр, …` after the first argument of `журнал` and `ошибка_машины`; the names are Latin words of the journal.
fn ac_named(mut p TxP, mut cx TxCx, sc TxScope) -> Result[[]TxKV, TranslateError] {
    mut params = []TxKV.new()
    while p_eat(p, ",") {
        ro n = p_tok(p)
        if n.kind != TK_NAME || !t_is(p_ahead(p, 1), ":") { return Err(p_fail(p, "ожидается параметр вида `имя: выр`")) }
        if !is_latin_code(n.text) { cx_error(cx, n, "name", "имя параметра журнала — латиница в нижнем регистре (правило 34б)") }
        p_adv(p)
        p_adv(p)
        ro value = ex_expr(p, cx, sc)?
        for seen in params {
            if seen.key == n.text { cx_error(cx, n, "syntax", "параметр `${n.text}` повторён") }
        }
        params.push(kv(n.text, value))
    }
    Ok(params)
}

// `журнал("код", имя: выр, …)`, `журнал("код")`, `журнал(все_данные)`, `журнал(выражение)` (AL-115): the code of an entry is a string literal in Latin lower case; the code without quotes (2.22) is refused with the new writing.
fn ac_journal(mut p TxP, mut cx TxCx, sc TxScope) -> Result[TxStmt, TranslateError] {
    p_adv(p)
    p_adv(p)
    ro first = p_tok(p)
    ro after = p_ahead(p, 1)
    if first.kind == TK_STR && (t_is(after, ",") || t_is(after, ")")) {
        p_adv(p)
        if !is_latin_code(first.text) { cx_error(cx, first, "name", "код журнала — латиница в нижнем регистре (правило 34б)") }
        ro params = ac_named(p, cx, sc)?
        p_expect(p, ")")?
        return Ok(stmt_of([a_journal(first.text, params)]))
    }
    if first.kind == TK_NAME && (t_is(after, ",") || t_is(after, ")")) {
        if t_is_kw(first, cx.words, "readable", "all_data") {
            p_adv(p)
            p_expect(p, ")")?
            return Ok(stmt_of([a_journal_all()]))
        }
        ro known = pair_has(sc.names, first.text) || pair_has(cx.env.globals, first.text) || is_executor_word(cx, first.text)
        if !known && is_identifier_latin(first.text) {
            ro message_tail = if t_is(after, ",") { ", имя: выр, …" } else { "" }
            return Err(tx_err(first.line, first.col, "syntax", "код журнала без кавычек в формате 2.22 не бывает (AL-115): пишется `${kw(cx.words, "action", "journal")}(\"${first.text}\"${message_tail})`; переходного периода нет"))
        }
    }
    ro value = ex_expr(p, cx, sc)?
    p_expect(p, ")")?
    Ok(stmt_of([a_journal_value(value)]))
}

fn is_executor_word(cx TxCx, w str) -> bool {
    match readable_json(cx.words, w) {
        Some(en) => true
        None => false
    }
}

fn ac_machine_error(mut p TxP, mut cx TxCx, sc TxScope) -> Result[TxStmt, TranslateError] {
    p_adv(p)
    p_adv(p)
    ro first = p_tok(p)
    if first.kind != TK_STR { return Err(p_fail(p, "первый аргумент `${kw(cx.words, "action", "machine_error")}` — код в кавычках")) }
    p_adv(p)
    ro params = ac_named(p, cx, sc)?
    p_expect(p, ")")?
    Ok(stmt_of([a_machine_error(first.text, params)]))
}

// `имя(арг, …)` as an action: a call of an external function in the place of an action (AL-123); the pairs of the named tail are `ключ: значение` after the positional arguments (AL-129).
fn ac_call(mut p TxP, mut cx TxCx, sc TxScope) -> Result[TxStmt, TranslateError] {
    ro n = p_tok(p)
    p_adv(p)
    ro args = ex_args(p, cx, sc)?
    if cx.env.in_defs_file && standard_call(cx, n.text) {
        cx_error(cx, n, "check", "в файле функций нет внешних функций (AL-123): `${n.text}` — стандартная внешняя функция, её зовёт машина")
    }
    ro node = match pair_get(cx.env.prims, n.text) {
        Some(en) => ext_call_action(cx, n, en, args)
        None => {
            named_refused(cx, n.text, args.named_tokens)
            ro std_en = kw_key(cx.words, "catalog", n.text) ?? n.text
            a_call(std_en, args.positional)
        }
    }
    Ok(stmt_of([node]))
}

fn ext_call_action(mut cx TxCx, name TxTok, prim_en str, args TxArgs) -> TxJ {
    if args.named.len() == 0 { return a_call(prim_en, args.positional) }
    if !pair_has(cx.env.tails, name.text) {
        named_refused(cx, name.text, args.named_tokens)
        return a_call(prim_en, args.positional)
    }
    mut seen = []str.new()
    mut at = 0
    for n in args.named {
        if seen.contains(n.key) { cx_error(cx, args.named_tokens[at], "check", "ключ `${n.key}` повторён в вызове `${name.text}` (AL-129)") }
        seen.push(n.key)
        at += 1
    }
    a_call_named(prim_en, args.positional, args.named)
}

// `для имя из выр { действия }` (AL-72, AL-97; in English `for x in xs { … }`).
fn ac_for(mut p TxP, mut cx TxCx, sc TxScope) -> Result[TxStmt, TranslateError] {
    p_adv(p)
    ro head = p_tok(p)
    if head.kind == TK_NAME {
        match former_find(cx.words.lang, "word", head.text) {
            Some(f) => return Err(tx_err(head.line, head.col, "syntax", former_message(f)))
            None => ()
        }
    }
    ro n = p_tok(p)
    if n.kind != TK_NAME { return Err(p_fail(p, "после `${kw(cx.words, "action", "for")}` ожидается имя")) }
    p_adv(p)
    if p_is_kw(p, cx.words, "operator", "in") && !p_is_kw(p, cx.words, "action", "in") {
        return Err(tx_err(p_tok(p).line, p_tok(p).col, "syntax", "цикл `${kw(cx.words, "action", "for")} ${n.text} ${p_tok(p).text} …` в формате 2.22 не бывает (AL-97): пишется `${kw(cx.words, "action", "for")} ${n.text} ${kw(cx.words, "action", "in")} выр { … }`; переходного периода нет"))
    }
    p_expect_kw(p, cx.words, "action", "in")?
    ro list_expr = ex_expr(p, cx, sc)?
    if p_is(p, ":") { return Err(tx_err(p_tok(p).line, p_tok(p).col, "syntax", "двоеточие после списка цикла в формате 2.22 не бывает (AL-72): тело цикла — блок `{ действия }`; переходного периода нет")) }
    ro en = tr_binder(cx, n)
    ro body = ac_branch(p, cx, sc_with(sc, n.text, en), kw(cx.words, "action", "in"))?
    Ok(stmt_of([a_for_each(en, list_expr, body)]))
}

// `если выр то { действия } иначе { действия }` (AL-70): the branches are blocks, `иначе` is optional.
fn ac_if(mut p TxP, mut cx TxCx, sc TxScope) -> Result[TxStmt, TranslateError] {
    p_adv(p)
    ro cond = ex_expr(p, cx, sc)?
    p_expect_kw(p, cx.words, "action", "then")?
    ro then_actions = ac_branch(p, cx, sc, kw(cx.words, "action", "then"))?
    mut else_actions = []TxJ.new()
    if p_eat_kw(p, cx.words, "action", "else") { else_actions = ac_branch(p, cx, sc, kw(cx.words, "action", "else"))? }
    Ok(stmt_of([a_if(cond, then_actions, else_actions)]))
}

// `пусть имя = выр`: bound for the next actions (the action `пусть имя = выр в действия` is gone, AL-73).
fn ac_let(mut p TxP, mut cx TxCx, sc TxScope) -> Result[TxStmt, TranslateError] {
    p_adv(p)
    ro n = p_tok(p)
    if n.kind != TK_NAME { return Err(p_fail(p, "после `${kw(cx.words, "action", "let")}` ожидается имя")) }
    p_adv(p)
    p_expect(p, "=")?
    ro value = ex_expr(p, cx, sc)?
    if p_is_kw(p, cx.words, "action", "in") || p_is_kw(p, cx.words, "operator", "in") {
        return Err(tx_err(p_tok(p).line, p_tok(p).col, "syntax", "действие `${kw(cx.words, "action", "let")} … ${p_tok(p).text} …` в формате 2.22 не бывает (AL-73): локальное имя — блок `{ ${kw(cx.words, "action", "let")} имя = выр; действия }`; переходного периода нет"))
    }
    ro en = tr_binder(cx, n)
    Ok(TxStmt { actions: [a_bind(en, value)], bind_ru: n.text, bind_en: en, bind_value: value })
}

// `отменить_открытые`, `отменить_открытые(сторона: имя)`, `отменить_открытые(кроме: вложенные)`.
fn ac_cancel(mut p TxP, mut cx TxCx, sc TxScope) -> Result[TxStmt, TranslateError] {
    ro head = p_tok(p)
    p_adv(p)
    if !p_eat(p, "(") { return Ok(stmt_of([a_cancel_open("")])) }
    ro key = p_tok(p)
    if key.kind != TK_NAME || !t_is(p_ahead(p, 1), ":") { return Err(p_fail(p, "в скобках `${kw(cx.words, "action", "cancel_open")}` ожидается `${kw(cx.words, "action", "except")}: …` или `${kw(cx.words, "action", "party")}: …`")) }
    p_adv(p)
    p_adv(p)
    if t_is_kw(key, cx.words, "action", "party") {
        ro party = p_tok(p)
        if party.kind != TK_NAME { return Err(p_fail(p, "ожидается имя стороны")) }
        p_adv(p)
        p_expect(p, ")")?
        match pair_get(cx.env.parties, party.text) {
            Some(en) => return Ok(stmt_of([a_cancel_open(en)]))
            None => {
                cx_error(cx, party, "name", "стороны `${party.text}` нет в таблице «Стороны»")
                return Ok(stmt_none())
            }
        }
    }
    if t_is_kw(key, cx.words, "action", "except") {
        ro names = ac_nested_list(p, cx)?
        p_expect(p, ")")?
        if names.len() == 0 { return Ok(stmt_of([a_cancel_open("")])) }
        return Ok(stmt_of([a_cancel_open_except(names_list_json(names))]))
    }
    Err(p_fail(p, "в скобках `${kw(cx.words, "action", "cancel_open")}` ожидается `${kw(cx.words, "action", "except")}: …` или `${kw(cx.words, "action", "party")}: …`"))
}

// The list of the nested machines as the expression of a list of text literals (the names of the registry of the caller).
fn names_list_json(names []str) -> TxJ {
    mut items = []TxJ.new()
    for n in names { items.push(x_lit(js(n))) }
    x_list(items)
}

// A list of nested machines: `[a, b]` (the names of the registry) or the name of a parameter of a fragment (`вложенные`) that was given a list. An empty list gives no name.
fn ac_nested_list(mut p TxP, mut cx TxCx) -> Result[[]str, TranslateError] {
    mut out = []str.new()
    if p_eat(p, "[") {
        while !p_is(p, "]") {
            ro item = p_tok(p)
            if item.kind != TK_NAME { return Err(p_fail(p, "в списке ожидаются имена вложенных машин")) }
            p_adv(p)
            out.push(nested_name(cx, item))
            if p_eat(p, ",") { continue }
            break
        }
        p_expect(p, "]")?
        return Ok(out)
    }
    ro n = p_tok(p)
    if n.kind == TK_NAME {
        p_adv(p)
        if cx.env.empty_lists.contains(n.text) { return Ok(out) }
        match pair_get(cx.env.nested_lists, n.text) {
            Some(joined) => {
                for one in joined.split(",") {
                    if one != "" { out.push(one) }
                }
                return Ok(out)
            }
            None => ()
        }
    }
    Err(p_fail(p, "ожидается список вложенных машин в скобках или параметр фрагмента"))
}

// `передать(вложенные, сигнал)`: the signal `stop`, `continue`, `halt` or `cancel` to the nested machines of the list; a pass to nobody is nothing.
fn ac_pass(mut p TxP, mut cx TxCx) -> Result[TxStmt, TranslateError] {
    p_adv(p)
    p_adv(p)
    ro names = ac_nested_list(p, cx)?
    p_expect(p, ",")?
    ro signal = p_tok(p)
    if signal.kind != TK_NAME { return Err(p_fail(p, "ожидается имя сигнала: ${signal_words_ru(cx.words).join(", ")}")) }
    p_adv(p)
    p_expect(p, ")")?
    mut key = ""
    match kw_key(cx.words, "enum_value", signal.text) {
        Some(k) => { key = k }
        None => ()
    }
    if key != "stop" && key != "continue" && key != "halt" && key != "cancel" {
        return Err(tx_err(signal.line, signal.col, "syntax", "сигнал: ${signal_words_ru(cx.words).join(", ")}, найдено: ${t_shown(signal)}"))
    }
    if names.len() == 0 { return Ok(stmt_none()) }
    Ok(stmt_of([a_pass(names_list_json(names), key)]))
}

fn signal_words_ru(w TxWords) -> []str => kw_all(w, "enum_value", ["stop", "continue", "halt", "cancel"])
