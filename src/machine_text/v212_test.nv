// v212_test.nv - task 125: the dictionary of the methodology of version 10 (AL-37): the datum `источник_запуска` is `launch_source`, no longer `source`, so that it does not shadow the binding
// `source` of the words of the fragment "Pause" (AL-26); and the table of words of 2.12 (the same as 2.11: the table `spec/alula-keywords.tsv` did not change).
module alula.machine_text

import std.text
import alula.machine.{text_of_file}
import alula.examples.{table_files}

test "v212 fragment files are 2.22" {
    assert(fragment_source("Pause", "ru").contains("- format: 2.22"))
    assert(fragment_source("Pause", "en").contains("- format: 2.22"))
    assert(!fragment_source("Pause", "ru").contains("- format: 2.11"))
    assert(!fragment_source("Pause", "en").contains("- format: 2.11"))
}

test "v212 fragment files carry the parameters" {
    for lang in ["ru", "en"] {
        ro text = fragment_source("Pause", lang)
        for key in pause_param_keys() {
            ro name = kw(words_load(lang), "fragment_param", key)
            assert(name != "")
        }
        assert(text.contains("Pause") || text.contains("Пауза"))
    }
}

// ---- what the fragment brings (the shape the generator leaves out) is what the translator puts in --------------------------------------------------------

test "v212 fragment shape of an unknown fragment is empty" {
    ro shape = fragment_shape("Rest")
    assert(shape.data.len() == 0 && shape.common == 0 && shape.states.len() == 0 && shape.signals.len() == 0)
}
