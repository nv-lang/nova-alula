// decl.nv - the declarations of a machine: the types (section 2), the constants, the parameters, the input, the data, the parties (section 1), the signals and
// the parts of an answer, the definitions (section 8) and the primitives (section 7), each as its part of the JSON.
module alula.machine_text

// ORACLE-WORKAROUND(32): `import std.text` is needed in `nova build` for `[]str.join` (a `nova test` build has it already); drop the import when item 32 is fixed
import std.text
import alula.machine_table.{fail_code_names}

// ---- helpers -------------------------------------------------------------------------------------------------------------------------

// The snake case of a name of the dictionary: `NoResult` -> `no_result`, `SwitchMode` -> `switch_mode`.
fn snake_of(name str) -> str {
    mut out = []str.new()
    mut prev_lower = false
    for c in name.chars() {
        ro upper = tx_is_upper(c)
        if upper && prev_lower { out.push("_") }
        out.push(tx_lower_char(c))
        prev_lower = !upper
    }
    out.join("")
}

// A name that stays inside the machine (a constant, a parameter, a definition, a party): it is written to the tree as it is (AL-46); a keyword cannot be one.
fn decl_internal(mut cx TxCx, t TxTok) -> str {
    if is_keyword(cx.words, t.text) { cx_error(cx, t, "name", "`${t.text}` — служебное слово, именем быть не может") }
    t.text
}

// A name that leaves the machine: its JSON name is the row of `## Имена` or is built by itself (AL-53, AL-60).
fn decl_exported(mut p TxP, mut cx TxCx, t TxTok, what str, space str, path []str) -> Result[str, TranslateError] {
    if is_keyword(cx.words, t.text) { cx_error(cx, t, "name", "`${t.text}` — служебное слово, именем быть не может") }
    decl_json(p, cx, t, what, space, path)
}

// The path of a name under the owner that is being read (`cx.env.opath`): the owner and the name.
fn path_under(cx TxCx, name str) -> []str {
    mut out = []str.new()
    for o in cx.env.opath { out.push(o) }
    out.push(name)
    out
}

// The word of the stamp of the event in the language of the file: `момент` (`событие.момент`), `at` (`event.at`).
fn ev_stamp_word(cx TxCx) -> str {
    ro full = kw(cx.words, "readable", "event.at")
    ro dot = full.find(".") ?? -1
    if dot >= 0 { return full[dot + 1..] }
    full
}

// A field `имя тип` of a record, of a case or of a signal; returns the JSON {"name", "type"}. `what` says whose field it is in a message; the owner of the field is `cx.env.opath`.
fn decl_field(mut p TxP, mut cx TxCx, what str) -> Result[TxJ, TranslateError] {
    ro n = p_tok(p)
    if n.kind != TK_NAME { return Err(p_fail(p, "ожидается имя поля")) }
    p_adv(p)
    if p_is(p, ":") { return Err(tx_err(p_tok(p).line, p_tok(p).col, "syntax", "после имени поля тип пишется без двоеточия (формат 2.3)")) }
    ro en = decl_exported(p, cx, n, what, "${what}:${cx.env.opath.join(".")}", path_under(cx, n.text))?
    // AL-78, AL-106: a field named as a list function of the catalog is told apart from the call of the list function by the brackets (`x.count` and `x.count(…)`): a warning, not an error, because the machines of the product have a field `count`
    // (AL-106 of the specification says so since the commit 87f59cb of the methodology)
    if is_macro_word(cx.words, n.text) {
        cx.warnings.push(tx_err(n.line, n.col, "warning", "поле `${n.text}` названо как функция списка каталога (AL-78, AL-106): `x.${n.text}` — поле, `x.${n.text}(…)` — вызов функции списка, их отличают скобки"))
    }
    if p_is(p, ":") { return Err(tx_err(p_tok(p).line, p_tok(p).col, "syntax", "после имени поля тип пишется без двоеточия (формат 2.3)")) }
    // AL-134: the field of a signal, of a part of an answer or of a form is read as `событие.<поле>`; the name of the stamp of the event (`момент` / `at`) is taken, a record may have it (it is not read after `событие`)
    if cx.env.opath.len() != 1 && n.text == ev_stamp_word(cx) {
        cx_error(cx, n, "check", "имя поля `${n.text}` занято читаемым именем `${kw(cx.words, "readable", "event.at")}` (AL-134): штамп события; поле сигнала, части ответа или формы так не называется")
    }
    declare_field(cx, n, en)
    ro type_text = ty_parse(p, cx)?
    Ok(jobj([kv("name", js(en)), kv("type", js(type_text))]))
}

// The fields up to `close` (not read): `имя тип, имя тип`, a trailing comma allowed.
fn decl_fields(mut p TxP, mut cx TxCx, close str, what str) -> Result[[]TxJ, TranslateError] {
    mut out = []TxJ.new()
    while !p_is(p, close) {
        if p_done(p) { return Err(p_fail(p, "ожидается `${close}`")) }
        out.push(decl_field(p, cx, what)?)
        if p_eat(p, ",") { continue }
        break
    }
    Ok(out)
}

// ---- the types -----------------------------------------------------------------------------------------------------------------------------

/// TxTypes: the records and the enumerations (the tree key `variants`) of the section `## Типы`.
type TxTypes { records []TxJ, variants []TxJ }

fn same_names(first []str, second []str) -> bool {
    if first.len() != second.len() { return false }
    for a in first {
        if !second.contains(a) { return false }
    }
    true
}

// Is the word of an enum value a Latin word of a code: lower case letters, digits, `_`, the first one a letter?
fn word_is_code(w str) -> bool {
    if w == "" { return false }
    mut first = true
    for c in w.chars() {
        ro one = "${c}"
        ro letter = one >= "a" && one <= "z"
        ro digit = one >= "0" && one <= "9"
        if first && !letter { return false }
        if !letter && !digit && one != "_" { return false }
        first = false
    }
    true
}

/// TxTypeDecl: the result of one declaration `тип …`: a record or an enumeration (the JSON, none for the built-in `КодСбоя`).
type TxTypeDecl { record bool, json Option[TxJ] }

// The last column that a token of the line occupies (the end of the code of the line, a comment not counted): the tokens of the line `line` from the place of the reader.
fn line_end_col(p TxP, line int) -> int {
    mut end = 0
    mut k = p.pos
    while k < p.toks.len() && p.toks[k].line == line {
        ro t = p.toks[k]
        ro w = t.raw.chars().count()
        if t.col + w - 1 > end { end = t.col + w - 1 }
        k += 1
    }
    end
}

/// `тип Имя перечисление …` (AL-99, as D406 of Nova; the values `Эл = "значение"` AL-41, AL-89), after the words `тип Имя перечисление`. On one line: `тип Имя перечисление Эл | Эл2` — only bare names, the line not longer
/// than 100 signs, no `|` before the first one. On several lines: the header, then a form on a line that starts with `|`: `| Эл`, `| Эл = "значение"`, `| Вар { поле тип, … }`. The type has either values at the elements or fields
/// at the forms. The JSON is one node of the variants: the cases, and the pairs `values` when there are values.
fn decl_enum(mut p TxP, mut cx TxCx, n TxTok, header_line int) -> Result[TxTypeDecl, TranslateError] {
    ro type_en = decl_exported(p, cx, n, "типа", "типы", [n.text])?
    pair_add(cx.env.types, n.text, type_en)
    mut cases = []TxJ.new()
    mut case_names = []str.new()
    mut word_pairs = []TxJ.new()
    mut word_owners = []TxPair.new()
    mut with_fields = false
    mut with_values = false
    // an enumeration with fields at its forms (AL-99): its parts are forms, else they are elements of the enumeration (the kind of the declaration in the messages and in the list of the names)
    mut fields_ahead = false
    mut look = p.pos
    while look < p.toks.len() {
        ro lt = p.toks[look]
        if lt.kind == TK_NAME && lt.col == 1 && (lt.text == kw(cx.words, "decl", "type") || former_is(cx.words.lang, "decl", lt.text)) { break }
        if t_is(lt, "{") { fields_ahead = true }
        look += 1
    }
    // the label of the kind of the declaration is the label of the reference script of the package (`tools/check-alula-keywords.py`, AL-110: "формы" for a form with fields): the tests compare the lists of names by it
    ro form_what = if fields_ahead { "формы" } else { "элемента перечисления" }
    ro form_space = if fields_ahead { "формы:" } else { "элементы:" }
    ro one_line = !p_done(p) && p_tok(p).line == header_line
    if one_line && p_is(p, "|") { return Err(tx_err(p_tok(p).line, p_tok(p).col, "syntax", "в записи перечисления на одной строке `|` перед первым элементом не бывает (AL-99): `тип Имя перечисление Эл | Эл2`; в несколько строк — заголовок и строки `  | Эл`")) }
    if p_done(p) || (!one_line && !p_is(p, "|")) { return Err(p_fail(p, "после `${kw(cx.words, "decl", "enum")}` ожидаются элементы перечисления")) }
    while true {
        if !one_line {
            // a form starts the line with `|`
            ro bar = p_tok(p)
            if !t_is(bar, "|") { break }
            if bar.line == header_line { break }
            p_adv(p)
        }
        ro c = p_tok(p)
        if c.kind != TK_NAME { return Err(p_fail(p, "ожидается элемент перечисления")) }
        if one_line && c.line != header_line { return Err(tx_err(c.line, c.col, "syntax", "запись перечисления на одной строке не переносится (AL-99): элементы — на строке заголовка или каждый на своей строке с `|`")) }
        p_adv(p)
        ro case_en = decl_exported(p, cx, c, form_what, "${form_space}${n.text}", [n.text, c.text])?
        pair_add(cx.env.cases, c.text, case_en)
        pair_add(cx.env.case_types, c.text, type_en)
        mut has_fields = false
        mut fields = []TxJ.new()
        if p_tok(p).kind == TK_STR && p_tok(p).line == c.line {
            return Err(tx_err(p_tok(p).line, p_tok(p).col, "syntax", "значение элемента пишется через `=`: `${c.text} = \"значение\"` (AL-89); `${c.text} \"значение\"` в формате 2.22 не бывает; переходного периода нет"))
        }
        if p_is(p, "=") {
            if one_line { return Err(tx_err(p_tok(p).line, p_tok(p).col, "syntax", "значение элемента в записи на одной строке не бывает (AL-99): заголовок `тип Имя перечисление` и строки `  | ${c.text} = \"значение\"`")) }
            p_adv(p)
            ro word = p_tok(p)
            if word.kind != TK_STR { return Err(p_fail(p, "после `=` ожидается значение в кавычках")) }
            p_adv(p)
            with_values = true
            if word.text == "" {
                cx_error(cx, word, "syntax", "значение `${c.text}` не может быть пустым")
            } else if !word_is_code(word.text) {
                cx_error(cx, word, "syntax", "значение `${c.text}` — \"${word.text}\": значение перечисления — латинский код (строчные буквы, цифры, `_`, первая — буква)")
            } else if pair_has_en(word_owners, word.text) {
                cx_error(cx, word, "syntax", "значение \"${word.text}\" повторено: оно уже у элемента `${pair_owner(word_owners, word.text)}`")
            } else {
                word_owners.push(TxPair { ru: c.text, en: word.text })
                if type_en == "FailCode" {
                    if word.text != snake_of(case_en) {
                        cx_unsupported(cx, word, "значение \"${word.text}\" у `${c.text}` не равно значению кода движка `${snake_of(case_en)}` (значения КодСбоя — значения движка)")
                    }
                } else {
                    word_pairs.push(TxArr([js(case_en), js(word.text)]))
                }
            }
        } else if p_is(p, "{") {
            if one_line { return Err(tx_err(p_tok(p).line, p_tok(p).col, "syntax", "форма с полями в записи на одной строке не бывает (AL-99): заголовок `тип Имя перечисление` и строки `  | ${c.text} { поле тип }`")) }
            p_adv(p)
            cx.env.owner = c.text
            cx.env.opath = [n.text, c.text]
            fields = decl_fields(p, cx, "}", "поля")?
            cx.env.owner = ""
            cx.env.opath = []str.new()
            p_expect(p, "}")?
            has_fields = true
            with_fields = true
        } else if p_is(p, "(") {
            return Err(tx_err(p_tok(p).line, p_tok(p).col, "syntax", "поля формы пишутся в фигурных скобках `${c.text} { поле тип }` (AL-82); круглые скобки — только у функций; переходного периода нет"))
        }
        case_names.push(case_en)
        if has_fields {
            cases.push(jobj([kv("name", js(case_en)), kv("fields", TxArr(fields))]))
        } else {
            cases.push(jobj([kv("name", js(case_en))]))
        }
        if one_line {
            if p_eat(p, "|") { continue }
            break
        }
        // the next form is on the next line; two forms on one line are an error
        if !p_done(p) && t_is(p_tok(p), "|") && p_tok(p).line == c.line {
            return Err(tx_err(p_tok(p).line, p_tok(p).col, "syntax", "в записи перечисления в несколько строк каждая форма — на своей строке с `|` (AL-99)"))
        }
    }
    if one_line && line_end_col(p_from_header(p, header_line), header_line) > 100 {
        return Err(tx_err(n.line, n.col, "syntax", "перечисление на одной строке длиннее 100 знаков (AL-99): пишется в несколько строк — заголовок `тип ${n.text} перечисление` и строки `  | Эл`"))
    }
    if with_fields && with_values { return Err(tx_err(n.line, n.col, "type", "у типа `${n.text}` значения и поля вперемешку (AL-99): либо у элементов значения `= \"значение\"`, либо у форм поля `{ … }`")) }
    if type_en == "FailCode" {
        if !same_names(case_names, fail_code_names()) {
            cx_unsupported(cx, n, "КодСбоя — встроенное перечисление из десяти значений, другого состава быть не может")
        }
        return Ok(TxTypeDecl { record: false, json: None })
    }
    mut pairs = [kv("name", js(type_en)), kv("cases", TxArr(cases))]
    if word_pairs.len() > 0 { pairs.push(kv("values", TxArr(word_pairs))) }
    Ok(TxTypeDecl { record: false, json: Some(jobj(pairs)) })
}

// A reader that stands on the first token of the header line `header_line` (the tokens of that line are looked at for the length of the line).
fn p_from_header(p TxP, header_line int) -> TxP {
    mut k = 0
    while k < p.toks.len() && p.toks[k].line != header_line { k += 1 }
    TxP { toks: p.toks, pos: k, end_line: p.end_line, end_col: p.end_col }
}

// ORACLE-WORKAROUND(41): the list is called `pairs_in`, not `list` or `pairs`: a name that means a list of one type in one function and a list of another type in another function of the unit is mixed up by the code generator; use plain names when item 41 is fixed
fn pair_has_en(pairs_in []TxPair, en str) -> bool {
    for q in pairs_in {
        if q.en == en { return true }
    }
    false
}

fn pair_owner(pairs_in []TxPair, en str) -> str {
    for q in pairs_in {
        if q.en == en { return q.ru }
    }
    ""
}

// `тип Имя { поле тип, … }`, after the words `тип Имя`.
fn decl_record(mut p TxP, mut cx TxCx, n TxTok) -> Result[TxTypeDecl, TranslateError] {
    ro type_en = decl_exported(p, cx, n, "типа", "типы", [n.text])?
    pair_add(cx.env.types, n.text, type_en)
    p_expect(p, "{")?
    cx.env.owner = n.text
    cx.env.opath = [n.text]
    ro fields = decl_fields(p, cx, "}", "поля")?
    cx.env.owner = ""
    cx.env.opath = []str.new()
    p_expect(p, "}")?
    Ok(TxTypeDecl { record: true, json: Some(jobj([kv("name", js(type_en)), kv("fields", TxArr(fields))])) })
}

// `тип Имя …`: a record `{ … }` or an enumeration `перечисление …` (AL-99); the former `тип Имя = …` is an error.
fn decl_type(mut p TxP, mut cx TxCx, head TxTok) -> Result[TxTypeDecl, TranslateError] {
    ro n = p_tok(p)
    if n.kind != TK_NAME { return Err(p_fail(p, "после `${kw(cx.words, "decl", "type")}` ожидается имя типа")) }
    p_adv(p)
    if p_is(p, "(") && p_ahead(p, 1).kind == TK_NAME && t_is(p_ahead(p, 2), ")") {
        cx_error(cx, p_tok(p), "name", "скобки `(${p_ahead(p, 1).text})` после имени типа `${n.text}` убраны из языка (AL-60): JSON-имя задаёт строка раздела `## Имена`, без строки оно строится само; переходного периода нет")
        p.pos += 3
    }
    if t_is(p_tok(p), "{") { return decl_record(p, cx, n) }
    if p_is_kw(p, cx.words, "decl", "enum") {
        ro word = p_tok(p)
        p_adv(p)
        return decl_enum(p, cx, n, word.line)
    }
    if p_is(p, "=") { return Err(tx_err(p_tok(p).line, p_tok(p).col, "syntax", "знак `=` после имени типа в формате 2.22 не бывает (AL-89, AL-99): `${kw(cx.words, "decl", "type")} ${n.text} ${kw(cx.words, "decl", "enum")} Эл | Эл2`; значение элемента — `Эл = \"значение\"`; переходного периода нет")) }
    Err(p_fail(p, "после имени типа ожидается `{` (запись) или `${kw(cx.words, "decl", "enum")}` (перечисление)"))
}

/// The section `## Типы`.
fn decl_types(entries []TxEntry, sec TxSection, mut cx TxCx) -> TxTypes {
    mut records = []TxJ.new()
    mut variants = []TxJ.new()
    mut segs = []TxSeg.new()
    mut i = sec.first
    while i < sec.last {
        ro e = entries[i]
        if e.kind == EN_TEXT {
            if e.text != "—" { segs.push(TxSeg { text: e.text, line: e.line, col: e.indent + 1, code: e.fenced }) }
        } else {
            note(cx, struct_error(e.line, 1, "в разделе `Типы` таблиц нет"))
        }
        i += 1
    }
    match lex_segs(segs) {
        Ok(p0) => {
            // the names of the types are known before the bodies are read: a field may name a type that is declared further down
            mut pre = p_copy(p0)
            while !p_done(pre) {
                ro first = p_tok(pre)
                p_adv(pre)
                if t_is_kw(first, cx.words, "decl", "type") {
                    ro named = p_tok(pre)
                    if named.kind == TK_NAME {
                        p_adv(pre)
                        if !pair_has(cx.env.types, named.text) { pair_add(cx.env.types, named.text, jn_peek(cx, named.text, "типа", [named.text])) }
                    }
                }
            }
            mut p = p_copy(p0)
            while !p_done(p) {
                ro head = p_tok(p)
                p_adv(p)
                if t_is_kw(head, cx.words, "decl", "type") {
                    match decl_type(p, cx, head) {
                        Ok(d) => {
                            match d.json {
                                Some(j) => {
                                    if d.record { records.push(j) } else { variants.push(j) }
                                }
                                None => ()
                            }
                        }
                        Err(e) => {
                            note(cx, e)
                            tx_skip_decl(p, cx.words)
                        }
                    }
                } else {
                    match former_find(cx.words.lang, "decl", head.text) {
                        Some(f) => note(cx, tx_err(head.line, head.col, "syntax", former_message(f)))
                        None => note(cx, tx_err(head.line, head.col, "syntax", "ожидается `${kw(cx.words, "decl", "type")}`, найдено: ${t_shown(head)}"))
                    }
                    tx_skip_decl(p, cx.words)
                }
            }
        }
        Err(e) => note(cx, e)
    }
    TxTypes { records, variants }
}

// After an error: to the next keyword of a declaration (or a word of a former declaration, which is an error of its own).
fn tx_skip_decl(mut p TxP, w TxWords) -> () {
    while !p_done(p) {
        if p_is_kw(p, w, "decl", "type") { break }
        ro t = p_tok(p)
        if t.kind == TK_NAME && t.col == 1 {
            match former_find(w.lang, "decl", t.text) {
                Some(f) => { break }
                None => ()
            }
        }
        p_adv(p)
    }
}

// ---- constants, parameters ------------------------------------------------------------------------------------------------------------

fn cell_expr(cell TxCell, line int, mut cx TxCx, sc TxScope) -> Result[TxJ, TranslateError] {
    mut p = cell_p(cell, line)?
    ro e = ex_expr(p, cx, sc)?
    p_end(p)?
    Ok(e)
}

fn cell_type(cell TxCell, line int, mut cx TxCx) -> Result[str, TranslateError] {
    mut p = cell_p(cell, line)?
    ro t = ty_parse(p, cx)?
    p_end(p)?
    Ok(t)
}

// The name in a cell: one word.
fn cell_name(cell TxCell, line int) -> Result[TxTok, TranslateError] {
    mut p = cell_p(cell, line)?
    ro t = p_tok(p)
    if t.kind != TK_NAME { return Err(p_fail(p, "ожидается имя")) }
    p_adv(p)
    p_end(p)?
    Ok(t)
}

fn kinds_constant() -> []str => ["constant", "data", "variable"]

/// The rows of `## Константы`: the JSON array; the names join the globals as they are read.
fn decl_constants(entries []TxEntry, sec TxSection, mut cx TxCx) -> []TxJ {
    mut out = []TxJ.new()
    for r in section_table(entries, sec, ["name", "type", "value"], cx) {
        cx.rows_total += 1
        ro before = cx.errors.len()
        match decl_constant_row(r, cx) {
            Ok(j) => {
                out.push(j)
                cx_place(cx, "$.constants[${out.len() - 1}]", r.line)
            }
            Err(e) => note(cx, e)
        }
        if cx.errors.len() > before { cx.rows_noted += 1 }
    }
    out
}

fn decl_constant_row(r TxEntry, mut cx TxCx) -> Result[TxJ, TranslateError] {
    ro n = cell_name(r.cells[0], r.line)?
    ro en = decl_internal(cx, n)
    ro type_text = cell_type(r.cells[1], r.line, cx)?
    ro value = cell_expr(r.cells[2], r.line, cx, sc_empty())?
    if pair_has(cx.env.globals, n.text) { cx_error(cx, n, "name", "имя `${n.text}` уже объявлено") }
    pair_add(cx.env.globals, n.text, en)
    jn_declare_internal(cx, n, "константы")
    Ok(jobj([kv("name", js(en)), kv("type", js(type_text)), kv("value", value)]))
}

fn decl_params(entries []TxEntry, sec TxSection, mut cx TxCx) -> []TxJ {
    mut out = []TxJ.new()
    for r in section_table(entries, sec, ["name", "type", "default", "project_override"], cx) {
        cx.rows_total += 1
        ro before = cx.errors.len()
        match decl_param_row(r, cx) {
            Ok(j) => {
                out.push(j)
                cx_place(cx, "$.params[${out.len() - 1}]", r.line)
            }
            Err(e) => note(cx, e)
        }
        if cx.errors.len() > before { cx.rows_noted += 1 }
    }
    out
}

fn decl_param_row(r TxEntry, mut cx TxCx) -> Result[TxJ, TranslateError] {
    ro n = cell_name(r.cells[0], r.line)?
    ro en = decl_internal(cx, n)
    ro type_text = cell_type(r.cells[1], r.line, cx)?
    ro value = cell_expr(r.cells[2], r.line, cx, sc_empty())?
    mut pairs = [kv("name", js(en)), kv("type", js(type_text)), kv("default", value)]
    ro key = r.cells[3].text
    if key != "—" && key != "" {
        ro prefix = "${kw(cx.words, "key", "project")}."
        if !key.starts_with(prefix) { return Err(tx_err(r.line, r.cells[3].col, "syntax", "переопределение проектом пишется `${prefix}<ключ>` или `—`")) }
        pairs.push(kv("project_key", js(key[prefix.byte_len()..])))
    }
    if pair_has(cx.env.globals, n.text) { cx_error(cx, n, "name", "имя `${n.text}` уже объявлено") }
    pair_add(cx.env.globals, n.text, en)
    jn_declare_internal(cx, n, "параметра")
    Ok(jobj(pairs))
}

// ---- the input ----------------------------------------------------------------------------------------------------------------------------

/// TxInput: the fields of the input and the invariants, and the scope of the invariants (the fields by name).
type TxInput { fields []TxJ, invariants []TxJ, scope TxScope }

fn decl_input(entries []TxEntry, sec TxSection, mut cx TxCx) -> TxInput {
    mut fields = []TxJ.new()
    mut invariants = []TxJ.new()
    mut scope = sc_empty()
    mut i = sec.first
    while i < sec.last {
        ro e = entries[i]
        if e.kind == EN_ROW {
            ro t = tab_read(entries, i, sec.last, ["name", "type", "note"], cx)
            for r in t.rows {
                cx.rows_total += 1
                ro before = cx.errors.len()
                match decl_input_row(r, cx) {
                    Ok(f) => {
                        fields.push(f.json)
                        scope = sc_with(scope, f.ru, f.en)
                        pair_add(cx.env.input_fields, f.ru, f.en)
                    }
                    Err(err) => note(cx, err)
                }
                if cx.errors.len() > before { cx.rows_noted += 1 }
            }
            i = tab_end(entries, i, sec.last, cx.words)
        } else if e.kind == EN_TEXT && kv_colon(e) >= 0 {
            ro line = kv_read(entries, i)
            if line.key == "Invariant" {
                match lex_segs(line.segs) {
                    Ok(p0) => {
                        mut p = p_copy(p0)
                        match ex_expr(p, cx, scope) {
                            Ok(j) => {
                                match p_end(p) {
                                    Ok(u) => invariants.push(j)
                                    Err(err) => note(cx, err)
                                }
                            }
                            Err(err) => note(cx, err)
                        }
                    }
                    Err(err) => note(cx, err)
                }
            } else {
                note(cx, struct_error(e.line, 1, "в разделе `Вход` бывают таблица полей и строки `Инвариант: …`"))
            }
            i += line.taken
        } else if e.kind == EN_TEXT && e.text == "—" {
            dash_line(cx, e)
            i += 1
        } else {
            note(cx, struct_error(e.line, e.indent + 1, "лишняя строка в разделе `Вход`"))
            i += 1
        }
    }
    TxInput { fields, invariants, scope }
}

/// TxInField: a field of the input.
type TxInField { json TxJ, ru str, en str }

fn decl_input_row(r TxEntry, mut cx TxCx) -> Result[TxInField, TranslateError] {
    ro d = cell_decl_json(r.cells[0], r.line, cx, "поля входа", "поля входа")?
    ro type_text = cell_type(r.cells[1], r.line, cx)?
    Ok(TxInField { json: jobj([kv("name", js(d.json)), kv("type", js(type_text))]), ru: d.tok.text, en: d.json })
}

// ---- the data -----------------------------------------------------------------------------------------------------------------------------

// The cell `пишет` of 2.25: `действия`, `механика`, `действия и механика` (English `rows`, `mechanics`, `rows and mechanics`; the words of the built-in library of 2.25 are gone in 0.9.1); the Russian words of 2.22 (`строки`, …) are refused with the new word (AL-122).
fn data_writes(cell TxCell, line int, w TxWords) -> Result[str, TranslateError] {
    ro keys = ["rows", "mechanics", "rows_and_mechanics"]
    match kw_key(w, "enum_value", cell.text) {
        Some(k) => {
            if keys.contains(k) { return Ok(k) }
        }
        None => ()
    }
    match former_find(w.lang, "writes", cell.text) {
        Some(f) => return Err(tx_err(line, cell.col, "syntax", former_message(f)))
        None => ()
    }
    Err(tx_err(line, cell.col, "syntax", "в столбце `${kw(w, "column", "writes")}` бывает: ${kw_all(w, "enum_value", keys).join(", ")}"))
}

// The cell `не убывает`: `—` (none), `да`, `да, <= выр`. Returns the JSON of "monotonic" or None.
fn data_monotonic(cell TxCell, line int, mut cx TxCx) -> Result[Option[TxJ], TranslateError] {
    if cell.text == "—" || cell.text == "" { return Ok(None) }
    mut p = cell_p(cell, line)?
    if !p_eat_kw(p, cx.words, "enum_value", "yes") { return Err(p_fail(p, "в столбце `${kw(cx.words, "column", "non_decreasing")}` бывает `—`, `${kw(cx.words, "enum_value", "yes")}` или `${kw(cx.words, "enum_value", "yes")}, <= выр`")) }
    if p_done(p) { return Ok(Some(TxBool(true))) }
    p_expect(p, ",")?
    if !p_eat(p, "<=") { return Err(p_fail(p, "после запятой ожидается `<= выр`")) }
    ro bound = ex_expr(p, cx, sc_empty())?
    p_end(p)?
    Ok(Some(jobj([kv("bound", bound)])))
}

// The cell `начальное`: `—` (a path datum), `вход.поле`, an expression. Returns the JSON of "initial" or None.
fn data_initial(cell TxCell, line int, mut cx TxCx) -> Result[Option[TxJ], TranslateError] {
    if cell.text == "—" || cell.text == "" { return Ok(None) }
    mut p = cell_p(cell, line)?
    if p_is_kw(p, cx.words, "readable", "input") && t_is(p_ahead(p, 1), ".") && p_ahead(p, 2).kind == TK_NAME && p_ahead(p, 3).kind == TK_EOF {
        p_adv(p)
        p_adv(p)
        ro f = p_tok(p)
        p_adv(p)
        match pair_get(cx.env.input_fields, f.text) {
            Some(en) => return Ok(Some(jobj([kv("from_input", js(en))])))
            None => {
                cx_error(cx, f, "name", "поля `${f.text}` нет в разделе `Вход`")
                return Ok(Some(jobj([kv("from_input", js(f.text))])))
            }
        }
    }
    ro e = ex_expr(p, cx, sc_empty())?
    p_end(p)?
    Ok(Some(jobj([kv("expr", e)])))
}

// The name of a datum or of a path datum `имя[*].поле`: the JSON name as the tree writes it (the brackets of the declaration, a readable word of the table of words, a Latin name), and the root.
type TxDatumName { en str, ru str, is_path bool }

fn data_name(cell TxCell, line int, mut cx TxCx) -> Result[TxDatumName, TranslateError] {
    mut p = cell_p(cell, line)?
    ro root = p_tok(p)
    if root.kind != TK_NAME { return Err(p_fail(p, "ожидается имя данного")) }
    p_adv(p)
    if p_is(p, "[") {
        p_adv(p)
        p_expect(p, "*")?
        p_expect(p, "]")?
        mut text = "[*]"
        mut ru = "[*]"
        while p_eat(p, ".") {
            ro f = p_tok(p)
            if f.kind != TK_NAME { return Err(p_fail(p, "после `.` ожидается поле")) }
            p_adv(p)
            text = "${text}.${tr_field_name(cx, f)}"
            ru = "${ru}.${f.text}"
        }
        p_end(p)?
        match pair_get(cx.env.globals, root.text) {
            Some(root_en) => return Ok(TxDatumName { en: "${root_en}${text}", ru: "${root.text}${ru}", is_path: true })
            None => return Err(tx_err(root.line, root.col, "name", "путь поля `${root.text}[*]…` называет данное, которого нет выше в таблице"))
        }
    }
    if is_keyword(cx.words, root.text) { cx_error(cx, root, "name", "`${root.text}` — служебное слово, именем быть не может") }
    // a readable name of the contract (`остановка`, `предыдущее`) has the JSON name of the table of words and no row names it (1a, AL-49)
    match readable_json(cx.words, root.text) {
        Some(key) => {
            if !p_is(p, "(") {
                p_end(p)?
                jn_declare_fixed(cx, root.line, root.col, root.text, "данного", "данные", [root.text], key)
                return Ok(TxDatumName { en: key, ru: root.text, is_path: false })
            }
        }
        None => ()
    }
    ro en = decl_json(p, cx, root, "данного", "данные", [root.text])?
    p_end(p)?
    Ok(TxDatumName { en, ru: root.text, is_path: false })
}

// The columns of `## Данные` of 2.26 (design 5): `имя | тип | начальное [| не убывает]`, no column `пишет` (the writes are not marked: the rows write the data of the machine,
// the engine writes the data of the contract and the counters of the parties). A header with `пишет` is the former form: the error with the hint, the rows are read without it.
fn data_columns_226(entries []TxEntry, sec TxSection, mut cx TxCx) -> []str {
    mut i = sec.first
    while i < sec.last {
        ro e = entries[i]
        if e.kind == EN_ROW {
            ro n = e.cells.len()
            if n == 5 && header_norm(e.cells[4].text) == header_norm(kw(cx.words, "column", "writes")) {
                note(cx, struct_error(e.line, e.cells[4].col, "с 2.26 столбца `${kw(cx.words, "column", "writes")}` нет: данные машины пишут строки, данные контракта и счётчики сторон — движок; столбцы: ${kw_all(cx.words, "column", ["name", "type", "initial", "non_decreasing"]).join(" | ")} (последний необязателен)"))
                return ["name", "type", "initial", "non_decreasing", "writes"]
            }
            if n == 3 { return ["name", "type", "initial"] }
            return ["name", "type", "initial", "non_decreasing"]
        }
        i += 1
    }
    ["name", "type", "initial", "non_decreasing"]
}

fn decl_data(entries []TxEntry, sec TxSection, mut cx TxCx) -> []TxJ {
    mut out = []TxJ.new()
    ro columns = if cx.v226 { data_columns_226(entries, sec, cx) } else { ["name", "type", "initial", "non_decreasing", "writes"] }
    for r in section_table(entries, sec, columns, cx) {
        cx.rows_total += 1
        ro before = cx.errors.len()
        match decl_data_row(r, cx) {
            Ok(j) => {
                out.push(j)
                cx_place(cx, "$.data[${out.len() - 1}]", r.line)
            }
            Err(e) => note(cx, e)
        }
        if cx.errors.len() > before { cx.rows_noted += 1 }
    }
    out
}

fn decl_data_row(r TxEntry, mut cx TxCx) -> Result[TxJ, TranslateError] {
    ro name = data_name(r.cells[0], r.line, cx)?
    ro type_text = cell_type(r.cells[1], r.line, cx)?
    ro initial = data_initial(r.cells[2], r.line, cx)?
    mut pairs = [kv("name", js(name.en)), kv("type", js(type_text))]
    match initial {
        Some(j) => pairs.push(kv("initial", j))
        None => ()
    }
    // the column `не убывает` may be left out in a file of 2.26
    if r.cells.len() > 3 {
        match data_monotonic(r.cells[3], r.line, cx)? {
            Some(j) => pairs.push(kv("monotonic", j))
            None => ()
        }
    }
    // a file of 2.26 marks no writes (design 5): the tree has no key `writes`, the loader reads the rows
    if !cx.v226 { pairs.push(kv("writes", js(data_writes(r.cells[4], r.line, cx.words)?))) }
    if !name.is_path {
        if pair_has(cx.env.globals, name.ru) { return Err(tx_err(r.line, r.cells[0].col, "name", "имя `${name.ru}` уже объявлено")) }
        pair_add(cx.env.globals, name.ru, name.en)
    }
    Ok(jobj(pairs))
}
