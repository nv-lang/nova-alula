// decl_test.nv - the declarations: the types, the constants, the parameters, the input, the data, the parties, the signals, the definitions, the primitives. Since 2.13 (AL-46) a name that leaves the machine
// gets its JSON name from the brackets of the declaration, the internal names (constants, parameters, definitions, parties, bindings) are written to the tree as they are.
module alula.machine_text

import std.text

fn head() -> str => `# Машина: Проба

machine: Probe
machine_version: 1
format: 2.23

`

// The JSON that the translator makes of the header and the sections (the missing states and ends are noted, the JSON stays).
fn jsn(sections str) -> str => translate_report("${head()}${sections}").json

fn errs_of(sections str) -> []TranslateError => translate_report("${head()}${sections}").errors

// Does some error of the sections say the needle? The missing states and ends are noted first, so the first error is not the one to look at.
fn says(sections str, needle str) -> bool {
    for e in errs_of(sections) {
        if e.message.contains(needle) { return true }
    }
    false
}

fn kind_says(sections str, kind str, needle str) -> bool {
    for e in errs_of(sections) {
        if e.kind == kind && e.message.contains(needle) { return true }
    }
    false
}

fn types_json(text str) -> str {
    match translate_types(text) {
        Ok(j) => j
        Err(problems) => "ERR ${problems[0].kind}: ${problems[0].message}"
    }
}

fn first_type_error(text str) -> str {
    match translate_types(text) {
        Ok(j) => "ok"
        Err(problems) => "${problems[0].kind}: ${problems[0].message}"
    }
}

// ---- the types ---------------------------------------------------------------------------------------------------------------------

test "dc enum" {
    ro text = types_json("тип ВидВызывающего перечисление Линза | СессияЦикла | ХодЧата | Вратарь")
    assert(text == "{\"records\":[],\"variants\":[{\"name\":\"CallerKind\",\"cases\":[{\"name\":\"Lens\"},{\"name\":\"CycleSession\"},{\"name\":\"ChatTurn\"},{\"name\":\"Gatekeeper\"}]}]}")
    assert(text.contains("\"cases\":[{\"name\":\"Lens\"}"))
}

test "dc enum values" {
    ro ok = types_json("тип ВидДействия перечисление\n  | Чтение = \"read\"\n  | Запись = \"write\"\n  | Удаление = \"delete\"")
    assert(ok.contains("\"name\":\"ActionKind\""))
    assert(ok.contains("{\"name\":\"Read\"},{\"name\":\"Write\"},{\"name\":\"Delete\"}"))
    assert(types_json("тип ВидДействия перечисление\n  | Чтение = \"reed\"\n  | Запись = \"write\"").contains("\"values\":[[\"Read\",\"reed\"],[\"Write\",\"write\"]]"))
    assert(first_type_error("тип ВидДействия перечисление\n  | Чтение = \"reed\"\n  | Запись = \"write\"") == "ok")
    assert(first_type_error("тип ВидДействия перечисление\n  | Чтение = \"read\"\n  | Запись = \"read\"").contains("повторено"))
}

test "dc enum lines" {
    ro text = "тип ВидДействия перечисление\n  | Чтение = \"read\"\n  | Запись = \"write\"\n  | Удаление = \"delete\"\n  | Перенос = \"move\"\n"
    assert(first_type_error(text) == "ok")
    assert(types_json(text).contains("{\"name\":\"Move\"}"))
}

test "dc fail code" {
    ro all = "тип КодСбоя перечисление\n  | НетРезультата = \"no_result\"\n  | ОтказМодели = \"model_refused\"\n  | СоединениеОборвалось = \"connection_lost\"\n  | ФормаНеИсправлена = \"form_not_fixed\"\n  | НетОтветаВСрок = \"timeout\"\n  | ОстановленоЧеловеком = \"stopped_by_human\"\n  | ПотолокЗаходов = \"ceiling_reached\"\n  | ОтмененоРодителем = \"cancelled\"\n  | ПредельТокенов = \"max_tokens\"\n  | ПредельЗапросовХода = \"max_turn_requests\""
    assert(types_json(all) == "{\"records\":[],\"variants\":[]}")
    assert(first_type_error("тип КодСбоя перечисление НетРезультата | ОтказМодели").starts_with("unsupported:"))
}

test "dc record" {
    ro text = types_json("тип МодельАгента { идентификатор строка, поставщик строка, вариант ?строка }")
    assert(text == "{\"records\":[{\"name\":\"AgentModel\",\"fields\":[{\"name\":\"id\",\"type\":\"text\"},{\"name\":\"provider\",\"type\":\"text\"},{\"name\":\"variant\",\"type\":\"?text\"}]}],\"variants\":[]}")
    ro multi = types_json("тип МодельАгента {\n  идентификатор строка,\n  поставщик строка,\n  вариант ?строка,\n}\n")
    assert(multi == text)
}

test "dc record types" {
    ro text = types_json("тип Токены { вход ?число, выход ?число>=0, рассуждение []число, кэш_чтение словарь[строка, число], кэш_запись (строка, число) }")
    assert(text.contains("\"type\":\"?int\""))
    assert(text.contains("\"type\":\"?int>=0\""))
    assert(text.contains("\"type\":\"[]int\""))
    assert(text.contains("\"type\":\"{text: int}\""))
    assert(text.contains("\"type\":\"(text, int)\""))
}

test "dc variant" {
    ro text = types_json("тип ИтогХода перечисление\n  | Закончен { текст ?строка, артефакт ?строка }\n  | Обрезан { расход число }\n  | ВременнаяОшибка\n  | ПостояннаяОшибка\n")
    assert(text.contains("\"variants\":[{\"name\":\"TurnResult\",\"cases\":["))
    assert(text.contains("{\"name\":\"Finished\",\"fields\":[{\"name\":\"text\",\"type\":\"?text\"},{\"name\":\"artifact\",\"type\":\"?text\"}]}"))
    assert(text.contains("{\"name\":\"TransientError\"},{\"name\":\"PermanentError\"}"))
    assert(text.contains("{\"name\":\"Truncated\",\"fields\":[{\"name\":\"raskhod\",\"type\":\"int\"}]}"))
}

test "dc type errors" {
    assert(first_type_error("тип Токены { вход: ?число }").contains("после имени поля тип пишется без двоеточия"))
    assert(first_type_error("тип Токены { вход ?число").contains("ожидается `}`"))
    assert(first_type_error("тип Токены (TokenUsage) { вход число }").contains("скобки"))
    assert(first_type_error("тип Токены { вход (input) число }").contains("скобки"))
    assert(first_type_error("что-то Токены { }").contains("ожидается `тип`"))
    assert(first_type_error("тип ИтогХода перечисление ").contains("ожидаются элементы перечисления"))
    assert(first_type_error("тип ВидВызывающего перечисление  ").contains("ожидаются элементы перечисления"))
    assert(first_type_error("тип Токены { вход число } ещё слова").contains("ожидается `тип`"))
}

test "dc type errors all" {
    match translate_types("тип Токены { вход: ?число }\nтип Нетакого (X) { а число }\nперечисление ВидДействия = Чтение \"reed\"") {
        Ok(j) => assert(false)
        Err(problems) => {
            assert(problems.len() >= 2)
            assert(problems[0].kind == "syntax")
        }
    }
}

test "dc names are built by themselves" {
    // since 2.16 (AL-53) the dictionary of the methodology gives `Токены` the name TokenUsage and `вход` the name input; a name out of it is transliterated; a Latin name stays
    assert(first_type_error("тип Токены { вход ?число }") == "ok")
    assert(types_json("тип Токены { вход ?число }").contains("{\"name\":\"TokenUsage\",\"fields\":[{\"name\":\"input\",\"type\":\"?int\"}]}"))
    assert(types_json("тип Нетакоготипа { вход число }").contains("{\"name\":\"Netakogotipa\",\"fields\":[{\"name\":\"input\",\"type\":\"int\"}]}"))
    assert(types_json("тип Tokens { input ?число }").contains("{\"name\":\"Tokens\",\"fields\":[{\"name\":\"input\",\"type\":\"?int\"}]}"))
}

// ---- constants, parameters, input -----------------------------------------------------------------------------------------------------

test "dc constants" {
    ro text = jsn("## Константы\n\n| имя | тип | значение |\n|---|---|---|\n| ЧИСЛО_ПОВТОРОВ | число>=0 | 3 |\n| ПРЕДЕЛ_ХОДОВ | число>=0 | ЧИСЛО_ПОВТОРОВ + 17 |\n")
    assert(text.contains("\"constants\":[{\"name\":\"ЧИСЛО_ПОВТОРОВ\",\"type\":\"int>=0\",\"value\":{\"op\":\"lit\",\"value\":3}},{\"name\":\"ПРЕДЕЛ_ХОДОВ\""))
    assert(text.contains("\"value\":{\"op\":\"+\",\"left\":{\"op\":\"name\",\"name\":\"ЧИСЛО_ПОВТОРОВ\"}"))
}

test "dc constants errors" {
    ro bad = "## Константы\n\n| имя | тип | значение |\n|---|---|---|\n| ПРЕДЕЛ | число | НЕТ_ТАКОЙ |\n| ЧИСЛО_ПОВТОРОВ | число | 1 |\n| ЧИСЛО_ПОВТОРОВ | число | 2 |\n"
    assert(kind_says(bad, "name", "`НЕТ_ТАКОЙ` не объявлено в этой машине"))
    assert(kind_says(bad, "name", "имя `ЧИСЛО_ПОВТОРОВ` уже объявлено"))
}

test "dc params" {
    ro text = jsn("## Параметры\n\n| имя | тип | по умолчанию | переопределение проектом |\n|---|---|---|---|\n| ПАУЗА_ПОВТОРА | число>=0 | 2000 | — |\n| ЧИСЛО_ПОВТОРОВ | число>=0 | 3 | проект.повторы |\n")
    assert(text.contains("\"params\":[{\"name\":\"ПАУЗА_ПОВТОРА\",\"type\":\"int>=0\",\"default\":{\"op\":\"lit\",\"value\":2000}}"))
    assert(text.contains("\"project_key\":\"повторы\""))
    assert(says("## Параметры\n\n| имя | тип | по умолчанию | переопределение проектом |\n|---|---|---|---|\n| ПАУЗА_ПОВТОРА | число>=0 | 2000 | где-то |\n", "проект.<ключ>"))
}

test "dc input" {
    ro text = jsn("## Вход\n\n| имя | тип | примечание |\n|---|---|---|\n| запрос_агента | строка | — |\n| число_ходов | число>=0 | — |\n\n- Инвариант: число_ходов <= 100\n")
    assert(text.contains("\"input\":{\"fields\":[{\"name\":\"agent_request\",\"type\":\"text\"},{\"name\":\"turn_count\",\"type\":\"int>=0\"}],\"invariants\":[{\"op\":\"<=\""))
    assert(says("## Вход\n\n| имя | тип | примечание |\n|---|---|---|\n| запрос_агента | строка | — |\n\n- Предел запросов: 1\n", "в разделе `Вход` бывают таблица полей и строки `Инвариант: …`"))
}

// ---- the data ----------------------------------------------------------------------------------------------------------------------

fn data_head() -> str => "## Данные\n\n| имя | тип | начальное | не убывает | пишет |\n|---|---|---|---|---|\n"

test "dc data initial" {
    ro text = jsn("## Вход\n\n| имя | тип | примечание |\n|---|---|---|\n| запрос_агента | строка | — |\n\n${data_head()}| запрос_агента | строка | вход.запрос_агента | — | действия |\n| ход | ?строка | пусто | — | действия |\n| число_ходов | число>=0 | 0 | да, <= 20 | механика |\n")
    assert(text.contains("{\"name\":\"agent_request\",\"type\":\"text\",\"initial\":{\"from_input\":\"agent_request\"},\"writes\":\"rows\"}"))
    assert(text.contains("{\"name\":\"turn\",\"type\":\"?text\",\"initial\":{\"expr\":{\"op\":\"lit\",\"value\":null}},\"writes\":\"rows\"}"))
    assert(text.contains("\"monotonic\":{\"bound\":{\"op\":\"lit\",\"value\":20}},\"writes\":\"mechanics\""))
}

test "dc data writes" {
    ro all_pairs = [["действия", "rows"], ["механика", "mechanics"], ["действия и механика", "rows_and_mechanics"], ["фрагмент", "fragment"], ["действия и фрагмент", "rows_and_fragment"]]
    for pair in all_pairs {
        ro text = jsn("${data_head()}| число_ходов | число>=0 | 0 | — | ${pair[0]} |\n")
        assert(text.contains("\"writes\":\"${pair[1]}\""))
    }
}

// AL-122: the words of the column `пишет` of 2.22 (`строки`, `строки и механика`, `строки и фрагмент`) are refused with the new word, there is no transition period
test "dc data writes the former words" {
    for pair in [["строки", "действия"], ["строки и механика", "действия и механика"], ["строки и фрагмент", "действия и фрагмент"]] {
        assert(says("${data_head()}| число_ходов | число>=0 | 0 | — | ${pair[0]} |\n", "`${pair[0]}` в формате 2.22 не бывает (AL-122): пишется `${pair[1]}`; переходного периода нет"))
    }
}

test "dc data path" {
    ro text = jsn("## Типы\n\n```\nтип Линза { попытка число>=0 }\n```\n\n${data_head()}| линзы | словарь[строка, Линза] | [] | — | действия |\n| линзы[*].попытка | число>=0 | — | да | механика |\n")
    assert(text.contains("{\"name\":\"lenses\",\"type\":\"{text: Lens}\""))
    assert(text.contains("{\"name\":\"lenses[*].attempt\",\"type\":\"int>=0\",\"monotonic\":true,\"writes\":\"mechanics\"}"))
    assert(says("${data_head()}| линзы[*].попытка | число>=0 | — | да | механика |\n", "называет данное, которого нет выше"))
}

test "dc data dict literal" {
    ro text = jsn("${data_head()}| ответы_свидетеля | словарь[число>=0, []строка] | [] | — | действия |\n")
    assert(text.contains("\"initial\":{\"expr\":{\"op\":\"dict\",\"entries\":[]}}"))
}

test "dc data readable name" {
    // a readable name of the contract is the word `en` of the table of words and needs no brackets
    ro text = jsn("${data_head()}| остановка | \"\" \\| \"a\" | \"\" | — | действия |\n| предыдущее | ?Состояние | пусто | — | фрагмент |\n")
    assert(text.contains("{\"name\":\"stop_reason\""))
    assert(text.contains("{\"name\":\"previous\""))
}

// ---- the parties -------------------------------------------------------------------------------------------------------------------

fn parties_head() -> str => "## Стороны\n\n| имя | идентификатор | вид | профиль | сигналы | счётчик |\n|---|---|---|---|---|---|\n"

fn data_for_parties() -> str => "${data_head()}| попытка_агента | число>=0 | 0 | да | механика |\n| попытка_вратаря | число>=0 | 0 | да | механика |\n| попытка_усиленного | число>=0 | 0 | да | механика |\n"

test "dc parties" {
    ro text = jsn("## Имена\n\n| имя | JSON-имя |\n|---|---|\n| исполнитель_повышенного_внимания | attention_executor |\n\n${data_for_parties()}\n${parties_head()}| агент | agent | agent(итог строка) | — | — | попытка_агента |\n| вратарь | gatekeeper | human или agent по настройке исполнитель_повышенного_внимания(итог ИсходВорот) | — | разрешить, отказать | попытка_вратаря |\n| усиленный | enhanced | enhanced(итог ИсходВорот) | — | продолжить { слово_человека строка, автор строка, источник строка }, остановить | попытка_усиленного |\n")
    assert(text.contains("{\"name\":\"агент\",\"id\":\"agent\",\"kind\":\"agent\",\"result\":\"text\",\"counter\":\"agent_attempt\"}"))
    assert(text.contains("{\"name\":\"вратарь\",\"id\":\"gatekeeper\",\"kind\":\"gatekeeper\",\"setting\":\"attention_executor\",\"counter\":\"gatekeeper_attempt\",\"signals\":[{\"name\":\"allow\"},{\"name\":\"deny\"}]}"))
    assert(text.contains("\"kind\":\"enhanced\",\"counter\":\"enhanced_attempt\",\"signals\":[{\"name\":\"continue\",\"fields\":[{\"name\":\"human_word\",\"type\":\"text\"},{\"name\":\"author\",\"type\":\"text\"},{\"name\":\"source\",\"type\":\"text\"}]},{\"name\":\"halt\"}]"))
}

test "dc parties set" {
    ro text = jsn("${data_for_parties()}\n${parties_head()}| агент | — | agent(итог строка) | — | — | попытка_агента |\n")
    assert(text.contains("\"id\":\"\""))
}

test "dc parties errors" {
    ro twice = "${data_for_parties()}\n${parties_head()}| агент | agent | agent(итог строка) | — | — | попытка_агента |\n| агент | agent2 | agent(итог строка) | — | — | попытка_агента |\n"
    assert(says(twice, "сторона `агент` уже объявлена"))
    assert(kind_says("${data_for_parties()}\n${parties_head()}| агент | agent | agent(итог строка) | — | — | нет_такого |\n", "name", "не объявлено в этой машине"))
    assert(says("${data_for_parties()}\n${parties_head()}| агент | agent | agent(итог строка) | — | сигнал( | попытка_агента |\n", "в формате 2.22 не бывает"))
    assert(says("${data_for_parties()}\n${parties_head()}| агент | agent | agent(итог строка) | — | сигнал { | попытка_агента |\n", "ожидается `}`"))
}

// ---- signals and parts of an answer ------------------------------------------------------------------------------------------------------

test "dc signals parts" {
    ro text = jsn("## Имена\n\n| имя | JSON-имя |\n|---|---|\n| кусок_ответа | agent_chunk |\n| отмена | cancel |\n\n${data_for_parties()}\n${parties_head()}| агент | agent | agent(итог строка) | — | — | попытка_агента |\n\n## Части ответа\n\n| сторона | имя | поля |\n|---|---|---|\n| агент | кусок_ответа | текст строка |\n\n## Сигналы\n\n| имя | поля |\n|---|---|\n| отмена | — |\n")
    assert(text.contains("\"progress\":[{\"name\":\"agent_chunk\",\"fields\":[{\"name\":\"text\",\"type\":\"text\"}]}]"))
    assert(text.contains("\"signals\":[{\"name\":\"cancel\"}]"))
}

test "dc parts errors" {
    assert(kind_says("## Части ответа\n\n| сторона | имя | поля |\n|---|---|---|\n| никто | кусок_ответа | текст строка |\n", "name", "стороны `никто` нет в таблице «Стороны»"))
}

// ---- the definitions ---------------------------------------------------------------------------------------------------------------

// ORACLE-WORKAROUND(43): the helper is `ticks`, not `fence`: a user function `fence` clashes with the C function of the runtime; rename to `fence` when item 43 is fixed
fn ticks() -> str => "```"

fn defs_text(body str) -> str => "## Функции\n\n${ticks()}\n${body}\n${ticks()}\n"

test "dc definitions" {
    ro text = jsn(defs_text("функция слово_да_нет(б булево) -> строка =>\n  если б то { \"yes\" } иначе { \"no\" }"))
    assert(text.contains("\"definitions\":[{\"name\":\"слово_да_нет\""))
    assert(text.contains("\"params\":[{\"name\":\"б\",\"type\":\"bool\"}],\"result\":\"text\",\"body\":{\"op\":\"if\""))
}

test "dc definitions calls" {
    ro body = "функция сумма_целых(а ?число, б ?число) -> ?число =>\n  если есть(а) и есть(б) то { (а ?? 0) + (б ?? 0) } иначе { а ?? б }\n\nфункция сложить(а число, б число) -> число =>\n  сумма_целых(а, б) ?? 0\n"
    ro text = jsn(defs_text(body))
    assert(text.contains("\"name\":\"сумма_целых\""))
    assert(text.contains("{\"op\":\"call\",\"fn\":\"сумма_целых\",\"args\":[{\"op\":\"name\",\"name\":\"а\"},{\"op\":\"name\",\"name\":\"б\"}]}"))
}

test "dc definitions errors" {
    assert(says(defs_text("функция сумма_целых(а ?число) ?число =>\n  а"), "после параметров ожидается `->`"))
    assert(says(defs_text("функция сумма_целых(а ?число) -> ?число\n  а"), "ожидается `=>`"))
    assert(says("## Функции\n\n${ticks()}\nвот что-то лишнее\n${ticks()}\n", "ожидается `функция`"))
    assert(says(defs_text("функция сумма_целых(а ?число, а ?число) -> ?число =>\n  а"), "повторён"))
}

test "dc reserved name" {
    assert(kind_says(defs_text("функция сумма_целых(в ?число) -> ?число =>\n  в"), "name", "`в` — служебное слово, именем быть не может"))
}

// ---- the primitives ----------------------------------------------------------------------------------------------------------------------

test "dc primitives" {
    ro text = jsn("## Имена\n\n| имя | JSON-имя |\n|---|---|\n| время_сейчас | time_here |\n\n## Примитивы\n\n| имя | параметры | результат | класс | читает | пишет |\n|---|---|---|---|---|---|\n| time_now | — | число | изменчивая | — | — |\n| close_agent_turn | — | — | действующая | — | — |\n| время_сейчас | — | число | изменчивая | — | — |\n")
    assert(text.contains("\"primitives\":[\"time_now\",\"close_agent_turn\",\"time_here\"]"))
    assert(says("## Примитивы\n\n| имя | параметры | результат | класс | читает | пишет |\n|---|---|---|---|---|---|\n| time_now | — | число | чтение | — | — |\n", "класс примитива: pure, изменчивая, действующая"))
}

fn prim_ru(class str) -> str => "## Примитивы\n\n| имя | параметры | результат | класс | читает | пишет |\n|---|---|---|---|---|---|\n| time_now | — | число | ${class} | — | — |\n"

fn prim_en(class str) -> str => "# Machine: Probe\n\n- machine: Probe\n- machine_version: 1\n- format: 2.23\n- language: en\n\n## Primitives\n\n| name | parameters | result | class | reads | writes |\n|---|---|---|---|---|---|\n| time_now | — | int | ${class} | — | — |\n"

fn says_en(text str, needle str) -> bool {
    for e in translate_report(text).errors {
        if e.message.contains(needle) { return true }
    }
    false
}

// AL-116: the classes of a primitive are `pure`, `изменчивая` (`volatile`) and `действующая` (`acting`); the words of the format 2.22 are refused with the new word, there is no transition period
test "dc the classes of a primitive are read in the words of the file" {
    assert(!says(prim_ru("pure"), "класс примитива"))
    assert(!says(prim_ru("изменчивая"), "класс примитива"))
    assert(!says(prim_ru("действующая"), "класс примитива"))
    assert(!says_en(prim_en("pure"), "класс примитива"))
    assert(!says_en(prim_en("volatile"), "класс примитива"))
    assert(!says_en(prim_en("acting"), "класс примитива"))
    assert(jsn(prim_ru("изменчивая")).contains("\"primitives\":[\"time_now\"]"))
    assert(jsn(prim_ru("действующая")).contains("\"primitives\":[\"time_now\"]"))
}

test "dc the former classes of a primitive are refused with the new word" {
    assert(kind_says(prim_ru("reading"), "syntax", "`reading` в формате 2.22 не бывает (AL-116): пишется `изменчивая`; переходного периода нет"))
    assert(kind_says(prim_ru("writing"), "syntax", "`writing` в формате 2.22 не бывает (AL-116): пишется `действующая`; переходного периода нет"))
    assert(kind_says(prim_ru("irreversible"), "syntax", "`irreversible` в формате 2.22 не бывает (AL-116): пишется `действующая`; переходного периода нет"))
    // the word of the other language is no class of a Russian file: the list of the classes is told
    assert(says(prim_ru("volatile"), "класс примитива: pure, изменчивая, действующая"))
    assert(says(prim_ru("acting"), "класс примитива: pure, изменчивая, действующая"))
}

test "dc the former classes of a primitive of an English file are refused with the new word" {
    assert(says_en(prim_en("reading"), "`reading` в формате 2.22 не бывает (AL-116): пишется `volatile`; переходного периода нет"))
    assert(says_en(prim_en("writing"), "`writing` в формате 2.22 не бывает (AL-116): пишется `acting`; переходного периода нет"))
    assert(says_en(prim_en("irreversible"), "`irreversible` в формате 2.22 не бывает (AL-116): пишется `acting`; переходного периода нет"))
    // the word of the other language is no class of an English file
    assert(says_en(prim_en("изменчивая"), "класс примитива: pure, volatile, acting"))
}
