// folder_test.nv - task 116: `alula test` on the folder `src/machine/` (the machines and the tests of the product) passes every test; `alula run` passes every test
// of the agent step one by one (the rows are taken by the tests: task 109), of the chat, of the small machines; a test that is changed is a report.
module alula.alula_tests

import std.fs.{Path}
import std.text
import alula.machine.{NamedText, text_of_file}
import alula.examples.{machine_files, test_files, table_files, library_files_in}

test "ps test folder all tests" {
    ro ran = run_with(["test", "/machine"], machine_folder())
    assert(ran.err == "")
    ro total = test_files().len()
    assert(ran.out == "${total} of ${total} tests passed\n")
    assert(ran.code == 0)
}

fn nested_files(callee_file str, callee_text str) -> []NamedText {
    mut out = [
        NamedText { name: "/n/caller.alula.json", text: text_of_file(machine_files(), "caller.alula.json") },
        NamedText { name: callee_file, text: callee_text },
        NamedText { name: "/n/nested-call-ok.alula.test.json", text: text_of_file(test_files(), "nested-call-ok.alula.test.json") }
    ]
    // the table of the callee connects «Пауза» (2.26, task 239): its library lies beside it
    for f in library_files_in("/n") { out.push(f) }
    out
}

test "ps test folder nested" {
    ro ran = run_with(["test", "/n"], nested_files("/n/callee.alula.json", text_of_file(machine_files(), "callee.alula.json")))
    assert(ran.err == "")
    assert(ran.out == "1 of 1 tests passed\n")
    assert(ran.code == 0)
}

test "ps test folder nested from a table" {
    // the nested machine has no JSON in the folder: it is read from its table when the parent calls it
    ro ran = run_with(["test", "/n"], nested_files("/n/callee.alula.md", text_of_file(table_files(), "callee.alula.md")))
    assert(ran.err == "")
    assert(ran.out == "1 of 1 tests passed\n")
    assert(ran.code == 0)
}

test "ps test folder nested lacks" {
    ro files = [
        NamedText { name: "/n/caller.alula.json", text: text_of_file(machine_files(), "caller.alula.json") },
        NamedText { name: "/n/nested-call-ok.alula.test.json", text: text_of_file(test_files(), "nested-call-ok.alula.test.json") }
    ]
    ro ran = run_with(["test", "/n"], files)
    assert(ran.code == 1)
    assert(ran.out.contains("FAIL /n/nested-call-ok.alula.test.json"))
    assert(ran.out.contains("the machine callee of the party child is not in the registry"))
    assert(ran.out.ends_with("0 of 1 tests passed\n"))
}

test "ps test folder nested does not fit" {
    // a machine of the name `callee` whose input is not the input type of the party
    ro other = text_of_file(machine_files(), "fan.alula.json").replace("\"machine\":\"fan\"", "\"machine\":\"callee\"")
    ro ran = run_with(["test", "/n"], nested_files("/n/callee.alula.json", other))
    assert(ran.code == 1)
    assert(ran.out.contains("the nested machines do not fit"))
}

test "ps run refuses a parent" {
    ro files = nested_files("/n/callee.alula.json", text_of_file(machine_files(), "callee.alula.json"))
    ro ran = run_with(["run", "/n/caller.alula.json", "/n/nested-call-ok.alula.test.json"], files)
    assert(ran.code == 1)
    assert(ran.err.contains("calls nested machines"))
    assert(ran.err.contains("alula test"))
}

test "ps test folder nested changed" {
    ro original = text_of_file(test_files(), "nested-call-ok.alula.test.json")
    ro changed = original.replace("\"outcome\": \"answer:hi\"", "\"outcome\": \"answer:bye\"")
    assert(changed != original)
    ro files = [
        NamedText { name: "/n/caller.alula.json", text: text_of_file(machine_files(), "caller.alula.json") },
        NamedText { name: "/n/callee.alula.json", text: text_of_file(machine_files(), "callee.alula.json") },
        NamedText { name: "/n/nested-call-ok.alula.test.json", text: changed }
    ]
    ro ran = run_with(["test", "/n"], files)
    assert(ran.code == 1)
    assert(ran.out.contains("answer:bye"))
}

test "ps test folder verbose" {
    ro ran = run_with(["test", "/machine", "-v"], machine_folder())
    assert(ran.code == 0)
    ro total = test_files().len()
    assert(count_lines_with(ran.out, "ok /machine/tests/") == total)
    assert(ran.out.ends_with("${total} of ${total} tests passed\n"))
}

test "ps run small machines" {
    assert(run_all("calc.alula.json", text_of_file(machine_files(), "calc.alula.json"), tests_with("calc-")) == "")
    assert(run_all("gate.alula.json", text_of_file(machine_files(), "gate.alula.json"), tests_with("gate-")) == "")
    assert(run_all("lenses.alula.json", text_of_file(machine_files(), "lenses.alula.json"), tests_with("lenses-")) == "")
    assert(run_all("variants.alula.json", text_of_file(machine_files(), "variants.alula.json"), tests_with("variants-")) == "")
}

test "ps changed test is a report" {
    ro original = text_of_file(test_files(), "gate-done.alula.test.json")
    ro changed = original.replace("\"state\": \"Done\"", "\"state\": \"Work\"")
    assert(changed != original)
    ro files = [
        NamedText { name: "/g/gate.alula.json", text: text_of_file(machine_files(), "gate.alula.json") },
        NamedText { name: "/g/gate-done.alula.test.json", text: changed }
    ]
    ro ran = run_with(["run", "/g/gate.alula.json", "/g/gate-done.alula.test.json"], files)
    assert(ran.code == 1)
    assert(ran.out.contains("difference(s)"))
    assert(ran.out.contains("Done"))
    assert(ran.out.contains("Work"))
    ro folder = run_with(["test", "/g"], files)
    assert(folder.code == 1)
    assert(folder.out.contains("FAIL /g/gate-done.alula.test.json"))
    assert(folder.out.ends_with("0 of 1 tests passed\n"))
}
