// v227_test.nv - task 244 (Alula 0.27, AL-147): the root of the tree says `"kind": "machine"` and `revision` (an integer, 1 by default) instead of `"format": "machine/2"` and
// `version`; the old keys in a tree of 0.27 are an error with the hint; a tree of another version of the language is refused; the package names the one version 0.27.
module alula.machine_table

import std.text

fn up227() -> str => `,{"name":"u_attempt","type":"int>=0","initial":{"expr":${jl("0")}},"monotonic":true,"writes":"mechanics"}`

// The small machine as a tree of 0.27: the root keys of 0.27, the counter of the party without a row (the rules of 2.26 stay).
fn tiny227() -> str => tiny().replace(up227(), "").replace("{\"format\":\"machine/2\",\"machine\":\"Tiny\",\"version\":\"1\",", "{\"kind\":\"machine\",\"alula_version\":\"0.28\",\"machine\":\"Tiny\",\"revision\":4,")

test "v227 a tree of 0.27 with kind and revision is loaded" {
    assert(first_issue(tiny227()) == "ok")
    match parse_machine(tiny227()) {
        Ok(def) => {
            assert(def.alula_version == "0.28")
            assert(def.version == "4")
        }
        Err(e) => assert(false)
    }
}

test "v227 the revision is 1 by default" {
    ro t = tiny227().replace("\"revision\":4,", "")
    assert(first_issue(t) == "ok")
    match parse_machine(t) {
        Ok(def) => assert(def.version == "1")
        Err(e) => assert(false)
    }
}

test "v227 a revision that is not an integer is refused" {
    assert(!ok_text(tiny227().replace("\"revision\":4", "\"revision\":\"alula-2.26\"")))
    assert(!ok_text(tiny227().replace("\"revision\":4", "\"revision\":1.5")))
}

test "v227 the key format in a tree of 0.27 is an error with the hint" {
    ro t = tiny227().replace("{\"kind\":\"machine\",", "{\"format\":\"machine/2\",")
    assert(says(t, "с 0.27 — kind и revision"))
    ro both = tiny227().replace("{\"kind\":\"machine\",", "{\"kind\":\"machine\",\"format\":\"machine/2\",")
    assert(says(both, "с 0.27 — kind и revision"))
}

test "v227 the key version in a tree of 0.27 is an error with the hint" {
    ro t = tiny227().replace("\"revision\":4", "\"version\":\"4\"")
    assert(says(t, "с 0.27 — kind и revision"))
}

test "v227 a kind other than machine is refused" {
    assert(!ok_text(tiny227().replace("\"kind\":\"machine\"", "\"kind\":\"test\"")))
}

test "v227 a tree of another version of the language is refused" {
    assert(!ok_text(tiny227().replace("\"alula_version\":\"0.28\"", "\"alula_version\":\"2.26\"")))
    assert(says(tiny227().replace("\"alula_version\":\"0.28\"", "\"alula_version\":\"2.26\""), "0.27"))
}

test "v227 the package names the one version 0.27" {
    assert(alula_versions().len() == 1)
    assert(alula_versions().contains("0.27"))
    assert(ALULA_VERSION == "0.28")
    assert(top_keys().contains("kind"))
    assert(top_keys().contains("revision"))
}
