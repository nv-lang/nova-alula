// load_test.nv - the decoder: the chat machine, the keys of the schema, the refusals with their places.
module alula.machine_table

import alula.machine.{spec_text}
import std.text

test "parse errors" {
    match parse_machine("not json") {
        Ok(d) => assert(false)
        Err(e) => assert(e.path == "$")
    }
    match parse_machine("[]") {
        Ok(d) => assert(false)
        Err(e) => assert(e.message.contains("object"))
    }
    assert(first_issue("{}").contains("kind"))
    assert(first_issue("{\"format\":\"machine/1\"}").contains("machine/2"))
}

test "decode details" {
    ro def = decoded(tiny())
    assert(def.states.len() == 4)
    match def.states[1].rows[0].next.target {
        ToState(n) => assert(n == "Finished")
        _ => assert(false)
    }
    assert(def.states[1].rows[1].is_else)
    assert(def.states[3].except_field == "stop")
    assert(def.states[3].except_values.len() == 1)
    ro stay = tiny().replace("\"to\":\"Wait\"", "\"to\":\"@same\"")
    match decoded(stay).states[1].rows[1].next.target {
        ToSame => assert(true)
        _ => assert(false)
    }
    ro prev = tiny().replace("\"to\":\"Wait\"", "\"to\":\"@previous\", \"restart\":true")
    ro goto = decoded(prev).states[1].rows[1].next
    assert(goto.restart)
    match goto.target {
        ToPrevious => assert(true)
        _ => assert(false)
    }
}

test "data forms" {
    ro from_input = tiny_with(",{\"name\":\"m\",\"type\":\"int\",\"initial\":{\"from_input\":\"k\"}}", "", tiny_wait_rows(), tiny_ends_rows())
    match decoded(from_input).data[3].initial {
        InitialFromInput(f) => assert(f == "k")
        _ => assert(false)
    }
    ro zero_init = "\"initial\":{\"expr\":{\"op\":\"lit\",\"value\":0}}}"
    ro bounded = tiny().replace(zero_init, "\"initial\":{\"expr\":{\"op\":\"lit\",\"value\":0}},\"monotonic\":{\"bound\":{\"op\":\"lit\",\"value\":9}}}")
    ro d = decoded(bounded)
    assert(d.data[0].monotonic.on)
    assert(d.data[0].monotonic.bound.len() == 1)
    assert(says(tiny().replace(zero_init, "\"initial\":{\"expr\":{\"op\":\"lit\",\"value\":0},\"from_input\":\"q\"}}"), "alternatives"))
    assert(says(tiny().replace(zero_init, "\"initial\":{}}"), "expr or from_input"))
}

test "all actions decode" {
    ro one = jl("1")
    ro yes = jl("true")
    ro empty = jl("[]")
    ro a1 = `{"do":"add","target":{"name":"n","path":[{"key":${one}},{"field":"f"}]},"value":${one}}`
    ro a2 = `{"do":"journal_value","value":${one}}`
    ro a3 = `{"do":"journal_all"}`
    ro a4 = `{"do":"for_each","var":"x","in":${empty},"body":[]}`
    ro a5 = `{"do":"let","name":"y","value":${one},"body":[]}`
    ro a6 = `{"do":"bind","name":"z","value":${one}}`
    ro a7 = `{"do":"if","cond":${yes},"then":[]}`
    ro a8 = `{"do":"call","primitive":"close_agent_turn"}`
    ro a9 = `{"do":"machine_error","code":"boom"}`
    ro a10 = `{"do":"cancel_open","party":"user","except":[]}`
    ro a11 = `{"do":"pass","nested":${empty},"signal":"stop"}`
    ro rows = `{"n":1,"event":{"kind":"signal","name":"go"},"actions":[${a1},${a2},${a3},${a4},${a5},${a6},${a7},${a8},${a9},${a10},${a11}],"to":"Decide"}`
    ro def = decoded(tiny_with("", "", rows, tiny_ends_rows()))
    assert(def.states[0].rows[0].actions.len() == 11)
    match def.states[0].rows[0].actions[0] {
        AddAct { target, value } => {
            assert(target.root == "n")
            assert(target.steps.len() == 2)
        }
        _ => assert(false)
    }
    match def.states[0].rows[0].actions[3] {
        ForEachAct { var, list, body } => assert(var == "x")
        _ => assert(false)
    }
    match def.states[0].rows[0].actions[8] {
        MachineErrorAct { code, params } => assert(code == "boom")
        _ => assert(false)
    }
}

test "all events decode" {
    ro evs = [
        "{\"kind\":\"answer\",\"bind\":\"v\"}", "{\"kind\":\"answer_variant\",\"variant\":\"A\",\"bind\":{\"f\":\"g\"}}",
        "{\"kind\":\"failure\",\"reasons\":[\"Timeout\"],\"bind\":\"r\"}", "{\"kind\":\"timeout\"}",
        "{\"kind\":\"progress\",\"name\":\"p\"}", "{\"kind\":\"signal\",\"name\":\"s\"}", "{\"kind\":\"now\"}"
    ]
    mut labels = []str.new()
    for e in evs {
        ro rows = "{\"n\":1,\"event\":${e},\"to\":\"Decide\"}"
        ro def = decoded(tiny_with("", "", rows, tiny_ends_rows()))
        labels.push(event_label(def.states[0].rows[0].event))
    }
    assert(labels.join(",") == "answer,answer_variant,failure,timeout,progress,signal,now")
    assert(says(tiny_with("", "", "{\"n\":1,\"event\":{\"kind\":\"timeout\",\"x\":1},\"to\":\"Decide\"}", tiny_ends_rows()), "the key x"))
}

test "row forms" {
    ro both = "{\"n\":1,\"event\":{\"kind\":\"signal\",\"name\":\"go\"},\"cond\":${jl("true")},\"else\":true,\"to\":\"Decide\"}"
    assert(says(tiny_with("", "", both, tiny_ends_rows()), "condition or else"))
    ro unnumbered = "{\"event\":{\"kind\":\"signal\",\"name\":\"go\"},\"to\":\"Decide\"}"
    assert(says(tiny_with("", "", unnumbered, tiny_ends_rows()), "n is missing") || says(tiny_with("", "", unnumbered, tiny_ends_rows()), "the key n"))
    ro null_to = "{\"n\":1,\"event\":{\"kind\":\"signal\",\"name\":\"go\"},\"to\":null}"
    assert(says(tiny_with("", "", null_to, tiny_ends_rows()), "ends in machine_error"))
}
