// v212_test.nv - Alula 2.12 on the side of the tree and of the checks (task 125): the version of the language, the key `fragments`, the journal tables of the methodology and of the product
// (AL-31), the table "by role" of the parse (AL-33). Every check is red on the broken tree and green on the good one.
module alula.machine_table

import std.text
import alula.machine.{standard_registry, new_registry, find_role, has_roles, JournalCode, methodology_journal, product_journal, journal_union, journal_find, journal_table_issues}
import alula.machine.{schema_files, text_of_file, TextType, ListType, RecordType, IntMin, VariantType, machine_files, add_role, register, Primitive, ParamSpec, Reading}

fn with_version(version str) -> str => tiny().replace("\"format\":\"machine/2\",", "\"format\":\"machine/2\",\"alula_version\":\"${version}\",")

fn jlog(code str, names []str) -> str {
    mut ps = []str.new()
    for n in names { ps.push(`{"name":"${n}","value":${jl(jstr("v"))}}`) }
    `{"do":"journal","code":"${code}","params":[${ps.join(",")}]}`
}

// The tiny machine whose first word writes the journal event.
fn tiny_logging(code str, names []str) -> str {
    ro inc = jassign("n", jb("+", jn("n"), jl("1")))
    ro go = `{"n":1,"event":{"kind":"signal","name":"go"},"actions":[${inc},${jlog(code, names)}],"to":"Decide"}`
    ro halt = `{"n":2,"event":{"kind":"signal","name":"halt"},"actions":[${jassign("stop", jl(jstr("a")))}],"to":"Stopped"}`
    tiny_with("", "", "${go},${halt}", tiny_ends_rows())
}

fn with_fragments(call_args str) -> str => tiny().replace("\"initial\":\"Wait\"", "\"fragments\":[{\"name\":\"Pause\",\"args\":{${call_args}}}],\"initial\":\"Wait\"")

// ---- the version of the language ---------------------------------------------------------------------------------------------------------

test "v212 version accepted" {
    assert(ok_text(with_version("2.17")))
    assert(ok_text(tiny()))
}

test "v212 version 2.11 refused" {
    assert(!ok_text(with_version("2.11")))
    assert(says(with_version("2.11"), "alula_version"))
    assert(says(with_version("2.11"), "2.17"))
}

test "v212 older versions refused" {
    for v in ["2.5", "2.6", "2.7", "2.8", "2.9", "2.10", "2.14", "2.16"] {
        assert(!ok_text(with_version(v)))
    }
}

test "v212 versions list" {
    assert(alula_versions().len() == 1)
    assert(alula_versions()[0] == "2.17")
    assert(ALULA_VERSION == "2.17")
}

test "v212 schema versions" {
    ro schema = text_of_file(schema_files(), "machine-2.schema.json")
    assert(schema.contains("\"2.17\""))
    assert(!schema.contains("\"2.11\""))
    assert(!schema.contains("\"2.5\""))
}

test "v212 machines are 2.17" {
    for f in machine_files() {
        ro tree = decoded(f.text)
        assert(tree.states.len() > 0)
        assert(!f.text.contains("2.11"))
        assert(!f.text.contains("alula-2.11"))
        assert(!f.text.contains("alula-2.10"))
    }
}

// ---- the key `fragments` (1b (м), AL-32) -----------------------------------------------------------------------------------------------------

fn pause_args() -> str => `"halt_signal":{"op":"lit","value":"halt"},"halt_code":{"op":"lit","value":"pause_halt"},"nested":{"op":"list","items":[]},"cancel_requests":{"op":"lit","value":"mechanics"},"reenter":{"op":"lit","value":"nothing"},"write_right":{"op":"lit","value":"x"}`

test "v212 fragments key in the schema" {
    ro schema = text_of_file(schema_files(), "machine-2.schema.json")
    assert(schema.contains("\"fragments\""))
    assert(top_keys().contains("fragments"))
}

test "v212 fragments accepted" {
    assert(ok_text(with_fragments(pause_args())))
}

test "v212 fragments args missing" {
    assert(says(with_fragments(pause_args().replace(`,"write_right":{"op":"lit","value":"x"}`, "")), "write_right"))
    assert(says(with_fragments(pause_args().replace(`"write_right"`, `"extra"`)), "extra"))
}

test "v212 fragments name unknown" {
    assert(says(with_fragments(pause_args()).replace("\"name\":\"Pause\"", "\"name\":\"Rest\""), "fragment"))
}

test "v212 fragments args not an object" {
    assert(!ok_text(tiny().replace("\"initial\":\"Wait\"", "\"fragments\":[{\"name\":\"Pause\",\"args\":[]}],\"initial\":\"Wait\"")))
}

test "v212 fragments twice" {
    ro once = "{\"name\":\"Pause\",\"args\":{${pause_args()}}}"
    ro twice = tiny().replace("\"initial\":\"Wait\"", "\"fragments\":[${once},${once}],\"initial\":\"Wait\"")
    assert(says(twice, "twice"))
}

test "v212 fragments behavior word" {
    assert(says(with_fragments(pause_args().replace(`"value":"mechanics"`, `"value":"sometimes"`)), "cancel_requests"))
    assert(says(with_fragments(pause_args().replace(`"value":"nothing"`, `"value":"always"`)), "reenter"))
}

// ---- the journal tables (AL-31) ----------------------------------------------------------------------------------------------------------

test "v212 methodology table" {
    ro table = methodology_journal()
    assert(table.len() >= 80)
    assert(journal_find(table, "signal_passed").is_some())
    assert(journal_find(table, "human_stop").is_some())
    assert(journal_find(table, "fork_no_match").is_some())
    assert(journal_find(table, "machine_error").is_some())
    assert(journal_find(table, "input_rejected").is_some())
}

test "v212 methodology parameters" {
    match journal_find(methodology_journal(), "human_stop") {
        Some(row) => {
            assert(row.params.len() == 3)
            assert(row.params.contains("author") && row.params.contains("source") && row.params.contains("event"))
        }
        None => assert(false)
    }
    match journal_find(methodology_journal(), "input_rejected") {
        Some(row) => {
            assert(row.params == ["reason"])
            assert(row.optional == ["field", "index"])
        }
        None => assert(false)
    }
}

test "v212 product table" {
    ro table = product_journal()
    for code in ["signal_ordered", "answer_edited", "form_returned", "request_repeated", "event_ignored"] {
        assert(journal_find(table, code).is_some())
    }
    assert(table.len() >= 30)
}

test "v212 product table is its own" {
    assert(journal_table_issues(methodology_journal(), product_journal()).len() == 0)
    for row in product_journal() {
        assert(journal_find(methodology_journal(), row.code).is_none())
    }
}

test "v212 product table cannot repeat" {
    ro dup = [JournalCode { machine: "x", code: "human_stop", template: "стоп", params: []str.new(), optional: []str.new() }]
    ro issues = journal_table_issues(methodology_journal(), dup)
    assert(issues.len() == 1)
    assert(issues[0].contains("human_stop"))
}

test "v212 product table cannot replace the format code" {
    for code in ["signal_passed", "input_rejected", "machine_error", "machine_data"] {
        ro dup = [JournalCode { machine: "x", code, template: "t", params: []str.new(), optional: []str.new() }]
        assert(journal_table_issues(methodology_journal(), dup).len() == 1)
    }
}

test "v212 product table codes are snake case" {
    ro bad = [JournalCode { machine: "x", code: "BadCode", template: "t", params: []str.new(), optional: []str.new() }]
    assert(journal_table_issues(methodology_journal(), bad).len() == 1)
}

test "v212 union" {
    ro all = journal_union()
    assert(all.len() == methodology_journal().len() + product_journal().len())
    assert(journal_find(all, "signal_passed").is_some())
    assert(journal_find(all, "signal_ordered").is_some())
}

test "v212 registry names the tables" {
    assert(standard_registry().journal.len() == journal_union().len())
    assert(standard_registry().journal.len() > 100)
    assert(new_registry().journal.len() == 0)
}

test "v212 known methodology code" {
    assert(ok_text(tiny_logging("fork_no_match", ["fork"])))
}

test "v212 known product code" {
    assert(ok_text(tiny_logging("answer_edited", ["party", "request"])))
}

test "v212 unknown code" {
    assert(says(tiny_logging("not_in_any_table", []), "journal tables"))
    assert(says(tiny_logging("not_in_any_table", []), "not_in_any_table"))
}

test "v212 wrong parameters" {
    assert(says(tiny_logging("fork_no_match", ["place"]), "fork_no_match"))
    assert(says(tiny_logging("answer_edited", ["party"]), "request"))
}

test "v212 optional parameters" {
    assert(ok_text(tiny_logging("input_rejected", ["reason"])))
    assert(ok_text(tiny_logging("input_rejected", ["reason", "field"])))
    assert(says(tiny_logging("input_rejected", ["reason", "other"]), "other"))
}

test "v212 empty registry skips the table" {
    match load_machine(tiny_logging("not_in_any_table", []), new_registry()) {
        Ok(d) => assert(true)
        Err(list) => {
            mut said = false
            for e in list {
                if issue_text(e).contains("journal tables") { said = true }
            }
            assert(!said)
        }
    }
}

// ---- the table "by role" of the parse (AL-33) ------------------------------------------------------------------------------------------

test "v212 role table of the host" {
    ro reg = standard_registry()
    assert(has_roles(reg, "parse_agent_reply"))
    assert(find_role(reg, "parse_agent_reply", "witness").is_some())
    assert(find_role(reg, "parse_agent_reply", "author").is_some())
    assert(find_role(reg, "parse_agent_reply", "lens").is_some())
    assert(find_role(reg, "parse_agent_reply", "judge").is_none())
}

test "v212 role result types" {
    match find_role(standard_registry(), "parse_agent_reply", "witness") {
        Some(row) => assert(row.result == ListType(VariantType("WitnessAnswer")))
        None => assert(false)
    }
    match find_role(standard_registry(), "parse_agent_reply", "lens") {
        Some(row) => assert(row.result == RecordType("LensResult"))
        None => assert(false)
    }
}

test "v212 add role" {
    mut reg = new_registry()
    ro p = Primitive { name: "pr", params: [ParamSpec { name: "reply", spec: TextType }, ParamSpec { name: "role", spec: TextType }], result: TextType, class: Reading, reads: []str.new(), writes: []str.new() }
    assert(register(reg, p).is_ok())
    assert(add_role(reg, "pr", "a", IntMin(0), ["x"]).is_ok())
    assert(add_role(reg, "pr", "a", IntMin(0), []str.new()).is_err())
    assert(add_role(reg, "ghost", "a", IntMin(0), []str.new()).is_err())
    assert(find_role(reg, "pr", "a").is_some())
}
