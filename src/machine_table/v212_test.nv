// v212_test.nv - Alula 2.12 on the side of the tree and of the checks (task 125): the version of the language, the key `fragments` refused, the journal tables of the methodology and of the product
// (AL-31), the parse of a role (AL-33; one function per role since 2.24, AL-131). Every check is red on the broken tree and green on the good one.
module alula.machine_table

import std.text
import alula.machine.{new_registry, find_primitive, JournalCode, journal_find, journal_table_issues}
import alula.machine.{schema_files, text_of_file, ListType, RecordType, VariantType}
import alula.examples.{machine_files, sample_registry, example_registry}

fn with_version(version str) -> str => tiny().replace("\"format\":\"machine/2\",", "\"format\":\"machine/2\",\"alula_version\":\"${version}\",")

fn jlog(code str, names []str) -> str {
    mut ps = []str.new()
    for n in names { ps.push(`{"name":"${n}","value":${jl(jstr("v"))}}`) }
    `{"do":"journal","code":"${code}","params":[${ps.join(",")}]}`
}

// The tiny machine whose first signal writes the journal event.
fn tiny_logging(code str, names []str) -> str {
    ro inc = jassign("n", jb("+", jn("n"), jl("1")))
    ro go = `{"n":1,"event":{"kind":"signal","name":"go"},"actions":[${inc},${jlog(code, names)}],"to":"Decide"}`
    ro halt = `{"n":2,"event":{"kind":"signal","name":"halt"},"actions":[${jassign("stop", jl(jstr("a")))}],"to":"Stopped"}`
    tiny_with("", "", "${go},${halt}", tiny_ends_rows())
}

// The check of the journal codes needs a table: the registry of the examples (the language and the codes of `examples/journal.md`).
fn journal_issues(text str) -> []str {
    mut out = []str.new()
    match load_machine(text, example_registry()) {
        Ok(def) => ()
        Err(list) => {
            for e in list { out.push(issue_text(e)) }
        }
    }
    out
}

fn journal_ok(text str) -> bool => journal_issues(text).len() == 0

fn journal_says(text str, needle str) -> bool {
    for line in journal_issues(text) {
        if line.contains(needle) { return true }
    }
    false
}

// ---- the version of the language ---------------------------------------------------------------------------------------------------------

test "v212 version accepted" {
    assert(ok_text(with_version("2.25")))
    assert(ok_text(tiny()))
}

test "v212 version 2.11 refused" {
    assert(!ok_text(with_version("2.11")))
    assert(says(with_version("2.11"), "alula_version"))
    assert(says(with_version("2.11"), "0.27"))
}

test "v212 older versions refused" {
    for v in ["2.5", "2.6", "2.7", "2.8", "2.9", "2.10", "2.14", "2.16"] {
        assert(!ok_text(with_version(v)))
    }
}

test "v212 versions list" {
    assert(alula_versions().len() == 1)
    assert(alula_versions()[0] == "0.27")
    assert(ALULA_VERSION == "0.27")
}

test "v212 schema versions" {
    ro schema = text_of_file(schema_files(), "machine-2.schema.json")
    assert(schema.contains("\"0.27\""))
    assert(!schema.contains("\"2.11\""))
    assert(!schema.contains("\"2.5\""))
}

test "v212 machines are 2.25" {
    for f in machine_files() {
        ro tree = decoded(f.text)
        assert(tree.states.len() > 0)
        assert(!f.text.contains("2.11"))
        assert(!f.text.contains("alula-2.11"))
        assert(!f.text.contains("alula-2.10"))
    }
}

// ---- the key `fragments` is gone (0.9.1, task 241): a library is connected by its file ---------------------------------------------------------------

test "v212 the key fragments is refused" {
    ro schema = text_of_file(schema_files(), "machine-2.schema.json")
    assert(!schema.contains("\"fragments\""))
    assert(!top_keys().contains("fragments"))
    ro old = tiny().replace("\"initial\":\"Wait\"", "\"fragments\":[{\"name\":\"Pause\",\"args\":{}}],\"initial\":\"Wait\"")
    assert(!ok_text(old))
    assert(says(old, "a library is connected by its file"))
}

// ---- the journal tables (AL-31) ----------------------------------------------------------------------------------------------------------

test "v212 known language code of the format" {
    assert(journal_ok(tiny_logging("fork_no_match", ["fork"])))
}

test "v212 known language code of the engine" {
    assert(journal_ok(tiny_logging("answer_edited", ["party", "request"])))
}

test "v212 unknown code" {
    assert(journal_says(tiny_logging("not_in_any_table", []), "journal tables"))
    assert(journal_says(tiny_logging("not_in_any_table", []), "not_in_any_table"))
}

test "v212 wrong parameters" {
    assert(journal_says(tiny_logging("fork_no_match", ["place"]), "fork_no_match"))
    assert(journal_says(tiny_logging("answer_edited", ["party"]), "request"))
}

test "v212 optional parameters" {
    assert(journal_ok(tiny_logging("input_rejected", ["reason"])))
    assert(journal_ok(tiny_logging("input_rejected", ["reason", "field"])))
    assert(journal_says(tiny_logging("input_rejected", ["reason", "other"]), "other"))
}

test "v212 empty registry skips the table" {
    match load_machine(tiny_logging("not_in_any_table", []), new_registry()) {
        Ok(d) => assert(true)
        Err(list) => {
            mut said = false
            for e in list {
                if issue_text(e).contains("journal tables") { said = true }
            }
            assert(!said)
        }
    }
}

// ---- the parse of a role (AL-33; since 2.24 one function per role and no table by role, AL-131) ------------------------------------------------------------------------------------------

test "v212 parse functions by role in the registry of the host (AL-131)" {
    ro reg = sample_registry()
    assert(find_primitive(reg, "parse_agent_reply").is_none())
    for name in ["parse_witness_reply", "parse_author_reply", "parse_lens_reply"] {
        assert(find_primitive(reg, name).is_some())
    }
}

test "v212 parse function result types" {
    match find_primitive(sample_registry(), "parse_witness_reply") {
        Some(p) => assert(p.result == ListType(VariantType("WitnessAnswer")))
        None => assert(false)
    }
    match find_primitive(sample_registry(), "parse_author_reply") {
        Some(p) => assert(p.result == VariantType("EditResult"))
        None => assert(false)
    }
    match find_primitive(sample_registry(), "parse_lens_reply") {
        Some(p) => assert(p.result == RecordType("LensResult"))
        None => assert(false)
    }
}

test "v212 the witness function reads the proposal, the others do not" {
    match find_primitive(sample_registry(), "parse_witness_reply") {
        Some(p) => assert(p.reads.contains("object: proposal"))
        None => assert(false)
    }
    match find_primitive(sample_registry(), "parse_author_reply") {
        Some(p) => assert(!p.reads.contains("object: proposal"))
        None => assert(false)
    }
}
