// support_test.nv - helpers of the tests of the English sample of the agent step: the two samples of the methodology, the comparison of two trees `machine/2` that does not count the names of the
// local variables of the author (the parameters of a definition, `let`, the variables of a lambda and of a loop, the bindings of an event) and the strings of the author.
module alula.machine_agent_en

import std.text
import std.encoding.json.{Json, JsonValue, JsonObject}
import alula.machine_agent.{methodology_text, methodology_en_text}
import alula.machine_text.{translate_checked, TranslateReport}
import alula.examples.{sample_registry}

fn lf(text str) -> str => text.replace("\r\n", "\n")

fn ru_sample() -> str => lf(methodology_text())

fn en_sample() -> str => lf(methodology_en_text())

fn report_of(text str) -> TranslateReport => translate_checked(text, sample_registry())

fn en_report() -> TranslateReport => report_of(en_sample())

fn ru_report() -> TranslateReport => report_of(ru_sample())

fn sval(o JsonObject, key str) -> str {
    match o.get(key) {
        Some(v) => match v.str() {
            Some(s) => s
            None => ""
        }
        None => ""
    }
}

fn is_defn(o JsonObject) -> bool => o.contains("params") && o.contains("result") && o.contains("body")

// The names that a unit (a definition, a state, a common event, the ends) binds for itself.
fn binders_of(v JsonValue, mut out []str) -> () {
    match v.array() {
        Some(items) => {
            for item in items { binders_of(item, out) }
            return
        }
        None => ()
    }
    match v.object() {
        Some(o) => {
            ro op = sval(o, "op")
            ro act = sval(o, "do")
            if op == "let" { out.push(sval(o, "name")) }
            if act == "let" || act == "bind" { out.push(sval(o, "name")) }
            if act == "for_each" { out.push(sval(o, "var")) }
            if op == "lambda" {
                match o.get("params") {
                    Some(ps) => {
                        match ps.array() {
                            Some(items) => {
                                for p in items {
                                    match p.str() {
                                        Some(s) => out.push(s)
                                        None => ()
                                    }
                                }
                            }
                            None => ()
                        }
                    }
                    None => ()
                }
            }
            if is_defn(o) {
                match o.get("params") {
                    Some(ps) => {
                        match ps.array() {
                            Some(items) => {
                                for p in items {
                                    match p.object() {
                                        Some(po) => out.push(sval(po, "name"))
                                        None => ()
                                    }
                                }
                            }
                            None => ()
                        }
                    }
                    None => ()
                }
            }
            match o.get("bind") {
                Some(b) => {
                    match b.object() {
                        Some(bo) => {
                            for k in bo.keys() { out.push(sval(bo, k)) }
                        }
                        None => {
                            match b.str() {
                                Some(s) => out.push(s)
                                None => ()
                            }
                        }
                    }
                }
                None => ()
            }
            for k in o.keys() {
                match o.get(k) {
                    Some(child) => binders_of(child, out)
                    None => ()
                }
            }
        }
        None => ()
    }
}

// The text of the tree with the local names turned into `_`.
fn masked(v JsonValue, locals []str) -> str {
    match v.array() {
        Some(items) => {
            mut parts = []str.new()
            for item in items { parts.push(masked(item, locals)) }
            return "[${parts.join(",")}]"
        }
        None => ()
    }
    match v.object() {
        Some(o) => {
            ro op = sval(o, "op")
            ro act = sval(o, "do")
            ro defn = is_defn(o)
            mut parts = []str.new()
            for k in o.keys() {
                match o.get(k) {
                    Some(child) => {
                        mut shown = ""
                        if k == "name" && op == "name" && locals.contains(sval(o, "name")) {
                            shown = "\"_\""
                        } else if (k == "name" && (op == "let" || act == "let" || act == "bind")) || (k == "var" && act == "for_each") {
                            shown = "\"_\""
                        } else if k == "params" && op == "lambda" {
                            shown = masked_all(child, "_")
                        } else if k == "params" && defn {
                            shown = masked_defn_params(child)
                        } else if k == "bind" {
                            shown = masked_bind(child)
                        } else {
                            shown = masked(child, locals)
                        }
                        parts.push("\"${k}\":${shown}")
                    }
                    None => ()
                }
            }
            return "{${parts.join(",")}}"
        }
        None => ()
    }
    v.to_str()
}

fn masked_all(v JsonValue, word str) -> str {
    match v.array() {
        Some(items) => {
            mut parts = []str.new()
            for item in items { parts.push("\"${word}\"") }
            "[${parts.join(",")}]"
        }
        None => v.to_str()
    }
}

fn masked_defn_params(v JsonValue) -> str {
    match v.array() {
        Some(items) => {
            mut parts = []str.new()
            for item in items {
                match item.object() {
                    Some(o) => parts.push("{\"name\":\"_\",\"type\":${(o.get("type") ?? JsonValue.null()).to_str()}}")
                    None => ()
                }
            }
            "[${parts.join(",")}]"
        }
        None => v.to_str()
    }
}

// The binding of an event: the fields stay, the local names go.
fn masked_bind(v JsonValue) -> str {
    match v.object() {
        Some(o) => {
            mut parts = []str.new()
            for k in o.keys() { parts.push("\"${k}\":\"_\"") }
            "{${parts.join(",")}}"
        }
        None => "\"_\""
    }
}

// The tree of a JSON text with the units that bind names masked (the definitions, the states, the common events, the ends), and without the title.
fn tree_text(json str) -> str {
    match Json.parse(json) {
        Ok(root) => {
            match root.object() {
                Some(o) => {
                    mut parts = []str.new()
                    for k in o.keys() {
                        if k == "title" { continue }
                        match o.get(k) {
                            Some(child) => {
                                if k == "definitions" || k == "states" || k == "common_events" {
                                    match child.array() {
                                        Some(items) => {
                                            mut units = []str.new()
                                            for unit in items {
                                                mut locals = []str.new()
                                                binders_of(unit, locals)
                                                units.push(masked(unit, locals))
                                            }
                                            parts.push("\"${k}\":[${units.join(",")}]")
                                        }
                                        None => parts.push("\"${k}\":${child.to_str()}")
                                    }
                                } else if k == "ends" {
                                    mut locals = []str.new()
                                    binders_of(child, locals)
                                    parts.push("\"${k}\":${masked(child, locals)}")
                                } else {
                                    parts.push("\"${k}\":${child.to_str()}")
                                }
                            }
                            None => ()
                        }
                    }
                    "{${parts.join(",")}}"
                }
                None => "not an object"
            }
        }
        Err(e) => "not a json"
    }
}

// The strings of the author in the Russian sample that the English one writes in English (the text of the refusal of the end Errored, the note `write_right` of the connection of Pause).
fn ru_strings_in_english(json str) -> str => json.replace("дефект шага агента: ", "agent step defect: ").replace("файлы, которые правит агент; пауза их права не трогает", "files the agent edits; the pause does not touch their rights")

// The names under a key of a tree, in order (`constants`, `params`, `definitions`, `parties`).
fn names_under(json str, key str) -> []str {
    mut out = []str.new()
    match Json.parse(json) {
        Ok(root) => {
            match root.object() {
                Some(o) => {
                    match o.get(key) {
                        Some(list) => {
                            match list.array() {
                                Some(items) => {
                                    for item in items {
                                        match item.object() {
                                            Some(io) => out.push(sval(io, "name"))
                                            None => ()
                                        }
                                    }
                                }
                                None => ()
                            }
                        }
                        None => ()
                    }
                }
                None => ()
            }
        }
        Err(e) => ()
    }
    out
}

// The Russian tree as the English one writes it: the strings of the author, and the internal names (a constant, a parameter, a definition, a party: they are written to the tree as they are, AL-46)
// by the place in the two lists; the JSON names are the same in both trees. Every quoted name is replaced, so its uses (a call, a reference, the party of a state) follow.
fn ru_in_english(ru_json str, en_json str) -> str {
    mut text = ru_strings_in_english(ru_json)
    for key in ["constants", "params", "definitions", "parties"] {
        ro from = names_under(ru_json, key)
        ro to = names_under(en_json, key)
        if from.len() != to.len() { panic("the lists ${key} differ in length: ${from.len()} / ${to.len()}") }
        mut i = 0
        while i < from.len() {
            if from[i] != to[i] { text = text.replace("\"${from[i]}\"", "\"${to[i]}\"") }
            // the key of the project is the key of the project in both trees (a parameter is named after it)
            if from[i] != to[i] { text = text.replace("\"project_key\":\"${to[i]}\"", "\"project_key\":\"${from[i]}\"") }
            i += 1
        }
    }
    text
}
