// table_test.nv - the many-turn chat as data (task 114): the table `machines/dialog.alula.md` (Alula 2.11) translates without a note, its translation is the committed file
// `dialog.alula.json`, the machine loads, builds, takes the idle term from the parameter of the project, has no primitives; every row of the table has a scenario (the mark `taken`).
module alula.machine_dialog

// ORACLE-WORKAROUND(32): `import std.text` is needed in `nova build` for `[]str.join` (a `nova test` build has it already); drop the import when item 32 is fixed
import std.text
import std.encoding.json.{Json}
import alula.machine.{standard_registry, dialog_machine_text, dialog_table_text, scenario_files, NamedText, Int, Text}
import alula.machine_table.{MachineDef, load_machine}
import alula.machine_run.{AlulaMachine, AlulaState, ProjectValue, Scenario, ScenarioRun, load_alula_machine, load_alula_machine_with, parse_scenario, run_scenario, run_ok, report_text}
import alula.machine_text.{translate_checked, translate_report, TranslateReport, error_text, render_summary}
import alula.engine.{Incoming, EventKind, StepEnvironment, Order}

fn dialog_report() -> TranslateReport => translate_checked(dialog_table_text(), standard_registry())

fn errors_text(report TranslateReport) -> str {
    mut parts = []str.new()
    for e in report.errors { parts.push(error_text(e, "dialog.alula.md")) }
    for w in report.warnings { parts.push(error_text(w, "dialog.alula.md")) }
    parts.join(" ## ")
}

fn dialog_def() -> MachineDef {
    match load_machine(dialog_machine_text(), standard_registry()) {
        Ok(d) => d
        Err(issues) => panic("the dialog machine does not load: ${issues[0].path}: ${issues[0].message}")
    }
}

// ORACLE-WORKAROUND(51): the table of the project is built by a function, not by a literal inside the `match` that loads the machine (a record literal in the scrutinee is a syntax error); write it in place when item 51 is fixed
fn term_value(ms int) -> []ProjectValue => [ProjectValue { key: "проект.срок_бездействия", value: Int(ms) }]

fn dialog_with(ms int) -> AlulaMachine {
    match load_alula_machine_with(dialog_machine_text(), standard_registry(), term_value(ms)) {
        Ok(m) => m
        Err(e) => panic("the dialog machine is not made: ${e}")
    }
}

test "dl clean" {
    ro report = dialog_report()
    if report.errors.len() > 0 || report.warnings.len() > 0 { panic(errors_text(report)) }
    assert(report.errors.len() == 0)
    assert(report.warnings.len() == 0)
    assert(report.rows_noted == 0)
    assert(report.rows_total == 19)
}

test "dl file is translation" {
    assert(dialog_report().json == dialog_machine_text())
    assert(translate_report(dialog_table_text()).json == dialog_machine_text())
}

test "dl header" {
    assert(dialog_table_text().contains("- format: 2.17"))
    assert(dialog_table_text().contains("- machine: DialogSession"))
    assert(dialog_machine_text().contains("\"alula_version\": \"2.17\"") || dialog_machine_text().contains("\"alula_version\":\"2.17\""))
}

test "dl loads" {
    ro def = dialog_def()
    assert(def.name == "DialogSession")
    assert(def.version == "1")
    assert(def.initial == "Idle")
    assert(def.states.len() == 3)
    assert(def.states[0].name == "Idle")
    assert(def.states[1].name == "Awaiting")
    assert(def.states[2].name == "Closed")
    assert(def.states[0].rows.len() == 2)
    assert(def.states[1].rows.len() == 5)
    assert(def.parties.len() == 2)
    assert(def.params.len() == 1)
    assert(def.params[0].name == "СРОК_БЕЗДЕЙСТВИЯ")
    assert(def.params[0].project_key == "срок_бездействия")
    assert(def.constants.len() == 0)
    assert(def.end_rows.len() == 1)
    assert(def.common.len() == 0)
}

test "dl no primitives" {
    ro def = dialog_def()
    assert(def.primitives.len() == 0)
    assert(def.definitions.len() == 0)
    assert(def.request_limit.len() == 0)
}

test "dl builds" {
    ro m = dialog_with(30000)
    assert(m.name() == "DialogSession")
    assert(m.state_name(m.initial()) == "Idle")
    assert(m.limit == 0)
    assert(m.quiet_start)
}

test "dl summary" {
    ro text = render_summary(dialog_machine_text())
    assert(text.starts_with("machine DialogSession (version 1): 3 states, 7 rows, "))
    assert(text.contains("  Idle (appeal): 2 rows"))
    assert(text.contains("  Awaiting (appeal): 5 rows"))
    assert(text.contains("  Closed (end): 0 rows"))
    assert(text.contains("ends: 1 rows"))
}

// ---- the parameter of the project: the idle term ---------------------------------------------------------------------------------

fn orders_text(orders []Order) -> str {
    mut parts = []str.new()
    for o in orders {
        match o {
            Send(order) => parts.push("send:${order.party}:${order.input}:${order.idle_term}")
            Note(event) => parts.push("log:${event.code}")
            Cancel(order) => parts.push("cancel:${order.party}")
            Save => parts.push("save")
            Finish(c) => parts.push("finish")
        }
    }
    parts.join(",")
}

fn first_message(m AlulaMachine) -> str {
    mut environment = StepEnvironment.new()
    ro event = Incoming { id: "e-1", trace: "t-1", step: 2, kind: EventKind.Input, name: "user_message", request: None, input: "hi", at: 1000 }
    ro transition = m.step(m.initial(), event, environment)
    orders_text(environment.orders)
}

test "dl idle term from the project" {
    assert(first_message(dialog_with(30000)) == "log:user_message,send:agent:hi:30000,save")
    assert(first_message(dialog_with(1)) == "log:user_message,send:agent:hi:1,save")
    assert(first_message(dialog_with(900000)) == "log:user_message,send:agent:hi:900000,save")
    assert(first_message(dialog_with(123456)) == "log:user_message,send:agent:hi:123456,save")
}

test "dl idle term default" {
    match load_alula_machine(dialog_machine_text(), standard_registry()) {
        Ok(m) => assert(first_message(m) == "log:user_message,send:agent:hi:900000,save")
        Err(e) => panic("the dialog machine does not load: ${e}")
    }
}

test "dl idle term refused" {
    ro bad_key = [ProjectValue { key: "проект.срок", value: Int(5) }]
    match load_alula_machine_with(dialog_machine_text(), standard_registry(), bad_key) {
        Ok(m) => assert(false)
        Err(e) => assert(e.contains("проект.срок"))
    }
    ro bad_type = [ProjectValue { key: "проект.срок_бездействия", value: Text("soon") }]
    match load_alula_machine_with(dialog_machine_text(), standard_registry(), bad_type) {
        Ok(m) => assert(false)
        Err(e) => assert(e.contains("СРОК_БЕЗДЕЙСТВИЯ"))
    }
    ro negative = term_value(-1)
    match load_alula_machine_with(dialog_machine_text(), standard_registry(), negative) {
        Ok(m) => assert(false)
        Err(e) => assert(e.contains("СРОК_БЕЗДЕЙСТВИЯ"))
    }
    ro twice = [ProjectValue { key: "проект.срок_бездействия", value: Int(5) }, ProjectValue { key: "проект.срок_бездействия", value: Int(6) }]
    match load_alula_machine_with(dialog_machine_text(), standard_registry(), twice) {
        Ok(m) => assert(false)
        Err(e) => assert(e.contains("twice"))
    }
}

test "dl the step reads only its event" {
    // the stamp of the event is the only clock: two stamps, the same orders and the same state
    ro m = dialog_with(30000)
    mut first = StepEnvironment.new()
    mut second = StepEnvironment.new()
    ro early = Incoming { id: "e-1", trace: "t-1", step: 2, kind: EventKind.Input, name: "user_message", request: None, input: "hi", at: 1000 }
    ro late = Incoming { id: "e-1", trace: "t-1", step: 2, kind: EventKind.Input, name: "user_message", request: None, input: "hi", at: 9999999 }
    ro a = m.step(m.initial(), early, first)
    ro b = m.step(m.initial(), late, second)
    assert(orders_text(first.orders) == orders_text(second.orders))
    match a {
        Go(sa) => match b {
            Go(sb) => assert(m.encode_state(sa) == m.encode_state(sb))
            Stay => assert(false)
        }
        Stay => assert(false)
    }
}

// ---- every row has a scenario -----------------------------------------------------------------------------------------------------

// The rows of the machine as marks: `State#n`, `common#n`, `end:State#n`.
fn all_rows() -> []str {
    ro def = dialog_def()
    mut out = []str.new()
    for st in def.states {
        for r in st.rows { out.push("${st.name}#${r.n}") }
    }
    for r in def.common { out.push("common#${r.n}") }
    for er in def.end_rows { out.push("end:${er.state}#${er.n}") }
    out
}

fn dialog_scenarios() -> []NamedText {
    mut out = []NamedText.new()
    for f in scenario_files() {
        if f.name.starts_with("dialog-") { out.push(f) }
    }
    out
}

// The rows taken after every step of a scenario, from the encoded state of the trace.
fn taken_of(encoded str) -> []str {
    mut out = []str.new()
    match Json.parse(encoded) {
        Ok(j) => match j.object() {
            Some(o) => match o.get("taken") {
                Some(t) => match t.array() {
                    Some(items) => {
                        for item in items {
                            match item.str() {
                                Some(s) => out.push(s)
                                None => ()
                            }
                        }
                    }
                    None => ()
                }
                None => ()
            }
            None => ()
        }
        Err(e) => ()
    }
    out
}

fn taken_by(run ScenarioRun) -> []str {
    mut out = []str.new()
    for t in run.traces {
        for r in taken_of(t.encoded) {
            if !out.contains(r) { out.push(r) }
        }
    }
    out
}

test "dl rows counted" {
    ro rows = all_rows()
    assert(rows.len() == 8)
    for r in ["Idle#1", "Idle#2", "Awaiting#1", "Awaiting#2", "Awaiting#3", "Awaiting#4", "Awaiting#5", "end:Closed#1"] { assert(rows.contains(r)) }
}

test "dl scenarios take every row" {
    ro m = dialog_with(30000)
    ro files = dialog_scenarios()
    assert(files.len() >= 30)
    mut covered = []str.new()
    mut steps = 0
    for f in files {
        match parse_scenario(f.text) {
            Ok(sc) => {
                ro run = run_scenario(m, sc)
                if !run_ok(run) { panic(report_text(run)) }
                steps += sc.steps.len()
                for r in taken_by(run) {
                    if !covered.contains(r) { covered.push(r) }
                }
            }
            Err(e) => panic("${f.name}: ${e.path}: ${e.message}")
        }
    }
    assert(steps >= 150)
    for row in all_rows() {
        if !covered.contains(row) { panic("no scenario takes the row ${row}") }
    }
    assert(covered.len() == 8)
}
