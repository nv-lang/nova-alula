// render_test.nv - task 113: the reverse generator `render_machine(json, language)`: the canonical form of section 1b (the header, the eleven sections, the keys of a state in their order, the
// tables with one space round the bar, the operators of the language), the circles "tree -> file -> tree" in both languages on every machine of the product, and "Russian -> English -> Russian".
module alula.machine_text_render

import std.text
import alula.machine.{table_files, text_of_file, chat_table_text, agent_step_table_text}
import alula.machine_agent.{methodology_text, methodology_en_text}
import alula.machine_text_eq.{case_text}
import alula.machine_text.{render_machine, render_machine_with, render, translate_report, render_type_in, render_expression_in, render_actions_in}

fn chat_json() -> str => machine_json("chat.alula.json")

fn calc_json() -> str => machine_json("calc.alula.json")

// ---- the canonical form ----------------------------------------------------------------------------------------------------------

test "rn header ru" {
    ro text = render(calc_json(), "ru")
    ro lines = text.split("\n")
    mut first = []str.new()
    for l in lines {
        if first.len() < 7 { first.push(l) }
    }
    assert(first[0] == "# Машина: Calc")
    assert(first[1] == "")
    assert(first[2] == "- machine: Calc")
    assert(first[3] == "- machine_version: 1")
    assert(first[4] == "- format: 2.12")
    assert(first[5] == "- language: ru")
    assert(first[6] == "")
}

test "rn header en" {
    ro text = render(calc_json(), "en")
    assert(text.starts_with("# Machine: Calc\n\n- machine: Calc\n- machine_version: 1\n- format: 2.12\n- language: en\n\n"))
}

test "rn eleven sections" {
    ro ru = render(calc_json(), "ru")
    ro en = render(calc_json(), "en")
    mut at = 0
    for h in ["## Типы", "## Константы", "## Параметры", "## Вход", "## Данные", "## Стороны", "## Определения", "## Подключения", "## Состояния", "## Концы", "## Примитивы"] {
        ro found = index_of_line(ru, h)
        assert(found > at)
        at = found
    }
    mut at_en = 0
    for h in ["## Types", "## Constants", "## Parameters", "## Input", "## Data", "## Parties", "## Definitions", "## Includes", "## States", "## Ends", "## Primitives"] {
        ro found = index_of_line(en, h)
        assert(found > at_en)
        at_en = found
    }
}

test "rn empty section dash" {
    ro en = render(chat_json(), "en")
    ro at = index_of_line(en, "## Types")
    assert(at > 0)
    assert(lines_from(en, at, 3) == "## Types\n—\n")
    assert(lines_from(en, index_of_line(en, "## Input"), 2) == "## Input\n—")
    assert(lines_from(en, index_of_line(en, "## Includes"), 2) == "## Includes\n—")
    // a table has an empty line under the heading
    assert(lines_from(en, index_of_line(en, "## Data"), 3).starts_with("## Data\n\n| name |"))
}

test "rn file ends once" {
    for lang in ["ru", "en"] {
        ro text = render(calc_json(), lang)
        assert(text.ends_with("\n"))
        assert(!text.ends_with("\n\n"))
        assert(!text.contains("\r"))
        assert(text.to_code_points()[0] != 65279)
    }
}

test "rn language word" {
    ro ru = render(chat_json(), "ru")
    ro en = render(chat_json(), "en")
    assert(text_has_line(ru, "## Состояния") && text_has_line(ru, "## Концы"))
    assert(text_has_line(en, "## States") && text_has_line(en, "## Ends"))
    assert(!en.contains("Состояния"))
    assert(ru.contains("Начальное состояние: ") && en.contains("Initial state: "))
}

test "rn tables" {
    ro en = render(calc_json(), "en")
    assert(text_has_line(en, "| name | type | initial | non_decreasing | writes |"))
    assert(text_has_line(en, "|---|---|---|---|---|"))
    assert(text_has_line(en, "| № | Event | Condition | Actions | To |"))
    ro ru = render(calc_json(), "ru")
    assert(text_has_line(ru, "| имя | тип | начальное | не убывает | пишет |"))
    assert(text_has_line(ru, "| № | Событие | Условие | Действия | Куда |"))
    assert(text_has_line(ru, "|---|---|---|---|---|"))
}

test "rn appeal keys in order" {
    ro en = render(machine_json("gate.alula.json"), "en")
    ro party = index_of_line(en, "- Party: agent")
    assert(party > 0)
    assert(lines_from(en, party, 1) == "- Party: agent")
    ro idle = lines_from(en, party + 1, 1)
    assert(idle.starts_with("- Idle term: "))
    assert(lines_from(en, party + 2, 1).starts_with("- Input:"))
}

test "rn state heading no brackets" {
    ro en = render(calc_json(), "en")
    assert(en.contains("### Errored — end\n"))
    assert(!en.contains(" — end (Errored)"))
    ro ru = render(calc_json(), "ru")
    assert(ru.contains("### Errored — конец\n"))
    assert(ru.contains("Начальное состояние: "))
}

test "rn operators en ascii" {
    ro en = render(calc_json(), "en")
    for sign in ["≥", "≤", "≠", "→", "…", "∈"] { assert(!en.contains(sign)) }
    ro agent = render(machine_json("agent_step.alula.json"), "en")
    for sign in ["≥", "≤", "≠", "→", "…", "∈"] { assert(!agent.contains(sign)) }
    assert(agent.contains("int>=0"))
    assert(agent.contains("-> "))
}

test "rn operators ru canon" {
    ro agent = render(machine_json("agent_step.alula.json"), "ru")
    assert(agent.contains("число≥0"))
    assert(agent.contains("→"))
    assert(agent.contains(" ∈ {") || agent.contains("Кроме: "))
    assert(agent.contains(" >= "))
    assert(!agent.contains(" ≥ "))
}

test "rn declarations in blocks" {
    ro agent = render(machine_json("agent_step.alula.json"), "en")
    ro at = index_of_line(agent, "## Types")
    assert(lines_from(agent, at + 1, 2) == "\n```")
    assert(agent.contains("\nenum CallerKind = Lens | CycleSession | ChatTurn | Gatekeeper\n"))
    assert(agent.contains("\nvariant TurnResult {\n  Finished { text ?text, artifact ?text, usage TransportUsage }\n"))
    assert(agent.contains("\ndefine sum_ints(a ?int, b ?int) -> ?int =\n  "))
}

test "rn words of an enum" {
    ro agent = render(machine_json("agent_step.alula.json"), "en")
    assert(agent.contains("Read \"read\""))
    assert(agent.contains("SwitchMode \"switch_mode\""))
}

fn inc_en(hash str) -> str => `# Machine: Inc

- machine: Inc
- machine_version: 1
- format: 2.12
- language: en

## Data

| name | type | initial | non_decreasing | writes |
|---|---|---|---|---|
| n | int>=0 | 0 | — | rows |

## Includes

definitions: cycle_arithmetic version 1 hash ${hash}

## States

Initial state: S

### S — operation
- Input: n

| № | Event | Condition | Actions | To |
|---|---|---|---|---|
| 1 | immediate | — | n = if ceiling_reached(n, 1, 3) then 0 else n + 1 | F |

### F — end
- Input: n

## Ends

- Result: int

| end | № | when | response |
|---|---|---|---|
| F | 1 | true | Response(n) |
`

test "rn includes line by default" {
    ro first = json_of(inc_en("eee8c3a13a08"))
    assert(!first.starts_with("ERROR "))
    ro made = render_machine(first, "en")
    assert(made.notes.len() == 0)
    assert(made.text.contains("## Includes\n\n```\ndefinitions: cycle_arithmetic version 1 hash eee8c3a13a08\n```\n"))
    assert(!made.text.contains("define ceiling_reached"))
    assert(same_tree(first, json_of(made.text)) == "")
    ro ru = render(first, "ru")
    assert(ru.contains("определения: cycle_arithmetic версия 1 хеш eee8c3a13a08"))
    assert(same_tree(first, json_of(ru)) == "")
}

test "rn includes as copy" {
    ro first = json_of(inc_en("eee8c3a13a08"))
    ro made = render_machine_with(first, "en", true)
    assert(made.text.contains("define ceiling_reached(pass_number int>=1, origin int>=1, limit int>=0) -> bool =\n  pass_number - 1 - origin + 1 >= limit"))
    assert(made.text.contains("## Includes\n—\n"))
    ro back = json_of(made.text)
    assert(!back.starts_with("ERROR "))
    assert(!back.contains("\"includes\""))
    assert(back.contains("\"definitions\":[{\"name\":\"ceiling_reached\""))
}

test "rn include unknown file" {
    ro first = "{\"format\":\"machine/2\",\"machine\":\"M\",\"version\":\"1\",\"includes\":[{\"name\":\"nothing\",\"version\":\"1\",\"hash\":\"000000000000\"}],\"data\":[],\"parties\":[],\"initial\":\"S\",\"states\":[],\"ends\":{\"result\":\"int\",\"rows\":[]}}"
    ro made = render_machine(first, "en")
    assert(made.notes.len() == 1)
    assert(made.notes[0].contains("`nothing` is not in the registry"))
}

