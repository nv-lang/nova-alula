{
  "format": "machine/2",
  "alula_version": "2.23",
  "machine": "Actions",
  "version": "1",
  "title": "One word for every kind of action: assignment, +=, the key and the path, the three journal forms, for each, let, if, a call, a machine error",
  "types": {
    "records": [ { "name": "Item", "fields": [ { "name": "name", "type": "text" } ] } ]
  },
  "primitives": [ "close_agent_turn" ],
  "data": [
    { "name": "total", "type": "int", "initial": { "expr": { "op": "lit", "value": 0 } } },
    { "name": "label", "type": "text", "initial": { "expr": { "op": "lit", "value": "" } } },
    { "name": "log", "type": "[]text", "initial": { "expr": { "op": "list", "items": [] } } },
    { "name": "counts", "type": "{text: int}", "initial": { "expr": { "op": "dict", "entries": [] } } },
    { "name": "items", "type": "{text: Item}", "initial": { "expr": { "op": "dict", "entries": [] } } },
    { "name": "p_attempt", "type": "int>=0", "initial": { "expr": { "op": "lit", "value": 0 } }, "monotonic": true, "writes": "mechanics" }
  ],
  "parties": [
    {
      "name": "p", "id": "p", "kind": "human", "counter": "p_attempt",
      "signals": [
        { "name": "add", "fields": [ { "name": "n", "type": "int" } ] },
        { "name": "tag", "fields": [ { "name": "s", "type": "text" } ] },
        { "name": "push", "fields": [ { "name": "item", "type": "text" } ] },
        { "name": "put", "fields": [ { "name": "key", "type": "text" }, { "name": "val", "type": "text" } ] },
        { "name": "rename", "fields": [ { "name": "key", "type": "text" }, { "name": "val", "type": "text" } ] },
        { "name": "each" },
        { "name": "branch", "fields": [ { "name": "n", "type": "int" } ] },
        { "name": "letit", "fields": [ { "name": "n", "type": "int" } ] },
        { "name": "shut" },
        { "name": "boom" },
        { "name": "finish" }
      ]
    }
  ],
  "initial": "Wait",
  "error_end": "Errored",
  "states": [
    {
      "name": "Wait", "kind": "appeal", "party": "p",
      "inputs": [
        { "field": "total", "value": { "op": "name", "name": "total" }, "reads": "executor" },
        { "field": "label", "value": { "op": "name", "name": "label" }, "reads": "executor" },
        { "field": "log", "value": { "op": "name", "name": "log" }, "reads": "executor" },
        { "field": "counts", "value": { "op": "name", "name": "counts" }, "reads": "executor" },
        { "field": "items", "value": { "op": "name", "name": "items" }, "reads": "executor" }
      ],
      "rows": [
        { "n": 1, "event": { "kind": "signal", "name": "add", "bind": { "n": "n" } },
          "actions": [ { "do": "add", "target": "total", "value": { "op": "name", "name": "n" } } ], "to": "@same" },
        { "n": 2, "event": { "kind": "signal", "name": "tag", "bind": { "s": "s" } },
          "actions": [ { "do": "add", "target": "label", "value": { "op": "name", "name": "s" } } ], "to": "@same" },
        { "n": 3, "event": { "kind": "signal", "name": "push", "bind": { "item": "item" } },
          "actions": [
            { "do": "add", "target": "log", "value": { "op": "list", "items": [ { "op": "name", "name": "item" } ] } },
            { "do": "assign", "target": { "name": "counts", "path": [ { "key": { "op": "name", "name": "item" } } ] },
              "value": { "op": "+", "left": { "op": "??", "left": { "op": "index", "of": { "op": "name", "name": "counts" }, "index": { "op": "name", "name": "item" } }, "right": { "op": "lit", "value": 0 } }, "right": { "op": "lit", "value": 1 } } }
          ], "to": "@same" },
        { "n": 4, "event": { "kind": "signal", "name": "put", "bind": { "key": "key", "val": "val" } },
          "actions": [
            { "do": "assign", "target": { "name": "items", "path": [ { "key": { "op": "name", "name": "key" } } ] },
              "value": { "op": "record", "type": "Item", "fields": { "name": { "op": "name", "name": "val" } } } }
          ], "to": "@same" },
        { "n": 5, "event": { "kind": "signal", "name": "rename", "bind": { "key": "key", "val": "val" } },
          "actions": [
            { "do": "assign", "target": { "name": "items", "path": [ { "key": { "op": "name", "name": "key" } }, { "field": "name" } ] }, "value": { "op": "name", "name": "val" } }
          ], "to": "@same" },
        { "n": 6, "event": { "kind": "signal", "name": "each" },
          "actions": [
            { "do": "for_each", "var": "x", "in": { "op": "name", "name": "log" },
              "body": [ { "do": "journal", "code": "seen", "params": [ { "name": "item", "value": { "op": "name", "name": "x" } } ] } ] }
          ], "to": "@same" },
        { "n": 7, "event": { "kind": "signal", "name": "branch", "bind": { "n": "n" } },
          "actions": [
            { "do": "if", "cond": { "op": ">", "left": { "op": "name", "name": "n" }, "right": { "op": "lit", "value": 5 } },
              "then": [ { "do": "journal", "code": "big" } ], "else": [ { "do": "journal", "code": "small" } ] }
          ], "to": "@same" },
        { "n": 8, "event": { "kind": "signal", "name": "letit", "bind": { "n": "n" } },
          "actions": [
            { "do": "let", "name": "m", "value": { "op": "*", "left": { "op": "name", "name": "n" }, "right": { "op": "lit", "value": 2 } },
              "body": [ { "do": "journal", "code": "doubled", "params": [ { "name": "value", "value": { "op": "call", "fn": "text", "args": [ { "op": "name", "name": "m" } ] } } ] },
                        { "do": "assign", "target": "total", "value": { "op": "name", "name": "m" } } ] }
          ], "to": "@same" },
        { "n": 9, "event": { "kind": "signal", "name": "shut" },
          "actions": [ { "do": "call", "primitive": "close_agent_turn" } ], "to": "@same" },
        { "n": 10, "event": { "kind": "signal", "name": "boom" },
          "actions": [
            { "do": "assign", "target": "total", "value": { "op": "lit", "value": 99 } },
            { "do": "machine_error", "code": "boom", "params": [ { "name": "why", "value": { "op": "lit", "value": "asked" } } ] }
          ] },
        { "n": 11, "event": { "kind": "signal", "name": "finish" }, "to": "Done" }
      ]
    },
    { "name": "Done", "kind": "end", "reads": [ "total" ] },
    {
      "name": "Errored", "kind": "end", "reads_all": true,
      "entry": [ { "do": "journal_value", "value": { "op": "name", "name": "transition_note" } }, { "do": "journal_all" } ]
    }
  ],
  "ends": {
    "result": "int",
    "rows": [
      { "state": "Done", "n": 1, "when": { "op": "lit", "value": true }, "answer": { "kind": "answer", "value": { "op": "name", "name": "total" } } },
      { "state": "Errored", "n": 1, "when": { "op": "lit", "value": true },
        "answer": { "kind": "refusal", "code": { "op": "variant", "type": "FailCode", "name": "NoResult" },
                    "text": { "op": "call", "fn": "record_text", "args": [ { "op": "name", "name": "transition_note" } ] } } }
    ]
  }
}
