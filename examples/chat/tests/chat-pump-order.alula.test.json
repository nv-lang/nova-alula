{
  "kind": "test",
  "machine": "ChatSession",
  "name": "pump takes the incoming events of the agent in the order of arrival",
  "start_at": 1000,
  "steps": [
    {"do": "feed", "event": {"kind": "signal", "name": "user_message", "input": "hi"}, "expect": {"state": "Awaiting"}},
    {"do": "deliver", "event": {"kind": "progress", "name": "agent_chunk", "request": "agent-1", "input": "one "}},
    {"do": "deliver", "event": {"kind": "progress", "name": "agent_chunk", "request": "agent-1", "input": "two"}},
    {"do": "deliver", "event": {"kind": "answer", "name": "agent_done", "request": "agent-1"}},
    {"do": "pump", "expect": {"state": "Done", "outcome": "answer:one two", "journal": [{"code": "agent_chunk", "params": {"text": "one "}}, {"code": "agent_chunk", "params": {"text": "two"}}, {"code": "agent_done", "params": {}}]}}
  ]
}
