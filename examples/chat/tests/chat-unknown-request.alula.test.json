{
  "kind": "test",
  "machine": "ChatSession",
  "name": "an answer to a request nobody opened is discarded as unknown",
  "start_at": 1000,
  "steps": [
    {"do": "feed", "event": {"kind": "signal", "name": "user_message", "input": "hi"}, "expect": {"state": "Awaiting"}},
    {"do": "feed", "event": {"kind": "answer", "name": "agent_done", "request": "agent-7"}, "expect": {"state": "Awaiting", "journal": [], "open": ["agent-1"], "outcome": "none"}}
  ]
}
