{
  "kind": "test",
  "machine": "ChatSession",
  "name": "an answer that comes after the cancel is discarded as a reply to a closed request",
  "start_at": 1000,
  "steps": [
    {"do": "feed", "event": {"kind": "signal", "name": "user_message", "input": "hi"}, "expect": {"state": "Awaiting"}},
    {"do": "feed", "event": {"kind": "signal", "name": "cancel_request"}, "expect": {"state": "Failed", "outcome": "refusal:StoppedByHuman", "cancelled": ["agent-1"]}},
    {"do": "feed", "event": {"kind": "answer", "name": "agent_done", "request": "agent-1"}, "expect": {"state": "Failed", "journal": [], "outcome": "refusal:StoppedByHuman"}}
  ]
}
