{
  "kind": "test",
  "machine": "ChatSession",
  "name": "a late chunk of a closed request is discarded by the engine and reopens nothing",
  "start_at": 1000,
  "steps": [
    {"do": "feed", "event": {"kind": "signal", "name": "user_message", "input": "hi"}, "expect": {"state": "Awaiting"}},
    {"do": "feed", "event": {"kind": "answer", "name": "agent_done", "request": "agent-1"}, "expect": {"state": "Done", "outcome": "answer:"}},
    {"do": "feed", "event": {"kind": "progress", "name": "agent_chunk", "request": "agent-1", "input": "late"}, "expect": {"state": "Done", "journal": [], "outcome": "answer:", "open": []}}
  ]
}
