{
  "kind": "test",
  "machine": "ChatSession",
  "name": "an answer that comes after the timeout is discarded",
  "start_at": 1000,
  "steps": [
    {"do": "feed", "event": {"kind": "signal", "name": "user_message", "input": "hi"}, "expect": {"state": "Awaiting"}},
    {"do": "advance", "ms": 31000},
    {"do": "pump", "expect": {"state": "Failed", "outcome": "refusal:Timeout"}},
    {"do": "deliver", "event": {"kind": "answer", "name": "agent_done", "request": "agent-1"}},
    {"do": "pump", "expect": {"state": "Failed", "journal": [], "outcome": "refusal:Timeout"}}
  ]
}
