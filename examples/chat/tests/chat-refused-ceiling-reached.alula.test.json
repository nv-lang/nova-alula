{
  "kind": "test",
  "machine": "ChatSession",
  "name": "a refusal with the code CeilingReached ends the session with it",
  "start_at": 1000,
  "steps": [
    {"do": "feed", "event": {"kind": "signal", "name": "user_message", "input": "hi"}, "expect": {"state": "Awaiting"}},
    {"do": "feed", "event": {"kind": "failure", "name": "agent_refused", "request": "agent-1", "code": "CeilingReached"}, "expect": {"state": "Failed", "journal": [{"code": "agent_refused", "params": {"code": "ceiling_reached"}}], "outcome": "refusal:CeilingReached", "open": []}}
  ]
}
