{
  "format": "machine/2",
  "alula_version": "2.26",
  "machine": "Variants",
  "version": "1",
  "title": "The answer of an agent is a variant: a row for each case, On accept before the transition, a list of failure codes, restart of the request, the term",
  "types": {
    "variants": [
      {
        "name": "Outcome",
        "cases": [
          {
            "name": "Done",
            "fields": [
              {
                "name": "text",
                "type": "text"
              }
            ]
          },
          {
            "name": "Retry"
          },
          {
            "name": "Fail",
            "fields": [
              {
                "name": "why",
                "type": "text"
              }
            ]
          }
        ]
      }
    ]
  },
  "data": [
    {
      "name": "tries",
      "type": "int>=0",
      "initial": {
        "expr": {
          "op": "lit",
          "value": 0
        }
      },
      "monotonic": true
    },
    {
      "name": "result",
      "type": "text",
      "initial": {
        "expr": {
          "op": "lit",
          "value": ""
        }
      }
    }
  ],
  "parties": [
    {
      "name": "agent",
      "id": "agent",
      "kind": "agent",
      "result": "Outcome",
      "counter": "agent_attempt"
    }
  ],
  "initial": "Ask",
  "states": [
    {
      "name": "Ask",
      "kind": "appeal",
      "party": "agent",
      "inputs": [
        {
          "field": "task",
          "value": {
            "op": "lit",
            "value": "go"
          },
          "reads": "party"
        },
        {
          "field": "tries",
          "value": {
            "op": "name",
            "name": "tries"
          },
          "reads": "executor"
        }
      ],
      "silence": {
        "op": "lit",
        "value": 5000
      },
      "accept": [
        {
          "event": {
            "kind": "answer"
          },
          "actions": [
            {
              "do": "assign",
              "target": "tries",
              "value": {
                "op": "+",
                "left": {
                  "op": "name",
                  "name": "tries"
                },
                "right": {
                  "op": "lit",
                  "value": 1
                }
              }
            }
          ]
        },
        {
          "event": {
            "kind": "failure"
          },
          "actions": [
            {
              "do": "assign",
              "target": "tries",
              "value": {
                "op": "+",
                "left": {
                  "op": "name",
                  "name": "tries"
                },
                "right": {
                  "op": "lit",
                  "value": 1
                }
              }
            }
          ]
        }
      ],
      "rows": [
        {
          "n": 1,
          "event": {
            "kind": "answer_variant",
            "variant": "Done",
            "bind": {
              "text": "t"
            }
          },
          "actions": [
            {
              "do": "assign",
              "target": "result",
              "value": {
                "op": "name",
                "name": "t"
              }
            },
            {
              "do": "journal",
              "code": "got",
              "params": [
                {
                  "name": "text",
                  "value": {
                    "op": "name",
                    "name": "t"
                  }
                }
              ]
            }
          ],
          "to": "Fin"
        },
        {
          "n": 2,
          "event": {
            "kind": "answer_variant",
            "variant": "Retry"
          },
          "actions": [
            {
              "do": "journal",
              "code": "retrying"
            }
          ],
          "to": "@same",
          "restart": true
        },
        {
          "n": 3,
          "event": {
            "kind": "answer_variant",
            "variant": "Fail",
            "bind": {
              "why": "w"
            }
          },
          "actions": [
            {
              "do": "assign",
              "target": "result",
              "value": {
                "op": "name",
                "name": "w"
              }
            },
            {
              "do": "journal",
              "code": "failed",
              "params": [
                {
                  "name": "why",
                  "value": {
                    "op": "name",
                    "name": "w"
                  }
                }
              ]
            }
          ],
          "to": "Bad"
        },
        {
          "n": 4,
          "event": {
            "kind": "failure",
            "reasons": [
              "ConnectionLost",
              "Timeout"
            ]
          },
          "actions": [
            {
              "do": "journal",
              "code": "transient"
            }
          ],
          "to": "@same",
          "restart": true
        },
        {
          "n": 5,
          "event": {
            "kind": "failure",
            "bind": "code"
          },
          "actions": [
            {
              "do": "assign",
              "target": "result",
              "value": {
                "op": "call",
                "fn": "text",
                "args": [
                  {
                    "op": "name",
                    "name": "code"
                  }
                ]
              }
            },
            {
              "do": "journal",
              "code": "other_failure"
            }
          ],
          "to": "Bad"
        },
        {
          "n": 6,
          "event": {
            "kind": "timeout"
          },
          "actions": [
            {
              "do": "assign",
              "target": "result",
              "value": {
                "op": "lit",
                "value": "silent"
              }
            },
            {
              "do": "journal",
              "code": "silent"
            }
          ],
          "to": "Bad"
        }
      ]
    },
    {
      "name": "Fin",
      "kind": "end",
      "reads": [
        "result"
      ]
    },
    {
      "name": "Bad",
      "kind": "end",
      "reads": [
        "result"
      ]
    }
  ],
  "ends": {
    "result": "text",
    "rows": [
      {
        "state": "Fin",
        "n": 1,
        "when": {
          "op": "lit",
          "value": true
        },
        "answer": {
          "kind": "answer",
          "value": {
            "op": "name",
            "name": "result"
          }
        }
      },
      {
        "state": "Bad",
        "n": 1,
        "when": {
          "op": "lit",
          "value": true
        },
        "answer": {
          "kind": "refusal",
          "code": {
            "op": "variant",
            "type": "FailCode",
            "name": "NoResult"
          },
          "text": {
            "op": "name",
            "name": "result"
          }
        }
      }
    ]
  }
}
