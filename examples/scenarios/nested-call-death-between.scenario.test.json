{
  "format": "scenario/0",
  "machine": "caller",
  "name": "a call: the parent dies between the commit and the send; the restart sends the request once and the nested machine starts once",
  "start_at": 1000,
  "steps": [
    {
      "do": "accept",
      "event": {
        "kind": "start",
        "request": "up-1",
        "input": {
          "task": "t"
        }
      },
      "expect": {
        "state": "Call",
        "open": [
          "callee-1"
        ],
        "sent": [],
        "queue": [
          "send callee-1"
        ]
      }
    },
    {
      "do": "restart",
      "expect": {
        "state": "Call",
        "open": [
          "callee-1"
        ],
        "sent": [],
        "queue": [
          "send callee-1"
        ]
      }
    },
    {
      "do": "dispatch",
      "expect": {
        "sent": [
          "callee-1"
        ],
        "queue": []
      },
      "also": {
        "callee-1": {
          "state": "Ask",
          "sent": [
            "agent-1"
          ],
          "open": [
            "agent-1"
          ]
        }
      }
    },
    {
      "do": "dispatch",
      "expect": {
        "sent": [
          "callee-1"
        ]
      },
      "also": {
        "callee-1": {
          "sent": [
            "agent-1"
          ]
        }
      }
    },
    {
      "do": "feed",
      "event": {
        "kind": "answer",
        "request": "agent-1",
        "input": "hi"
      },
      "on": "callee-1",
      "expect": {
        "state": "Done",
        "journal": [
          {
            "code": "callee_answered",
            "params": {
              "label": "t"
            }
          }
        ],
        "open": [],
        "outcome": "answer:{\"$record\":\"CallOutput\",\"fields\":{\"answer\":\"hi\",\"score\":3}}"
      },
      "also": {
        "parent": {
          "state": "Call",
          "queue": [
            "in answer"
          ],
          "outcome": "none"
        }
      }
    },
    {
      "do": "pump",
      "expect": {
        "state": "Done",
        "journal": [
          {
            "code": "child_answered",
            "params": {
              "answer": "hi",
              "score": "3"
            }
          }
        ],
        "open": [],
        "queue": [],
        "outcome": "answer:hi"
      }
    }
  ]
}
