{
  "format": "scenario/0",
  "machine": "Batch",
  "name": "a set: the agent of one nested machine fails; the element is lost, the others go on and the answer counts the ones that answered",
  "start_at": 1000,
  "steps": [
    {"do": "feed", "event": {"kind": "start", "input": {"names": ["a", "b", "c"]}, "request": "up-1"}},
    {"do": "feed", "event": {"kind": "failure", "request": "agent-1", "code": "ConnectionLost"}, "on": "b-1"},
    {"do": "pump", "expect": {"state": "Jobs", "journal": [{"code": "job_lost", "params": {"party": "b", "code": "no_result"}}], "open": ["a-1", "c-1"], "data": {"lost": ["b"], "to_send": []}}},
    {"do": "feed", "event": {"kind": "answer", "request": "agent-1", "input": "ra"}, "on": "a-1"},
    {"do": "pump", "expect": {"state": "Jobs", "open": ["c-1"]}},
    {"do": "feed", "event": {"kind": "answer", "request": "agent-1", "input": "rc"}, "on": "c-1"},
    {"do": "pump", "expect": {"state": "Done", "outcome": "answer:2", "data": {"lost": ["b"], "answered": ["a", "c"]}}}
  ]
}
