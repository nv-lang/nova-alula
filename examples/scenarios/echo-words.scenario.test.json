{
  "format": "scenario/0",
  "machine": "Echo",
  "name": "free input: the words of the user are journaled and counted, the row `same` keeps the state and opens no request",
  "start_at": 1000,
  "steps": [
    {"do": "feed", "event": {"kind": "start"}, "expect": {"state": "Idle", "open": [], "sent": []}},
    {"do": "feed", "event": {"kind": "signal", "name": "message", "input": "hello"}, "expect": {"state": "Idle", "journal": [{"code": "echoed", "params": {"text": "hello"}}], "data": {"messages": 1, "last": "hello"}, "sent": [], "open": []}},
    {"do": "feed", "event": {"kind": "signal", "name": "message", "input": "again"}, "expect": {"state": "Idle", "journal": [{"code": "echoed", "params": {"text": "again"}}], "data": {"messages": 2, "last": "again"}}}
  ]
}
