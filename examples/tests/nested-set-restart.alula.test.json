{
  "format": "test/0",
  "machine": "fan",
  "name": "a set: the parent restarts with two requests open; both are sent again, no nested machine starts twice",
  "start_at": 1000,
  "steps": [
    {
      "do": "feed",
      "event": {
        "kind": "start",
        "request": "up-1",
        "input": {
          "order": [
            "a",
            "b",
            "c"
          ]
        }
      }
    },
    {
      "do": "restart",
      "expect": {
        "state": "Lenses",
        "open": [
          "a-1",
          "b-1"
        ],
        "queue": [
          "send a-1",
          "send b-1"
        ]
      }
    },
    {
      "do": "dispatch",
      "expect": {
        "sent": [
          "a-1",
          "b-1",
          "a-1",
          "b-1"
        ]
      },
      "also": {
        "a-1": {
          "sent": [
            "agent-1"
          ]
        },
        "b-1": {
          "sent": [
            "agent-1"
          ]
        }
      }
    },
    {
      "do": "feed",
      "event": {
        "kind": "answer",
        "request": "agent-1",
        "input": "ra"
      },
      "on": "a-1"
    },
    {
      "do": "feed",
      "event": {
        "kind": "answer",
        "request": "agent-1",
        "input": "rb"
      },
      "on": "b-1"
    },
    {
      "do": "pump",
      "expect": {
        "state": "Lenses",
        "open": [
          "c-1"
        ],
        "data": {
          "answered": [
            "a",
            "b"
          ]
        }
      }
    }
  ]
}
