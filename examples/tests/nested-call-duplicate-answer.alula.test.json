{
  "kind": "test",
  "machine": "caller",
  "name": "a call: the same answer comes three times; the first is taken, the others are dropped (one request - one answer)",
  "start_at": 1000,
  "steps": [
    {
      "do": "feed",
      "event": {
        "kind": "start",
        "request": "up-1",
        "input": {
          "task": "t"
        }
      },
      "expect": {
        "state": "Call",
        "journal": [],
        "open": [
          "callee-1"
        ],
        "sent": [
          "callee-1"
        ],
        "queue": [],
        "outcome": "none",
        "data": {
          "call_request_id": "up-1",
          "child_attempt": 1,
          "open_requests": [
            "callee-1"
          ]
        }
      },
      "also": {
        "callee-1": {
          "state": "Ask",
          "open": [
            "agent-1"
          ],
          "sent": [
            "agent-1"
          ],
          "queue": [],
          "outcome": "none",
          "data": {
            "label": "t",
            "count": 3,
            "profile": "fast",
            "call_request_id": "callee-1",
            "agent_attempt": 1,
            "open_requests": [
              "agent-1"
            ]
          }
        }
      }
    },
    {
      "do": "deliver",
      "event": {
        "kind": "answer",
        "request": "callee-1",
        "input": "{\"$record\":\"CallOutput\",\"fields\":{\"answer\":\"dup\",\"score\":3}}"
      },
      "expect": {
        "queue": [
          "in answer"
        ]
      }
    },
    {
      "do": "deliver",
      "event": {
        "kind": "answer",
        "request": "callee-1",
        "input": "{\"$record\":\"CallOutput\",\"fields\":{\"answer\":\"dup\",\"score\":3}}"
      }
    },
    {
      "do": "pump",
      "expect": {
        "state": "Done",
        "outcome": "answer:dup",
        "queue": [],
        "journal": [
          {
            "code": "child_answered",
            "params": {
              "answer": "dup",
              "score": "3"
            }
          }
        ]
      }
    }
  ]
}
