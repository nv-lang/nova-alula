{
  "format": "test/0",
  "machine": "Retry",
  "name": "same, rerun: a silent agent is asked again - the open request is cancelled, a new one is sent, the counter of the attempts grows",
  "start_at": 1000,
  "steps": [
    {"do": "feed", "event": {"kind": "start"}, "expect": {"state": "Ask", "sent": ["agent-1"], "open": ["agent-1"], "data": {"agent_attempt": 1}}},
    {"do": "feed", "event": {"kind": "failure", "name": "failure", "request": "agent-1", "code": "Timeout"}, "expect": {"state": "Ask", "journal": [{"code": "asked_again_silent", "params": {}}], "sent": ["agent-1", "agent-2"], "open": ["agent-2"], "data": {"agent_attempt": 2}}},
    {"do": "feed", "event": {"kind": "answer", "name": "answer", "request": "agent-2", "input": "fine"}, "expect": {"state": "Review", "journal": [{"code": "got_reply", "params": {"text": "fine"}}], "open": [], "data": {"reply": "fine"}}}
  ]
}
