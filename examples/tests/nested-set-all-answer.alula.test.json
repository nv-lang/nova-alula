{
  "kind": "test",
  "machine": "fan",
  "name": "a set: the answers come one by one; each frees a place, the next element goes; the end answers with the list",
  "start_at": 1000,
  "steps": [
    {
      "do": "feed",
      "event": {
        "kind": "start",
        "request": "up-1",
        "input": {
          "order": [
            "a",
            "b",
            "c"
          ]
        }
      }
    },
    {
      "do": "feed",
      "event": {
        "kind": "answer",
        "request": "agent-1",
        "input": "ra"
      },
      "on": "a-1"
    },
    {
      "do": "pump",
      "expect": {
        "state": "Lenses",
        "open": [
          "b-1",
          "c-1"
        ],
        "sent": [
          "a-1",
          "b-1",
          "c-1"
        ],
        "journal": [
          {
            "code": "lens_answered",
            "params": {
              "party": "a",
              "answer": "ra"
            }
          }
        ],
        "data": {
          "to_send": [],
          "answered": [
            "a"
          ],
          "lenses": {
            "a": {
              "$record": "Lens",
              "fields": {
                "attempt": 1,
                "name": "a"
              }
            },
            "b": {
              "$record": "Lens",
              "fields": {
                "attempt": 1,
                "name": "b"
              }
            },
            "c": {
              "$record": "Lens",
              "fields": {
                "attempt": 1,
                "name": "c"
              }
            }
          }
        }
      },
      "also": {
        "c-1": {
          "state": "Ask",
          "data": {
            "label": "c"
          }
        }
      }
    },
    {
      "do": "feed",
      "event": {
        "kind": "answer",
        "request": "agent-1",
        "input": "rb"
      },
      "on": "b-1"
    },
    {
      "do": "pump",
      "expect": {
        "state": "Lenses",
        "open": [
          "c-1"
        ],
        "data": {
          "answered": [
            "a",
            "b"
          ]
        }
      }
    },
    {
      "do": "feed",
      "event": {
        "kind": "answer",
        "request": "agent-1",
        "input": "rc"
      },
      "on": "c-1"
    },
    {
      "do": "pump",
      "expect": {
        "state": "Done",
        "open": [],
        "outcome": "answer:[\"a\",\"b\",\"c\"]"
      }
    }
  ]
}
