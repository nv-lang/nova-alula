{
  "kind": "test",
  "machine": "Router",
  "name": "a fork over all the values of an enumeration needs no `else`: Mode.A goes to Alpha, the size 5 is small",
  "start_at": 1000,
  "steps": [
    {"do": "feed", "event": {"kind": "start", "input": {"mode": {"$variant": "Mode", "name": "A", "fields": {}}, "size": 5}}, "expect": {"state": "Small", "outcome": "answer:alpha:small", "journal": [{"code": "measured", "params": {"verdict": "small"}}], "data": {"route": "alpha", "verdict": "small"}}}
  ]
}
