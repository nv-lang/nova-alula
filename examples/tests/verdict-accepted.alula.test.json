{
  "kind": "test",
  "machine": "Verdict",
  "name": "a form with a field: Accepted { score } is bound by the event and ends with the answer",
  "start_at": 1000,
  "steps": [
    {"do": "feed", "event": {"kind": "start"}, "expect": {"state": "Judge", "sent": ["judge-1"]}},
    {"do": "feed", "event": {"kind": "answer", "name": "answer", "request": "judge-1", "input": {"$variant": "Verdict", "name": "Accepted", "fields": {"score": 7}}}, "expect": {"state": "Passed", "journal": [{"code": "verdict_accepted", "params": {"score": "7"}}], "outcome": "answer:accepted with 7", "data": {"total": 7}}}
  ]
}
