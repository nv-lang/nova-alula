    {"do": "advance", "ms": 500},
    {"do": "feed", "event": {"kind": "signal", "name": "message", "input": "hello"}, "expect": {"state": "Idle", "data": {"started": 1000, "seen": 1500, "same_read": true, "seen_text": "1970-01-01T00:00:01.500Z", "back": 1500}}},
    {"do": "advance", "ms": 250},
    {"do": "feed", "event": {"kind": "signal", "name": "message", "input": "again"}, "expect": {"state": "Idle", "data": {"started": 1000, "seen": 1750, "same_read": true, "seen_text": "1970-01-01T00:00:01.750Z", "back": 1750}}}
  ]
